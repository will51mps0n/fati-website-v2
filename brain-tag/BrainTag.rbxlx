		bush(164, -133, 6, "Green"),
		bush(60, -136, 5, "Orange"),
		bush(-20, -136, 4, "Green"),
		bush(150, -138, 4, "Orange"),
	}

	layout.humanSpawns = {
		pt(-60, 116),
		pt(30, 128),
		pt(150, 125),
		pt(-162, 100),
		pt(-162, 30),
		pt(165, 70),
		pt(165, 5),
		pt(-162, -60),

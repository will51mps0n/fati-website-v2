local UPRIGHT_FRAME = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, Vector3.zAxis) -- X axis points up

export type Built = {
	model: Model,
	body: Part,
	kind: string,
	weight: FurnitureSpecs.Weight,
	decor: boolean,
	home: CFrame,
}

-- The piece's parts, posed at its spot (body first, no physics yet).
local function draw(spot: MapLayout.FurnitureSpot): (Model, Part, CFrame)
	local spec = FurnitureSpecs.get(spot.kind)
	local design = DESIGNS[spot.kind]
	local floorTop = MapLayout.HEIGHTS.Floor
	local decor = spec.decor == true
	local baseY = if decor then MapLayout.HEIGHTS.Rug - spec.h / 2 else floorTop + spec.h / 2 + 0.02
	local home = CFrame.new(spot.x, baseY, spot.z) * CFrame.Angles(0, math.rad(spot.rot), 0)

	local model = Instance.new("Model")
	model.Name = spot.kind
	local body = Parts.make({
		name = "Body",
		size = Vector3.new(spec.w, spec.h, spec.d),
		cframe = home,
		color = design.body,
		transparency = if design.transparentBody then 1 else 0,
		parent = model,
	})
	model.PrimaryPart = body

	design.draw(newCtx(model, body, spec.w, spec.d, spec.h))

	if not design.transparentBody and not decor then
		-- A darker, slightly bigger copy just under the top: from above it
		-- draws the thick outline the original's furniture has.
		local base = Color3.fromHex(design.body)
		Parts.make({
			name = "Outline",
			size = Vector3.new(spec.w + 0.4, spec.h - 0.04, spec.d + 0.4),
			cframe = home * CFrame.new(0, -0.02, 0),
			color = Color3.new(base.R * 0.55, base.G * 0.55, base.B * 0.55),
			parent = model,
		})
	end
	return model, body, home
end

-- A still, anchored copy for editing maps in Studio (MapStudio). Its pivot
-- is the spot: move or turn it and the map follows.
function FurnitureBuilder.preview(spot: MapLayout.FurnitureSpot, parent: Instance): Model
	local model = draw(spot)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	model.Parent = parent
	return model
end

function FurnitureBuilder.build(spot: MapLayout.FurnitureSpot, parent: Instance): Built
	local spec = FurnitureSpecs.get(spot.kind)
	local decor = spec.decor == true
	local model, body, home = draw(spot)

	if decor then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
			end
		end
		model.Parent = parent
		return {
			model = model,
			body = body,
			kind = spot.kind,
			weight = spec.weight,
			decor = true,
			home = home,
		}
	end

	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= body then
			Parts.makeVisual(part)
			Parts.weldInPlace(body, part)
		end
	end

	body.Anchored = false
	body.CollisionGroup = "Furniture"
	-- Low friction with weight 1: floors (friction 0, weight 100) let pieces
	-- glide at exactly the speed FurnitureService sets, while walls (friction
	-- 1, weight 100) grip them, so a barricade pressed into a doorway holds.
	body.CustomPhysicalProperties =
		PhysicalProperties.new(Config.FURNITURE_DENSITY[spec.weight], 0.3, 0, 1, 1)

	-- Stay upright but spin freely around the vertical axis.
	local attachment = Instance.new("Attachment")
	attachment.Name = "Upright"
	attachment.CFrame = UPRIGHT_FRAME
	attachment.Parent = body
	local align = Instance.new("AlignOrientation")
	align.Name = "KeepUpright"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.AlignType = Enum.AlignType.PrimaryAxisParallel
	align.Attachment0 = attachment
	align.CFrame = UPRIGHT_FRAME
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.Parent = body

	model:SetAttribute("Weight", spec.weight)
	model:SetAttribute("OwnerUserId", 0)
	model.Parent = parent
	return { model = model, body = body, kind = spot.kind, weight = spec.weight, decor = false, home = home }
end

return FurnitureBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">FurnitureService</string>
          <string name="Source"><![CDATA[-- Owns every furniture piece: builds them, decides who simulates each one,
-- and resets them each round.
--
-- Responsiveness: when you push a piece, your client asks for it ("claim")
-- and the server hands you its physics, so it moves the instant you push
-- and stops the instant you stop, with no network lag. If anyone else pushes
-- the same piece (a zombie on the other side of a barricade, another player,
-- a bot), the server takes it back and resolves everyone's pushes itself, so
-- a barricade standoff is fair. Pieces nobody pushes stand perfectly still.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureBuilder = require(script.Parent.FurnitureBuilder)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

local FurnitureService = {}

type Piece = FurnitureBuilder.Built & {
	owner: Player?,
	lastClaim: number,
	pushers: { [string]: number }, -- participant id -> last time seen pushing
	contestedUntil: number,
	tugOfWar: boolean, -- contestedUntil came from two pushers, not a shove
	burst: Vector3,
	burstUntil: number,
	burstLength: number,
	lastGood: CFrame, -- last position that passed the anti-cheat checks
	lastGoodAt: number, -- when the piece last moved to lastGood
}

-- Someone who can push furniture. `reach` is set while they hold a melee
-- weapon, whose shaft (along `aim`) pushes too.
export type Mover = {
	root: BasePart,
	humanoid: Humanoid,
	id: string,
	scale: number,
	aim: Vector3,
	firmness: number?, -- held weapon's Items.firmness
	guard: number?, -- held weapon's Items.guard
	reach: number?,
	zombie: boolean?, -- a zombie's arms push furniture too
}

local OWNER = FurniturePush.OWNER_ATTRIBUTE
local CONTEST_SECONDS = 0.8

local pieces: { Piece } = {}
local byBody: { [BasePart]: Piece } = {}
local byModel: { [Instance]: Piece } = {}
local folder: Folder
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local getMovers: () -> { Mover } = function()
	return {}
end

local function serverOwns(piece: Piece)
	piece.owner = nil
	pcall(function()
		piece.body:SetNetworkOwner(nil)
	end)
	piece.model:SetAttribute(OWNER, 0)
end

local function stop(piece: Piece)
	local v = piece.body.AssemblyLinearVelocity
	piece.body.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
	piece.body.AssemblyAngularVelocity = Vector3.zero
end

-- Takes a piece back from a client (optionally blocking new claims for a
-- bit). In a tug of war the piece keeps moving: the server writes the
-- resolved velocity the same frame, so stopping it would only cause a snap.
local function revoke(piece: Piece, blockSeconds: number, halt: boolean?)
	if piece.owner then
		serverOwns(piece)
		if halt ~= false then
			stop(piece)
		end
	end
	piece.contestedUntil = math.max(piece.contestedUntil, os.clock() + blockSeconds)
end

-- True if anyone other than `id` pushed the piece in the last moment.
local function othersPushing(piece: Piece, id: string, now: number): boolean
	for other, seen in piece.pushers do
		if other ~= id and now - seen <= 0.3 then
			return true
		end
	end
	return false
end

local function grant(piece: Piece, player: Player)
	local ok = pcall(function()
		piece.body:SetNetworkOwner(player)
	end)
	if ok then
		piece.owner = player
		piece.model:SetAttribute(OWNER, player.UserId)
	end
end

function FurnitureService.build(layout: MapLayout.Layout)
	folder = workspace:WaitForChild("Furniture") :: Folder
	folder:ClearAllChildren()
	table.clear(pieces)
	table.clear(byBody)
	table.clear(byModel)
	for _, spot in layout.furniture do
		local built = FurnitureBuilder.build(spot, folder)
		if not built.decor then
			local piece = built :: Piece
			piece.owner = nil
			piece.lastClaim = 0
			piece.pushers = {}
			piece.contestedUntil = 0
			piece.tugOfWar = false
			piece.burst = Vector3.zero
			piece.burstUntil = 0
			piece.burstLength = 1
			piece.lastGood = built.home
			piece.lastGoodAt = 0
			table.insert(pieces, piece)
			byBody[built.body] = piece
			byModel[built.model] = piece
			serverOwns(piece)
		end
	end
	overlap.FilterDescendantsInstances = { folder }
end

-- A sudden shove (shotgun blast, potato hit): the server takes the piece and
-- moves it at `velocity`, easing to a stop over `seconds`.
function FurnitureService.shove(body: BasePart, velocity: Vector3, seconds: number)
	local piece = byBody[body]
	if not piece then
		return
	end
	revoke(piece, seconds + 0.2)
	piece.burst = Vector3.new(velocity.X, 0, velocity.Z)
	piece.burstLength = seconds
	piece.burstUntil = os.clock() + seconds
end

function FurnitureService.pieceOf(part: BasePart): FurnitureBuilder.Built?
	return byBody[part]
end

-- Every movable piece within `radius` of a point (bots barricading).
function FurnitureService.piecesNear(position: Vector3, radius: number): { BasePart }
	local out: { BasePart } = {}
	for _, piece in pieces do
		if piece.body.Parent and Util.flatDistance(piece.body.Position, position) <= radius then
			table.insert(out, piece.body)
		end
	end
	return out
end

function FurnitureService.weightOf(body: BasePart): string?
	local piece = byBody[body]
	return piece and piece.weight
end

function FurnitureService.findInBox(cframe: CFrame, size: Vector3): { BasePart }
	local found = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, overlap) do
		if byBody[part] then
			table.insert(found, part)
		end
	end
	return found
end

function FurnitureService.resetAll()
	for _, piece in pieces do
		serverOwns(piece)
		piece.contestedUntil = 0
		piece.tugOfWar = false
		piece.burstUntil = 0
		table.clear(piece.pushers)
		piece.model:PivotTo(piece.home)
		piece.lastGood = piece.home
		piece.body.AssemblyLinearVelocity = Vector3.zero
		piece.body.AssemblyAngularVelocity = Vector3.zero
	end
end

-- A client asks to drive the pieces it is pushing.
local function onClaim(player: Player, list: unknown)
	if typeof(list) ~= "table" then
		return
	end
	local claims = list :: { unknown }
	if #claims > 16 then
		return
	end
	local p = Participants.fromPlayer(player)
	local root = p and Participants.body(p)
	if not p or not root then
		return
	end
	local now = os.clock()
	for _, model in claims do
		local piece = if typeof(model) == "Instance" then byModel[model] else nil
		if not piece or now < piece.contestedUntil or now < piece.burstUntil then
			continue
		end
		if piece.owner and piece.owner ~= player then
			revoke(piece, CONTEST_SECONDS, false) -- two players fighting over it: server decides
			continue
		end
		if othersPushing(piece, p.id, now) then
			continue -- someone else is on it too: the server settles that
		end
		-- Only pieces you could actually be touching (body or longest weapon).
		local range = piece.body.Size.Magnitude / 2 + root.Size.X / 2 + 12 * math.max(1, p.scale) + 3
		if Util.flatDistance(piece.body.Position, root.Position) > range then
			continue
		end
		piece.lastClaim = now
		if piece.owner ~= player then
			grant(piece, player)
		end
	end
end

-- Pushers in a line add up: someone walking into the back of another mover
-- heading the same way leans on them and lends them their strength (a
-- little less per link), so a queue of zombies at a barricade shoves as one.
type Lean = { dir: Vector3?, own: number, leaners: { number } }

local function leanGraph(movers: { Mover }): { Lean }
	local shell = Config.CHARACTER.ShellDiameter / 2
	local leans: { Lean } = {}
	for i, mover in movers do
		local move = mover.humanoid.MoveDirection
		local flat = Vector3.new(move.X, 0, move.Z)
		local moving = flat.Magnitude > 0.1 and mover.humanoid.WalkSpeed > 0
		leans[i] = {
			dir = if moving then flat.Unit else nil,
			own = RoundRules.pushStrength(mover.scale, mover.zombie),
			leaners = {},
		}
	end
	for i, a in leans do
		local dir = a.dir
		if not dir then
			continue
		end
		local ra = shell * movers[i].scale
		local here = movers[i].root.Position
		local best, bestAlong = nil, math.huge
		for j, b in leans do
			local bDir = b.dir
			if j == i or not bDir or bDir:Dot(dir) < 0.3 then
				continue
			end
			local rb = shell * movers[j].scale
			local rel = movers[j].root.Position - here
			rel = Vector3.new(rel.X, 0, rel.Z)
			local along = rel:Dot(dir)
			local side = (rel - dir * along).Magnitude
			if along > 0.2 and along < ra + rb + 0.8 and side < (ra + rb) * 0.9 and along < bestAlong then
				best, bestAlong = j, along
			end
		end
		if best then
			table.insert(leans[best].leaners, i)
		end
	end
	return leans
end

-- Strength of mover `i` plus everyone leaning on it (and on them...); adds
-- every helper's id to `helpers`.
local function chained(
	movers: { Mover },
	leans: { Lean },
	i: number,
	helpers: { string },
	seen: { [number]: boolean }
): number
	seen[i] = true
	local total = leans[i].own
	for _, j in leans[i].leaners do
		if not seen[j] then
			table.insert(helpers, movers[j].id)
			total += chained(movers, leans, j, helpers, seen) * Config.PUSH_CHAIN_SHARE
		end
	end
	return total
end

local function collectPushes(now: number): FurniturePush.Pushes
	local pushes: FurniturePush.Pushes = {}
	local movers = getMovers()
	local leans = leanGraph(movers)
	for i, mover in movers do
		local humanoid, root = mover.humanoid, mover.root
		local walk = humanoid.WalkSpeed
		if walk <= 0 then
			continue
		end
		local dir = leans[i].dir
		local moving = dir ~= nil
		local strength = leans[i].own
		local helpers: { string } = {}
		if moving and #leans[i].leaners > 0 then
			strength = chained(movers, leans, i, helpers, {})
		end
		local touched: { [BasePart]: boolean } = {}
		local function pushing(piece: Piece)
			piece.pushers[mover.id] = now
			for _, id in helpers do
				piece.pushers[id] = now
			end
		end
		if dir then
			local probe, size = FurniturePush.moverProbe(root, dir, mover.scale)
			for _, part in workspace:GetPartBoundsInBox(probe, size, overlap) do
				local piece = byBody[part]
				if piece then
					touched[part] = true
					pushing(piece)
					FurniturePush.add(pushes, part, dir * walk, strength, probe.Position)
				end
			end
		end
		-- A zombie's arms are solid: walking, they push what they touch along
		-- with the body; standing or turning, they shove it out of the way.
		if mover.zombie then
			local probe, size = FurniturePush.armsProbe(
				root,
				mover.scale,
				CharacterLook.ZOMBIE_ARM_REACH,
				CharacterLook.ZOMBIE_ARM_SPAN
			)
			for _, part in workspace:GetPartBoundsInBox(probe, size, overlap) do
				local piece = byBody[part]
				if piece and not touched[part] then
					touched[part] = true
					if dir then
						pushing(piece)
						FurniturePush.add(pushes, part, dir * walk, strength, probe.Position)
					else
						local exit = FurniturePush.shaftExit(root.Position, probe.LookVector, part)
						FurniturePush.add(
							pushes,
							part,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							strength,
							nil
						)
					end
				end
			end
		end
		-- A held weapon's shaft is solid, same as on the client: it pushes
		-- what it touches along your path, or out of its way when you stand
		-- still or turn.
		if mover.reach then
			local grip = CharacterLook.grip(mover.scale)
			local hand = (root.CFrame * grip).Position
			local shaft, shaftSize = FurniturePush.itemProbe(root, grip, mover.aim, mover.reach, mover.guard)
			local firm = leans[i].own * (mover.firmness or 1)
			for _, part in workspace:GetPartBoundsInBox(shaft, shaftSize, overlap) do
				local piece = byBody[part]
				if piece and not touched[part] then
					if dir then
						-- Only walking counts as pushing for ownership: someone just
						-- standing near a piece with a weapon out shouldn't take it
						-- away from the player driving it.
						piece.pushers[mover.id] = now
						FurniturePush.add(pushes, part, dir * walk, firm, part.Position + mover.aim * 0.5)
					else
						local exit = FurniturePush.shaftExit(hand, mover.aim, part)
						FurniturePush.add(
							pushes,
							part,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							firm,
							nil
						)
					end
				end
			end
		end
	end
	-- A pushed piece pushes whatever it runs into, so a shove moves a whole
	-- barricade (two links deep).
	for _ = 1, 2 do
		for body, push in table.clone(pushes) do
			local velocity = FurniturePush.resolve(body, push)
			local ahead = Util.flatUnit(velocity)
			if ahead and velocity.Magnitude > 0.5 then
				local center = body.Position + ahead * (FurniturePush.extent(body, ahead) + 0.6)
				local side = Vector3.new(-ahead.Z, 0, ahead.X)
				local width = FurniturePush.extent(body, side) * 2 * 0.9
				local probe = CFrame.lookAt(center, center + ahead)
				for _, other in workspace:GetPartBoundsInBox(probe, Vector3.new(width, 2, 1.2), overlap) do
					if other ~= body and byBody[other] and not pushes[other] then
						FurniturePush.add(pushes, other, velocity, push.strength, center)
					end
				end
			end
		end
	end
	return pushes
end

-- Is a client-driven piece somewhere a legitimate push could have put it?
local function plausible(piece: Piece, now: number): boolean
	local body = piece.body
	local owner = piece.owner
	local p = owner and Participants.fromPlayer(owner)
	local root = p and Participants.body(p)
	if not p or not root then
		return false
	end
	local v = body.AssemblyLinearVelocity
	if Vector3.new(v.X, 0, v.Z).Magnitude > Config.FURNITURE_MAX_SPEED * 1.5 or v.Y > 8 then
		return false
	end
	if body.AssemblyAngularVelocity.Magnitude > 3 then
		return false
	end
	-- Client positions arrive in bursts, so compare against the time since
	-- the piece last moved, not one server frame (capped so a piece that sat
	-- still for a while can't jump far).
	local moved = Util.flatDistance(body.Position, piece.lastGood.Position)
	local elapsed = math.clamp(now - piece.lastGoodAt, 1 / 60, 0.3)
	if moved > Config.FURNITURE_MAX_SPEED * 1.6 * elapsed + 1.5 then
		return false -- teleported
	end
	local range = body.Size.Magnitude / 2 + root.Size.X / 2 + 14 * math.max(1, p.scale) + 6
	return Util.flatDistance(body.Position, root.Position) <= range
end

local function step(dt: number)
	local now = os.clock()
	local pushes = collectPushes(now)
	for _, piece in pieces do
		local body = piece.body
		if body.Parent == nil then
			continue
		end

		-- Who is pushing this piece right now (seen by the server)?
		local owner = piece.owner
		local ownerId = if owner then "P" .. owner.UserId else ""
		local active, someoneElse = 0, false
		for id, seen in piece.pushers do
			if now - seen > 0.3 then
				piece.pushers[id] = nil
			else
				active += 1
				if owner and id ~= ownerId then
					someoneElse = true
				end
			end
		end
		if now >= piece.contestedUntil then
			piece.tugOfWar = false
		end
		if active >= 2 or someoneElse then
			-- A tug of war: the server simulates it so both sides count.
			piece.tugOfWar = true
			revoke(piece, CONTEST_SECONDS, false)
		elseif not owner and piece.tugOfWar and now < piece.contestedUntil and active >= 1 then
			-- Keep the server in charge until the tug of war is really over.
			piece.contestedUntil = now + CONTEST_SECONDS
		elseif owner then
			if owner.Parent ~= Players or now - piece.lastClaim > Config.FURNITURE_RELEASE_SECONDS then
				revoke(piece, 0)
			elseif not plausible(piece, now) then
				-- Moved in a way no push could: put it back and take it away.
				revoke(piece, 1.5)
				piece.model:PivotTo(piece.lastGood)
			end
		end
		if piece.owner then
			-- Only advance when a new position has arrived (see plausible).
			if (body.Position - piece.lastGood.Position).Magnitude > 0.01 then
				piece.lastGood, piece.lastGoodAt = body.CFrame, now
			end
		end

		if piece.owner == nil then
			piece.lastGood, piece.lastGoodAt = body.CFrame, now
			local v = body.AssemblyLinearVelocity
			if now < piece.burstUntil then
				local k = (piece.burstUntil - now) / piece.burstLength
				body.AssemblyLinearVelocity =
					Vector3.new(piece.burst.X * k, math.min(v.Y, 0), piece.burst.Z * k)
			else
				local push = pushes[body]
				if push then
					local velocity, spin = FurniturePush.resolve(body, push)
					body.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(v.Y, 0), velocity.Z)
					body.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
				elseif
					math.abs(v.X) + math.abs(v.Z) > 0.02 or body.AssemblyAngularVelocity.Magnitude > 0.02
				then
					stop(piece) -- no sliding
				end
			end
		end
	end
end

function FurnitureService.start(movers: () -> { Mover })
	getMovers = movers
	Remotes.unreliable("PushClaim").OnServerEvent:Connect(onClaim)
	Players.PlayerRemoving:Connect(function(player)
		for _, piece in pieces do
			if piece.owner == player then
				revoke(piece, 0)
			end
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return FurnitureService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Held items and items lying on the ground. Each human holds at most one
-- item (shown in their right hand). E picks up the nearest ground item, G
-- drops, left click uses. Becoming a zombie drops whatever you held.
-- Every use is validated and resolved here on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Combat = require(script.Parent.Combat)
local Config = require(ReplicatedStorage.Shared.Config)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local MapBuilder = require(script.Parent.MapBuilder)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Traps = require(script.Parent.Traps)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local ItemService = {}

local groundFolder: Folder
local rng = Random.new()

-- Hand models -------------------------------------------------------------------

local function attachHeld(p: Participant)
	local character = p.character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldItem")
	if old then
		old:Destroy()
	end
	if not p.heldItem or p.team ~= "Human" then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local model = ItemModels.build(p.heldItem, Items.reachScale(p.scale))
	model.Name = "HeldItem"
	model:SetAttribute("ItemId", p.heldItem) -- clients read it for weapon force fields
	local handle = model.PrimaryPart :: BasePart
	local s = p.scale
	local grip = CharacterLook.grip(s)
	model:PivotTo(root.CFrame * grip)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			Parts.makeVisual(part)
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "GripWeld"
	weld.Part0 = root
	weld.Part1 = handle
	weld.C0 = grip
	weld.Parent = handle
	model.Parent = character
end

function ItemService.refreshHand(p: Participant)
	attachHeld(p)
end

local function setStreaming(p: Participant, itemId: string?)
	p.streaming = itemId ~= nil
	if p.character then
		p.character:SetAttribute("Spraying", itemId) -- clients draw the spray
	end
end

-- Inventory ----------------------------------------------------------------------------
-- Config.INVENTORY_SLOTS slots; the active one is in your hand. p.heldItem and
-- p.heldCharges mirror the active slot, so everything else just reads those.

local function publishSlots(p: Participant)
	for i = 1, Config.INVENTORY_SLOTS do
		local slot = p.slots[i]
		p.state:SetAttribute("Slot" .. i, if slot then slot.id else "")
		p.state:SetAttribute("Slot" .. i .. "Charges", if slot then slot.charges or 0 else 0)
	end
	p.state:SetAttribute("ActiveSlot", p.slot)
end

-- Puts the active slot's item in the hand.
local function equipActive(p: Participant)
	local slot = p.slots[p.slot]
	p.heldItem = if slot then slot.id else nil
	p.heldCharges = if slot then slot.charges else nil
	setStreaming(p, nil)
	p.state:SetAttribute("HeldItem", p.heldItem or "")
	p.state:SetAttribute("HeldCharges", p.heldCharges or 0)
	publishSlots(p)
	attachHeld(p)
end

-- Sets (or empties) the active slot.
local function setHeld(p: Participant, itemId: string?, charges: number?)
	if itemId then
		local item = Items.get(itemId)
		p.slots[p.slot] = { id = itemId, charges = charges or (item and item.charges) }
	else
		p.slots[p.slot] = nil
	end
	equipActive(p)
end

-- Charges left on the item in hand (peels, water, fuel).
local function setCharges(p: Participant, charges: number)
	p.heldCharges = charges
	local slot = p.slots[p.slot]
	if slot then
		slot.charges = charges
	end
	p.state:SetAttribute("HeldCharges", charges)
	publishSlots(p)
end

function ItemService.hasFreeSlot(p: Participant): boolean
	for i = 1, Config.INVENTORY_SLOTS do
		if not p.slots[i] then
			return true
		end
	end
	return false
end

function ItemService.carries(p: Participant, itemId: string): boolean
	for _, slot in p.slots do
		if slot.id == itemId then
			return true
		end
	end
	return false
end

-- Switches which slot is in your hand.
function ItemService.select(p: Participant, slot: number)
	if slot >= 1 and slot <= Config.INVENTORY_SLOTS and slot ~= p.slot then
		p.slot = slot
		equipActive(p)
	end
end

-- Ground items -----------------------------------------------------------------------

function ItemService.spawnGround(itemId: string, position: Vector3, charges: number?): Model
	local model = ItemModels.build(itemId)
	model.Name = itemId
	-- Built at the origin, so the bounding box center is the offset to undo.
	local center = model:GetBoundingBox().Position
	local y = MapLayout.HEIGHTS.Floor + 0.55
	local spin = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	model:PivotTo(CFrame.new(position.X, y, position.Z) * spin * CFrame.new(-center.X, 0, -center.Z))
	local ring = Parts.disc(
		"Ring",
		Vector3.new(position.X, MapLayout.HEIGHTS.Floor + 0.05, position.Z),
		4,
		0.06,
		"FFFFFF",
		model
	)
	ring.Transparency = 0.55
	ring.CanCollide = false
	ring.CanQuery = false
	model:SetAttribute("ItemId", itemId)
	model:SetAttribute("Charges", charges)
	model:SetAttribute("SpotX", position.X)
	model:SetAttribute("SpotZ", position.Z)
	model.Parent = groundFolder
	return model
end

local function groundSpot(model: Model): Vector3
	return Vector3.new(model:GetAttribute("SpotX") :: number, 0, model:GetAttribute("SpotZ") :: number)
end

function ItemService.clearGround()
	groundFolder:ClearAllChildren()
end

function ItemService.scatter()
	local count = rng:NextInteger(Config.GROUND_ITEMS_MIN, Config.GROUND_ITEMS_MAX)
	local spots = table.clone(MapLayout.current().itemSpots)
	local pool = Items.groundTable()
	local total = 0
	for _, entry in pool do
		total += entry.weight
	end
	for _ = 1, math.min(count, #spots) do
		local spot = table.remove(spots, rng:NextInteger(1, #spots)) :: MapLayout.Point
		local roll = rng:NextNumber() * total
		local chosen = pool[#pool].id
		for _, entry in pool do
			roll -= entry.weight
			if roll < 0 then
				chosen = entry.id
				break
			end
		end
		ItemService.spawnGround(chosen, Vector3.new(spot.x, 0, spot.z))
	end
end

-- Holding ----------------------------------------------------------------------------

-- Adds an item: into your hand if it's empty, else into the first free
-- slot. With every slot full, the item in your hand is dropped for it.
function ItemService.give(p: Participant, itemId: string, charges: number?)
	if p.slots[p.slot] then
		for i = 1, Config.INVENTORY_SLOTS do
			if not p.slots[i] then
				local item = Items.get(itemId)
				p.slots[i] = { id = itemId, charges = charges or (item and item.charges) }
				publishSlots(p)
				return
			end
		end
		ItemService.drop(p)
	end
	setHeld(p, itemId, charges)
end

function ItemService.drop(p: Participant)
	local itemId = p.heldItem
	if not itemId then
		return
	end
	local root = Participants.body(p)
	if root then
		local spot = root.Position + p.aim * (root.Size.X / 2 + 2)
		ItemService.spawnGround(itemId, spot, p.heldCharges)
	end
	setHeld(p, nil)
end

function ItemService.take(p: Participant)
	setHeld(p, nil)
end

function ItemService.pickUp(p: Participant)
	if p.team ~= "Human" then
		return
	end
	local root = Participants.body(p)
	if not root then
		return
	end
	local best: Model? = nil
	local bestDistance = Config.PICKUP_RADIUS * math.max(1, p.scale)
	for _, model in groundFolder:GetChildren() do
		if model:IsA("Model") then
			local d = Util.flatDistance(groundSpot(model), root.Position)
			if d <= bestDistance then
				best, bestDistance = model, d
			end
		end
	end
	if not best then
		return
	end
	local itemId = best:GetAttribute("ItemId") :: string
	local charges = best:GetAttribute("Charges")
	best:Destroy()
	ItemService.give(p, itemId, if typeof(charges) == "number" then charges else nil)
	Announcer.fx("Pickup", { position = root.Position })
end

-- Getting eaten loses everything you carry (items should be rare: mostly bought).
function ItemService.onInfected(p: Participant)
	table.clear(p.slots)
	equipActive(p)
end

-- Melee weapons without `hits` only keep zombies away while held; a click
-- does nothing.
local function canUse(item: Items.Item): boolean
	return item.kind ~= "Melee" or item.hits == true
end

-- Using ----------------------------------------------------------------------------

local function breakWallAhead(p: Participant, aim: Vector3, reach: number): boolean
	local root = Participants.body(p)
	if not root then
		return false
	end
	for _, angle in { 0, 0.18, -0.18 } do
		local direction = (CFrame.Angles(0, angle, 0) * aim) * reach
		local result = workspace:Raycast(root.Position, direction, Combat.wallParams())
		if result then
			local segment = MapBuilder.segmentOf(result.Instance)
			if segment and MapBuilder.breakSegment(segment) then
				local wall = segment.PrimaryPart
				if wall then
					Announcer.fx("WallBreak", { cframe = wall.CFrame, size = wall.Size })
				end
				return true
			end
		end
	end
	return false
end

local function use(p: Participant, item: Items.Item, aim: Vector3)
	local root = Participants.body(p)
	if not root then
		return
	end
	local kind = item.kind
	if kind == "Melee" or kind == "Blast" then
		local reach = (item.reach or 5) * Items.reachScale(p.scale)
		for _, hit in Combat.peopleInCone(p, aim, reach, item.arc or 90) do
			local direction = if item.straight then aim else hit.direction
			Combat.knockback(hit.target, direction * (item.knockback or 50), item.stun or 0.3)
			local zRoot = Participants.body(hit.target)
			if zRoot and item.fx then
				Announcer.fx("Hit", { position = zRoot.Position, fx = item.fx })
			end
			if item.effect == "Plunge" then
				Announcer.fx(
					"Plunged",
					{ character = hit.target.character, seconds = item.effectSeconds or 1.5 }
				)
			end
		end
		if kind == "Blast" then
			Announcer.fx("Blast", { origin = root.Position, direction = aim, reach = reach, item = item.id })
			if item.breaksWalls then
				breakWallAhead(p, aim, reach)
			end
			-- The blast also throws furniture around (heavier pieces less).
			local center = root.Position + aim * (reach / 2)
			for _, body in
				FurnitureService.findInBox(
					CFrame.lookAt(center, center + aim),
					Vector3.new(reach * 0.9, 4, reach)
				)
			do
				local away = Util.flatUnit(body.Position - root.Position) or aim
				local mass = (Config.FURNITURE_MASS :: { [string]: number })[FurnitureService.weightOf(body) or "Medium"]
					or 0.45
				FurnitureService.shove(body, away * 28 * math.clamp(1 - mass / 1.6, 0.15, 1), 0.35)
			end
		else
			Announcer.fx("Swing", { character = p.character, item = item.id })
		end
	elseif kind == "Projectile" then
		Projectiles.fire(p, item, aim)
		Announcer.fx("Shoot", { character = p.character, item = item.id })
	elseif kind == "Trap" then
		Traps.place(root.Position - aim * (root.Size.X / 2 + 0.6), item, p)
		Announcer.fx("Drop", { position = root.Position })
		setCharges(p, (p.heldCharges or 1) - 1)
		if (p.heldCharges or 0) <= 0 then
			ItemService.take(p)
		end
	elseif kind == "Consumable" and item.speedBoost then
		CharacterService.speedEffect(p, item.speedBoost, item.boostSeconds or 8)
		ItemService.take(p)
		Announcer.fx("Gulp", { position = root.Position, character = p.character })
		if p.player then
			Announcer.toast(
				p.player,
				"Zoom! Faster for " .. (item.boostSeconds or 8) .. " seconds",
				Config.COLORS.Good
			)
		end
	elseif kind == "Consumable" then
		local before = p.immunity
		Participants.setImmunity(p, p.immunity + (item.immunity or 0))
		ItemService.take(p)
		Announcer.fx("Eat", { position = root.Position })
		if p.player then
			Announcer.toast(
				p.player,
				string.format("Immunity %d -> %d / %d", before, p.immunity, Config.IMMUNITY_MAX),
				Config.COLORS.Good
			)
		end
	elseif kind == "Passive" then
		if p.player then
			Announcer.toast(
				p.player,
				string.format("Hold this when the round ends: +%d%% score", (item.rewardBonus or 0) * 100)
			)
		end
	end
end

local function onUse(player: Player, action: unknown, aim: unknown)
	local p = Participants.fromPlayer(player)
	if not p or typeof(aim) ~= "Vector3" then
		return
	end
	local direction = Util.flatUnit(aim :: Vector3)
	if not direction then
		return
	end
	p.aim = direction
	if action == "stop" then
		setStreaming(p, nil)
		return
	end
	if action ~= "start" or p.team ~= "Human" then
		return
	end
	local item = Items.get(p.heldItem)
	if not item then
		return
	end
	if item.kind == "Stream" then
		setStreaming(p, item.id) -- sprays until "stop" (see streamStep)
		return
	end
	if not canUse(item) then
		return
	end
	local now = os.clock()
	if now < p.itemReadyAt then
		return
	end
	p.itemReadyAt = now + (item.cooldown or 0.5)
	use(p, item, direction)
end

-- Bots use their held item with the same rules and cooldowns as players
-- (streams spray for a moment).
function ItemService.botUse(p: Participant, aim: Vector3)
	local direction = Util.flatUnit(aim)
	local item = Items.get(p.heldItem)
	if not direction or not item or p.team ~= "Human" then
		return
	end
	p.aim = direction
	if item.kind == "Stream" then
		setStreaming(p, item.id)
		task.delay(0.6, function()
			if p.heldItem == item.id then
				setStreaming(p, nil)
			end
		end)
		return
	end
	if not canUse(item) then
		return
	end
	local now = os.clock()
	if now < p.itemReadyAt then
		return
	end
	p.itemReadyAt = now + (item.cooldown or 0.5)
	use(p, item, direction)
end

-- Held melee weapons are solid to people too: anyone else (zombie or human)
-- touching the shaft (within the item's `guard`) is shoved off it in short
-- pulses, so a stick held across a doorway keeps zombies out. Firm weapons
-- (bat, pan) hold people completely; soft ones (pool noodle) give, so they
-- squeeze past. A bigger holder holds harder, a bigger person pushes
-- through easier.
-- Held melee weapons are solid but not bouncy. Someone pressing on the
-- shaft is held off it, and leans on the holder in turn, shared by strength
-- (size squared; a firm bat counts for more than a pool noodle): equal sizes
-- share the push, so a zombie can walk you backwards and slide round the
-- end, while a much bigger holder doesn't budge. Bots are moved here;
-- players feel it on their own screen (client ForceField).
local function shaftStep(dt: number)
	local people = Participants.all()
	local rate = math.min(1, dt * Config.SHAFT_SOFTNESS)
	for _, p in Participants.onTeam("Human") do
		local item = Items.get(p.heldItem)
		local root = Participants.body(p)
		if not item or item.kind ~= "Melee" or not root then
			continue
		end
		local reach = (item.reach or 5) * Items.reachScale(p.scale)
		local guard = item.guard or 0.5
		local hand = (root.CFrame * CharacterLook.grip(p.scale)).Position
		local start = Vector3.new(hand.X, 0, hand.Z)
		local hold = p.scale * p.scale * (item.firmness or 1)
		if not p.player then
			-- Furniture is solid to the weapon: a bot whose weapon is pressed
			-- into a piece gets pushed back off it (players' own screens do
			-- this for them, see ForceField).
			local grip = CharacterLook.grip(p.scale)
			local frame, size = FurniturePush.itemProbe(root, grip, p.aim, reach, guard)
			for _, body in FurnitureService.findInBox(frame, size + Vector3.new(1, 0, 1)) do
				local depth, out = FurniturePush.overlapOut(start, start + p.aim * reach, guard, body)
				if out then
					root.CFrame += out * (math.min(depth, 2) * rate)
				end
			end
		end
		for _, other in people do
			local oRoot = if other ~= p then Participants.body(other) else nil
			if not oRoot or (other.player and p.player) then
				continue -- two players: their own screens handle it
			end
			local o = Vector3.new(oRoot.Position.X, 0, oRoot.Position.Z)
			local along = math.clamp((o - start):Dot(p.aim), 0, reach)
			local offset = o - (start + p.aim * along)
			local radius = Config.CHARACTER.ShellDiameter / 2 * other.scale
			local overlap = radius + guard - offset.Magnitude
			if overlap > 0 and Combat.lineOfSight(root.Position, oRoot.Position) then
				local push = RoundRules.pushStrength(other.scale, other.team == "Zombie")
				local away = Util.flatUnit(offset) or p.aim
				local step = math.min(overlap, 2) * rate
				if not other.player then
					oRoot.CFrame += away * (step * hold / (hold + push))
					other.pressedUntil = os.clock() + 0.4 -- bots learn to go round
				end
				if not p.player then
					root.CFrame -= away * (step * push / (hold + push))
				end
			end
		end
	end
end

-- Water gun and leaf blower: while held, push everyone in the cone a
-- little, many times a second. The leaf blower also blows light furniture.
local function streamStep()
	local now = os.clock()
	for _, p in Participants.onTeam("Human") do
		if not p.streaming then
			continue
		end
		local item = Items.get(p.heldItem)
		local root = Participants.body(p)
		if not item or item.kind ~= "Stream" or not root then
			setStreaming(p, nil)
			continue
		end
		if now < p.nextStreamTick then
			continue
		end
		p.nextStreamTick = now + (item.tick or 0.12)
		if item.charges then
			setCharges(p, (p.heldCharges or 1) - 1)
			if (p.heldCharges or 0) <= 0 then
				ItemService.take(p) -- out of water
			end
		end
		local reach = (item.reach or 14) * Items.reachScale(p.scale)
		for _, hit in Combat.peopleInCone(p, p.aim, reach, item.arc or 30) do
			local falloff = 1 - hit.distance / (reach * 1.5)
			Combat.knockback(hit.target, p.aim * (item.knockback or 15) * falloff, item.stun or 0.1)
		end
		if item.fx == "Leaves" then
			local center = root.Position + p.aim * (reach / 2)
			local box = CFrame.lookAt(center, center + p.aim)
			for _, body in FurnitureService.findInBox(box, Vector3.new(reach * 0.6, 4, reach)) do
				local weight = FurnitureService.weightOf(body)
				if weight == "Light" or weight == "Medium" then
					FurnitureService.shove(body, p.aim * (if weight == "Light" then 12 else 6), 0.18)
				end
			end
		end
	end
end

function ItemService.init()
	groundFolder = workspace:WaitForChild("GroundItems") :: Folder
	CharacterService.onResized = attachHeld -- the grip moves with your size

	Remotes.event("UseItem").OnServerEvent:Connect(onUse)
	Remotes.unreliable("Aim").OnServerEvent:Connect(function(player, aim)
		local p = Participants.fromPlayer(player)
		local direction = if p and typeof(aim) == "Vector3" then Util.flatUnit(aim) else nil
		if p and direction then
			p.aim = direction
		end
	end)

	local lastAction: { [Player]: number } = {}
	local function throttled(player: Player): boolean
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.2 then
			return true
		end
		lastAction[player] = now
		return false
	end

	Remotes.event("PickUp").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and not throttled(player) then
			ItemService.pickUp(p)
		end
	end)
	Remotes.event("DropItem").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and p.team == "Human" and not throttled(player) then
			ItemService.drop(p)
		end
	end)
	Remotes.event("SelectSlot").OnServerEvent:Connect(function(player, slot)
		local p = Participants.fromPlayer(player)
		if p and typeof(slot) == "number" and slot == math.floor(slot) then
			ItemService.select(p, slot)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)

	RunService.Heartbeat:Connect(shaftStep)
	RunService.Heartbeat:Connect(streamStep)
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="33">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the world, starts every service, and turns
-- joining players into participants.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes")) -- creates the remotes

local WorldSetup = require(script.Parent.WorldSetup)
WorldSetup.run()

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)

local AdminService = require(script.Parent.AdminService)
local BotService = require(script.Parent.BotService)
local BushService = require(script.Parent.BushService)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local DataService = require(script.Parent.DataService)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local MapBuilder = require(script.Parent.MapBuilder)
local MapStudio = require(script.Parent.MapStudio)
local MonetizationService = require(script.Parent.MonetizationService)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local RoundManager = require(script.Parent.RoundManager)
local ShopService = require(script.Parent.ShopService)
local TopScores = require(script.Parent.TopScores)
local Traps = require(script.Parent.Traps)

-- Maps built in Studio (Workspace.BrainTagMaps) join the rotation, first.
MapStudio.loadAll()
MapBuilder.setDecor(MapStudio.decor)
local firstMap = MapLayout.use(MapLayout.rotation(Config.MAP_ROTATION)[1] or "Neighborhood")
MapBuilder.build(firstMap)
FurnitureService.build(firstMap)
CharacterService.buildTemplate()
CharacterService.init()

FurnitureService.start(function()
	local movers = {}
	for _, p in Participants.all() do
		local root, humanoid = Participants.body(p)
		if root and humanoid then
			local item = Items.get(p.heldItem)
			local melee = p.team == "Human" and item and item.kind == "Melee"
			table.insert(movers, {
				root = root,
				humanoid = humanoid,
				id = p.id,
				scale = p.scale,
				aim = p.aim,
				reach = if melee and item then (item.reach or 5) * Items.reachScale(p.scale) else nil,
				firmness = if melee and item then item.firmness else nil,
				guard = if melee and item then item.guard else nil,
				zombie = p.team == "Zombie",
			})
		end
	end
	return movers
end)

Combat.init()
Projectiles.init()
Traps.init()
BushService.init()
ItemService.init()
ShopService.init()
DataService.init()
MonetizationService.init()
TopScores.start()
RoundManager.start()
AdminService.init()

local function onPlayerAdded(player: Player)
	player.CanLoadCharacterAppearance = false
	local profile = DataService.load(player) -- yields
	local passes = MonetizationService.ownedPasses(player) -- yields
	if player.Parent ~= Players then
		return
	end
	local p = Participants.add({
		id = Participants.playerId(player),
		name = player.DisplayName,
		player = player,
		isBot = false,
		profile = profile,
		passes = passes,
	})
	MonetizationService.applyPasses(p)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local p = Participants.fromPlayer(player)
	if p then
		Participants.remove(p)
	end
end)

BotService.start()
print("[Brain Tag] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds a map from MapLayout: grass with little details, dirt paths, the
-- road, house floors with patterns, outlined walls split into breakable
-- segments, windows, bushes and an invisible boundary, all in the map's
-- theme colors (MapThemes), with its lighting. Fake (secret) wall pieces
-- look like the rest but people walk through them. Roofed maps put a roof
-- over every room, hiding it except on the screen of whoever is inside
-- (RoofController).

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local MapThemes = require(ReplicatedStorage.Shared.MapThemes)
local Parts = require(ReplicatedStorage.Shared.Parts)

local MapBuilder = {}

local COLORS = MapLayout.COLORS -- the current map's theme palette (set in build)
local H = MapLayout.HEIGHTS
local WALL_HEIGHT = MapLayout.WALL_HEIGHT

type Rect = MapLayout.Rect
type Layout = MapLayout.Layout

local mapFolder: Folder
local wallsFolder: Folder? = nil
local brokenSegments: { Model } = {}

local function sub(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Thin detail lying on a surface whose top is `surfaceY`.
local function detail(
	name: string,
	x: number,
	z: number,
	sx: number,
	sz: number,
	surfaceY: number,
	color: string,
	parent: Instance,
	yaw: number?
): Part
	local part = Parts.make({
		name = name,
		size = Vector3.new(sx, 0.04, sz),
		cframe = CFrame.new(x, surfaceY + 0.015, z) * CFrame.Angles(0, yaw or 0, 0),
		color = color,
		canCollide = false,
		canQuery = false,
		parent = parent,
	})
	return part
end

local function flatDisc(
	name: string,
	x: number,
	z: number,
	diameter: number,
	surfaceY: number,
	color: string,
	parent: Instance
)
	local part = Parts.disc(name, Vector3.new(x, surfaceY + 0.02, z), diameter, 0.05, color, parent)
	part.CanCollide = false
	part.CanQuery = false
	return part
end

local function slab(name: string, r: Rect, topY: number, color: string, parent: Instance): Part
	return Parts.slab(name, r.x1, r.z1, r.x2, r.z2, topY, 0.4, color, parent)
end

-- Ground, decorations, paths -----------------------------------------------------

local function speckle(
	r: Rect,
	surfaceY: number,
	color: string,
	perArea: number,
	rng: Random,
	parent: Instance
)
	local count = math.floor((r.x2 - r.x1) * (r.z2 - r.z1) / perArea)
	for _ = 1, count do
		flatDisc(
			"Speck",
			rng:NextNumber(r.x1 + 0.4, r.x2 - 0.4),
			rng:NextNumber(r.z1 + 0.4, r.z2 - 0.4),
			rng:NextNumber(0.25, 0.5),
			surfaceY,
			color,
			parent
		)
	end
end

local function buildGround(parent: Instance, layout: Layout)
	-- Outside the brick wall: a darker field, far bigger than the playable
	-- area so the camera never sees past it (beyond it you'd see the sky).
	local outside = Parts.slab("Outside", -900, -900, 900, 900, H.Grass - 0.05, 4, COLORS.Outside, parent)
	outside.Name = "Outside"
	local b = layout.bounds
	local ground = Parts.slab("Grass", b.x1, b.z1, b.x2, b.z2, H.Grass, 4, COLORS.Grass, parent)
	ground.Name = "Ground"

	local decor = sub("GrassDetails", parent)
	local rng = Random.new(1337)
	local blocked = MapLayout.noDecorRects(layout)
	local bounds = layout.bounds
	local function isFree(x: number, z: number): boolean
		for _, r in blocked do
			if MapLayout.inRect(r, x, z, 1) then
				return false
			end
		end
		return true
	end

	local placed = 0
	local tries = 0
	while placed < 460 and tries < 6000 do
		tries += 1
		local x = rng:NextNumber(bounds.x1 + 3, bounds.x2 - 3)
		local z = rng:NextNumber(bounds.z1 + 3, bounds.z2 - 3)
		if isFree(x, z) then
			placed += 1
			local roll = rng:NextNumber()
			if roll < 0.5 then
				-- Tuft: three dark blades fanned out.
				for _, angle in { -0.5, 0, 0.5 } do
					detail("Tuft", x + angle * 0.5, z, 0.25, 1.1, H.Grass, COLORS.GrassTuft, decor, angle)
				end
			elseif roll < 0.7 then
				flatDisc("Flower", x, z, 1.0, H.Grass, COLORS.Flower, decor)
				flatDisc("FlowerCenter", x, z, 0.35, H.Grass + 0.03, COLORS.FlowerCenter, decor)
			elseif roll < 0.88 then
				flatDisc("Pebble", x, z, rng:NextNumber(0.5, 0.9), H.Grass, COLORS.Pebble, decor)
				if rng:NextNumber() < 0.5 then
					flatDisc(
						"Pebble",
						x + 0.8,
						z + 0.3,
						rng:NextNumber(0.35, 0.6),
						H.Grass,
						COLORS.Pebble,
						decor
					)
				end
			else
				local yaw = rng:NextNumber(0, math.pi)
				detail("Twig", x, z, 0.16, 1.5, H.Grass, COLORS.Twig, decor, yaw)
				detail("Twig", x + 0.3, z + 0.2, 0.12, 0.6, H.Grass, COLORS.Twig, decor, yaw + 0.8)
			end
		end
	end

	local paths = sub("Paths", parent)
	for _, r in layout.paths do
		slab("Dirt", r, H.Dirt, COLORS.Dirt, paths)
		speckle(r, H.Dirt, COLORS.DirtSpeck, 14, rng, paths)
	end

	local patios = sub("Patios", parent)
	for _, r in layout.patios do
		slab("Patio", r, H.Patio, COLORS.Concrete, patios)
		speckle(r, H.Patio, COLORS.ConcreteSpeck, 30, rng, patios)
	end
end

-- Pools: a white rim, blue water with light ripples, and an invisible wall
-- so nobody walks across the water.
local function buildPools(parent: Instance, layout: Layout)
	for _, r in layout.pools do
		local rim = { x1 = r.x1 - 1.5, z1 = r.z1 - 1.5, x2 = r.x2 + 1.5, z2 = r.z2 + 1.5 }
		slab("PoolRim", rim, H.PoolRim, COLORS.PoolRim, parent)
		slab("PoolWater", r, H.PoolRim + 0.02, COLORS.PoolWater, parent)
		local z = r.z1 + 3
		while z < r.z2 - 2 do
			detail(
				"Ripple",
				(r.x1 + r.x2) / 2 + math.sin(z) * 4,
				z,
				(r.x2 - r.x1) * 0.6,
				0.3,
				H.PoolRim + 0.02,
				"8FD3F5",
				parent
			)
			z += 5
		end
		Parts.make({
			name = "PoolWall",
			size = Vector3.new(r.x2 - r.x1 + 2, 6, r.z2 - r.z1 + 2),
			cframe = CFrame.new((r.x1 + r.x2) / 2, 3, (r.z1 + r.z2) / 2),
			color = "000000",
			transparency = 1,
			canQuery = false,
			parent = parent,
		})
	end
end

local function buildRoad(parent: Instance, layout: Layout)
	local road = layout.road
	local rng = Random.new(99)
	for _, r in road.sidewalks do
		slab("Sidewalk", r, H.Sidewalk, COLORS.Sidewalk, parent)
		speckle(r, H.Sidewalk, COLORS.SidewalkSpeck, 40, rng, parent)
	end
	for _, r in road.asphalt do
		slab("Asphalt", r, H.Asphalt, COLORS.Asphalt, parent)
	end
	for _, r in road.centerLines do
		slab("CenterLine", r, H.RoadLine, COLORS.CenterLine, parent)
	end
	for _, r in road.edgeLines do
		slab("EdgeLine", r, H.RoadLine, COLORS.EdgeLine, parent)
	end
	for _, island in layout.islands do
		slab("IslandWalk", island.walk, H.IslandWalk, COLORS.Sidewalk, parent)
		slab("IslandGrass", island.grass, H.IslandGrass, COLORS.Grass, parent)
	end

	for _, spawn in layout.zombieSpawns do
		flatDisc("ZombiePit", spawn.x, spawn.z, 11, H.RoadLine, COLORS.ZombiePit, parent)
		flatDisc("ZombiePitInner", spawn.x, spawn.z, 7, H.RoadLine + 0.03, "4A1C1C", parent)
	end
end

-- Floors ---------------------------------------------------------------------------

local function brickFloor(r: Rect, parent: Instance)
	slab("Brick", r, H.Floor, COLORS.Brick, parent)
	local row = 0
	local z = r.z1
	while z < r.z2 - 0.5 do
		local nextZ = math.min(z + 2.5, r.z2)
		if nextZ < r.z2 then
			detail("Mortar", (r.x1 + r.x2) / 2, nextZ, r.x2 - r.x1, 0.22, H.Floor, COLORS.BrickMortar, parent)
		end
		local x = r.x1 + (if row % 2 == 0 then 5 else 2.5)
		while x < r.x2 - 0.5 do
			detail("Joint", x, (z + nextZ) / 2, 0.22, nextZ - z, H.Floor, COLORS.BrickMortar, parent)
			x += 5
		end
		z = nextZ
		row += 1
	end
end

local function tileFloor(r: Rect, parent: Instance)
	slab("Tile", r, H.Floor, COLORS.Tile, parent)
	local size = 4
	local i = 0
	local x = r.x1
	while x < r.x2 - 0.01 do
		local x2 = math.min(x + size, r.x2)
		local j = 0
		local z = r.z1
		while z < r.z2 - 0.01 do
			local z2 = math.min(z + size, r.z2)
			if (i + j) % 2 == 1 then
				detail("TileAlt", (x + x2) / 2, (z + z2) / 2, x2 - x, z2 - z, H.Floor, COLORS.TileAlt, parent)
			end
			z = z2
			j += 1
		end
		x = x2
		i += 1
	end
end

local function woodFloor(r: Rect, parent: Instance, rng: Random)
	slab("Wood", r, H.Floor, COLORS.Wood, parent)
	local z = r.z1 + 2.5
	while z < r.z2 - 0.5 do
		detail("Plank", (r.x1 + r.x2) / 2, z, r.x2 - r.x1, 0.18, H.Floor, COLORS.WoodLine, parent)
		local x = r.x1 + rng:NextNumber(3, 12)
		while x < r.x2 - 2 do
			detail("PlankEnd", x, z - 1.25, 0.18, 2.5, H.Floor, COLORS.WoodLine, parent)
			x += rng:NextNumber(11, 17)
		end
		z += 2.5
	end
end

local function concreteFloor(r: Rect, parent: Instance, rng: Random)
	slab("Concrete", r, H.Floor, COLORS.Concrete, parent)
	speckle(r, H.Floor, COLORS.ConcreteSpeck, 12, rng, parent)
end

local function buildFloors(parent: Instance, layout: Layout)
	local rng = Random.new(7)
	for _, room in layout.rooms do
		local folder = sub(room.house .. " " .. room.name, parent)
		if room.floor == "Brick" then
			brickFloor(room.rect, folder)
		elseif room.floor == "Dirt" then
			slab("Dirt", room.rect, H.Floor, COLORS.Dirt, folder)
			speckle(room.rect, H.Floor, COLORS.DirtSpeck, 30, rng, folder)
		elseif room.floor == "Tile" then
			tileFloor(room.rect, folder)
		elseif room.floor == "Concrete" then
			concreteFloor(room.rect, folder, rng)
		else
			woodFloor(room.rect, folder, rng)
		end
	end
end

-- Walls ----------------------------------------------------------------------------

local function outlineColor(layout: Layout, houseId: string): string
	for _, house in layout.houses do
		if house.id == houseId then
			return if house.outline == "Orange" then COLORS.OutlineOrange else COLORS.OutlineBlue
		end
	end
	return COLORS.OutlineBlue
end

local function wallColor(layout: Layout, houseId: string): string
	for _, house in layout.houses do
		if house.id == houseId and house.wall then
			return house.wall
		end
	end
	return COLORS.Wall
end

local function buildWalls(parent: Instance, layout: Layout)
	for i, piece in MapLayout.allWallPieces(layout) do
		local r = piece.rect
		local sx, sz = r.x2 - r.x1, r.z2 - r.z1
		local cx, cz = (r.x1 + r.x2) / 2, (r.z1 + r.z2) / 2
		local segment = Instance.new("Model")
		segment.Name = "WallSegment" .. i

		local wall = Parts.make({
			name = "Wall",
			size = Vector3.new(sx, WALL_HEIGHT, sz),
			cframe = CFrame.new(cx, WALL_HEIGHT / 2, cz),
			color = wallColor(layout, piece.house),
			parent = segment,
		})
		-- A slightly bigger, slightly lower slab: from above only its edge shows,
		-- which draws a colored outline around the whole wall shape.
		Parts.make({
			name = "Outline",
			size = Vector3.new(sx + 1, WALL_HEIGHT - 0.1, sz + 1),
			cframe = CFrame.new(cx, (WALL_HEIGHT - 0.1) / 2, cz),
			color = outlineColor(layout, piece.house),
			canCollide = false, -- keeps doorways at their designed width
			canQuery = false,
			parent = segment,
		})
		if piece.window then
			Parts.make({
				name = "Window",
				size = if piece.horizontal then Vector3.new(sx, 0.1, 1.2) else Vector3.new(1.2, 0.1, sz),
				cframe = CFrame.new(cx, WALL_HEIGHT + 0.05, cz),
				color = COLORS.Window,
				canCollide = false,
				canQuery = false,
				parent = segment,
			})
		end
		if piece.secret then
			-- Looks like any other wall and blocks furniture, shots and the bots'
			-- view (and their pathfinding), but people walk straight through.
			wall.CollisionGroup = "SecretWalls"
			segment:SetAttribute("Secret", true)
		end
		segment.PrimaryPart = wall
		segment:SetAttribute("House", piece.house)
		CollectionService:AddTag(segment, "Breakable")
		segment.Parent = parent
	end
end

-- Bushes and boundary -------------------------------------------------------------

-- Tall leaf cylinders you can walk into. Seen from the top-down camera they
-- cover anyone standing inside (see Bushes.luau).
-- A lighter (k > 1) or darker (k < 1) version of a hex color.
local function shade(hex: string, k: number): string
	local c = Color3.fromHex(hex)
	if k >= 1 then
		local t = k - 1
		return Color3.new(c.R + (1 - c.R) * t, c.G + (1 - c.G) * t, c.B + (1 - c.B) * t):ToHex()
	end
	return Color3.new(c.R * k, c.G * k, c.B * k):ToHex()
end

local function buildBushes(parent: Instance, layout: Layout)
	local height = Config.BUSH_HEIGHT
	local classic = layout.theme == "Classic"
	for _, bush in layout.bushes do
		local orange = bush.color == "Orange"
		local cobweb = bush.color == "Cobweb" -- an indoor hiding spot: a big clump of webs
		local base = if cobweb then "C3C9CF" elseif orange then COLORS.BushOrange else COLORS.BushGreen
		-- Classic keeps its hand-picked shades; other themes derive them.
		local light = if classic and not cobweb
			then (if orange then "F2AC62" else "5CBF67")
			else shade(base, 1.3)
		local model = Instance.new("Model")
		model.Name = "Bush"
		local blobs = {
			{ 0, 0, bush.r * 2 },
			{ math.cos(0.7) * bush.r * 0.6, math.sin(0.7) * bush.r * 0.6, bush.r * 1.4 },
			{ math.cos(3.5) * bush.r * 0.6, math.sin(3.5) * bush.r * 0.6, bush.r * 1.3 },
		}
		local outline = if classic and not cobweb
			then (if orange then "B5651E" else "2E7D3E")
			else shade(base, 0.65)
		for _, blob in blobs do
			-- A darker, slightly bigger, slightly lower disc draws the outline.
			Parts.disc(
				"Outline",
				Vector3.new(bush.x + blob[1], (height - 0.1) / 2, bush.z + blob[2]),
				blob[3] + 0.7,
				height - 0.1,
				outline,
				model
			)
		end
		for _, blob in blobs do
			Parts.disc(
				"Leaves",
				Vector3.new(bush.x + blob[1], height / 2, bush.z + blob[2]),
				blob[3],
				height,
				base,
				model
			)
			Parts.disc(
				"Highlight",
				Vector3.new(bush.x + blob[1] - 0.2, height + 0.03, bush.z + blob[2] - 0.2),
				blob[3] * 0.6,
				0.06,
				light,
				model
			)
		end
		if cobweb then
			-- Strands across the top.
			for k = 0, 3 do
				local strand = Parts.make({
					name = "Strand",
					size = Vector3.new(bush.r * 2.2, 0.05, 0.12),
					cframe = CFrame.new(bush.x, height + 0.08, bush.z) * CFrame.Angles(0, k * math.pi / 4, 0),
					color = "F4F6F8",
					parent = model,
				})
				strand.Transparency = 0.3
			end
		end
		-- Walk-through and shoot-through: bushes only hide what's inside.
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
			end
		end
		model.Parent = parent
	end
end

-- A brick wall around the playable area so it's obvious where the map ends:
-- brick-textured tops with a dark cap line on the inside edge, plus an
-- invisible tall barrier on top so nothing is ever knocked over it.
local BOUNDARY_THICKNESS = 3
local BOUNDARY_HEIGHT = 8

type Side = { cx: number, cz: number, sx: number, sz: number, inward: Vector3 }

local function buildBoundary(parent: Instance, layout: Layout)
	local b = layout.bounds
	local t = BOUNDARY_THICKNESS
	local w, d = b.x2 - b.x1, b.z2 - b.z1
	local sides: { Side } = {
		{ cx = (b.x1 + b.x2) / 2, cz = b.z1 - t / 2, sx = w + t * 2, sz = t, inward = Vector3.zAxis },
		{ cx = (b.x1 + b.x2) / 2, cz = b.z2 + t / 2, sx = w + t * 2, sz = t, inward = -Vector3.zAxis },
		{ cx = b.x1 - t / 2, cz = (b.z1 + b.z2) / 2, sx = t, sz = d, inward = Vector3.xAxis },
		{ cx = b.x2 + t / 2, cz = (b.z1 + b.z2) / 2, sx = t, sz = d, inward = -Vector3.xAxis },
	}
	for _, side in sides do
		local cx, cz, sx, sz, inward = side.cx, side.cz, side.sx, side.sz, side.inward
		Parts.make({
			name = "BrickWall",
			size = Vector3.new(sx, BOUNDARY_HEIGHT, sz),
			cframe = CFrame.new(cx, BOUNDARY_HEIGHT / 2, cz),
			color = COLORS.BoundaryBrick,
			material = Enum.Material.Brick,
			parent = parent,
		})
		-- Dark line along the inside edge, like the outline on house walls.
		local edge = Vector3.new(cx, 0, cz) + inward * (t / 2 - 0.25)
		Parts.make({
			name = "WallCap",
			size = if inward.X == 0 then Vector3.new(sx, 0.1, 0.5) else Vector3.new(0.5, 0.1, sz),
			cframe = CFrame.new(edge.X, BOUNDARY_HEIGHT + 0.05, edge.Z),
			color = COLORS.BoundaryCap,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
		Parts.make({
			name = "Boundary",
			size = Vector3.new(sx, 40, sz),
			cframe = CFrame.new(cx, BOUNDARY_HEIGHT + 20, cz),
			color = "000000",
			transparency = 1,
			canQuery = false,
			parent = parent,
		})
	end
end

-- Public ----------------------------------------------------------------------------

-- Surface physics for furniture (see FurnitureBuilder): the weight-100 side
-- of a contact decides its friction.
local SLIPPERY = PhysicalProperties.new(0.7, 0, 0, 100, 1)
local GRIPPY = PhysicalProperties.new(0.7, 1, 0, 100, 1)

local function setPhysics(folder: Instance, properties: PhysicalProperties)
	for _, part in folder:GetDescendants() do
		if part:IsA("BasePart") and part.CanCollide then
			part.CustomPhysicalProperties = properties
		end
	end
end

-- Builds `layout`, replacing whatever map was there. The Walls folder is
-- kept (only emptied) so raycast filters that point at it stay valid.
-- Extra parts a map built in Studio brought along (anything not named as a
-- map part: statues, trees, signs...), by map name. Main wires this to
-- MapStudio.
local decorFor: (string) -> Instance? = function()
	return nil
end

function MapBuilder.setDecor(lookup: (string) -> Instance?)
	decorFor = lookup
end

local function collides(instance: Instance): boolean
	if instance:IsA("BasePart") and instance.CanCollide then
		return true
	end
	for _, d in instance:GetDescendants() do
		if d:IsA("BasePart") and d.CanCollide then
			return true
		end
	end
	return false
end

-- Solid ones go with the walls (bots see them as walls; they never break).
local function buildDecor(layout: Layout, walls: Folder)
	local template = decorFor(layout.name)
	if not template then
		return
	end
	local open = sub("Custom", mapFolder)
	local solid = sub("Custom", walls)
	for _, child in template:GetChildren() do
		child:Clone().Parent = if collides(child) then solid else open
	end
end

-- Roofs: one over every room of every house, just under the wall tops so
-- the walls still draw the floor plan. Each player's RoofController hides
-- the roof of the room they stand in, so you see inside only once you're in.
local function buildRoofs(parent: Folder, layout: Layout)
	for _, room in layout.rooms do
		if room.house == "" then
			continue -- yards (a graveyard, a pumpkin patch) stay open
		end
		local r = room.rect
		local roof = Parts.make({
			name = "Roof",
			size = Vector3.new(r.x2 - r.x1, 0.3, r.z2 - r.z1),
			cframe = CFrame.new((r.x1 + r.x2) / 2, WALL_HEIGHT - 0.2, (r.z1 + r.z2) / 2),
			color = COLORS.Roof,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
		roof.CanTouch = false
		roof.CastShadow = false
		roof:SetAttribute("Room", room.house .. " " .. room.name)
	end
	-- A shut-looking door in every doorway, poking up through the roofs. It's
	-- only a look: walk straight through.
	for _, door in MapLayout.doors(layout) do
		local length = door.width - 0.2
		local height = WALL_HEIGHT + 0.1
		local panel = Parts.make({
			name = "Door",
			size = if door.horizontal
				then Vector3.new(length, height, 0.8)
				else Vector3.new(0.8, height, length),
			cframe = CFrame.new(door.x, height / 2, door.z),
			color = COLORS.Door,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
		panel.CanTouch = false
	end
end

-- Sky and light for the map's theme.
local function applyLighting(theme: MapThemes.Theme)
	local l = theme.lighting
	Lighting.Ambient = Color3.fromHex(l.ambient)
	Lighting.OutdoorAmbient = Color3.fromHex(l.outdoor)
	Lighting.Brightness = l.brightness
	Lighting.ClockTime = l.clock
	-- Dark maps need shadows so walls stop your lantern.
	Lighting.GlobalShadows = theme.dark == true
	local tint = Lighting:FindFirstChild("ThemeColor") :: ColorCorrectionEffect?
	if not tint then
		local made = Instance.new("ColorCorrectionEffect")
		made.Name = "ThemeColor"
		made.Parent = Lighting
		tint = made
	end
	assert(tint, "tint")
	tint.TintColor = Color3.fromHex(l.tint or "FFFFFF")
	tint.Saturation = l.saturation or 0
	tint.Contrast = l.contrast or 0
end

function MapBuilder.build(layout: Layout)
	mapFolder = workspace:WaitForChild("Map") :: Folder
	local theme = MapThemes.get(layout.theme)
	COLORS = MapThemes.palette(layout.theme)
	applyLighting(theme)
	local walls = wallsFolder or sub("Walls", mapFolder)
	wallsFolder = walls
	for _, child in mapFolder:GetChildren() do
		if child ~= walls then
			child:Destroy()
		end
	end
	walls:ClearAllChildren()
	table.clear(brokenSegments)

	local ground = sub("Ground", mapFolder)
	buildGround(ground, layout)
	local road = sub("Road", mapFolder)
	buildRoad(road, layout)
	local pools = sub("Pools", mapFolder)
	buildPools(pools, layout)
	local floors = sub("Floors", mapFolder)
	buildFloors(floors, layout)
	buildWalls(walls, layout)
	local bushes = sub("Bushes", mapFolder)
	buildBushes(bushes, layout)
	buildBoundary(sub("Boundary", mapFolder), layout)
	buildDecor(layout, walls)
	if layout.roofs then
		buildRoofs(sub("Roofs", mapFolder), layout)
	end
	for _, folder in { ground, road, floors } do
		setPhysics(folder, SLIPPERY)
	end
	setPhysics(walls, GRIPPY)
	setPhysics(pools, GRIPPY)
	mapFolder:SetAttribute("MapName", layout.name)
	mapFolder:SetAttribute("Theme", theme.name) -- clients light dark maps (DarknessController)
end

function MapBuilder.wallsFolder(): Folder
	assert(wallsFolder, "MapBuilder.build has not run yet")
	return wallsFolder
end

-- Shotgun hit: hide a wall segment until the next round.
function MapBuilder.breakSegment(segment: Model): boolean
	if segment:GetAttribute("Broken") or not CollectionService:HasTag(segment, "Breakable") then
		return false
	end
	segment:SetAttribute("Broken", true)
	for _, part in segment:GetChildren() do
		if part:IsA("BasePart") then
			part:SetAttribute("WasCollide", part.CanCollide)
			part:SetAttribute("WasQuery", part.CanQuery)
			part.Transparency = 1
			part.CanCollide = false
			part.CanQuery = false
		end
	end
	table.insert(brokenSegments, segment)
	return true
end

function MapBuilder.restoreWalls()
	for _, segment in brokenSegments do
		segment:SetAttribute("Broken", nil)
		for _, part in segment:GetChildren() do
			if part:IsA("BasePart") then
				part.Transparency = 0
				part.CanCollide = part:GetAttribute("WasCollide") ~= false
				part.CanQuery = part:GetAttribute("WasQuery") ~= false
			end
		end
	end
	table.clear(brokenSegments)
end

-- Finds the breakable segment a part belongs to.
function MapBuilder.segmentOf(part: Instance): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	if model and CollectionService:HasTag(model, "Breakable") then
		return model
	end
	return nil
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">MapStudio</string>
          <string name="Source"><![CDATA[-- Maps you build in Roblox Studio (README "Making your own maps").
--
-- Workspace.BrainTagMaps holds one folder per map, made of parts named for
-- what they are: Bounds, Wall, Door, Window, Floor, House, HumanSpawn,
-- ZombieSpawn, Start, ItemSpot, WizardSpot, Bush, Road... and any furniture
-- name (Couch, PoolTable...). Anything else you add (a statue, a tree, a
-- sign) is kept as scenery: solid scenery counts as wall for the bots and
-- never breaks. When the game starts it reads every map folder (see
-- MapMarks), adds it to the rotation and tucks the folder away. A map named
-- like a built-in one (Neighborhood, Mansion) replaces it.
--
-- Command Bar helpers (in Studio, while not playing):
--   local Maps = require(game.ServerScriptService.Server.MapStudio)
--   Maps.copy("Neighborhood")         -- edit a built-in map
--   Maps.copy("Mansion", "Castle")    -- start a new map from a built-in one
--   Maps.new("MyMap")                 -- a small starter map
--   Maps.new("Spooky", "Haunted")     -- ...in a theme (MapThemes: Classic,
--                                        Haunted, Winter, Lab, Desert)
--   Maps.resize("MyMap", 400, 300)    -- make the play area bigger (studs)
--   Maps.palette()                    -- one of every part, to copy from
--   Maps.check()                      -- what each map has, and any mistakes
--   Maps.unlock()                     -- unlock parts made by older versions
--
-- Map folder attributes: Title, Enabled, Theme (see MapThemes) and Roofs
-- (every room gets a pitch black roof hiding it, except on the screen of
-- whoever is inside, plus a shut-looking door in each doorway).

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local FurnitureBuilder = require(script.Parent.FurnitureBuilder)
local FurnitureSpecs = require(game:GetService("ReplicatedStorage").Shared.FurnitureSpecs)
local MapLayout = require(game:GetService("ReplicatedStorage").Shared.MapLayout)
local MapMarks = require(game:GetService("ReplicatedStorage").Shared.MapMarks)
local MapThemes = require(game:GetService("ReplicatedStorage").Shared.MapThemes)

type Mark = MapMarks.Mark
type Rect = MapLayout.Rect

local MapStudio = {}

local FOLDER = "BrainTagMaps"
local H = MapLayout.HEIGHTS
local WALL_H = MapLayout.WALL_HEIGHT

-- How each kind looks while you edit (top = height of its top above the
-- ground, which is the top of the Bounds part). `color` is a theme palette
-- name (MapLayout.COLORS) or a hex color.
type Look = {
	color: string,
	top: number,
	height: number,
	transparency: number?,
	disc: boolean?,
	label: boolean?,
	group: string,
}

local LOOKS: { [string]: Look } = {
	Bounds = { color = "Grass", top = 0, height = 1, group = "Ground" },
	Road = { color = "Asphalt", top = H.Asphalt, height = 0.1, group = "Ground" },
	Sidewalk = { color = "Sidewalk", top = H.Sidewalk, height = 0.1, group = "Ground" },
	CenterLine = { color = "CenterLine", top = H.RoadLine, height = 0.05, group = "Ground" },
	EdgeLine = { color = "EdgeLine", top = H.RoadLine, height = 0.05, group = "Ground" },
	Path = { color = "Dirt", top = H.Dirt, height = 0.05, group = "Ground" },
	Patio = { color = "Concrete", top = H.Patio, height = 0.05, group = "Ground" },
	Pool = { color = "PoolWater", top = H.PoolRim, height = 0.3, group = "Ground" },
	IslandWalk = { color = "Sidewalk", top = H.IslandWalk, height = 0.1, group = "Ground" },
	IslandGrass = { color = "Grass", top = H.IslandGrass, height = 0.05, group = "Ground" },
	House = {
		color = "OutlineBlue",
		top = 0.06,
		height = 0.05,
		transparency = 0.3,
		group = "Buildings",
	},
	Floor = { color = "Wood", top = H.Floor, height = 0.2, group = "Buildings" },
	Wall = { color = "Wall", top = WALL_H, height = WALL_H, group = "Buildings" },
	Door = {
		color = "39D353",
		top = WALL_H + 1,
		height = WALL_H + 1,
		transparency = 0.3,
		group = "Buildings",
	},
	Window = { color = "Window", top = WALL_H + 0.5, height = WALL_H + 0.5, group = "Buildings" },
	SecretWall = {
		color = "B05CFF",
		top = WALL_H + 1.2,
		height = WALL_H + 1.2,
		transparency = 0.35,
		group = "Buildings",
	},
	HumanSpawn = { color = "3B82F6", top = 0.9, height = 0.5, disc = true, label = true, group = "Spawns" },
	ZombieSpawn = { color = "E0303A", top = 0.9, height = 0.5, disc = true, label = true, group = "Spawns" },
	Start = { color = "FFFFFF", top = 0.9, height = 0.5, disc = true, label = true, group = "Spawns" },
	ItemSpot = { color = "F5C542", top = 0.9, height = 0.5, disc = true, label = true, group = "Spawns" },
	WizardSpot = { color = "9B59B6", top = 0.9, height = 0.5, disc = true, label = true, group = "Spawns" },
	Bush = { color = "BushGreen", top = 6, height = 6, disc = true, group = "Bushes" },
}

local FLOOR_LOOKS: { [string]: { color: string, material: Enum.Material } } = {
	Dirt = { color = "Dirt", material = Enum.Material.Ground },
	Brick = { color = "Brick", material = Enum.Material.Brick },
	Tile = { color = "Tile", material = Enum.Material.Slate },
	Wood = { color = "Wood", material = Enum.Material.WoodPlanks },
	Concrete = { color = "Concrete", material = Enum.Material.Concrete },
}

-- Reading parts ---------------------------------------------------------------------------

local function attr(instance: Instance, name: string): string?
	local value = instance:GetAttribute(name)
	return if typeof(value) == "string" and value ~= "" then value else nil
end

-- Size of a box seen from above, along world X and Z (any rotation).
local function extents(cf: CFrame, size: Vector3): (number, number, number)
	local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	local w = math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z
	local h = math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z
	local d = math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
	return w, d, h
end

-- Degrees turned about the vertical (CFrame.Angles(0, a, 0) gives a).
local function yawOf(cf: CFrame): number
	local look = cf.LookVector
	return math.deg(math.atan2(-look.X, -look.Z))
end

local function floorOf(part: BasePart): string
	local m = part.Material
	if m == Enum.Material.Brick then
		return "Brick"
	elseif
		m == Enum.Material.Concrete
		or m == Enum.Material.Asphalt
		or m == Enum.Material.Cobblestone
		or m == Enum.Material.Pavement
	then
		return "Concrete"
	elseif m == Enum.Material.Ground or m == Enum.Material.Mud or m == Enum.Material.Sand then
		return "Dirt"
	elseif
		m == Enum.Material.Slate
		or m == Enum.Material.Marble
		or m == Enum.Material.Granite
		or m == Enum.Material.Basalt
	then
		return "Tile"
	end
	return "Wood"
end

local function orange(instance: Instance): boolean
	if instance:IsA("BasePart") then
		local c = instance.Color
		return c.R > c.G + 0.1
	end
	return false
end

-- Map coordinates start at the middle of the Bounds part's top.
local function originOf(bounds: BasePart): Vector3
	local _, _, h = extents(bounds.CFrame, bounds.Size)
	return Vector3.new(bounds.Position.X, bounds.Position.Y + h / 2, bounds.Position.Z)
end

local function markOf(child: Instance, kind: string, origin: Vector3): Mark
	local cf: CFrame, w: number, d: number
	if child:IsA("Model") then
		if MapMarks.isFurniture(kind) then
			cf, w, d = child:GetPivot(), 0, 0
		else
			local box, size = child:GetBoundingBox()
			cf = box
			w, d = extents(box, size)
		end
	else
		local part = child :: BasePart
		cf = part.CFrame
		w, d = extents(part.CFrame, part.Size)
	end
	local m: Mark = { kind = kind, x = cf.X - origin.X, z = cf.Z - origin.Z, w = w, d = d, rot = yawOf(cf) }
	m.id = attr(child, "Id")
	if kind == "Floor" then
		m.floor = attr(child, "Floor") or (if child:IsA("BasePart") then floorOf(child) else nil)
	elseif kind == "House" then
		m.outline = attr(child, "Outline") or (if orange(child) then "Orange" else "Blue")
		m.color = attr(child, "WallColor")
	elseif kind == "Bush" then
		m.color = attr(child, "Color") or (if orange(child) then "Orange" else "Green")
	end
	return m
end

local function holdsKinds(instance: Instance): boolean
	for _, d in instance:GetDescendants() do
		if MapMarks.isKind(attr(d, "Kind") or d.Name) and (d:IsA("BasePart") or d:IsA("Model")) then
			return true
		end
	end
	return false
end

-- A map folder -> its layout (nil if it can't be played), the problems, and
-- its scenery (moved so the map's origin is at 0, 0, 0).
function MapStudio.read(folder: Instance): (MapLayout.Layout?, { string }, { string }, Model)
	local decor = Instance.new("Model")
	decor.Name = folder.Name .. " scenery"
	local bounds = folder:FindFirstChild("Bounds", true)
	if not (bounds and bounds:IsA("BasePart")) then
		return nil, { "No Bounds part: add a part named Bounds under the whole play area" }, {}, decor
	end
	local origin = originOf(bounds)
	local marks: { Mark } = {}
	local function visit(parent: Instance)
		for _, child in parent:GetChildren() do
			local kind = attr(child, "Kind") or child.Name
			local shape = child:IsA("BasePart") or child:IsA("Model")
			if shape and MapMarks.isKind(kind) then
				table.insert(marks, markOf(child, kind, origin))
			elseif child:IsA("Folder") or (child:IsA("Model") and holdsKinds(child)) then
				visit(child)
			elseif shape then
				local copy = child:Clone()
				if copy then
					for _, part in copy:GetDescendants() do
						if part:IsA("BasePart") then
							part.Anchored = true
						end
					end
					if copy:IsA("BasePart") then
						copy.Anchored = true
						copy.CFrame -= origin
					elseif copy:IsA("Model") then
						copy:PivotTo(copy:GetPivot() - origin)
					end
					(copy :: Instance).Parent = decor
				end
			end
		end
	end
	visit(folder)
	local layout, errors, warnings =
		MapMarks.toLayout(folder.Name, attr(folder, "Title") or folder.Name, marks)
	local theme = attr(folder, "Theme")
	if theme and MapThemes.exists(theme) then
		layout.theme = theme
	elseif theme then
		table.insert(
			warnings,
			"Unknown Theme " .. theme .. " (themes: " .. table.concat(MapThemes.NAMES, ", ") .. ")"
		)
	end
	layout.roofs = folder:GetAttribute("Roofs") == true
	return if #errors == 0 then layout else nil, errors, warnings, decor
end

-- Loading at game start -----------------------------------------------------------------------

local decorByMap: { [string]: Model } = {}

local function rootFolder(): Instance?
	return workspace:FindFirstChild(FOLDER) or ServerStorage:FindFirstChild(FOLDER)
end

local function isMap(folder: Instance): boolean
	return (folder:IsA("Folder") or folder:IsA("Model")) and string.sub(folder.Name, 1, 1) ~= "_"
end

-- Reads every map folder and adds the good ones to MapLayout. Call once,
-- before the first map is built. Returns the names loaded.
function MapStudio.loadAll(): { string }
	local root = rootFolder()
	if not root then
		return {}
	end
	root.Parent = ServerStorage -- the editable copies stay out of the game world
	local loaded = {}
	for _, folder in root:GetChildren() do
		if not isMap(folder) or folder:GetAttribute("Enabled") == false then
			continue
		end
		local ok, layout, errors, warnings, decor = pcall(MapStudio.read, folder)
		if not ok then
			warn(string.format("[Maps] %s couldn't be read: %s", folder.Name, tostring(layout)))
			continue
		end
		for _, text in warnings do
			warn(string.format("[Maps] %s: %s", folder.Name, text))
		end
		if layout then
			MapLayout.register(layout)
			if #decor:GetChildren() > 0 then
				decorByMap[layout.name] = decor
			end
			table.insert(loaded, layout.name)
			print(string.format("[Maps] loaded your map %s", folder.Name))
		else
			for _, text in errors do
				warn(string.format("[Maps] %s can't be played: %s", folder.Name, text))
			end
		end
	end
	return loaded
end

-- The scenery of a map built in Studio (for MapBuilder).
function MapStudio.decor(name: string): Instance?
	return decorByMap[name]
end

-- Making parts (Command Bar helpers) ---------------------------------------------------------

local function editing(): boolean
	if RunService:IsRunning() then
		warn("[Maps] Stop the game first: map helpers work while editing.")
		return false
	end
	return true
end

local function label(part: BasePart, text: string)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(12, 3) -- studs
	gui.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	gui.LightInfluence = 0
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = text
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 0
	textLabel.Parent = gui
	gui.Parent = part
end

local function groupFolder(map: Instance, name: string): Instance
	local found = map:FindFirstChild(name)
	if found then
		return found
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = map
	return folder
end

local function makeMark(m: Mark, origin: Vector3, parent: Instance, palette: { [string]: string }): Instance
	if MapMarks.isFurniture(m.kind) then
		local model = FurnitureBuilder.preview(
			{ kind = m.kind, x = origin.X + m.x, z = origin.Z + m.z, rot = m.rot, house = "" },
			parent
		)
		model:PivotTo(model:GetPivot() + Vector3.new(0, origin.Y, 0))
		return model
	end
	local look = LOOKS[m.kind]
	local part = Instance.new("Part")
	part.Name = m.kind
	part.Anchored = true
	part.CanCollide = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	local color = palette[look.color] or look.color
	if m.kind == "Floor" then
		local floor = FLOOR_LOOKS[m.floor or "Wood"] or FLOOR_LOOKS.Wood
		color = palette[floor.color] or floor.color
		part.Material = floor.material
		part:SetAttribute("Floor", m.floor or "Wood")
	elseif m.kind == "House" then
		color = if m.outline == "Orange" then palette.OutlineOrange else palette.OutlineBlue
		part:SetAttribute("Outline", m.outline or "Blue")
		if m.color then
			part:SetAttribute("WallColor", m.color) -- hex, e.g. corn maze walls
		end
	elseif m.kind == "Bush" then
		color = if m.color == "Cobweb"
			then "C3C9CF"
			elseif m.color == "Orange" then palette.BushOrange
			else palette.BushGreen
		part:SetAttribute("Color", m.color or "Green")
	end
	if m.id then
		part:SetAttribute("Id", m.id)
	end
	part.Color = Color3.fromHex(color)
	part.Transparency = look.transparency or 0
	local center = Vector3.new(origin.X + m.x, origin.Y + look.top - look.height / 2, origin.Z + m.z)
	if look.disc then
		local diameter = math.max(m.w, m.d, 1)
		part.Shape = Enum.PartType.Cylinder
		part.Size = Vector3.new(look.height, diameter, diameter)
		part.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	else
		part.Size = Vector3.new(math.max(m.w, 0.2), look.height, math.max(m.d, 0.2))
		part.CFrame = CFrame.new(center)
	end
	if look.label then
		label(part, m.kind)
	end
	part.Parent = parent
	return part
end

local function ensureRoot(): Instance
	local root = rootFolder()
	if root then
		if root.Parent ~= workspace then
			root.Parent = workspace
		end
		return root
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = workspace
	return folder
end

-- Where a new map (or the palette) goes: just right of everything there.
local function freeOrigin(root: Instance, bounds: Rect): Vector3
	local right = -math.huge
	for _, child in root:GetChildren() do
		local b = child:FindFirstChild("Bounds", true)
		if b and b:IsA("BasePart") then
			local w = extents(b.CFrame, b.Size)
			right = math.max(right, b.Position.X + w / 2)
		elseif child.Name == "_Palette" and child:IsA("Folder") then
			for _, d in child:GetDescendants() do
				if d:IsA("BasePart") then
					right = math.max(right, d.Position.X + d.Size.Magnitude / 2)
				end
			end
		end
	end
	-- Lifted a stud so it never flickers against a Baseplate.
	if right == -math.huge then
		return Vector3.new(0, 1, 0)
	end
	return Vector3.new(right + 60 - bounds.x1, 1, 0)
end

local function show(folder: Instance, origin: Vector3, bounds: Rect)
	pcall(function()
		game:GetService("Selection"):Set({ folder })
	end)
	local camera = workspace.CurrentCamera
	if camera then
		local center = origin + Vector3.new((bounds.x1 + bounds.x2) / 2, 0, (bounds.z1 + bounds.z2) / 2)
		local size = math.max(bounds.x2 - bounds.x1, bounds.z2 - bounds.z1)
		camera.CFrame = CFrame.lookAt(center + Vector3.new(0, size * 0.9, size * 0.45), center)
		camera.Focus = CFrame.new(center)
	end
	pcall(function()
		game:GetService("ChangeHistoryService"):SetWaypoint("Brain Tag map")
	end)
end

local function place(name: string, title: string, marks: { Mark }, theme: string, roofs: boolean): Instance?
	if not editing() then
		return nil
	end
	local root = ensureRoot()
	if root:FindFirstChild(name) then
		warn(
			string.format(
				"[Maps] BrainTagMaps already has %s. Pick another name, or delete that folder first.",
				name
			)
		)
		return nil
	end
	local bounds: Rect = { x1 = -100, z1 = -100, x2 = 100, z2 = 100 }
	for _, m in marks do
		if m.kind == "Bounds" then
			bounds = { x1 = m.x - m.w / 2, z1 = m.z - m.d / 2, x2 = m.x + m.w / 2, z2 = m.z + m.d / 2 }
		end
	end
	local origin = freeOrigin(root, bounds)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder:SetAttribute("Title", title)
	folder:SetAttribute("Enabled", true)
	folder:SetAttribute("Theme", theme)
	folder:SetAttribute("Roofs", roofs)
	local palette = MapThemes.palette(theme) :: any
	for _, m in marks do
		local group = if MapMarks.isFurniture(m.kind) then "Furniture" else LOOKS[m.kind].group
		makeMark(m, origin, groupFolder(folder, group), palette)
	end
	folder.Parent = root
	show(folder, origin, bounds)
	print(
		string.format(
			"[Maps] Made %s in Workspace.BrainTagMaps. Edit it, then press Play: it plays first.",
			name
		)
	)
	return folder
end

-- A built-in map as parts. Keep its name to change that map, or give a
-- new name to start a new map from it.
function MapStudio.copy(name: string, newName: string?): Instance?
	local layout = MapLayout.get(name)
	if not layout then
		warn(
			"[Maps] No map called "
				.. tostring(name)
				.. ". Built-in maps: "
				.. table.concat(MapLayout.names, ", ")
		)
		return nil
	end
	local title = if newName then newName else layout.title
	return place(newName or name, title, MapMarks.fromLayout(layout), layout.theme, layout.roofs)
end

-- A small map to build on, in a theme (Classic if none).
function MapStudio.new(name: string?, theme: string?): Instance?
	local mapName = name or "MyMap"
	local themeName = theme or "Classic"
	if not MapThemes.exists(themeName) then
		warn("[Maps] No theme called " .. themeName .. ". Themes: " .. table.concat(MapThemes.NAMES, ", "))
		return nil
	end
	-- Dark maps get roofs (rooms stay pitch black until you walk in).
	local dark = MapThemes.get(themeName).dark == true
	return place(mapName, mapName, MapMarks.starter(), themeName, dark)
end

local function mapFolder(name: string): Instance?
	local root = rootFolder()
	local folder = root and root:FindFirstChild(name)
	if not folder then
		warn("[Maps] No map called " .. name .. " in Workspace.BrainTagMaps")
	end
	return folder
end

-- Makes a map's play area (its Bounds part) this many studs wide (X) and
-- deep (Z), keeping its middle where it is.
function MapStudio.resize(name: string, width: number, depth: number)
	if not editing() then
		return
	end
	local folder = mapFolder(name)
	local bounds = folder and folder:FindFirstChild("Bounds", true)
	if not (bounds and bounds:IsA("BasePart")) then
		warn("[Maps] " .. name .. " has no Bounds part")
		return
	end
	bounds.Locked = false
	bounds.Size = Vector3.new(math.max(40, width), bounds.Size.Y, math.max(40, depth))
	pcall(function()
		game:GetService("ChangeHistoryService"):SetWaypoint("Resize map")
	end)
	print(
		string.format(
			"[Maps] %s is now %d x %d studs.",
			name,
			math.round(bounds.Size.X),
			math.round(bounds.Size.Z)
		)
	)
end

-- Unlocks every part in your maps (older versions locked the ground and
-- house plates, so Studio's tools couldn't move or scale them).
function MapStudio.unlock()
	local root = rootFolder()
	if not root then
		return
	end
	local count = 0
	for _, part in root:GetDescendants() do
		if part:IsA("BasePart") and part.Locked then
			part.Locked = false
			count += 1
		end
	end
	print(string.format("[Maps] Unlocked %d parts.", count))
end

-- One of every part (and every furniture piece) beside your maps, to copy
-- (Ctrl+D) into a map folder.
function MapStudio.palette(): Instance?
	if not editing() then
		return nil
	end
	local root = ensureRoot()
	local old = root:FindFirstChild("_Palette")
	if old then
		old:Destroy()
	end
	local samples: { Mark } = {}
	local function sample(kind: string, w: number, d: number, extra: { [string]: string }?): Mark
		local m: Mark = { kind = kind, x = 0, z = 0, w = w, d = d, rot = 0 }
		if extra then
			m.floor, m.color, m.outline = extra.floor, extra.color, extra.outline
		end
		table.insert(samples, m)
		return m
	end
	sample("Wall", 20, 3)
	sample("Door", 8, 3)
	sample("Window", 10, 3)
	sample("SecretWall", 8, 3)
	for _, floor in MapMarks.FLOORS do
		sample("Floor", 16, 16, { floor = floor })
	end
	sample("House", 16, 16, { outline = "Blue" })
	sample("House", 16, 16, { outline = "Orange" })
	for _, kind in { "HumanSpawn", "ZombieSpawn", "Start", "ItemSpot", "WizardSpot" } do
		sample(kind, 4, 4)
	end
	sample("Bush", 9, 9, { color = "Green" })
	sample("Bush", 9, 9, { color = "Orange" })
	sample("Bush", 6, 6, { color = "Cobweb" })
	sample("Road", 16, 16)
	sample("Sidewalk", 16, 8)
	sample("CenterLine", 16, 1)
	sample("EdgeLine", 16, 1)
	sample("Path", 16, 6)
	sample("Patio", 14, 14)
	sample("Pool", 16, 10)
	sample("IslandWalk", 16, 12)
	sample("IslandGrass", 12, 8)
	local kinds = {}
	for kind in FurnitureSpecs.specs do
		table.insert(kinds, kind)
	end
	table.sort(kinds)
	for _, kind in kinds do
		local spec = FurnitureSpecs.get(kind)
		sample(kind, spec.w, spec.d)
	end

	-- A grid of 26-stud cells, 8 across.
	local cell, across = 26, 8
	local rows = math.ceil(#samples / across)
	local bounds: Rect = { x1 = 0, z1 = 0, x2 = cell * across, z2 = cell * rows }
	local origin = freeOrigin(root, bounds)
	local folder = Instance.new("Folder")
	folder.Name = "_Palette"
	for i, m in samples do
		local col, row = (i - 1) % across, (i - 1) // across
		m.x, m.z = (col + 0.5) * cell, (row + 0.5) * cell
		local made = makeMark(m, origin, folder, MapThemes.palette("Classic") :: any)
		local part = if made:IsA("Model") then made.PrimaryPart else made :: BasePart
		if part and not part:FindFirstChild("Label") then
			label(part, m.kind)
		end
	end
	folder.Parent = root
	show(folder, origin, bounds)
	print("[Maps] Palette ready: select a piece, Ctrl+D to copy it, then drag it into your map's folder.")
	return folder
end

-- What each map folder (or just `name`) has, and anything wrong with it.
function MapStudio.check(name: string?)
	local root = rootFolder()
	if not root then
		print('[Maps] No maps yet. Try: require(game.ServerScriptService.Server.MapStudio).new("MyMap")')
		return
	end
	for _, folder in root:GetChildren() do
		if not isMap(folder) or (name and folder.Name ~= name) then
			continue
		end
		local layout, errors, warnings = MapStudio.read(folder)
		if layout then
			local doors, windows = 0, 0
			for _, w in layout.walls do
				doors += #w.gaps
				windows += #w.windows
			end
			print(
				string.format(
					"[Maps] %s%s (theme %s): %d walls, %d doors, %d windows, %d rooms, %d furniture, %d human spawns, %d zombie spawns, %d item spots, %d bushes",
					folder.Name,
					if folder:GetAttribute("Enabled") == false then " (turned off)" else "",
					layout.theme,
					#layout.walls,
					doors,
					windows,
					#layout.rooms,
					#layout.furniture,
					#layout.humanSpawns,
					#layout.zombieSpawns,
					#layout.itemSpots,
					#layout.bushes
				)
			)
		end
		for _, text in errors do
			warn(string.format("[Maps] %s can't be played: %s", folder.Name, text))
		end
		for _, text in warnings do
			warn(string.format("[Maps] %s: %s", folder.Name, text))
		end
		if layout and #warnings == 0 then
			print(string.format("[Maps] %s is ready to play.", folder.Name))
		end
	end
end

return MapStudio
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Robux purchases: game passes (permanent perks) and developer products
-- (one-off items, boosts and skins). Ids live in Config.MONETIZATION; any id
-- left at 0 is simply ignored.
--
-- ProcessReceipt follows Roblox's recommended pattern: a purchase is granted
-- once, recorded in the buyer's saved profile by its PurchaseId, and only
-- reported as granted after that profile is saved. If anything fails, Roblox
-- retries later and the receipt log prevents a double grant.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local ItemService = require(script.Parent.ItemService)
local Participants = require(script.Parent.Participants)
local Skins = require(ReplicatedStorage.Shared.Skins)
local ShopService = require(script.Parent.ShopService)

type Participant = Participants.Participant

local MonetizationService = {}

local money = Config.MONETIZATION

local function keyFor(map: { [string]: number }, id: number): string?
	for key, value in map do
		if value ~= 0 and value == id then
			return key
		end
	end
	return nil
end

-- Game passes ----------------------------------------------------------------------

-- Which configured passes this player owns (yields; call before spawning).
function MonetizationService.ownedPasses(player: Player): { [string]: boolean }
	local owned: { [string]: boolean } = {}
	for key, id in money.GamePasses do
		if id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and has then
				owned[key :: string] = true
			end
		end
	end
	return owned
end

local function applyPasses(p: Participant)
	-- Pass skins unlock automatically.
	for _, skin in Skins.list do
		if skin.pass and p.passes[skin.pass] then
			ShopService.grantSkin(p, skin.id)
		end
	end
	Participants.publish(p)
	CharacterService.refreshNameTag(p)
end

function MonetizationService.applyPasses(p: Participant)
	applyPasses(p)
end

-- Developer products -----------------------------------------------------------------

local function giveOrQueue(p: Participant, itemId: string)
	if p.team == "Human" and Participants.body(p) then
		ItemService.give(p, itemId)
		if p.player then
			Announcer.toast(p.player, "Delivered! It's in your inventory.", Config.COLORS.Good)
		end
	elseif p.profile then
		table.insert(p.profile.PendingItems, itemId)
		if p.player then
			Announcer.toast(p.player, "Saved for you: you'll get it next round.", Config.COLORS.Good)
		end
	end
end

type Handler = (p: Participant) -> ()

local HANDLERS: { [string]: Handler } = {
	InstantBat = function(p)
		giveOrQueue(p, "Bat")
	end,
	InstantSpear = function(p)
		giveOrQueue(p, "Spear")
	end,
	InstantShotgun = function(p)
		giveOrQueue(p, "Shotgun")
	end,
	InstantAncientSpear = function(p)
		giveOrQueue(p, "AncientSpear")
	end,
	ImmunityShot = function(p)
		Participants.setImmunity(p, p.immunity + money.IMMUNITY_SHOT_AMOUNT)
		if p.player then
			Announcer.toast(p.player, "Immunity boosted!", Config.COLORS.Good)
		end
	end,
	ScoreBoost30 = function(p)
		local now = os.time()
		p.boostEndsAt = math.max(now, p.boostEndsAt) + money.SCORE_BOOST_SECONDS
		if p.profile then
			p.profile.BoostEndsAt = p.boostEndsAt
		end
		p.state:SetAttribute("BoostEndsAt", p.boostEndsAt)
		if p.player then
			Announcer.toast(p.player, "2x score is active!", Config.COLORS.Good)
		end
	end,
}

-- Every skin sold as a product gets a handler that unlocks and equips it.
for _, skin in Skins.list do
	if skin.product then
		HANDLERS[skin.product] = function(p)
			ShopService.grantSkin(p, skin.id)
			ShopService.equipSkin(p, skin)
			if p.player then
				Announcer.toast(p.player, "Unlocked " .. skin.name .. "!", Config.COLORS.Good)
			end
		end
	end
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- retried when they rejoin
	end
	local p = Participants.fromPlayer(player)
	local profile = DataService.get(player)
	if not p or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key = keyFor(money.Products, receipt.ProductId)
	local handler = key and HANDLERS[key]
	if not handler then
		warn(
			"[Shop] Unknown product id "
				.. tostring(receipt.ProductId)
				.. "; add it to Config.MONETIZATION.Products"
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptId = tostring(receipt.PurchaseId)
	if not profile.Receipts[receiptId] then
		local ok, err = pcall(function()
			(handler :: Handler)(p)
			return true
		end)
		if not ok then
			warn("[Shop] Grant failed: " .. tostring(err))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		profile.Receipts[receiptId] = os.time()
	end

	if DataService.isSaved(player) then
		if DataService.save(player) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Studio test purchases are free; with saving off, grant for this session.
	if RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = keyFor(money.GamePasses, passId)
		local p = Participants.fromPlayer(player)
		if key and p then
			p.passes[key] = true
			applyPasses(p)
			Announcer.toast(player, "Thanks! Your pass is active.", Config.COLORS.Good)
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Participants</string>
          <string name="Source"><![CDATA[-- Everyone taking part in rounds: real players and Studio test bots, behind
-- one interface. Each participant is mirrored into a Configuration under
-- ReplicatedStorage.BrainTagState.Participants so every client's HUD can read
-- teams, scores and held items.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Skins = require(ReplicatedStorage.Shared.Skins)

export type Team = "Human" | "Zombie"

export type Slot = { id: string, charges: number? }

export type Participant = {
	id: string,
	name: string,
	player: Player?,
	isBot: boolean,
	character: Model?,
	team: Team,
	score: number,
	immunity: number,
	scale: number,
	heldItem: string?, -- the item in the active slot (in your hand)
	slots: { [number]: Slot }, -- inventory: slot number -> item (missing = empty)
	slot: number, -- active slot
	humanSkin: string,
	zombieSkin: string,
	ownedSkins: { [string]: boolean },
	passes: { [string]: boolean },
	boostEndsAt: number,
	-- runtime only
	itemReadyAt: number,
	returnReadyAt: number,
	stunUntil: number,
	streaming: boolean, -- holding the button with a water gun / leaf blower
	nextStreamTick: number,
	heldCharges: number?, -- uses left (banana peels)
	boostUntil: number, -- energy drink
	boostFactor: number,
	slowUntil: number, -- snowball freeze
	adminSpeed: number, -- speed multiplier set from the admin panel (1 = normal)
	alpha: boolean, -- one of this round's first zombies (special look)
	knockedUntil: number, -- a real hit's shove lasts until then (see Combat.knockback)
	pressedUntil: number, -- bots: being held off someone's weapon (ItemService.shaftStep)
	slowFactor: number,
	spawning: boolean,
	aim: Vector3,
	profile: any?, -- saved data table for players (DataService)
	state: Configuration,
}

local Participants = {}

local byId: { [string]: Participant } = {}
local order: { Participant } = {}
-- Plain callback lists, not BindableEvents: a BindableEvent hands listeners a
-- COPY of any table it carries, and every service must share the same
-- participant table.
local addedCallbacks: { (Participant) -> () } = {}
local removingCallbacks: { (Participant) -> () } = {}

-- Runs `callback(p)` in its own thread for every participant added from now on.
function Participants.onAdded(callback: (Participant) -> ())
	table.insert(addedCallbacks, callback)
end

-- Runs `callback(p)` just before a participant is removed.
function Participants.onRemoving(callback: (Participant) -> ())
	table.insert(removingCallbacks, callback)
end

local function stateFolder(): Folder
	return ReplicatedStorage:WaitForChild("BrainTagState"):WaitForChild("Participants") :: Folder
end

local function csv(set: { [string]: boolean }): string
	local list = {}
	for key, on in set do
		if on then
			table.insert(list, key)
		end
	end
	table.sort(list)
	return table.concat(list, ",")
end

-- Writes every replicated field. Cheap enough to call after any change.
function Participants.publish(p: Participant)
	local s = p.state
	s:SetAttribute("DisplayName", p.name)
	s:SetAttribute("UserId", if p.player then p.player.UserId else 0)
	s:SetAttribute("IsBot", p.isBot)
	s:SetAttribute("Team", p.team)
	s:SetAttribute("Score", math.floor(p.score))
	s:SetAttribute("Immunity", p.immunity)
	s:SetAttribute("Scale", p.scale)
	s:SetAttribute("HeldItem", p.heldItem or "")
	s:SetAttribute("HeldCharges", p.heldCharges or 0)
	s:SetAttribute("HumanSkin", p.humanSkin)
	s:SetAttribute("ZombieSkin", p.zombieSkin)
	s:SetAttribute("OwnedSkins", csv(p.ownedSkins))
	s:SetAttribute("Passes", csv(p.passes))
	s:SetAttribute("VIP", p.passes.VIP == true)
	s:SetAttribute("BoostEndsAt", p.boostEndsAt)
	if p.profile then
		s:SetAttribute("Wins", p.profile.Wins or 0)
		s:SetAttribute("Infections", p.profile.Infections or 0)
		s:SetAttribute("RoundsPlayed", p.profile.RoundsPlayed or 0)
		s:SetAttribute("BestScore", p.profile.BestScore or 0)
		s:SetAttribute("SeenTutorial", p.profile.SeenTutorial == true)
	end
end

export type NewParticipant = {
	id: string,
	name: string,
	player: Player?,
	isBot: boolean,
	profile: any?,
	passes: { [string]: boolean }?,
}

function Participants.add(info: NewParticipant): Participant
	local state = Instance.new("Configuration")
	state.Name = info.id
	local profile = info.profile
	local owned = {}
	if profile and profile.OwnedSkins then
		for id, on in profile.OwnedSkins do
			owned[id] = on == true
		end
	end
	owned[Skins.DEFAULT_HUMAN] = true
	owned[Skins.DEFAULT_ZOMBIE] = true

	local p: Participant = {
		id = info.id,
		name = info.name,
		player = info.player,
		isBot = info.isBot,
		character = nil,
		team = "Human",
		score = 0, -- points reset every visit; only BestScore is saved
		immunity = 0,
		scale = 1,
		heldItem = nil,
		slots = {},
		slot = 1,
		humanSkin = if profile then profile.HumanSkin or Skins.DEFAULT_HUMAN else Skins.DEFAULT_HUMAN,
		zombieSkin = if profile then profile.ZombieSkin or Skins.DEFAULT_ZOMBIE else Skins.DEFAULT_ZOMBIE,
		ownedSkins = owned,
		passes = info.passes or {},
		boostEndsAt = if profile then profile.BoostEndsAt or 0 else 0,
		itemReadyAt = 0,
		returnReadyAt = 0,
		stunUntil = 0,
		streaming = false,
		nextStreamTick = 0,
		heldCharges = nil,
		boostUntil = 0,
		boostFactor = 1,
		slowUntil = 0,
		adminSpeed = 1,
		alpha = false,
		knockedUntil = 0,
		pressedUntil = 0,
		slowFactor = 1,
		spawning = false,
		aim = Vector3.new(0, 0, -1),
		profile = profile,
		state = state,
	}
	byId[p.id] = p
	table.insert(order, p)
	Participants.publish(p)
	state.Parent = stateFolder()
	for _, callback in addedCallbacks do
		task.spawn(callback, p)
	end
	return p
end

function Participants.remove(p: Participant)
	if byId[p.id] ~= p then
		return
	end
	for _, callback in removingCallbacks do
		task.spawn(callback, p)
	end
	byId[p.id] = nil
	local index = table.find(order, p)
	if index then
		table.remove(order, index)
	end
	p.state:Destroy()
end

function Participants.get(id: string): Participant?
	return byId[id]
end

function Participants.playerId(player: Player): string
	return "P" .. player.UserId
end

function Participants.fromPlayer(player: Player): Participant?
	return byId[Participants.playerId(player)]
end

function Participants.fromCharacter(model: Instance?): Participant?
	if not model then
		return nil
	end
	local id = model:GetAttribute("ParticipantId")
	if typeof(id) == "string" then
		return byId[id]
	end
	return nil
end

-- Finds the participant whose character contains `part`.
function Participants.fromPart(part: Instance): Participant?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local p = Participants.fromCharacter(model)
		if p then
			return p
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Participants.all(): { Participant }
	return table.clone(order)
end

function Participants.count(): number
	return #order
end

function Participants.onTeam(team: Team): { Participant }
	local list = {}
	for _, p in order do
		if p.team == team then
			table.insert(list, p)
		end
	end
	return list
end

-- Root and humanoid of a participant whose character is alive, else nil.
function Participants.body(p: Participant): (BasePart?, Humanoid?)
	local character = p.character
	if not character or character.Parent == nil then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

function Participants.setScore(p: Participant, value: number)
	p.score = math.max(0, math.floor(value))
	if p.profile and p.score > p.profile.BestScore then
		p.profile.BestScore = p.score
		p.state:SetAttribute("BestScore", p.score)
	end
	p.state:SetAttribute("Score", p.score)
end

function Participants.addScore(p: Participant, amount: number)
	Participants.setScore(p, p.score + amount)
end

function Participants.setImmunity(p: Participant, value: number)
	p.immunity = math.clamp(value, 0, 100)
	p.state:SetAttribute("Immunity", p.immunity)
end

return Participants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[-- Everything that flies: potatoes, pebbles, snowballs, bubbles and rubber
-- ducks. Simulated on the server with sphere casts so hits are decided in
-- one place. Shots pass through bushes and stop at the first person (zombie
-- or human, never the shooter), wall or piece of furniture, then apply their
-- effect (shove, freeze, bubble trap or explosion).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local FurnitureService = require(script.Parent.FurnitureService)
local Items = require(ReplicatedStorage.Shared.Items)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local Projectiles = {}

type Shot = {
	model: Model,
	position: Vector3,
	direction: Vector3,
	traveled: number,
	item: Items.Item,
	params: RaycastParams,
	ignored: { Instance },
}

local shots: { Shot } = {}
local folder: Folder

local function ball(model: Model, diameter: number, offset: Vector3, color: string, transparency: number?)
	local part = Parts.make({
		name = "Ball",
		shape = Enum.PartType.Ball,
		size = Vector3.one * diameter,
		cframe = CFrame.new(offset),
		color = color,
		transparency = transparency,
		canCollide = false,
		canQuery = false,
		parent = model,
	})
	if not model.PrimaryPart then
		model.PrimaryPart = part
	end
end

-- The flying object, built at the origin facing -Z.
local function buildLook(item: Items.Item): Model
	local model = Instance.new("Model")
	model.Name = item.projectile or "Potato"
	local d = (item.projectileRadius or 0.6) * 2
	local look = item.projectile
	if look == "Pebble" then
		ball(model, d, Vector3.zero, "8C8C8C")
	elseif look == "Snowball" then
		ball(model, d, Vector3.zero, "FFFFFF")
		ball(model, d * 0.5, Vector3.new(0.2, 0.25, -0.1), "E8F6FF")
	elseif look == "Bubble" then
		ball(model, d, Vector3.zero, "BFE9FF", 0.55)
		ball(model, d * 0.25, Vector3.new(-d * 0.2, d * 0.3, -d * 0.15), "FFFFFF", 0.2) -- shine
	elseif look == "Duck" then
		ball(model, d, Vector3.zero, "FFD93B")
		ball(model, d * 0.6, Vector3.new(0, d * 0.35, -d * 0.35), "FFD93B")
		Parts.make({
			name = "Beak",
			size = Vector3.new(0.35, 0.15, 0.4) * d,
			cframe = CFrame.new(0, d * 0.32, -d * 0.7),
			color = "F28C1C",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	else
		ball(model, d, Vector3.zero, if item.isRare then "B98A4E" else "C9A66B")
		ball(model, d * 0.25, Vector3.new(d * 0.2, d * 0.3, 0), "8B6A43")
	end
	return model
end

local function impact(shot: Shot, at: Vector3, target: Participant?, hitPart: Instance)
	local item = shot.item
	local dir = shot.direction
	if item.effect == "Explode" then
		Combat.explode(at, item.radius or 10, item.knockback or 100, item.stun or 0.5)
		for _, body in
			FurnitureService.findInBox(
				CFrame.new(at),
				Vector3.new(1, 0, 1) * (item.radius or 10) * 1.6 + Vector3.yAxis * 6
			)
		do
			local away = Util.flatUnit(body.Position - at) or dir
			FurnitureService.shove(body, away * 18, 0.35)
		end
		Announcer.fx("Boom", { position = at })
		return
	end
	if target then
		if item.knockback and item.knockback > 0 then
			Combat.knockback(target, dir * item.knockback, item.stun or 0.3)
		else
			Combat.knockback(target, Vector3.zero, item.stun or 0.3)
		end
		if item.effect == "Freeze" then
			CharacterService.speedEffect(target, item.slowFactor or 0.4, item.effectSeconds or 2.5)
			Announcer.fx("Frozen", { character = target.character, seconds = item.effectSeconds or 2.5 })
		elseif item.effect == "Bubble" then
			Announcer.fx("Bubbled", { character = target.character, seconds = item.effectSeconds or 2 })
		end
	elseif hitPart:IsA("BasePart") then
		local weight = FurnitureService.weightOf(hitPart)
		if weight == "Light" or (weight == "Medium" and (item.knockback or 0) >= 80) then
			FurnitureService.shove(hitPart, dir * 12, 0.25)
		end
	end
	Announcer.fx("Splat", { position = at, look = item.projectile })
end

local function finish(shot: Shot)
	shot.model:Destroy()
	local index = table.find(shots, shot)
	if index then
		table.remove(shots, index)
	end
end

local function step(dt: number)
	for i = #shots, 1, -1 do
		local shot = shots[i]
		local item = shot.item
		local distance = (item.projectileSpeed or 90) * dt
		local radius = item.projectileRadius or 0.6
		local done = false
		-- A Spherecast ignores parts already overlapping its starting sphere,
		-- so each cast starts a little behind the shot. Otherwise a zombie
		-- walking into it between frames would be missed.
		local back = radius + 1
		local origin = shot.position - shot.direction * back
		for _ = 1, 4 do
			local result =
				workspace:Spherecast(origin, radius, shot.direction * (distance + back), shot.params)
			if not result then
				break
			end
			local target = Participants.fromPart(result.Instance)
			impact(shot, result.Position, target, result.Instance)
			finish(shot)
			done = true
			break
		end
		if not done then
			shot.position += shot.direction * distance
			shot.traveled += distance
			if shot.traveled >= (item.projectileRange or 100) then
				if item.effect == "Explode" then
					impact(shot, shot.position, nil, workspace) -- ducks go off at the end of their flight
				end
				finish(shot)
			else
				-- Ducks and potatoes tumble a little as they fly.
				local spin = CFrame.Angles(0, shot.traveled * 0.15, 0)
				shot.model:PivotTo(CFrame.lookAt(shot.position, shot.position + shot.direction) * spin)
			end
		end
	end
end

function Projectiles.fire(shooter: Participant, item: Items.Item, aim: Vector3)
	local root = Participants.body(shooter)
	if not root or not shooter.character then
		return
	end
	local radius = item.projectileRadius or 0.6
	local origin = root.Position + aim * (root.Size.X / 2 + radius + 0.4)
	local model = buildLook(item)
	model:PivotTo(CFrame.lookAt(origin, origin + aim))
	model.Parent = folder
	local ignored: { Instance } = {
		shooter.character,
		folder,
		workspace:WaitForChild("GroundItems"),
		workspace:WaitForChild("Traps"),
		workspace:WaitForChild("Effects"),
	}
	local map = workspace:WaitForChild("Map")
	-- Shots stop at the boundary wall, but fly over the ground, under roofs
	-- and through non-solid scenery.
	for _, name in { "Ground", "Road", "Floors", "Roofs", "Custom" } do
		local child = map:FindFirstChild(name)
		if child then
			table.insert(ignored, child)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignored
	table.insert(shots, {
		model = model,
		position = origin,
		direction = aim,
		traveled = 0,
		item = item,
		params = params,
		ignored = ignored,
	})
end

function Projectiles.clear()
	for i = #shots, 1, -1 do
		finish(shots[i])
	end
end

function Projectiles.init()
	folder = workspace:WaitForChild("Projectiles") :: Folder
	RunService.Heartbeat:Connect(step)
end

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[-- The round loop: Waiting -> Prep -> Outbreak -> Infection -> End -> (reset) -> Prep.
--
-- Prep: everyone is human; the banner counts down "Outbreak happening in N
-- seconds"; humans shop and barricade. Outbreak: first zombies are picked,
-- weighted by immunity. Infection: a zombie touching a human converts them.
-- Zombies win when no humans remain; survivors win if anyone lasts the timer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local MapBuilder = require(script.Parent.MapBuilder)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Traps = require(script.Parent.Traps)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)
local Wizard = require(script.Parent.Wizard)

type Participant = Participants.Participant
type Phase = "Waiting" | "Prep" | "Infection" | "End"
type Winner = RoundRules.Winner

local RoundManager = {}

local state: Folder
local phase: Phase = "Waiting"
local rng = Random.new()

-- Spawning ---------------------------------------------------------------------------

local function spawnFrame(team: string, scale: number): CFrame
	local layout = MapLayout.current()
	local list = if team == "Zombie" then layout.zombieSpawns else layout.humanSpawns
	local spot = list[rng:NextInteger(1, #list)]
	local jitter = if team == "Zombie" then 3 else 5
	local x = spot.x + rng:NextNumber(-jitter, jitter)
	local z = spot.z + rng:NextNumber(-jitter, jitter)
	local y = MapLayout.HEIGHTS.Floor
		+ Config.CHARACTER.HipHeight
		+ Config.CHARACTER.RootHeight / 2 * scale
		+ 0.3
	return CFrame.new(x, y, z)
end

-- Every human starts the round at the map's start spot, packed into a
-- little crowd around it (a sunflower spiral, so nobody lands on anyone).
local crowd = 0

local function startFrame(scale: number): CFrame
	local spot = MapLayout.current().start
	crowd += 1
	local radius = 2.4 * math.sqrt(crowd - 1) * math.max(1, scale)
	local angle = crowd * 2.39996
	local y = MapLayout.HEIGHTS.Floor
		+ Config.CHARACTER.HipHeight
		+ Config.CHARACTER.RootHeight / 2 * scale
		+ 0.3
	return CFrame.new(spot.x + math.cos(angle) * radius, y, spot.z + math.sin(angle) * radius)
end

local function recount()
	state:SetAttribute("Survivors", #Participants.onTeam("Human"))
	state:SetAttribute("Zombies", #Participants.onTeam("Zombie"))
end

function RoundManager.phase(): Phase
	return phase
end

local function setPhase(name: Phase, seconds: number)
	phase = name
	state:SetAttribute("Phase", name)
	state:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + seconds)
end

local function secondsLeft(): number
	return (state:GetAttribute("PhaseEndsAt") :: number) - workspace:GetServerTimeNow()
end

function RoundManager.secondsLeft(): number
	return secondsLeft()
end

-- Teams --------------------------------------------------------------------------------

function RoundManager.setTeam(p: Participant, team: Participants.Team)
	if p.team == team then
		return
	end
	p.team = team
	p.state:SetAttribute("Team", team)
	p.boostUntil, p.slowUntil = 0, 0 -- drinks and freezes don't carry across teams
	if team == "Human" then
		p.alpha = false
	end
	if team == "Zombie" then
		ItemService.onInfected(p)
	end
	CharacterService.applyLook(p)
	CharacterService.refreshSpeed(p)
	ItemService.refreshHand(p)
	recount()
end

local function bonusesFor(p: Participant, includeDrumstick: boolean): RoundRules.RewardBonuses
	-- A drumstick anywhere in your inventory counts (the best one).
	local drumstick: number? = nil
	for _, slot in p.slots do
		local item = Items.get(slot.id)
		if item and item.kind == "Passive" and item.rewardBonus then
			drumstick = math.max(drumstick or 0, item.rewardBonus)
		end
	end
	return {
		drumstick = if includeDrumstick then drumstick else nil,
		vip = p.passes.VIP == true,
		doubleScore = p.passes.DoubleScore == true,
		boosted = os.time() < p.boostEndsAt,
	}
end

local function award(p: Participant, base: number, includeDrumstick: boolean, reason: string)
	local amount = RoundRules.reward(base, bonusesFor(p, includeDrumstick))
	Participants.addScore(p, amount)
	CharacterService.refreshSize(p)
	CharacterService.refreshSpeed(p)
	if p.player then
		Announcer.toast(
			p.player,
			string.format("+%s score  %s", Util.commas(amount), reason),
			Config.COLORS.Good
		)
	end
end

-- Every few seconds of the outbreak: a little score for every human still
-- standing, and every zombie loses a little (it has to eat to stay big).
local function payStanding()
	for _, p in Participants.all() do
		if not Participants.body(p) then
			continue
		end
		if p.team == "Human" then
			Participants.addScore(p, RoundRules.reward(Config.SURVIVAL_POINTS, bonusesFor(p, false)))
		elseif p.score > 0 then
			local loss = math.max(Config.ZOMBIE_DECAY_MIN, math.floor(p.score * Config.ZOMBIE_DECAY_FRACTION))
			Participants.addScore(p, -loss)
		end
		CharacterService.refreshSize(p)
		CharacterService.refreshSpeed(p)
	end
end

local function infect(zombie: Participant, human: Participant)
	local root = Participants.body(human)
	-- The zombie eats a share of the human's points: the human shrinks and
	-- slows, the zombie grows and speeds up.
	local stolen = math.floor(human.score * Config.INFECT_STEAL_FRACTION)
	if stolen > 0 then
		Participants.addScore(human, -stolen)
		Participants.addScore(zombie, stolen)
		human.scale = RoundRules.scaleForScore(human.score)
		human.state:SetAttribute("Scale", human.scale)
		if human.player then
			Announcer.toast(
				human.player,
				string.format("-%s points: %s ate them!", Util.commas(stolen), zombie.name),
				Config.COLORS.ZombieText
			)
		end
		if zombie.player then
			Announcer.toast(
				zombie.player,
				string.format("+%s points eaten from %s", Util.commas(stolen), human.name),
				Config.COLORS.Good
			)
		end
	end
	RoundManager.setTeam(human, "Zombie") -- rebuilds the look at the new size
	CharacterService.refreshSpeed(human)
	award(zombie, Config.INFECT_REWARD, false, "infection")
	if zombie.profile then
		zombie.profile.Infections = (zombie.profile.Infections or 0) + 1
		zombie.state:SetAttribute("Infections", zombie.profile.Infections)
	end
	if root then
		Announcer.fx("Infect", { position = root.Position })
	end
	Announcer.chat(string.format("%s infected %s!", zombie.name, human.name), "9BE22D")
end

-- Does any part of the zombie touch the human? Its body, or the arms
-- reaching out in front of it (the box they sweep, in the zombie's own
-- frame), against the human's body circle.
local ARM_REACH = CharacterLook.ZOMBIE_ARM_REACH
local ARM_SPAN = CharacterLook.ZOMBIE_ARM_SPAN

local function touching(zRoot: BasePart, zScale: number, hRoot: BasePart, hScale: number): boolean
	local shell = Config.CHARACTER.ShellDiameter / 2
	local hr = shell * hScale + 0.25
	local offset = Util.flat(hRoot.Position - zRoot.Position)
	if offset.Magnitude <= hr + shell * zScale then
		return true
	end
	if offset.Magnitude > hr + (ARM_REACH + ARM_SPAN) * zScale then
		return false
	end
	local rel = zRoot.CFrame:VectorToObjectSpace(offset)
	local x = math.clamp(rel.X, -ARM_SPAN * zScale, ARM_SPAN * zScale)
	local z = math.clamp(rel.Z, -ARM_REACH * zScale, 0)
	local dx, dz = rel.X - x, rel.Z - z
	return dx * dx + dz * dz <= hr * hr
end

-- Every frame of the infection phase: a single touch from any part of a
-- zombie (with no wall or furniture between them) converts the human.
local function infectionStep()
	if phase ~= "Infection" then
		return
	end
	local zombies = Participants.onTeam("Zombie")
	local humans = Participants.onTeam("Human")
	for _, human in humans do
		local hRoot = Participants.body(human)
		if hRoot and human.team == "Human" then
			for _, zombie in zombies do
				local zRoot = Participants.body(zombie)
				if zRoot and zombie.team == "Zombie" then
					if
						touching(zRoot, zombie.scale, hRoot, human.scale)
						and Combat.clearPath(zRoot.Position, hRoot.Position)
					then
						infect(zombie, human)
						break
					end
				end
			end
		end
	end
end

-- World reset ---------------------------------------------------------------------------

local function grantRoundStartItems(p: Participant)
	if not ItemService.hasFreeSlot(p) then
		return
	end
	local profile = p.profile
	if profile and profile.PendingItems and #profile.PendingItems > 0 then
		local itemId = table.remove(profile.PendingItems, 1)
		if typeof(itemId) == "string" and Items.get(itemId) then
			ItemService.give(p, itemId)
			if p.player then
				Announcer.toast(
					p.player,
					"Your " .. (Items.get(itemId) :: Items.Item).name .. " is ready!",
					Config.COLORS.Good
				)
			end
			return
		end
	end
	if p.passes.StarterKit and not ItemService.carries(p, "Bat") then
		ItemService.give(p, "Bat")
	end
end

-- Everyone back to human at a yard spawn, furniture and walls restored.
local function resetWorld()
	Wizard.leave()
	Projectiles.clear()
	Traps.clear()
	ItemService.clearGround()
	FurnitureService.resetAll()
	MapBuilder.restoreWalls()
	crowd = 0
	for _, p in Participants.all() do
		p.team = "Human"
		p.stunUntil = 0
		p.boostUntil, p.slowUntil = 0, 0
		p.alpha = false
		p.scale = RoundRules.scaleForScore(p.score) -- you grow as your score grows
		p.state:SetAttribute("Team", "Human")
		p.state:SetAttribute("Scale", p.scale)
		CharacterService.place(p, startFrame(p.scale))
		CharacterService.applyLook(p)
		CharacterService.refreshSpeed(p)
		grantRoundStartItems(p)
		ItemService.refreshHand(p)
	end
	recount()
end

-- Phases ----------------------------------------------------------------------------------

local function enoughPlayers(): boolean
	return Participants.count() >= Config.MIN_PLAYERS
end

local function waitForPlayers()
	if enoughPlayers() then
		return
	end
	setPhase("Waiting", 0)
	resetWorld()
	while not enoughPlayers() do
		state:SetAttribute("Needed", Config.MIN_PLAYERS)
		task.wait(1)
	end
end

-- Waits until the phase timer ends. Returns false if players dropped below
-- the minimum (round aborted).
-- An admin ended the round: it stops with no winner and the next one starts.
local endRequested = false

local function waitPhase(): boolean
	while secondsLeft() > 0 do
		if not enoughPlayers() or endRequested then
			return false
		end
		task.wait(0.2)
	end
	return not endRequested
end

local function pickFirstZombies(): { Participant }
	local candidates = {}
	for _, p in Participants.onTeam("Human") do
		if Participants.body(p) then
			table.insert(candidates, p)
		end
	end
	local count = RoundRules.firstZombieCount(#candidates)
	return RoundRules.weightedPick(
		candidates,
		function(p: Participant)
			return RoundRules.zombieWeight(p.immunity)
		end,
		count,
		function()
			return rng:NextNumber()
		end
	)
end

local function turnFirstZombie(p: Participant)
	p.alpha = true -- the alpha look (see Skins "Alpha")
	RoundManager.setTeam(p, "Zombie")
	Participants.setImmunity(p, 0)
	if Config.FIRST_ZOMBIES_TO_SPAWN then
		CharacterService.place(p, spawnFrame("Zombie", p.scale))
	end
	p.returnReadyAt = os.clock() + 1
end

local function outbreak()
	Wizard.leave()
	local picked = pickFirstZombies()
	local names = {}
	for _, p in picked do
		turnFirstZombie(p)
		table.insert(names, p.name)
	end
	Announcer.chat(
		"* OUTBREAK! "
			.. table.concat(names, ", ")
			.. (if #names == 1 then " is" else " are")
			.. " a zombie! *",
		"E0303A"
	)
	Announcer.fx("Outbreak", {})
end

local function finishRound(winner: Winner)
	setPhase("End", Config.END_SCREEN_SECONDS)
	state:SetAttribute("Winner", winner)
	for _, p in Participants.all() do
		if p.profile then
			p.profile.RoundsPlayed = (p.profile.RoundsPlayed or 0) + 1
			p.state:SetAttribute("RoundsPlayed", p.profile.RoundsPlayed)
		end
		if winner == "Survivors" and p.team == "Human" then
			award(p, Config.SURVIVOR_WIN_REWARD, true, "survived!")
			if p.profile then
				p.profile.Wins = (p.profile.Wins or 0) + 1
				p.state:SetAttribute("Wins", p.profile.Wins)
			end
		elseif winner == "Zombies" and p.team == "Zombie" then
			award(p, Config.ZOMBIE_WIN_REWARD, false, "zombies win")
		end
	end
	Announcer.chat(if winner == "Survivors" then "Survivors Win!!!" else "Zombies Win!!!")
	Announcer.fx("RoundEnd", { winner = winner })
	task.wait(Config.END_SCREEN_SECONDS)
	state:SetAttribute("Winner", "")
end

local function runInfection(): Winner?
	setPhase("Infection", Config.ROUND_SECONDS)
	local nextPay = os.clock() + Config.SURVIVAL_POINTS_SECONDS
	while true do
		task.wait(0.1)
		if endRequested then
			return nil
		end
		if os.clock() >= nextPay then
			nextPay += Config.SURVIVAL_POINTS_SECONDS
			payStanding()
		end
		local humans = Participants.onTeam("Human")
		local zombies = Participants.onTeam("Zombie")
		local result = RoundRules.outcome(#humans, secondsLeft())
		if result then
			return result :: Winner
		end
		if #zombies == 0 then
			-- Every zombie left the game: pick a new one, or let the humans win.
			if #humans >= 2 then
				local replacement = pickFirstZombies()[1]
				if replacement then
					turnFirstZombie(replacement)
					Announcer.chat("* The zombies fled... " .. replacement.name .. " turned! *", "E0303A")
				end
			else
				return "Survivors" :: Winner
			end
		end
	end
end

-- Map rotation ------------------------------------------------------------------------------

local rotation: { string } = {} -- built-in maps plus yours (MapLayout.rotation)
local mapIndex = 1
local roundsOnMap = 0
local pendingMap: string? = nil -- an admin picked the next map

local function loadMap(name: string)
	local layout = MapLayout.use(name)
	ItemService.clearGround()
	MapBuilder.build(layout)
	FurnitureService.build(layout)
	state:SetAttribute("Map", layout.title)
	Announcer.chat("* Next map: " .. layout.title .. " *")
end

local function nextMapIfDue()
	local picked = pendingMap
	if picked then
		pendingMap = nil
		roundsOnMap = 0
		mapIndex = table.find(rotation, picked) or mapIndex
		loadMap(picked)
	elseif roundsOnMap >= Config.ROUNDS_PER_MAP and #rotation > 1 then
		roundsOnMap = 0
		mapIndex = mapIndex % #rotation + 1
		loadMap(rotation[mapIndex])
	end
	roundsOnMap += 1
end

local function runRound()
	endRequested = false
	waitForPlayers()

	nextMapIfDue()
	resetWorld()
	local round = state:GetAttribute("Round")
	state:SetAttribute("Round", (if typeof(round) == "number" then round else 0) + 1)
	ItemService.scatter()
	setPhase("Prep", Config.PREP_SECONDS)
	Wizard.schedule()
	Announcer.chat(
		MapLayout.current().title
			.. ": outbreak in "
			.. Config.PREP_SECONDS
			.. " seconds. Barricade a room and grab items!"
	)
	if waitPhase() then
		outbreak()
		local winner = runInfection()
		if winner then
			finishRound(winner :: Winner)
		end
	end
end

local function loop()
	while true do
		local ok, err = pcall(function()
			runRound()
			return true
		end)
		if not ok then
			warn("[Rounds] round failed, starting a new one: " .. tostring(err))
			state:SetAttribute("Winner", "")
			task.wait(2)
		end
	end
end

-- Joining, leaving, respawning ----------------------------------------------------------------

local function spawnNew(p: Participant)
	p.scale = RoundRules.scaleForScore(p.score)
	p.state:SetAttribute("Scale", p.scale)
	-- Late joiners become zombies once the outbreak has happened.
	if phase == "Infection" then
		p.team = "Zombie"
		p.state:SetAttribute("Team", "Zombie")
	end
	-- Humans joining before the outbreak start with everyone else.
	CharacterService.spawn(p, if p.team == "Human" then startFrame(p.scale) else spawnFrame(p.team, p.scale))
	if p.team == "Human" then
		grantRoundStartItems(p)
	end
	ItemService.refreshHand(p)
	recount()
end

-- "Z": back to the zombie spawn, with a whoosh where you left.
local function warp(p: Participant)
	local root = Participants.body(p)
	if root then
		Announcer.fx("Warp", { position = root.Position })
	end
	CharacterService.place(p, spawnFrame("Zombie", p.scale))
end

local function onZombieReturn(player: Player)
	local p = Participants.fromPlayer(player)
	if not p or p.team ~= "Zombie" or phase ~= "Infection" then
		return
	end
	local now = os.clock()
	if now < p.returnReadyAt then
		return
	end
	p.returnReadyAt = now + Config.ZOMBIE_RETURN_COOLDOWN
	warp(p)
end

function RoundManager.roundNumber(): number
	local round = state:GetAttribute("Round")
	return if typeof(round) == "number" then round else 0
end

-- Admin controls -------------------------------------------------------------------------------

-- Ends the current phase now (prep -> outbreak, infection -> survivors win).
function RoundManager.skipPhase(): boolean
	if phase == "Waiting" or phase == "End" then
		return false
	end
	state:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow())
	return true
end

-- Ends the whole round now (no winner, no rewards); the next round starts
-- right away, on the map an admin queued if any.
function RoundManager.endRound(): boolean
	if phase == "Waiting" then
		return false
	end
	endRequested = true
	Announcer.chat("* An admin ended the round *")
	return true
end

-- The maps in the rotation, in order (built-in and Studio-made).
function RoundManager.mapNames(): { string }
	return rotation
end

function RoundManager.addTime(seconds: number): boolean
	local endsAt = state:GetAttribute("PhaseEndsAt")
	if typeof(endsAt) ~= "number" or phase == "Waiting" or phase == "End" then
		return false
	end
	state:SetAttribute("PhaseEndsAt", endsAt + seconds)
	return true
end

-- The next round starts on the next map in the rotation.
function RoundManager.queueNextMap(): boolean
	if #rotation < 2 then
		return false
	end
	pendingMap = nil
	roundsOnMap = Config.ROUNDS_PER_MAP
	return true
end

-- The next round starts on this map.
function RoundManager.queueMap(name: string): boolean
	if not MapLayout.get(name) then
		return false
	end
	pendingMap = name
	return true
end

function RoundManager.respawn(p: Participant)
	CharacterService.spawn(p, spawnFrame(p.team, p.scale))
	ItemService.refreshHand(p)
end

-- Lets bots press Z too.
function RoundManager.zombieReturn(p: Participant)
	if p.team == "Zombie" and phase == "Infection" and os.clock() >= p.returnReadyAt then
		p.returnReadyAt = os.clock() + Config.ZOMBIE_RETURN_COOLDOWN
		warp(p)
	end
end

function RoundManager.start()
	state = ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
	state:SetAttribute("Map", MapLayout.current().title)
	rotation = MapLayout.rotation(Config.MAP_ROTATION)
	mapIndex = table.find(rotation, MapLayout.current().name) or 1
	state:SetAttribute("Maps", table.concat(rotation, "|")) -- for the admin panel

	CharacterService.onNeedRespawn = function(p)
		CharacterService.spawn(p, spawnFrame(p.team, p.scale))
		ItemService.refreshHand(p)
	end

	Participants.onAdded(spawnNew)
	Participants.onRemoving(function(p)
		if p.isBot and p.character then
			p.character:Destroy()
		end
		task.defer(recount)
	end)

	Remotes.event("ZombieReturn").OnServerEvent:Connect(onZombieReturn)
	RunService.Heartbeat:Connect(infectionStep)
	task.spawn(loop)
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Score shop (B), the wizard's shop, skins and the first-join tutorial flag.
-- Clients only ask; every price, distance and balance is checked here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Util = require(ReplicatedStorage.Shared.Util)
local Wizard = require(script.Parent.Wizard)

type Participant = Participants.Participant

local ShopService = {}

local rng = Random.new()

function ShopService.rareChance(p: Participant): number
	if p.passes.Lucky then
		return Config.MONETIZATION.LUCKY_RARE_CHANCE
	end
	return Config.RARE_CHANCE
end

local function buyItem(player: Player, itemId: unknown, fromWizard: unknown): (boolean, string)
	if typeof(itemId) ~= "string" then
		return false, "Unknown item"
	end
	local p = Participants.fromPlayer(player)
	local item = Items.get(itemId)
	if not p or not item then
		return false, "Unknown item"
	end
	if p.team ~= "Human" then
		return false, "Zombies can't shop!"
	end
	local root = Participants.body(p)
	if not root then
		return false, "Wait until you spawn"
	end

	local price: number
	if fromWizard == true then
		if not item.wizardPrice then
			return false, "The wizard doesn't sell that"
		end
		if not Wizard.isNear(root.Position) then
			return false, "Walk closer to the wizard"
		end
		price = item.wizardPrice
	else
		if not item.price then
			return false, "That isn't sold here"
		end
		price = item.price
	end
	if p.score < price then
		return false, "You need " .. Util.commas(price) .. " score"
	end

	Participants.addScore(p, -price)
	CharacterService.refreshSize(p) -- points are size and speed
	CharacterService.refreshSpeed(p)
	CharacterService.refreshSpeed(p)

	local finalId = item.id
	if item.rare and rng:NextNumber() < ShopService.rareChance(p) then
		finalId = item.rare
	end
	ItemService.give(p, finalId)
	local final = Items.get(finalId) :: Items.Item
	if finalId ~= item.id then
		Announcer.chat(string.format("* %s rolled a %s! *", p.name, final.name), "F5C542")
		return true, "RARE! You got a " .. final.name .. "!"
	end
	return true, "Bought " .. final.name
end

-- Marks a skin owned (in the session and the saved profile).
function ShopService.grantSkin(p: Participant, skinId: string)
	p.ownedSkins[skinId] = true
	if p.profile then
		p.profile.OwnedSkins[skinId] = true
	end
	Participants.publish(p)
end

function ShopService.equipSkin(p: Participant, skin: Skins.Skin)
	if skin.team == "Zombie" then
		p.zombieSkin = skin.id
		if p.profile then
			p.profile.ZombieSkin = skin.id
		end
	else
		p.humanSkin = skin.id
		if p.profile then
			p.profile.HumanSkin = skin.id
		end
	end
	Participants.publish(p)
	if p.team == skin.team then
		CharacterService.applyLook(p)
		ItemService.refreshHand(p)
	end
end

-- Returns a status the client acts on:
--   "equipped" | "bought" | "prompt" (Robux product) | "promptPass" | "error"
local function buySkin(player: Player, skinId: unknown): (string, string)
	if typeof(skinId) ~= "string" then
		return "error", "Unknown skin"
	end
	local p = Participants.fromPlayer(player)
	local skin = Skins.get(skinId)
	if not p or not skin then
		return "error", "Unknown skin"
	end
	if skin.pass and p.passes[skin.pass] then
		ShopService.grantSkin(p, skin.id)
	end
	if p.ownedSkins[skin.id] then
		ShopService.equipSkin(p, skin)
		return "equipped", skin.name .. " equipped"
	end
	if skin.scorePrice then
		if p.score < skin.scorePrice then
			return "error", "You need " .. Util.commas(skin.scorePrice) .. " score"
		end
		Participants.addScore(p, -skin.scorePrice)
		CharacterService.refreshSize(p) -- points are size and speed
		CharacterService.refreshSpeed(p)
		CharacterService.refreshSpeed(p)
		ShopService.grantSkin(p, skin.id)
		ShopService.equipSkin(p, skin)
		return "bought", "Unlocked " .. skin.name .. "!"
	end
	if skin.product then
		return "prompt", skin.product
	end
	if skin.pass then
		return "promptPass", skin.pass
	end
	return "error", "Not available"
end

function ShopService.init()
	Remotes.func("BuyItem").OnServerInvoke = buyItem
	Remotes.func("BuySkin").OnServerInvoke = buySkin
	Remotes.event("TutorialDone").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and p.profile then
			p.profile.SeenTutorial = true
			p.state:SetAttribute("SeenTutorial", true)
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">TopScores</string>
          <string name="Source"><![CDATA[-- All-time top 10 (across servers) for the trophy panel, refreshed every
-- couple of minutes from the OrderedDataStore that DataService updates.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local TopScores = {}

local names: { [number]: string } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and name then
		names[userId] = name
		return name
	end
	return "Player " .. userId
end

local function refresh()
	local rows = {}
	for _, entry in DataService.topScores(10) do
		table.insert(rows, { name = nameOf(entry.userId), score = entry.score })
	end
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("TopScores", HttpService:JSONEncode(rows))
	end
end

function TopScores.start()
	task.spawn(function()
		while true do
			if DataService.isAvailable() then
				refresh()
			end
			task.wait(Config.TOP_SCORES_REFRESH_SECONDS)
		end
	end)
end

return TopScores
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Traps</string>
          <string name="Source"><![CDATA[-- Banana peels: dropped by humans, slippery for everyone (the dropper gets
-- a moment to walk off it). Whoever steps on one slips: a shove in the way
-- they were walking and a long daze.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local Combat = require(script.Parent.Combat)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Util = require(ReplicatedStorage.Shared.Util)

local Traps = {}

type Trap = { model: Model, position: Vector3, item: Items.Item, owner: Participant?, safeUntil: number }
type Participant = Participants.Participant

local traps: { Trap } = {}
local folder: Folder
local MAX_TRAPS = 30

local function buildPeel(at: Vector3, spin: number): Model
	local model = Instance.new("Model")
	model.Name = "BananaPeel"
	local y = MapLayout.HEIGHTS.Floor + 0.12
	local center = CFrame.new(at.X, y, at.Z) * CFrame.Angles(0, spin, 0)
	for i = 0, 2 do
		local arm = center * CFrame.Angles(0, i * math.pi * 2 / 3, 0) * CFrame.new(0, 0, -0.6)
		Parts.make({
			name = "Peel",
			size = Vector3.new(0.55, 0.12, 1.3),
			cframe = arm,
			color = "F7DC6F",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
		Parts.make({
			name = "PeelInside",
			size = Vector3.new(0.35, 0.13, 1.0),
			cframe = arm * CFrame.new(0, 0.005, 0.05),
			color = "FFF6C7",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	end
	Parts.disc("Stem", center.Position + Vector3.new(0, 0.05, 0), 0.5, 0.2, "8B5A2B", model).CanCollide =
		false
	return model
end

function Traps.place(position: Vector3, item: Items.Item, owner: Participant?)
	if #traps >= MAX_TRAPS then
		local oldest = table.remove(traps, 1)
		if oldest then
			oldest.model:Destroy()
		end
	end
	local model = buildPeel(position, math.random() * math.pi * 2)
	model.Parent = folder
	table.insert(traps, {
		model = model,
		position = Vector3.new(position.X, 0, position.Z),
		item = item,
		owner = owner,
		safeUntil = os.clock() + 1.5,
	})
end

function Traps.clear()
	for _, trap in traps do
		trap.model:Destroy()
	end
	table.clear(traps)
end

local function step()
	if #traps == 0 then
		return
	end
	local now = os.clock()
	for _, person in Participants.all() do
		local root, humanoid = Participants.body(person)
		if root and humanoid then
			for i = #traps, 1, -1 do
				local trap = traps[i]
				local safe = person == trap.owner and now < trap.safeUntil
				if not safe and Util.flatDistance(root.Position, trap.position) <= 1.4 + root.Size.X / 2 then
					local move = Util.flatUnit(humanoid.MoveDirection)
						or Util.flatUnit(root.CFrame.LookVector)
						or Vector3.xAxis
					Combat.knockback(person, move * (trap.item.knockback or 45), trap.item.stun or 1.2)
					Announcer.fx("Slip", { position = trap.position, character = person.character })
					trap.model:Destroy()
					table.remove(traps, i)
				end
			end
		end
	end
end

function Traps.init()
	folder = workspace:WaitForChild("Traps") :: Folder
	RunService.Heartbeat:Connect(step)
end

return Traps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Wizard</string>
          <string name="Source"><![CDATA[-- The wizard: shows up at a random moment during the prep phase in one of the
-- yards, sells rare items to humans standing within reach (press B near
-- him), and leaves when the outbreak starts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Announcer = require(script.Parent.Announcer)
local Config = require(ReplicatedStorage.Shared.Config)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Util = require(ReplicatedStorage.Shared.Util)

local Wizard = {}

local model: Model? = nil
local scheduleToken = 0
local rng = Random.new()

local function build(at: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "Wizard"
	local function disc(name: string, offset: Vector3, diameter: number, height: number, color: string): Part
		return Parts.disc(name, at + offset, diameter, height, color, m)
	end
	-- Like the original: a blue robe, a big brown pointy hat, a grey beard.
	disc("RobeOutline", Vector3.new(0, 1.95, 0), 4.3, 3.9, "2C5866")
	local robe = disc("Robe", Vector3.new(0, 2, 0), 3.9, 4, "4F8FA3")
	disc("RobeTrim", Vector3.new(0, 4.03, 0), 3.1, 0.06, "6FB0C2")
	disc("HatBrimOutline", Vector3.new(0, 4.55, 0), 3.7, 0.3, "4A2C17")
	disc("HatBrim", Vector3.new(0, 4.6, 0), 3.4, 0.3, "6B4226")
	disc("HatMid", Vector3.new(0, 5.1, 0), 2.2, 0.7, "8B5A2B")
	disc("HatTip", Vector3.new(0, 5.6, 0), 0.9, 0.3, "A0703F")
	disc("Star", Vector3.new(0.5, 5.5, 0.3), 0.5, 0.25, "FFD54A")
	disc("Beard", Vector3.new(0, 4.3, -1.6), 1.4, 0.3, "B8BEC4")
	-- Staff with a glowing orb.
	Parts.make({
		name = "Staff",
		size = Vector3.new(0.35, 0.35, 4.5),
		cframe = CFrame.new(at + Vector3.new(1.9, 4.4, -0.6)),
		color = "8B5A2B",
		canCollide = false,
		parent = m,
	})
	local orb = Parts.make({
		name = "Orb",
		shape = Enum.PartType.Ball,
		size = Vector3.one * 1.1,
		cframe = CFrame.new(at + Vector3.new(1.9, 4.7, -3.0)),
		color = "7FE7FF",
		material = Enum.Material.Neon,
		canCollide = false,
		parent = m,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromHex("7FE7FF")
	light.Range = 10
	light.Brightness = 2
	light.Parent = orb
	m.PrimaryPart = robe

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(240, 44)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2, -4.2)
	tag.Adornee = robe
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.BuilderSansExtraBold
	label.TextSize = 18
	label.TextColor3 = Color3.fromHex("D7B8FF")
	label.TextStrokeTransparency = 0.3
	label.Text = "Wizard\n[B] special items"
	label.Parent = tag
	tag.Parent = robe
	return m
end

function Wizard.arrive()
	if model then
		return
	end
	local spots = MapLayout.current().wizardSpots
	local spot = spots[rng:NextInteger(1, #spots)]
	local m = build(Vector3.new(spot.x, 0, spot.z))
	m.Parent = workspace
	model = m
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("WizardHere", true)
	end
	Announcer.chat("* The wizard has arrived! Press [B] at wizard to buy special items! *")
	Announcer.fx("Wizard", { position = Vector3.new(spot.x, 2, spot.z) })
end

function Wizard.leave()
	scheduleToken += 1
	if model then
		model:Destroy()
		model = nil
		Announcer.chat("* The wizard vanished in a puff of smoke. *")
	end
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("WizardHere", false)
	end
end

-- Arrives after a random delay inside the configured window, unless leave()
-- is called first.
function Wizard.schedule()
	scheduleToken += 1
	local token = scheduleToken
	task.delay(rng:NextNumber(Config.WIZARD_ARRIVE_MIN, Config.WIZARD_ARRIVE_MAX), function()
		if token == scheduleToken then
			Wizard.arrive()
		end
	end)
end

function Wizard.isNear(position: Vector3): boolean
	local current = model
	if not current or not current.PrimaryPart then
		return false
	end
	return Util.flatDistance(current.PrimaryPart.Position, position) <= Config.WIZARD_SHOP_RADIUS
end

return Wizard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">WorldSetup</string>
          <string name="Source"><![CDATA[-- One-time world settings: flat lighting, collision groups, the folders other
-- services fill, and the replicated state folder the HUD reads.

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldSetup = {}

WorldSetup.GROUPS = {
	Characters = "Characters",
	Furniture = "Furniture",
	Shells = "CharacterShells", -- body-sized cylinders that hit each other
	Bumpers = "Bumpers", -- wider cylinders that only furniture hits
	SecretWalls = "SecretWalls", -- fake walls: stop furniture, let people through
}

local function folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function WorldSetup.run()
	Players.CharacterAutoLoads = false

	Lighting.GlobalShadows = false
	Lighting.Brightness = 1
	Lighting.ClockTime = 12
	Lighting.Ambient = Color3.fromRGB(190, 190, 190)
	Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.FogEnd = 100000
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("BloomEffect") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end

	local groups = WorldSetup.GROUPS
	PhysicsService:RegisterCollisionGroup(groups.Characters)
	PhysicsService:RegisterCollisionGroup(groups.Furniture)
	PhysicsService:RegisterCollisionGroup(groups.Shells)
	PhysicsService:RegisterCollisionGroup(groups.Bumpers)
	PhysicsService:RegisterCollisionGroup(groups.SecretWalls)
	-- Root boxes never hit each other; the shells do the bumping with each
	-- other, and the wider bumpers keep furniture a little way off (so a body
	-- never sinks into a couch). Neither hits walls, so a big player's wide
	-- shell never snags a doorway.
	PhysicsService:CollisionGroupSetCollidable(groups.Characters, groups.Characters, false)
	for _, other in { "Default", groups.Characters, groups.Furniture } do
		PhysicsService:CollisionGroupSetCollidable(groups.Shells, other, false)
	end
	PhysicsService:CollisionGroupSetCollidable(groups.Shells, groups.Shells, Config.PLAYERS_COLLIDE)
	for _, other in { "Default", groups.Characters, groups.Shells, groups.Bumpers, groups.SecretWalls } do
		PhysicsService:CollisionGroupSetCollidable(groups.Bumpers, other, false)
	end
	PhysicsService:CollisionGroupSetCollidable(groups.Bumpers, groups.Furniture, true)
	for _, other in { "Default", groups.Characters, groups.Shells } do
		PhysicsService:CollisionGroupSetCollidable(groups.SecretWalls, other, false)
	end

	for _, name in { "Map", "Furniture", "GroundItems", "Projectiles", "Traps", "Effects", "Bots" } do
		folder(name, workspace)
	end

	local state = folder("BrainTagState", ReplicatedStorage)
	folder("Participants", state)
	state:SetAttribute("Phase", "Waiting")
	state:SetAttribute("PhaseEndsAt", 0)
	state:SetAttribute("Survivors", 0)
	state:SetAttribute("Zombies", 0)
	state:SetAttribute("Winner", "")
	state:SetAttribute("Round", 0)
	state:SetAttribute("Needed", Config.MIN_PLAYERS)
	state:SetAttribute("WizardHere", false)
	state:SetAttribute("TopScores", "[]")
end

function WorldSetup.state(): Folder
	return ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
end

return WorldSetup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="45">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="46">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Intentionally empty. Brain Tag characters are flat top-down blobs with no
-- limbs, so Roblox's default walk/idle animation script is replaced by this one.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="49">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">BushController</string>
            <string name="Source"><![CDATA[-- Hiding in bushes, on your screen: the bush you stand in fades so you can
-- see yourself (and anyone hiding with you), and the name tags of players
-- hiding in other bushes disappear. On dark maps, name tags also show only
-- for people close enough to see (DarknessController), and on roofed maps
-- only for people in the same room as you (Roofs).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Bushes = require(ReplicatedStorage.Shared.Bushes)
local Config = require(ReplicatedStorage.Shared.Config)
local DarknessController = require(script.Parent.DarknessController)
local Roofs = require(ReplicatedStorage.Shared.Roofs)

local BushController = {}

local player = Players.LocalPlayer
local INTERVAL = 0.1

local faded: Model? = nil

local function fade(bush: Model?, amount: number)
	if not bush then
		return
	end
	for _, part in bush:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = amount
		end
	end
end

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function rootOf(model: Instance): BasePart?
	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function step()
	local me = player.Character
	local myRoot = me and rootOf(me)
	local mine = if myRoot then Bushes.coverAt(myRoot.Position) else nil
	if mine ~= faded then
		fade(faded, 0)
		fade(mine, Config.BUSH_SEE_THROUGH)
		faded = mine
	end

	for _, model in characters() do
		if model:IsA("Model") and model:GetAttribute("ParticipantId") and model ~= me then
			local head = model:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("NameTag")
			local root = rootOf(model)
			if tag and tag:IsA("BillboardGui") and root then
				local theirs = Bushes.coverAt(root.Position)
				local show = (theirs == nil or theirs == mine)
					and DarknessController.sees(root.Position)
					and (myRoot == nil or Roofs.canSee(myRoot.Position, root.Position))
				if tag.Enabled ~= show then
					tag.Enabled = show
				end
			end
		end
	end
end

function BushController.start()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < INTERVAL then
			return
		end
		elapsed = 0
		local ok, err = pcall(function()
			step()
			return true
		end)
		if not ok then
			warn("[Bushes] " .. tostring(err))
		end
	end)
end

return BushController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Straight-down camera that follows your character. A narrow field of view
-- from high up gives the flat, near-orthographic 2D look. Screen up is world
-- -Z. No zoom or rotation (the Settings panel offers three fixed heights).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)

local CameraController = {}

local player = Players.LocalPlayer
local height = Config.CAMERA_HEIGHT
local focus: Vector3? = nil
local SCREEN_UP = Vector3.new(0, 0, -1)

function CameraController.setHeight(newHeight: number)
	height = newHeight
end

function CameraController.height(): number
	return height
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.CAMERA_FOV

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local target = Vector3.new(root.Position.X, 0, root.Position.Z)
		if not focus or Config.CAMERA_SMOOTHING <= 0 or (focus - target).Magnitude > 60 then
			focus = target -- locked on (and snaps after spawns and teleports)
		else
			focus = focus:Lerp(target, 1 - math.exp(-Config.CAMERA_SMOOTHING * dt))
		end
	end
	if focus then
		-- Bigger players see a little more around them.
		local scale = ClientState.my("Scale") or 1
		local eye = height * (1 + (scale - 1) * Config.CAMERA_GROWTH)
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, eye, 0), focus, SCREEN_UP)
	end
end

function CameraController.start()
	RunService:BindToRenderStep("BrainTagCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ChatSetup</string>
            <string name="Source"><![CDATA[-- TextChatService setup: chat window at the bottom-right (bottom-left and
-- hidden until opened on phones) with channel tabs,
-- yellow system announcements from the server, and a gold [VIP] tag.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ChatSetup = {}

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

function ChatSetup.setVisible(visible: boolean)
	local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	local input = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
	if window then
		window.Enabled = visible
	end
	if input then
		input.Enabled = visible
	end
end

function ChatSetup.isVisible(): boolean
	local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	return window == nil or window.Enabled
end

function ChatSetup.start()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	task.spawn(function()
		local window = TextChatService:WaitForChild("ChatWindowConfiguration", 10) :: ChatWindowConfiguration?
		if window then
			-- Desktop: bottom-right (points sit bottom-left). Phones keep the
			-- touch buttons bottom-right, so chat stays left and starts hidden
			-- (the chat button top-left shows it).
			window.HorizontalAlignment = if touch
				then Enum.HorizontalAlignment.Left
				else Enum.HorizontalAlignment.Right
			window.VerticalAlignment = Enum.VerticalAlignment.Bottom
			if touch then
				ChatSetup.setVisible(false)
			end
		end
		local tabs = TextChatService:FindFirstChildOfClass("ChannelTabsConfiguration")
		if tabs then
			tabs.Enabled = true
		end
	end)

	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local entry = ClientState.participants:FindFirstChild("P" .. source.UserId)
			if entry and entry:GetAttribute("VIP") then
				properties.PrefixText = string.format(
					'<font color="#%s">[VIP]</font> %s',
					Config.COLORS.VipName,
					message.PrefixText
				)
			end
		end
		return properties
	end

	local general: TextChannel? = nil
	task.spawn(function()
		local channels = TextChatService:WaitForChild("TextChannels", 20)
		general = channels and channels:WaitForChild("RBXGeneral", 20) :: TextChannel?
	end)

	Remotes.event("Announce").OnClientEvent:Connect(function(text: string, hex: string?)
		if typeof(text) ~= "string" then
			return
		end
		local channel = general
		if channel then
			channel:DisplaySystemMessage(
				string.format('<font color="#%s">%s</font>', hex or Config.COLORS.SystemMessage, escape(text))
			)
		end
	end)
end

return ChatSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- Read-only view of the replicated game state for client code: the round
-- phase and timer, and every participant's public info.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = {}

local player = Players.LocalPlayer
local folder = ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
local participants = folder:WaitForChild("Participants") :: Folder

ClientState.folder = folder
ClientState.participants = participants

function ClientState.phase(): string
	return (folder:GetAttribute("Phase") :: string?) or "Waiting"
end

function ClientState.secondsLeft(): number
	local endsAt = folder:GetAttribute("PhaseEndsAt")
	if typeof(endsAt) ~= "number" then
		return 0
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

function ClientState.attr(name: string): any
	return folder:GetAttribute(name)
end

function ClientState.myId(): string
	return "P" .. player.UserId
end

-- This player's replicated entry (nil until the server finished loading them).
function ClientState.me(): Configuration?
	return participants:FindFirstChild(ClientState.myId()) :: Configuration?
end

function ClientState.my(name: string): any
	local me = ClientState.me()
	return me and me:GetAttribute(name)
end

function ClientState.isZombie(): boolean
	return ClientState.my("Team") == "Zombie"
end

function ClientState.myCharacter(): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character, root, humanoid
end

function ClientState.owns(listAttr: string, key: string): boolean
	local raw = ClientState.my(listAttr)
	if typeof(raw) ~= "string" then
		return false
	end
	for entry in string.gmatch(raw, "[^,]+") do
		if entry == key then
			return true
		end
	end
	return false
end

export type Row = {
	id: string,
	name: string,
	score: number,
	team: string,
	isMe: boolean,
	isBot: boolean,
	vip: boolean,
}

function ClientState.rows(): { Row }
	local rows = {}
	local myId = ClientState.myId()
	for _, entry in participants:GetChildren() do
		table.insert(rows, {
			id = entry.Name,
			name = (entry:GetAttribute("DisplayName") :: string?) or entry.Name,
			score = (entry:GetAttribute("Score") :: number?) or 0,
			team = (entry:GetAttribute("Team") :: string?) or "Human",
			isMe = entry.Name == myId,
			isBot = entry:GetAttribute("IsBot") == true,
			vip = entry:GetAttribute("VIP") == true,
		})
	end
	table.sort(rows, function(a, b)
		if a.score == b.score then
			return a.name < b.name
		end
		return a.score > b.score
	end)
	return rows
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">DarknessController</string>
            <string name="Source"><![CDATA[-- Dark maps (MapThemes with dark = true, like the haunted house): a lantern
-- follows your own character, lit only on your screen, so you see what's
-- near you and little beyond. Other people's name tags show only within the
-- theme's sight (BushController asks `sees`).
--
-- The lantern is a light on an attachment in Terrain, not on a part: there
-- is nothing around it that could block it, nothing a respawn, a new look
-- or a new map can destroy, and it casts no shadows. Every frame it reads
-- the map's theme again and moves to you, so it can't get stuck off.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapThemes = require(ReplicatedStorage.Shared.MapThemes)

local DarknessController = {}

local player = Players.LocalPlayer
local theme = MapThemes.get("Classic")

local function myRoot(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local holder: Attachment? = nil
local light: PointLight? = nil

local function lantern(): (Attachment, PointLight)
	local at, lamp = holder, light
	if at and lamp and at.Parent == workspace.Terrain and lamp.Parent == at then
		return at, lamp
	end
	if at then
		at:Destroy()
	end
	local made = Instance.new("Attachment")
	made.Name = "MyLantern"
	local madeLight = Instance.new("PointLight")
	madeLight.Shadows = false
	madeLight.Parent = made
	made.Parent = workspace.Terrain
	holder, light = made, madeLight
	return made, madeLight
end

local function currentTheme(): MapThemes.Theme
	local map = workspace:FindFirstChild("Map")
	local name = map and map:GetAttribute("Theme")
	return MapThemes.get(if typeof(name) == "string" then name else nil)
end

local function updateLantern()
	theme = currentTheme()
	local at, lamp = lantern()
	local settings = theme.lantern
	local root = myRoot()
	local camera = workspace.CurrentCamera
	-- No character for a moment (respawning)? Light where the camera looks.
	local center = if root then root.Position elseif camera then camera.Focus.Position else nil
	if theme.dark and settings and center then
		local scale = if root then math.max(1, root.Size.Y / 2) else 1
		at.WorldPosition = center + Vector3.new(0, 2 + scale, 0)
		lamp.Range = settings.range
		lamp.Brightness = settings.brightness
		lamp.Color = Color3.fromHex(settings.color)
		lamp.Enabled = true
	else
		lamp.Enabled = false
	end
end

function DarknessController.isDark(): boolean
	return theme.dark == true
end

-- Can you see someone standing at `position`?
function DarknessController.sees(position: Vector3): boolean
	if not theme.dark then
		return true
	end
	local root = myRoot()
	if not root then
		return true
	end
	local offset = position - root.Position
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= (theme.sight or 40)
end

function DarknessController.start()
	updateLantern()
	RunService.RenderStepped:Connect(updateLantern)
end

return DarknessController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Plays what the server announces: your own knockback, item swings, potato
-- splats, shotgun blasts, wall debris, infection bursts and sounds.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.ClientState)
local Knockback = require(ReplicatedStorage.Shared.Knockback)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Sounds = require(script.Parent.Sounds)

local Effects = {}

local Items = require(ReplicatedStorage.Shared.Items)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)

-- Plays an item's sound style (a SoundBank name) if it has one.
local function playStyle(style: string?, position: Vector3?): boolean
	if style and Sounds.has(style) then
		Sounds.play(style, position)
		return true
	end
	return false
end

local player = Players.LocalPlayer
local effectsFolder = workspace:WaitForChild("Effects")

local baseGrip: { [Weld]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

local function fadeAndRemove(part: BasePart, seconds: number, grow: Vector3?)
	local goal: { [string]: any } = { Transparency = 1 }
	if grow then
		goal.Size = grow
	end
	local tween = TweenService:Create(
		part,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	tween.Completed:Once(function()
		part:Destroy()
	end)
end

local function flatPart(position: Vector3, diameter: number, color: string): Part
	local part = Parts.disc("Fx", position, diameter, 0.1, color, effectsFolder)
	part.CanCollide = false
	part.CanQuery = false
	return part
end

-- Swings the held item around its grip (or thrusts a spear).
local function swing(character: Model?, itemId: string)
	if not character then
		return
	end
	local held = character:FindFirstChild("HeldItem")
	local handle = held and held:FindFirstChild("Handle")
	local weld = handle and handle:FindFirstChild("GripWeld") :: Weld?
	if not weld then
		return
	end
	local base = baseGrip[weld] or weld.C0
	baseGrip[weld] = base
	local thrust = itemId == "Spear" or itemId == "AncientSpear"
	local started = os.clock()
	local duration = if thrust then 0.22 else 0.28
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - started) / duration
		if t >= 1 or weld.Parent == nil then
			connection:Disconnect()
			if weld.Parent then
				weld.C0 = base
			end
			return
		end
		if thrust then
			local push = math.sin(t * math.pi) * 2.2
			weld.C0 = base * CFrame.new(0, 0, -push)
		else
			-- Sweep from the right side across to the left, then settle.
			local angle = if t < 0.6
				then math.rad(70) - (t / 0.6) * math.rad(130)
				else math.rad(-60) * (1 - (t - 0.6) / 0.4)
			weld.C0 = base * CFrame.Angles(0, angle, 0)
		end
	end)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local item = Items.get(itemId)
	if not playStyle(item and item.sound, root and root.Position) then
		Sounds.play(if thrust then "Lunge" else "Whoosh", root and root.Position)
	end
end

-- Little bits flying out from a point and fading (stars, feathers, crumbs...).
local BITS: { [string]: { colors: { string }, size: number, count: number, shape: Enum.PartType } } = {
	Stars = { colors = { "FFE14D", "FFFFFF", "FFC21A" }, size = 0.5, count = 6, shape = Enum.PartType.Block },
	Puff = { colors = { "FFFFFF", "EDEDED" }, size = 0.45, count = 4, shape = Enum.PartType.Ball },
	Feathers = {
		colors = { "FFFFFF", "FFF3B0", "FFE14D" },
		size = 0.45,
		count = 8,
		shape = Enum.PartType.Block,
	},
	Crumbs = { colors = { "D9A15C", "B5783A", "E8C28A" }, size = 0.3, count = 10, shape = Enum.PartType.Ball },
	Sparkle = {
		colors = { "FF5FA2", "7FD3FF", "FFFFFF", "FFE14D" },
		size = 0.35,
		count = 8,
		shape = Enum.PartType.Ball,
	},
	Confetti = {
		colors = { "E5484D", "F1C40F", "2ECC71", "3498DB", "9B59B6", "FF5FA2" },
		size = 0.35,
		count = 30,
		shape = Enum.PartType.Block,
	},
	Snow = { colors = { "FFFFFF", "E8F6FF" }, size = 0.35, count = 10, shape = Enum.PartType.Ball },
	Peel = { colors = { "F7DC6F", "FFFFFF", "FFE14D" }, size = 0.4, count = 7, shape = Enum.PartType.Block },
}

local function bits(kind: string, position: Vector3, direction: Vector3?, spread: number?)
	local spec = BITS[kind]
	if not spec then
		return
	end
	local rng = Random.new()
	for i = 1, spec.count do
		local part = Parts.make({
			name = "Bit",
			shape = spec.shape,
			size = Vector3.new(spec.size, 0.08, spec.size)
				* (if spec.shape == Enum.PartType.Ball then 1 else 1),
			cframe = CFrame.new(position + Vector3.new(0, 2, 0))
				* CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			color = spec.colors[(i - 1) % #spec.colors + 1],
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		if spec.shape == Enum.PartType.Ball then
			part.Size = Vector3.one * spec.size
		end
		local dir: Vector3
		if direction then
			local cone = spread or 0.6
			dir = (CFrame.Angles(0, rng:NextNumber(-cone, cone), 0) * direction) * rng:NextNumber(14, 34)
		else
			local a = rng:NextNumber(0, math.pi * 2)
			dir = Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(6, 14)
		end
		local finish = position + Vector3.new(dir.X, 0, dir.Z) * 0.35
		local info = TweenInfo.new(rng:NextNumber(0.4, 0.8), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(part, info, {
			CFrame = CFrame.new(finish + Vector3.new(0, 1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			Transparency = 1,
		})
		tween:Play()
		tween.Completed:Once(function()
			part:Destroy()
		end)
	end
end

-- A temporary visual stuck to a character (plunger, bubble, ice).
local function stickTo(character: Model?, seconds: number, build: (root: BasePart) -> { BasePart })
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local parts = build(root)
	for _, part in parts do
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = character
	end
	task.delay(seconds, function()
		for _, part in parts do
			part:Destroy()
		end
	end)
end

local function bodyScale(root: BasePart): number
	return root.Size.X / 2.2
end

-- Spray particles on everyone currently holding a water gun / leaf blower.
local SPRAY_COLORS = {
	WaterGun = ColorSequence.new(Color3.fromHex("8FD3F5"), Color3.fromHex("E8F6FF")),
	LeafBlower = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHex("6BBF4E")),
		ColorSequenceKeypoint.new(0.5, Color3.fromHex("E8913A")),
		ColorSequenceKeypoint.new(1, Color3.fromHex("C0392B")),
	}),
}

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function updateSprays()
	for _, character in characters() do
		if character:IsA("Model") and character:GetAttribute("ParticipantId") then
			local spraying = character:GetAttribute("Spraying")
			local held = character:FindFirstChild("HeldItem")
			local handle = held and held:FindFirstChild("Handle")
			if handle then
				local emitter = handle:FindFirstChild("Spray", true) :: ParticleEmitter?
				if spraying and not emitter then
					local attachment = Instance.new("Attachment")
					attachment.Name = "SprayAt"
					attachment.CFrame = CFrame.new(0, 0, -4.3)
					attachment.Parent = handle
					local created = Instance.new("ParticleEmitter")
					created.Name = "Spray"
					created.Color = SPRAY_COLORS[spraying] or SPRAY_COLORS.WaterGun
					created.EmissionDirection = Enum.NormalId.Front
					created.Speed = NumberRange.new(28, 40)
					created.SpreadAngle = Vector2.new(if spraying == "LeafBlower" then 18 else 6, 4)
					created.Lifetime = NumberRange.new(0.35, 0.5)
					created.Rate = 70
					created.Size = NumberSequence.new(if spraying == "LeafBlower" then 0.9 else 0.6, 0.2)
					created.LightEmission = 0.2
					created.Parent = attachment
					emitter = created
				end
				if emitter then
					emitter.Enabled = spraying ~= nil
				end
			end
		end
	end
end

local function blast(origin: Vector3, direction: Vector3, reach: number)
	for _, angle in { -0.3, -0.15, 0, 0.15, 0.3 } do
		local dir = CFrame.Angles(0, angle, 0) * direction
		local mid = origin + dir * (reach / 2)
		local tracer = Parts.make({
			name = "Pellet",
			size = Vector3.new(0.25, 0.25, reach),
			cframe = CFrame.lookAt(mid, mid + dir),
			color = "FFE36E",
			material = Enum.Material.Neon,
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		fadeAndRemove(tracer, 0.18)
	end
	local flash = flatPart(origin + direction * 2 + Vector3.new(0, 1, 0), 3, "FFF3B0")
	flash.Material = Enum.Material.Neon
	fadeAndRemove(flash, 0.15, flash.Size * 1.6)
	Sounds.play("Shotgun", origin, 0.8)
end

local function debris(cframe: CFrame, size: Vector3)
	local rng = Random.new()
	for _ = 1, 8 do
		local offset = Vector3.new(
			rng:NextNumber(-size.X / 2, size.X / 2),
			rng:NextNumber(-1, 3),
			rng:NextNumber(-size.Z / 2, size.Z / 2)
		)
		local chunk = Parts.make({
			name = "Debris",
			size = Vector3.one * rng:NextNumber(0.8, 1.8),
			cframe = cframe * CFrame.new(offset),
			color = "4A4A4A",
			anchored = false,
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		chunk.AssemblyLinearVelocity =
			Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(20, 40), rng:NextNumber(-25, 25))
		task.delay(1.2, function()
			chunk:Destroy()
		end)
	end
end

local function burst(position: Vector3, color: string, size: number)
	local ring = flatPart(Vector3.new(position.X, 0.6, position.Z), 2, color)
	ring.Transparency = 0.2
	fadeAndRemove(ring, 0.45, Vector3.new(0.1, size, size))
end

local HANDLERS: { [string]: (data: { [string]: any }) -> () } = {
	Swing = function(data)
		swing(data.character, data.item)
	end,
	Shoot = function(data)
		local character = data.character :: Model?
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Shoot", root and root.Position)
	end,
	Splat = function(data)
		local look = data.look
		if look == "Snowball" then
			bits("Snow", data.position)
		elseif look == "Bubble" then
			burst(data.position, "BFE9FF", 5)
			playStyle("Pop", data.position)
		elseif look == "Pebble" then
			burst(data.position, "8C8C8C", 2.5)
		else
			burst(data.position, "C9A66B", 4)
			Sounds.play("Splat", data.position)
		end
	end,
	Blast = function(data)
		if data.item == "ConfettiCannon" then
			bits("Confetti", data.origin, data.direction, 0.6)
			playStyle("Pop", data.origin)
			playStyle("Squeak", data.origin)
		else
			blast(data.origin, data.direction, data.reach)
		end
	end,
	Hit = function(data)
		bits(data.fx, data.position)
		Sounds.play("Hit", data.position)
	end,
	Plunged = function(data)
		local target = data.character :: Model?
		local hit = target and target:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Plunge", hit and hit.Position)
		stickTo(data.character, data.seconds, function(root)
			local s = bodyScale(root)
			local plunger = ItemModels.build("Plunger")
			-- Cup on the face, stick pointing straight out the front.
			plunger:PivotTo(
				root.CFrame
					* CFrame.new(0, 1.2 * s, -1.0 * s)
					* CFrame.Angles(0, math.pi, 0)
					* CFrame.new(0, 0, 3.4)
			)
			local parts = {}
			for _, part in plunger:GetDescendants() do
				if part:IsA("BasePart") and part.Name ~= "Handle" then
					for _, weld in part:GetChildren() do
						if weld:IsA("Weld") then
							weld:Destroy()
						end
					end
					table.insert(parts, part)
				end
			end
			return parts
		end)
	end,
	Bubbled = function(data)
		local character = data.character :: Model?
		local inside = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Bubble", inside and inside.Position)
		stickTo(character, data.seconds, function(root)
			local s = bodyScale(root)
			local bubble = Parts.make({
				name = "Bubble",
				shape = Enum.PartType.Ball,
				size = Vector3.one * 5.2 * s,
				cframe = root.CFrame,
				color = "BFE9FF",
				transparency = 0.6,
			})
			local shine = Parts.make({
				name = "Shine",
				shape = Enum.PartType.Ball,
				size = Vector3.one * 1.1 * s,
				cframe = root.CFrame * CFrame.new(-1.2 * s, 1.9 * s, -1.0 * s),
				color = "FFFFFF",
				transparency = 0.3,
			})
			return { bubble, shine }
		end)
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			task.delay(data.seconds, function()
				burst(root.Position, "BFE9FF", 7)
				playStyle("Pop", root.Position)
			end)
		end
	end,
	Frozen = function(data)
		local character = data.character :: Model?
		if not character then
			return
		end
		local ice = Instance.new("Highlight")
		ice.FillColor = Color3.fromHex("9FE3FF")
		ice.FillTransparency = 0.45
		ice.OutlineColor = Color3.new(1, 1, 1)
		ice.DepthMode = Enum.HighlightDepthMode.Occluded
		ice.Parent = character
		task.delay(data.seconds, function()
			ice:Destroy()
		end)
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			bits("Snow", root.Position)
			Sounds.play("Freeze", root.Position)
		end
	end,
	Slip = function(data)
		bits("Peel", data.position)
		bits("Stars", data.position)
		playStyle("Slip", data.position)
	end,
	Drop = function(data)
		Sounds.play("Drop", data.position)
	end,
	Gulp = function(data)
		bits("Sparkle", data.position)
		playStyle("Gulp", data.position)
	end,
	Boom = function(data)
		bits("Feathers", data.position)
		burst(data.position, "FFD93B", 16)
		Sounds.play("Boom", data.position)
	end,
	WallBreak = function(data)
		debris(data.cframe, data.size)
		Sounds.play("WallBreak", data.cframe.Position)
	end,
	Infect = function(data)
		burst(data.position, "7BC043", 10)
		Sounds.play("Infect", data.position)
		task.delay(0.35, function()
			Sounds.play("Groan", data.position, 0.8)
		end)
	end,
	Eat = function(data)
		burst(data.position, "F4F4F4", 4)
		Sounds.play("Eat", data.position)
	end,
	Pickup = function(data)
		Sounds.play("Pickup", data.position)
	end,
	Outbreak = function()
		Sounds.play("Outbreak")
	end,
	RoundEnd = function(data)
		-- A happy chime if your side won, a sad one if it didn't.
		local zombie = ClientState.isZombie()
		local won = (data.winner == "Survivors" and not zombie) or (data.winner == "Zombies" and zombie)
		Sounds.play(if won then "RoundWin" else "RoundLose")
	end,
	Wizard = function(data)
		bits("Sparkle", data.position)
		Sounds.play("Wizard")
	end,
	Warp = function(data)
		Sounds.play("Warp", data.position)
	end,
}

-- Bumping into another character: a soft thud and a little puff where you
-- touched, so collisions read clearly. Your character's "Shell" is the
-- body-sized cylinder only other characters collide with.
local BUMP_COOLDOWN = 0.4
local lastBump = 0

local function watchShell(character: Model)
	local function hook(shell: Instance)
		if not shell:IsA("BasePart") or shell.Name ~= "Shell" then
			return
		end
		shell.Touched:Connect(function(other)
			if other.Name ~= "Shell" or other:IsDescendantOf(character) then
				return
			end
			local now = os.clock()
			if now - lastBump < BUMP_COOLDOWN then
				return
			end
			lastBump = now
			local between = (shell.Position + other.Position) / 2
			playStyle("Bump", between)
			bits("Puff", between)
		end)
	end
	character.ChildAdded:Connect(hook)
	for _, child in character:GetChildren() do
		hook(child)
	end
end

function Effects.start()
	player.CharacterAdded:Connect(watchShell)
	if player.Character then
		watchShell(player.Character)
	end
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(function()
				updateSprays()
				return true
			end)
			if not ok then
				warn("[Fx] spray: " .. tostring(err))
			end
		end
	end)
	Remotes.event("Knockback").OnClientEvent:Connect(function(velocity: Vector3, seconds: number)
		local character = player.Character
		if character and typeof(velocity) == "Vector3" then
			Knockback.apply(character, velocity, seconds)
		end
	end)
	Remotes.event("Fx").OnClientEvent:Connect(function(kind: string, data: { [string]: any })
		local handler = HANDLERS[kind]
		if handler then
			local ok, err = pcall(function()
				handler(data or {})
				return true
			end)
			if not ok then
				warn("[Fx] " .. kind .. ": " .. tostring(err))
			end
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ForceField</string>
            <string name="Source"><![CDATA[-- Soft force fields around people and held weapons, felt by YOUR character
-- (worked out on your machine, so it is smooth and instant):
--   * people on your team gently push apart before they overlap
--   * someone else's weapon pushes you off it (firm ones and bigger
--     holders harder)
--   * someone pressing on your own weapon pushes you back (by size)
--   * two weapons pressed together push their holders apart
-- So nobody stacks up and there is always a bit of friction, like the
-- original. Bots get the same push from the server (ItemService.shaftStep).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Config = require(ReplicatedStorage.Shared.Config)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local Items = require(ReplicatedStorage.Shared.Items)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)

local ForceField = {}

local C = Config.CHARACTER
local player = Players.LocalPlayer

type Body = { root: BasePart, scale: number, team: any, item: Items.Item? }

local cached: { Model } = {}
local cachedAt = 0

local function others(): { Model }
	local now = os.clock()
	if now - cachedAt > 0.25 then
		cachedAt = now
		cached = {}
		for _, folder in { workspace, workspace:FindFirstChild("Bots") } do
			if folder then
				for _, child in folder:GetChildren() do
					if
						child:IsA("Model")
						and child:GetAttribute("ParticipantId")
						and child ~= player.Character
					then
						table.insert(cached, child)
					end
				end
			end
		end
	end
	return cached
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Closest point to `p` on the segment a-b (all flat).
local function closest(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = b - a
	local length2 = ab:Dot(ab)
	if length2 < 1e-6 then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / length2, 0, 1)
	return a + ab * t
end

-- A held melee weapon's shaft: from the hand along where the holder faces.
local function shaft(root: BasePart, scale: number, item: Items.Item, facing: Vector3): (Vector3, Vector3)
	local hand = flat((root.CFrame * CharacterLook.grip(scale)).Position)
	local reach = (item.reach or 5) * Items.reachScale(scale)
	return hand, hand + facing * reach
end

local furnitureQuery = OverlapParams.new()
furnitureQuery.FilterType = Enum.RaycastFilterType.Include

local function solidPieces(center: Vector3, look: Vector3, size: Vector3): { BasePart }
	local folder = workspace:FindFirstChild("Furniture")
	if not folder then
		return {}
	end
	furnitureQuery.FilterDescendantsInstances = { folder }
	local found = {}
	local frame = CFrame.lookAt(center, center + look)
	for _, part in workspace:GetPartBoundsInBox(frame, size, furnitureQuery) do
		if part.Name == "Body" and not part.Anchored and part.CanCollide then
			table.insert(found, part)
		end
	end
	return found
end

-- Furniture is solid: your weapon bounces off a piece pushed into it (or one
-- it's pressed into that won't give), and your body is never left inside one.
local function furniturePush(root: BasePart, scale: number, a: Vector3?, b: Vector3?, guard: number): Vector3
	local push = Vector3.zero
	local y = root.Position.Y
	if a and b and (b - a).Magnitude > 0.1 then
		local mid = Vector3.new((a.X + b.X) / 2, y, (a.Z + b.Z) / 2)
		local size = Vector3.new(guard * 2 + 1, root.Size.Y + 2, (b - a).Magnitude + guard * 2 + 1)
		for _, body in solidPieces(mid, (b - a).Unit, size) do
			local depth, out = FurniturePush.overlapOut(a, b, guard, body)
			if out then
				push += out * math.min(depth * Config.FIELD_FURNITURE, Config.FIELD_WEAPON_MAX)
			end
		end
	end
	local me = flat(root.Position)
	local radius = Config.rootWidth(scale) / 2 * 0.9
	local around = Vector3.new(radius * 2 + 2, root.Size.Y + 2, radius * 2 + 2)
	for _, body in solidPieces(root.Position, Vector3.new(0, 0, -1), around) do
		local depth, out = FurniturePush.overlapOut(me, me, radius, body)
		if out then
			push += out * math.min(depth * 40, 40)
		end
	end
	return push
end

local function heldMelee(model: Model): Items.Item?
	local held = model:FindFirstChild("HeldItem")
	local id = held and held:GetAttribute("ItemId")
	local item = if typeof(id) == "string" then Items.get(id) else nil
	return if item and item.kind == "Melee" then item else nil
end

-- Extra velocity (studs/second, flat) for your character this frame.
function ForceField.velocity(root: BasePart, aim: Vector3, myItemId: string?, myTeam: any): Vector3
	local myScale = root.Size.Y / C.RootHeight -- (the width stops growing)
	local myRadius = C.ShellDiameter / 2 * myScale
	local me = flat(root.Position)
	local myItem = Items.get(myItemId)
	local myA, myB: Vector3? = nil, nil
	if myItem and myItem.kind == "Melee" then
		myA, myB = shaft(root, myScale, myItem, aim)
	end
	local push = furniturePush(root, myScale, myA, myB, if myItem then myItem.guard or 0.5 else 0.5)

	for _, model in others() do
		local other = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not other then
			continue
		end
		local them = flat(other.Position)
		local offset = me - them
		if offset.Magnitude > 40 then
			continue
		end
		local scale = other.Size.Y / C.RootHeight
		local radius = C.ShellDiameter / 2 * scale

		-- Body to body (same team only: a zombie touching you should infect).
		if model:GetAttribute("Team") == myTeam then
			local overlap = myRadius + radius + 0.3 - offset.Magnitude
			if overlap > 0 then
				local away = if offset.Magnitude > 0.01 then offset.Unit else Vector3.xAxis
				push += away * math.min(overlap * Config.FIELD_BODY, Config.FIELD_BODY_MAX)
			end
		end

		-- Their weapon against you.
		local item = heldMelee(model)
		local facing = flat(other.CFrame.LookVector)
		if item and facing.Magnitude > 0.1 then
			local a, b = shaft(other, scale, item, facing.Unit)
			local point = closest(a, b, me)
			local away = me - point
			local overlap = (item.guard or 0.5) + myRadius - away.Magnitude
			if overlap > 0 then
				-- Shared by strength (size squared, times how firm the weapon is):
				-- a much bigger holder holds you off completely.
				local hold = scale * scale * (item.firmness or 1)
				local share = hold / (hold + RoundRules.pushStrength(myScale, myTeam == "Zombie"))
				local dir = if away.Magnitude > 0.01 then away.Unit else facing.Unit
				push += dir * math.min(overlap * Config.FIELD_WEAPON * share * 2, Config.FIELD_WEAPON_MAX)
			end

			-- Weapon against weapon: both holders get pushed apart.
			if myA and myB and myItem then
				local mine = closest(myA, myB, closest(a, b, (myA + myB) / 2))
				local theirs = closest(a, b, mine)
				local gap = mine - theirs
				local touch = (myItem.guard or 0.5) + (item.guard or 0.5) - gap.Magnitude
				if touch > 0 then
					local dir = if gap.Magnitude > 0.01 then gap.Unit else (me - them).Unit
					push += dir * math.min(touch * Config.FIELD_WEAPON, Config.FIELD_WEAPON_MAX) * 0.6
				end
			end
		end

		-- Someone pressing on your weapon pushes you back, by their share of
		-- the strength: an equal zombie walks you backwards, a small one
		-- against a big you barely does.
		if myA and myB and myItem then
			local point = closest(myA, myB, them)
			local overlap = (myItem.guard or 0.5) + radius - (point - them).Magnitude
			if overlap > 0 then
				local back = if offset.Magnitude > 0.01 then offset.Unit else -aim
				local mine = myScale * myScale * (myItem.firmness or 1)
				local theirs = RoundRules.pushStrength(scale, model:GetAttribute("Team") == "Zombie")
				local share = theirs / (mine + theirs)
				push += back * math.min(overlap * Config.FIELD_RECOIL * share * 2, Config.FIELD_WEAPON_MAX)
			end
		end
	end
	return push
end

return ForceField
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">FurnitureController</string>
            <string name="Source"><![CDATA[-- Drives the furniture YOU are pushing, on your own machine, so it responds
-- instantly and stops the moment you stop. The server hands you a piece when
-- you claim it and takes it back if someone else pushes it too.
--
-- You move furniture by walking into it, with a zombie's arms, or with a
-- held weapon: its shaft is solid and pushes whatever it touches.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local Items = require(ReplicatedStorage.Shared.Items)
local MovementController = require(script.Parent.MovementController)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

local FurnitureController = {}

local player = Players.LocalPlayer
local OWNER = FurniturePush.OWNER_ATTRIBUTE
local CLAIM_INTERVAL = 0.1

local folder: Instance
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
local claimRemote: UnreliableRemoteEvent
local owned: { [BasePart]: boolean } = {}
local pendingClaims: { [Instance]: boolean } = {}
local lastClaim = 0

local function track(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local body = model:WaitForChild("Body", 10) :: BasePart?
	if not body then
		return
	end
	local function refresh()
		if model:GetAttribute(OWNER) == player.UserId and model.Parent == folder then
			owned[body] = true
		else
			owned[body] = nil
		end
	end
	model:GetAttributeChangedSignal(OWNER):Connect(refresh)
	model.AncestryChanged:Connect(refresh)
	refresh()
end

local function query(cframe: CFrame, size: Vector3): { BasePart }
	local found = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, overlap) do
		if part.Name == "Body" and not part.Anchored then
			table.insert(found, part)
		end
	end
	return found
end

local function collect(): FurniturePush.Pushes
	local pushes: FurniturePush.Pushes = {}
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return pushes
	end
	local scale = ClientState.my("Scale") or 1
	local strength = RoundRules.pushStrength(scale, ClientState.isZombie())
	local walk = humanoid.WalkSpeed
	local move = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z)
	local moving = move.Magnitude > 0.1 and walk > 0
	local dir = if moving then move.Unit else Vector3.zero

	-- Walking into furniture.
	if moving then
		local probe, size = FurniturePush.moverProbe(root, dir, scale)
		for _, body in query(probe, size) do
			FurniturePush.add(pushes, body, dir * walk, strength, probe.Position)
		end
	end

	-- A zombie's arms are solid: walking, they push what they touch; standing
	-- or turning, they shove it out of the way.
	if ClientState.isZombie() and walk > 0 then
		local probe, size = FurniturePush.armsProbe(
			root,
			scale,
			CharacterLook.ZOMBIE_ARM_REACH,
			CharacterLook.ZOMBIE_ARM_SPAN
		)
		for _, body in query(probe, size) do
			if not pushes[body] then
				if moving then
					FurniturePush.add(pushes, body, dir * walk, strength, probe.Position)
				else
					local exit = FurniturePush.shaftExit(root.Position, probe.LookVector, body)
					FurniturePush.add(
						pushes,
						body,
						exit * walk * Config.SHAFT_FURNITURE_FACTOR,
						strength,
						nil
					)
				end
			end
		end
	end

	-- Weapons: the shaft pushes what it touches.
	local item = Items.get(ClientState.my("HeldItem"))
	if item and item.kind == "Melee" and not ClientState.isZombie() then
		local aim = MovementController.aim()
		local reach = (item.reach or 5) * Items.reachScale(scale)
		local grip = CharacterLook.grip(scale)
		local hand = (root.CFrame * grip).Position
		local probe, size = FurniturePush.itemProbe(root, grip, aim, reach, item.guard)
		local touched = query(probe, size)
		local firm = strength * (item.firmness or 1) -- a stiff bat shoves harder than a noodle
		-- The shaft is solid: what it overlaps moves out of the way.
		if walk > 0 then
			for _, body in touched do
				if not pushes[body] then
					if moving then
						FurniturePush.add(pushes, body, dir * walk, firm, body.Position + aim * 0.5)
					else
						local exit = FurniturePush.shaftExit(hand, aim, body)
						FurniturePush.add(
							pushes,
							body,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							firm,
							nil
						)
					end
				end
			end
		end
	end

	-- A piece you drive pushes whatever it runs into, so you can shove a line.
	for body, push in table.clone(pushes) do
		if owned[body] then
			local velocity = FurniturePush.resolve(body, push)
			local ahead = Util.flatUnit(velocity)
			if ahead and velocity.Magnitude > 0.5 then
				local reachAhead = FurniturePush.extent(body, ahead)
				local center = body.Position + ahead * (reachAhead + 0.6)
				local side = Vector3.new(-ahead.Z, 0, ahead.X)
				local width = FurniturePush.extent(body, side) * 2 * 0.9
				local probe = CFrame.lookAt(center, center + ahead)
				for _, other in query(probe, Vector3.new(width, 2, 1.2)) do
					if other ~= body and not pushes[other] then
						FurniturePush.add(pushes, other, velocity, push.strength, center)
					end
				end
			end
		end
	end
	return pushes
end

local function step()
	local pushes = collect()

	-- Ask the server for anything we're pushing.
	for body in pushes do
		local model = body.Parent
		if model then
			pendingClaims[model] = true
		end
	end
	local now = os.clock()
	if next(pendingClaims) and now - lastClaim >= CLAIM_INTERVAL then
		local list = {}
		for model in pendingClaims do
			table.insert(list, model)
			if #list >= 16 then
				break
			end
		end
		table.clear(pendingClaims)
		lastClaim = now
		claimRemote:FireServer(list)
	end

	-- Drive the pieces the server gave us. Unpushed ones stand still.
	for body in owned do
		if body.Parent == nil then
			owned[body] = nil
			continue
		end
		local v = body.AssemblyLinearVelocity
		local push = pushes[body]
		if push then
			local velocity, spin = FurniturePush.resolve(body, push)
			body.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(v.Y, 0), velocity.Z)
			body.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
		elseif math.abs(v.X) + math.abs(v.Z) > 0.02 or body.AssemblyAngularVelocity.Magnitude > 0.02 then
			body.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
			body.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

function FurnitureController.start()
	folder = workspace:WaitForChild("Furniture")
	overlap.FilterDescendantsInstances = { folder }
	claimRemote = Remotes.unreliable("PushClaim")
	folder.ChildAdded:Connect(function(child)
		task.spawn(track, child)
	end)
	for _, child in folder:GetChildren() do
		task.spawn(track, child)
	end
	-- Before physics, so the velocities we set are used this very frame.
	RunService.PreSimulation:Connect(step)
end

return FurnitureController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Keyboard, mouse and gamepad actions. Touch buttons call the same functions.
--   Left click / R2: use item (hold to keep spraying)
--   E / X: pick up      G / B: drop      B / Y: shop      Z / L1: zombie return
--   1 2 3 / D-pad: switch inventory slot

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local MovementController = require(script.Parent.MovementController)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local InputController = {}

local useRemote = Remotes.event("UseItem")
local pickRemote = Remotes.event("PickUp")
local dropRemote = Remotes.event("DropItem")
local returnRemote = Remotes.event("ZombieReturn")
local slotRemote = Remotes.event("SelectSlot")

-- Set by the HUD.
InputController.onShop = function() end
InputController.isMenuOpen = function(): boolean
	return false
end

local using = false

function InputController.useStart()
	using = true
	useRemote:FireServer("start", MovementController.aim())
end

-- True while the use button is held (hooking furniture with a weapon).
function InputController.isUsing(): boolean
	return using
end

function InputController.useStop()
	if using then
		using = false
		useRemote:FireServer("stop", MovementController.aim())
	end
end

function InputController.pickUp()
	pickRemote:FireServer()
end

function InputController.drop()
	dropRemote:FireServer()
end

function InputController.selectSlot(slot: number)
	slotRemote:FireServer(slot)
end

function InputController.zombieReturn()
	returnRemote:FireServer()
end

function InputController.shop()
	InputController.onShop()
end

local BEGIN: { [Enum.KeyCode]: () -> () } = {
	[Enum.KeyCode.E] = InputController.pickUp,
	[Enum.KeyCode.G] = InputController.drop,
	[Enum.KeyCode.B] = InputController.shop,
	[Enum.KeyCode.Z] = InputController.zombieReturn,
	[Enum.KeyCode.ButtonX] = InputController.pickUp,
	[Enum.KeyCode.ButtonB] = InputController.drop,
	[Enum.KeyCode.ButtonY] = InputController.shop,
	[Enum.KeyCode.ButtonL1] = InputController.zombieReturn,
	[Enum.KeyCode.ButtonR2] = InputController.useStart,
	[Enum.KeyCode.One] = function()
		InputController.selectSlot(1)
	end,
	[Enum.KeyCode.Two] = function()
		InputController.selectSlot(2)
	end,
	[Enum.KeyCode.Three] = function()
		InputController.selectSlot(3)
	end,
	[Enum.KeyCode.DPadLeft] = function()
		InputController.selectSlot(1)
	end,
	[Enum.KeyCode.DPadUp] = function()
		InputController.selectSlot(2)
	end,
	[Enum.KeyCode.DPadRight] = function()
		InputController.selectSlot(3)
	end,
}

function InputController.start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not InputController.isMenuOpen() then
				InputController.useStart()
			end
			return
		end
		local action = BEGIN[input.KeyCode]
		if action then
			action()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.KeyCode == Enum.KeyCode.ButtonR2
		then
			InputController.useStop()
		end
	end)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="59">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point.

local Client = script.Parent

require(Client.ChatSetup).start()
require(Client.CameraController).start()
require(Client.MovementController).start()
require(Client.InputController).start()
require(Client.FurnitureController).start()
require(Client.BushController).start()
require(Client.DarknessController).start()
require(Client.RoofController).start()
require(Client.Effects).start()
require(Client.SoundController).start()
require(Client.UI.Hud).start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[-- Moves the character in SCREEN directions (W = up the screen = world -Z)
-- and turns it to face the mouse. On touch screens and gamepads, where there
-- is no mouse, the character faces the way it walks instead.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local ForceField = require(script.Parent.ForceField)

local MovementController = {}

local player = Players.LocalPlayer
local aim = Vector3.new(0, 0, -1)
local usingMouse = not UserInputService.TouchEnabled or UserInputService.MouseEnabled
local controls: any = nil
local aimRemote: UnreliableRemoteEvent? = nil
local lastAimSent = 0
local lastAimSentValue = Vector3.zero

local KEYS: { [Enum.KeyCode]: Vector3 } = {
	[Enum.KeyCode.W] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.Up] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.S] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.Down] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.A] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.Left] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.D] = Vector3.new(1, 0, 0),
	[Enum.KeyCode.Right] = Vector3.new(1, 0, 0),
}

local MOUSE_INPUTS = {
	[Enum.UserInputType.MouseMovement] = true,
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.MouseButton2] = true,
	[Enum.UserInputType.MouseWheel] = true,
	[Enum.UserInputType.Keyboard] = true,
}

function MovementController.aim(): Vector3
	return aim
end

function MovementController.usingMouse(): boolean
	return usingMouse
end

local function rawMove(): Vector3
	local v = Vector3.zero
	-- Thumbsticks and gamepads come from Roblox's PlayerModule. Its vector is
	-- already in screen terms: -Z means "up the screen".
	if controls then
		local ok, mv = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(mv) == "Vector3" then
			v += mv
		end
	end
	if not UserInputService:GetFocusedTextBox() then
		-- Read keys directly too, so arrows always work. Counting a key twice
		-- is harmless because the result is normalized below.
		for key, direction in KEYS do
			if UserInputService:IsKeyDown(key) then
				v += direction
			end
		end
	end
	v = Vector3.new(v.X, 0, v.Z)
	if v.Magnitude > 1 then
		v = v.Unit
	end
	return v
end

local function step()
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid.AutoRotate = false

	local move = rawMove()
	humanoid:Move(move, false) -- false = world space, not camera space

	-- Sharp, like the original: full speed the instant a key goes down, a dead
	-- stop the instant it comes up (a Humanoid alone eases in and out). Left
	-- alone while a knockback shove is playing.
	-- Soft force fields from people and weapons nearby are added on top, so
	-- nobody stacks and pushing always meets a little resistance.
	if not root:FindFirstChild("KnockbackForce") then
		local v = root.AssemblyLinearVelocity
		local speed = humanoid.WalkSpeed
		local field =
			ForceField.velocity(root, aim, ClientState.my("HeldItem"), character:GetAttribute("Team"))
		root.AssemblyLinearVelocity = Vector3.new(move.X * speed + field.X, v.Y, move.Z * speed + field.Z)
	end

	local camera = workspace.CurrentCamera
	if usingMouse and camera then
		local mouse = UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		if math.abs(ray.Direction.Y) > 1e-3 then
			local t = (root.Position.Y - ray.Origin.Y) / ray.Direction.Y
			local point = ray.Origin + ray.Direction * t
			local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
			if flat.Magnitude > 0.5 then
				aim = flat.Unit
			end
		end
	elseif move.Magnitude > 0.1 then
		aim = move.Unit
	end
	root.CFrame = CFrame.lookAt(root.Position, root.Position + aim)

	-- Keep the server's idea of your aim fresh (weapon pushes use it).
	local now = os.clock()
	if aimRemote and now - lastAimSent > 0.1 and aim:Dot(lastAimSentValue) < 0.995 then
		lastAimSent, lastAimSentValue = now, aim
		aimRemote:FireServer(aim)
	end
end

local function onCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.AutoRotate = false
	for _, state in
		{
			Enum.HumanoidStateType.Jumping,
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.FallingDown,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Swimming,
		}
	do
		humanoid:SetStateEnabled(state, false)
	end
end

function MovementController.start()
	task.spawn(function()
		local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
		aimRemote = Remotes.unreliable("Aim")
	end)
	task.spawn(function()
		local ok, module = pcall(function()
			return require(
					player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript
				) :: any
		end)
		if ok and module then
			controls = module:GetControls()
		else
			warn("[Movement] PlayerModule unavailable; keyboard only")
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		if MOUSE_INPUTS[inputType] then
			usingMouse = true
		elseif inputType == Enum.UserInputType.Touch or string.find(inputType.Name, "Gamepad") then
			usingMouse = false
		end
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	-- Runs right after Roblox's own control script (priority Input), so our
	-- world-space move wins.
	RunService:BindToRenderStep("BrainTagMove", Enum.RenderPriority.Input.Value + 1, step)
end

return MovementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">RoofController</string>
            <string name="Source"><![CDATA[-- Roofed maps (the haunted house): every room is covered by a pitch black
-- roof, so from outside you can't see who or what is in there. The roof of
-- the room you stand in disappears on your screen, so you see that room
-- only. Doorways are open: walk straight in.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Roofs = require(ReplicatedStorage.Shared.Roofs)

local RoofController = {}

local player = Players.LocalPlayer
local open: BasePart? = nil

local function step()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local mine = if root then Roofs.over(root.Position) else nil
	if mine == open then
		return
	end
	if open and open.Parent then
		open.LocalTransparencyModifier = 0
	end
	if mine then
		mine.LocalTransparencyModifier = 1
	end
	open = mine
end

function RoofController.start()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed >= 0.05 then
			elapsed = 0
			step()
		end
	end)
end

return RoofController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">SoundBank</string>
            <string name="Source"><![CDATA[-- Every sound in the game, built from the few sound files that ship inside
-- the Roblox client (so they always load, in any experience, with no
-- uploads). Each recipe picks a file and shapes it: pitch, volume, a slice of
-- the file, audio effects, or a short sequence of notes.
--
-- To use your own uploaded sound instead, put its id in
-- Config.SOUND_OVERRIDES, e.g. Squeak = "rbxassetid://1234567890".

export type Note = {
	file: string, -- key of FILES
	pitch: number?,
	volume: number?,
	from: number?, -- play only this slice of the file (seconds)
	to: number?,
	effects: { string }?, -- Echo, Distort, Tremolo, Flange, Reverb, Muffle, Thin
	delay: number?, -- seconds after the first note (sequences)
}

export type Recipe = { Note }

local FILES: { [string]: string } = {
	Fall = "rbxasset://sounds/action_falling.ogg", -- rushing air
	Steps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Jump = "rbxasset://sounds/action_jump.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3", -- thud
	Swim = "rbxasset://sounds/action_swim.mp3",
	Explosion = "rbxasset://sounds/impact_explosion_03.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Oof = "rbxasset://sounds/oof.ogg",
	Ouch = "rbxasset://sounds/ouch.ogg",
	Click = "rbxasset://sounds/volume_slider.ogg",
}

local function note(file: string, pitch: number, volume: number, extra: { [string]: any }?): Note
	local n: Note = { file = file, pitch = pitch, volume = volume }
	if extra then
		n.from = extra.from
		n.to = extra.to
		n.effects = extra.effects
		n.delay = extra.delay
	end
	return n
end

local function chime(pitches: { number }, gap: number, volume: number, effects: { string }?): Recipe
	local notes = {}
	for i, pitch in pitches do
		table.insert(notes, note("Click", pitch, volume, { delay = (i - 1) * gap, effects = effects }))
	end
	return notes
end

local RECIPES: { [string]: Recipe } = {
	-- Weapons
	Whoosh = { note("Fall", 2.4, 0.35, { from = 0.2, to = 0.5 }) },
	Lunge = { note("Jump", 1.6, 0.45) },
	Swish = { note("Fall", 1.6, 0.35, { from = 0.1, to = 0.45, effects = { "Flange" } }) },
	Hit = { note("Land", 1.5, 0.7) },
	Clang = {
		note("Land", 2.6, 0.75, { effects = { "Echo", "Thin" } }),
		note("Click", 0.7, 0.5, { effects = { "Echo" } }),
	},
	Squeak = { note("Oof", 2.4, 0.55) },
	Boing = { note("Jump", 0.55, 0.7, { effects = { "Tremolo", "Flange" } }) },
	Pop = { note("Click", 0.55, 1) },
	Twang = { note("Jump", 2.2, 0.5, { effects = { "Tremolo" } }) },
	Gulp = { note("Splash", 2.2, 0.45, { to = 0.35 }) },
	Slip = { note("Fall", 1.8, 0.4, { to = 0.4 }), note("Oof", 1.4, 0.6, { delay = 0.25 }) },
	Shoot = { note("Explosion", 2.8, 0.25, { to = 0.25 }) },
	Shotgun = { note("Explosion", 1.5, 0.55, { to = 0.6 }) },
	Boom = { note("Explosion", 1, 0.7), note("Oof", 2.4, 0.4, { delay = 0.1 }) },
	Splat = { note("Splash", 1.6, 0.35, { to = 0.3 }), note("Land", 1.2, 0.3) },
	Plunge = { note("Land", 0.8, 0.6), note("Splash", 2.5, 0.35, { to = 0.2 }) },
	Freeze = {
		note("Splash", 0.6, 0.35, { to = 0.5, effects = { "Echo" } }),
		note("Click", 2.8, 0.5, { delay = 0.05 }),
	},
	Bubble = { note("Swim", 2, 0.35, { to = 0.4 }) },
	WallBreak = { note("Explosion", 1.2, 0.6, { to = 0.8 }), note("Land", 0.7, 0.7) },

	-- People
	Bump = { note("Land", 1.9, 0.3) },
	Infect = { note("Oof", 1, 0.9) }, -- the classic
	Groan = { note("Ouch", 0.5, 0.55, { effects = { "Distort", "Reverb" } }) },
	Pickup = { note("GetUp", 1.7, 0.45), note("Click", 1.6, 0.4, { delay = 0.06 }) },
	Drop = { note("Land", 1.1, 0.35) },
	Eat = { note("Click", 1.2, 0.5), note("GetUp", 2, 0.4, { delay = 0.05 }) },
	Warp = { note("Fall", 0.8, 0.45, { to = 0.6, effects = { "Reverb" } }) },

	-- Round and UI
	Outbreak = {
		note("Explosion", 0.45, 0.6),
		note("Ouch", 0.45, 0.6, { delay = 0.2, effects = { "Distort", "Reverb" } }),
	},
	RoundWin = chime({ 1, 1.26, 1.5, 2 }, 0.12, 0.7, { "Reverb" }),
	RoundLose = {
		note("Ouch", 0.45, 0.6, { effects = { "Distort" } }),
		note("Click", 1, 0.6, { delay = 0.15 }),
		note("Click", 0.84, 0.6, { delay = 0.3 }),
		note("Click", 0.7, 0.6, { delay = 0.45 }),
		note("Click", 0.5, 0.6, { delay = 0.6 }),
	},
	Tick = { note("Click", 1.3, 0.5) },
	TickFinal = { note("Click", 1.9, 0.75) },
	UiClick = { note("Click", 1.5, 0.35) },
	Buy = chime({ 2, 2.6 }, 0.09, 0.6),
	Error = chime({ 0.6, 0.5 }, 0.1, 0.5),
	Wizard = chime({ 1.5, 2, 2.5, 3 }, 0.07, 0.5, { "Echo" }),

	-- Loops (started and stopped by SoundController)
	Spray = { note("Swim", 1.5, 0.3) },
	Blower = { note("Fall", 1.3, 0.3) },
	Scrape = { note("Steps", 0.45, 0.25, { effects = { "Muffle" } }) },
	Footsteps = { note("Steps", 1.1, 0.18) },
}

return {
	FILES = FILES,
	RECIPES = RECIPES,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[-- Sounds that follow what's going on rather than one-off events: countdown
-- ticks in the last 10 seconds of prep and of the round, your footsteps,
-- water guns and leaf blowers spraying, furniture scraping, and zombies
-- groaning near you.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)
local Sounds = require(script.Parent.Sounds)

local SoundController = {}

local player = Players.LocalPlayer
local HEARING = 90
local INTERVAL = 0.1
local rng = Random.new()

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function rootOf(model: Instance): BasePart?
	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function setPlaying(sound: Sound?, on: boolean)
	if not sound then
		return
	end
	if on and not sound.IsPlaying then
		sound:Play()
	elseif not on and sound.IsPlaying then
		sound:Stop()
	end
end

function SoundController.start()
	local footsteps = Sounds.loop("Footsteps")
	local footstepsPitch = if footsteps then footsteps.PlaybackSpeed else 1
	local scrape = Sounds.loop("Scrape")
	local sprays: { [Instance]: { sound: Sound, volume: number } } = {}
	local lastTick = -1
	local nextGroan = os.clock() + 5
	local furniture = workspace:WaitForChild("Furniture")

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < INTERVAL then
			return
		end
		elapsed = 0
		local on = Sounds.enabled()
		local character = player.Character
		local me = character and rootOf(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		-- Countdown ticks.
		local phase = ClientState.phase()
		local left = ClientState.secondsLeft()
		if (phase == "Prep" or phase == "Infection") and left > 0 and left <= 10 then
			local second = math.ceil(left)
			if second ~= lastTick then
				lastTick = second
				Sounds.play(if second <= 3 then "TickFinal" else "Tick")
			end
		else
			lastTick = -1
		end

		-- Your footsteps, faster when you're faster.
		local walking = on
			and humanoid ~= nil
			and humanoid.Health > 0
			and humanoid.WalkSpeed > 0
			and humanoid.MoveDirection.Magnitude > 0.1
		if footsteps and humanoid then
			footsteps.PlaybackSpeed = footstepsPitch * math.clamp(humanoid.WalkSpeed / 16, 0.8, 1.5)
		end
		setPlaying(footsteps, walking)

		-- Furniture scraping along the floor near you.
		local scraping = false
		if on and me then
			for _, model in furniture:GetChildren() do
				local body = model:FindFirstChild("Body") :: BasePart?
				if body and not body.Anchored and body.AssemblyLinearVelocity.Magnitude > 2 then
					if (body.Position - me.Position).Magnitude < 40 then
						scraping = true
						break
					end
				end
			end
		end
		setPlaying(scrape, scraping)

		-- Water guns and leaf blowers, louder the closer they are.
		local seen: { [Instance]: boolean } = {}
		for _, model in characters() do
			local kind = model:GetAttribute("Spraying")
			local root = rootOf(model)
			if on and typeof(kind) == "string" and root then
				seen[model] = true
				local entry = sprays[model]
				if not entry then
					local sound = Sounds.loop(if kind == "LeafBlower" then "Blower" else "Spray")
					if sound then
						entry = { sound = sound, volume = sound.Volume }
						sprays[model] = entry
						sound:Play()
					end
				end
				if entry then
					local distance = if me then (root.Position - me.Position).Magnitude else 0
					entry.sound.Volume = entry.volume * math.clamp(1 - distance / HEARING, 0, 1)
				end
			end
		end
		for model, entry in sprays do
			if not seen[model] then
				entry.sound:Destroy()
				sprays[model] = nil
			end
		end

		-- Now and then a zombie near you groans.
		local now = os.clock()
		if on and me and now >= nextGroan then
			nextGroan = now + rng:NextNumber(4, 8)
			local nearby = {}
			for _, model in characters() do
				local root = rootOf(model)
				if model ~= character and root and model:GetAttribute("Team") == "Zombie" then
					if (root.Position - me.Position).Magnitude < 70 then
						table.insert(nearby, root)
					end
				end
			end
			if #nearby > 0 then
				local root = nearby[rng:NextInteger(1, #nearby)]
				Sounds.play("Groan", root.Position, 0.6, rng:NextNumber(0.9, 1.15))
			end
		end
	end)
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Plays the game's sounds (recipes in SoundBank), quieter the farther they
-- happen from you (the camera is far overhead, so normal 3D falloff would
-- make everything silent). A sound named in Config.SOUND_OVERRIDES plays that
-- uploaded sound instead.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundBank = require(script.Parent.SoundBank)

local Sounds = {}

local enabled = true
local player = Players.LocalPlayer
local HEARING = 90
local rng = Random.new()

function Sounds.setEnabled(on: boolean)
	enabled = on
end

function Sounds.enabled(): boolean
	return enabled
end

function Sounds.has(name: string?): boolean
	return name ~= nil
		and (SoundBank.RECIPES[name] ~= nil or (Config.SOUND_OVERRIDES :: { [string]: string })[name] ~= nil)
end

local function listener(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

local EFFECTS: { [string]: () -> SoundEffect } = {
	Echo = function()
		local e = Instance.new("EchoSoundEffect")
		e.Delay = 0.07
		e.Feedback = 0.35
		e.WetLevel = -4
		return e
	end,
	Distort = function()
		local e = Instance.new("DistortionSoundEffect")
		e.Level = 0.55
		return e
	end,
	Tremolo = function()
		local e = Instance.new("TremoloSoundEffect")
		e.Frequency = 14
		e.Depth = 0.8
		return e
	end,
	Flange = function()
		local e = Instance.new("FlangeSoundEffect")
		e.Mix = 0.8
		e.Rate = 5
		e.Depth = 0.6
		return e
	end,
	Reverb = function()
		local e = Instance.new("ReverbSoundEffect")
		e.DecayTime = 0.9
		e.WetLevel = -6
		return e
	end,
	Muffle = function()
		local e = Instance.new("EqualizerSoundEffect")
		e.HighGain = -25
		e.MidGain = -6
		e.LowGain = 4
		return e
	end,
	Thin = function()
		local e = Instance.new("EqualizerSoundEffect")
		e.LowGain = -20
		e.MidGain = 2
		e.HighGain = 4
		return e
	end,
}

-- Builds (but doesn't play) one note.
local function make(note: SoundBank.Note, volume: number, pitch: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = SoundBank.FILES[note.file] or ""
	sound.Volume = (note.volume or 0.6) * volume
	sound.PlaybackSpeed = (note.pitch or 1) * pitch
	if note.from or note.to then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(note.from or 0, note.to or 60)
	end
	local effects: { string } = note.effects or {}
	for _, name in effects do
		local build = EFFECTS[name]
		if build then
			build().Parent = sound
		end
	end
	sound.Parent = SoundService
	return sound
end

local function playOnce(sound: Sound)
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(8, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- `volume` and `pitch` scale the recipe's own values.
function Sounds.play(name: string, position: Vector3?, volume: number?, pitch: number?)
	if not enabled then
		return
	end
	local v = volume or 1
	if position then
		local here = listener()
		if here then
			local dx, dz = position.X - here.X, position.Z - here.Z
			v *= math.clamp(1 - math.sqrt(dx * dx + dz * dz) / HEARING, 0, 1)
		end
		if v < 0.03 then
			return
		end
	end
	local p = (pitch or 1) * rng:NextNumber(0.96, 1.04) -- a little variety
	local override = (Config.SOUND_OVERRIDES :: { [string]: string })[name]
	if override and override ~= "" then
		local sound = Instance.new("Sound")
		sound.SoundId = override
		sound.Volume = 0.6 * v
		sound.PlaybackSpeed = p
		sound.Parent = SoundService
		playOnce(sound)
		return
	end
	local recipe = SoundBank.RECIPES[name]
	if not recipe then
		return
	end
	for _, n in recipe do
		if n.delay and n.delay > 0 then
			task.delay(n.delay, function()
				if enabled then
					playOnce(make(n, v, p))
				end
			end)
		else
			playOnce(make(n, v, p))
		end
	end
end

-- A looping sound you switch on and off (sprays, scraping, footsteps). Uses
-- the first note of the recipe.
function Sounds.loop(name: string): Sound?
	local override = (Config.SOUND_OVERRIDES :: { [string]: string })[name]
	local recipe = SoundBank.RECIPES[name]
	local sound: Sound
	if override and override ~= "" then
		sound = Instance.new("Sound")
		sound.SoundId = override
		sound.Parent = SoundService
	elseif recipe and recipe[1] then
		sound = make(recipe[1], 1, 1)
	else
		return nil
	end
	sound.Looped = true
	return sound
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="65">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- The admin panel (F2, or the ADMIN button on the left). Only shown to
-- admins; the server checks every request again (see AdminService).
--   Target: one player or everyone
--   Items:  give any item (or drop it in front of you)
--   Speed, points, immunity, team, bring / go to / respawn
--   Round:  skip phase, add time, next map, reset furniture, clear items
--   Maps:   pick the map for the next round (yours from Studio too)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.Parent.ClientState)
local Items = require(ReplicatedStorage.Shared.Items)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local UIKit = require(script.Parent.UIKit)

local AdminPanel = {}

local GRAY = Color3.fromRGB(70, 72, 78)
local ADMIN_RED = Color3.fromRGB(196, 54, 54)

export type Panel = {
	open: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
	update: () -> (),
}

-- Every item: the shop's order, then the wizard's, then anything else.
local function itemIds(): { string }
	local list, seen = {}, {}
	for _, group in { Items.shopOrder, Items.wizardOrder } do
		for _, id in group do
			if not seen[id] and Items.get(id) then
				seen[id] = true
				table.insert(list, id)
			end
		end
	end
	local rest = {}
	for id in Items.all do
		if not seen[id] then
			table.insert(rest, id)
		end
	end
	table.sort(rest)
	for _, id in rest do
		table.insert(list, id)
	end
	return list
end

function AdminPanel.build(parent: Instance, toast: (string, string?) -> ()): Panel
	local remote = Remotes.func("Admin")
	local window, content = UIKit.modal(parent, "Admin", 660, 600, function() end)

	local scroll = UIKit.new("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -28),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 21,
		Parent = content,
	}, { UIKit.list(Enum.FillDirection.Vertical, 6) })
	local status = UIKit.label({
		Name = "Status",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 16,
		TextColor3 = UIKit.MUTED,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Pick a target, then a command.",
		ZIndex = 21,
		Parent = content,
	})

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function heading(text: string)
		UIKit.label({
			Text = text,
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 22),
			TextSize = 18,
			Font = UIKit.HEAVY,
			TextColor3 = UIKit.GOLD,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 21,
			Parent = scroll,
		})
	end

	-- A wrapping row of buttons.
	local function row(height: number?): Frame
		return UIKit.new("Frame", {
			LayoutOrder = nextOrder(),
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 21,
			Parent = scroll,
		}, {
			UIKit.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(118, height or 32),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	local function button(parentRow: Frame, text: string, color: Color3?, onClick: () -> ()): TextButton
		return UIKit.button({
			Text = text,
			TextSize = 15,
			TextWrapped = true,
			BackgroundColor3 = color or UIKit.ACCENT,
			ZIndex = 22,
			Parent = parentRow,
		}, onClick)
	end

	-- Target picker --------------------------------------------------------------------------
	local target = ClientState.myId()
	local targetRow: Frame
	local function send(action: string, data: { [string]: any }?)
		local args: { [string]: any } = data or {}
		args.target = target
		status.Text = "..."
		task.spawn(function()
			local ok, success, message = pcall(function()
				return remote:InvokeServer(action, args)
			end)
			local text = if ok then tostring(message) else "Couldn't reach the server"
			status.Text = text
			status.TextColor3 = if ok and success then UIKit.GOOD else UIKit.RED
			if ok and success then
				toast(text)
			end
		end)
	end

	heading("Target")
	targetRow = row(30)
	local function refreshTargets()
		for _, child in targetRow:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local entries = { { id = "*", name = "Everyone" } }
		for _, r in ClientState.rows() do
			table.insert(entries, { id = r.id, name = (if r.isMe then "Me: " else "") .. r.name })
		end
		local stillThere = false
		for _, entry in entries do
			stillThere = stillThere or entry.id == target
		end
		if not stillThere then
			target = ClientState.myId()
		end
		for i, entry in entries do
			local b = button(
				targetRow,
				entry.name,
				if entry.id == target then UIKit.GOOD else GRAY,
				function()
					target = entry.id
					refreshTargets()
				end
			)
			b.LayoutOrder = i
		end
	end

	-- Items -------------------------------------------------------------------------------
	heading("Give item (click)")
	local toGround = false
	local modeRow = row(30)
	local modeButton: TextButton
	modeButton = button(modeRow, "To: their hand", GRAY, function()
		toGround = not toGround
		modeButton.Text = if toGround then "To: ground near me" else "To: their hand"
	end)
	local itemRow = row(30)
	for i, id in itemIds() do
		local item = Items.get(id)
		if item then
			local b = button(itemRow, item.name, nil, function()
				send("give", { item = id, ground = toGround })
			end)
			b.LayoutOrder = i
		end
	end

	-- Skins ---------------------------------------------------------------------------------
	heading("Give skin (they keep it, and wear it now)")
	local skinRow = row(30)
	for i, skin in Skins.list do
		local label = skin.name .. (if skin.team == "Zombie" then " (Z)" else "")
		local b = button(
			skinRow,
			label,
			if skin.team == "Zombie" then Color3.fromRGB(70, 120, 60) else nil,
			function()
				send("skin", { skin = skin.id })
			end
		)
		b.LayoutOrder = i
	end

	-- Speed ---------------------------------------------------------------------------------
	heading("Speed")
	local speedRow = row()
	for _, factor in { 0, 0.25, 0.5, 1, 1.5, 2, 3 } do
		local label = if factor == 0 then "Freeze" elseif factor == 1 then "Normal (1x)" else factor .. "x"
		button(speedRow, label, if factor < 1 then GRAY else nil, function()
			send("speed", { factor = factor })
		end)
	end

	-- Points --------------------------------------------------------------------------------
	heading("Points (size and speed follow points)")
	local pointsRow = row()
	for _, amount in { 1000, 10000, 100000, -1000 } do
		button(pointsRow, string.format("%+d", amount), if amount < 0 then GRAY else nil, function()
			send("points", { add = amount })
		end)
	end
	button(pointsRow, "Set to 0", ADMIN_RED, function()
		send("points", { set = 0 })
	end)

	-- Player --------------------------------------------------------------------------------
	heading("Player")
	local playerRow = row()
	button(playerRow, "Make human", nil, function()
		send("team", { team = "Human" })
	end)
	button(playerRow, "Make zombie", ADMIN_RED, function()
		send("team", { team = "Zombie" })
	end)
	button(playerRow, "Immunity 100", nil, function()
		send("immunity", { value = 100 })
	end)
	button(playerRow, "Bring to me", nil, function()
		send("bring")
	end)
	button(playerRow, "Go to", nil, function()
		send("goTo")
	end)
	button(playerRow, "Respawn", GRAY, function()
		send("respawn")
	end)

	-- Round ---------------------------------------------------------------------------------
	heading("Round")
	local roundRow = row()
	button(roundRow, "END ROUND NOW (next round)", ADMIN_RED, function()
		send("endRound")
	end)
	button(roundRow, "Skip phase", nil, function()
		send("skip")
	end)
	button(roundRow, "+60 seconds", nil, function()
		send("time", { seconds = 60 })
	end)
	button(roundRow, "-30 seconds", GRAY, function()
		send("time", { seconds = -30 })
	end)
	button(roundRow, "Next map (next round)", nil, function()
		send("nextMap")
	end)
	button(roundRow, "Reset furniture", GRAY, function()
		send("resetFurniture")
	end)
	button(roundRow, "Clear ground items", GRAY, function()
		send("clearItems")
	end)

	-- Maps --------------------------------------------------------------------------------------
	heading("Maps: Next = after this round, Now = end this round and go")
	local mapRow = row(30)
	local shownMaps = ""
	local function refreshMaps()
		local state = ReplicatedStorage:FindFirstChild("BrainTagState")
		local raw = state and state:GetAttribute("Maps")
		local list = if typeof(raw) == "string" then raw else ""
		if list == shownMaps then
			return
		end
		shownMaps = list
		for _, child in mapRow:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		for i, name in string.split(list, "|") do
			if name ~= "" then
				button(mapRow, "Next: " .. name, nil, function()
					send("map", { map = name })
				end).LayoutOrder = i
						* 2
					- 1
				button(mapRow, "Now: " .. name, ADMIN_RED, function()
					send("map", { map = name, now = true })
				end).LayoutOrder = i
					* 2
			end
		end
	end

	-- Open button (admins only) ----------------------------------------------------------------
	local openButton = UIKit.button({
		Name = "AdminButton",
		Text = "ADMIN\n(F2)",
		TextSize = 13,
		-- Under the left side bar's buttons.
		Position = UDim2.fromOffset(12, 10 + 5 * (66 + 8)),
		Size = UDim2.fromOffset(66, 46),
		BackgroundColor3 = ADMIN_RED,
		Visible = false,
		Parent = parent,
	})

	local function isAdmin(): boolean
		return ClientState.my("Admin") == true
	end

	local lastCount = -1
	local panel: Panel = {
		open = function()
			if isAdmin() then
				lastCount = #ClientState.rows()
				refreshTargets()
				refreshMaps()
				window.Visible = true
			end
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function()
			openButton.Visible = isAdmin()
			if window.Visible then
				local count = #ClientState.rows()
				if count ~= lastCount then
					lastCount = count
					refreshTargets()
				end
			end
		end,
	}
	local function toggle()
		if window.Visible then
			panel.close()
		else
			panel.open()
		end
	end
	openButton.Activated:Connect(toggle)
	local close = window:FindFirstChild("Close")
	if close and close:IsA("TextButton") then
		close.Activated:Connect(panel.close)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F2 then
			toggle()
		end
	end)
	return panel
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Banner</string>
              <string name="Source"><![CDATA[-- Top-center countdown banner: "Outbreak happening in N seconds", the
-- survival timer, or "Waiting for players".

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local Banner = {}

function Banner.build(parent: Instance): () -> ()
	local frame = UIKit.panel({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = parent,
	}, { UIKit.padding(18, 0) })
	local label = UIKit.label({
		Name = "Text",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 22,
		Font = UIKit.HEAVY,
		Parent = frame,
	})

	return function()
		local phase = ClientState.phase()
		local left = ClientState.secondsLeft()
		local text
		if phase == "Waiting" then
			local count = #ClientState.participants:GetChildren()
			local needed = ClientState.attr("Needed") or 2
			text = string.format("Waiting for players (%d/%d)", count, needed)
		elseif phase == "Prep" then
			text = string.format("Outbreak happening in %d seconds", math.ceil(left))
		elseif phase == "Infection" then
			if ClientState.isZombie() then
				text = "Infect them all!  " .. Util.clock(left)
			else
				text = "Survive!  " .. Util.clock(left) .. " left"
			end
		else
			text = "Next round starting..."
		end
		label.Text = text
		label.TextColor3 = if phase == "Infection" and left <= 10 then UIKit.RED else UIKit.WHITE
	end
end

return Banner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">BottomCenter</string>
              <string name="Source"><![CDATA[-- Bottom-center: a context hint ("Press E to pick up Bat"), the inventory
-- (3 slots with 3D previews; the gold one is in your hand), and the
-- "Immunity 0/100" bar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local InputController = require(script.Parent.Parent.InputController)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local BottomCenter = {}

-- " x3" for peels, " 60%" for a water tank, "" for everything else.
local function chargeText(item: Items.Item, charges: any): string
	if typeof(charges) ~= "number" or charges <= 0 or not item.charges then
		return ""
	end
	if item.kind == "Stream" then
		return string.format(" %d%%", math.ceil(charges / item.charges * 100))
	end
	return " x" .. charges
end

local function nearestGroundItem(position: Vector3): string?
	local folder = workspace:FindFirstChild("GroundItems")
	if not folder then
		return nil
	end
	local best: string? = nil
	local bestDistance = Config.PICKUP_RADIUS
	for _, model in folder:GetChildren() do
		local x, z = model:GetAttribute("SpotX"), model:GetAttribute("SpotZ")
		if typeof(x) == "number" and typeof(z) == "number" then
			local d = Util.flatDistance(Vector3.new(x, 0, z), position)
			if d <= bestDistance then
				best, bestDistance = model:GetAttribute("ItemId") :: string?, d
			end
		end
	end
	return best
end

function BottomCenter.wizardNear(position: Vector3): boolean
	local wizard = workspace:FindFirstChild("Wizard")
	local robe = wizard and wizard:FindFirstChild("Robe") :: BasePart?
	return robe ~= nil and Util.flatDistance(robe.Position, position) <= Config.WIZARD_SHOP_RADIUS
end

function BottomCenter.build(parent: Instance, touchMode: boolean): () -> ()
	local column = UIKit.new("Frame", {
		Name = "BottomCenter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(300, 150),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UIKit.list(
			Enum.FillDirection.Vertical,
			6,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Bottom
		),
	})

	local hint = UIKit.label({
		Name = "Hint",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(300, 22),
		TextSize = 17,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = hint

	-- The inventory: one box per slot, the one in your hand outlined in gold.
	-- Click a box (or press 1-3) to switch.
	local row = UIKit.new("Frame", {
		Name = "Inventory",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(Config.INVENTORY_SLOTS * 80, 72),
		BackgroundTransparency = 1,
		Parent = column,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	type SlotView = { box: Frame, stroke: UIStroke, name: TextLabel, shown: string?, preview: ViewportFrame? }
	local views: { SlotView } = {}
	for i = 1, Config.INVENTORY_SLOTS do
		local stroke = UIKit.stroke(UIKit.WHITE, 2) :: UIStroke
		local box = UIKit.new("Frame", {
			Name = "Slot" .. i,
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 72),
			BackgroundColor3 = UIKit.PANEL,
			BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
			BorderSizePixel = 0,
			Parent = row,
		}, { UIKit.corner(10), stroke })
		local number = UIKit.label({
			Name = "Number",
			Text = tostring(i),
			Position = UDim2.fromOffset(5, 2),
			Size = UDim2.fromOffset(16, 16),
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 4,
			Parent = box,
		})
		UIKit.textStroke(1).Parent = number
		local name = UIKit.label({
			Name = "ItemName",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -2),
			Size = UDim2.new(1, -4, 0, 14),
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 3,
			Parent = box,
		})
		UIKit.textStroke(1).Parent = name
		UIKit.new("TextButton", {
			Name = "Pick",
			Text = "",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 5,
			Parent = box,
		}).Activated
			:Connect(function()
				InputController.selectSlot(i)
			end)
		table.insert(views, { box = box, stroke = stroke, name = name, shown = nil, preview = nil })
	end

	local bar = UIKit.new("Frame", {
		Name = "Immunity",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(200, 18),
		BackgroundColor3 = Color3.fromRGB(40, 40, 44),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = column,
	}, { UIKit.corner(9) })
	local fill = UIKit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(94, 196, 255),
		BorderSizePixel = 0,
		Parent = bar,
	}, { UIKit.corner(9) })
	local barText = UIKit.label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		TextSize = 13,
		ZIndex = 2,
		Parent = bar,
	})
	UIKit.textStroke(1).Parent = barText

	return function()
		local active = ClientState.my("ActiveSlot") or 1
		for i, view in views do
			local raw = ClientState.my("Slot" .. i)
			local id = if typeof(raw) == "string" and raw ~= "" then raw else nil
			if id ~= view.shown then
				view.shown = id
				if view.preview then
					view.preview:Destroy()
					view.preview = nil
				end
				if id then
					view.preview = UIKit.viewport(view.box, ItemModels.build(id), { ZIndex = 2 })
				end
			end
			local slotItem = Items.get(id)
			view.name.Text = if slotItem
				then slotItem.name .. chargeText(slotItem, ClientState.my("Slot" .. i .. "Charges"))
				else ""
			local isActive = i == active
			view.stroke.Color = if isActive then UIKit.GOLD else UIKit.WHITE
			view.stroke.Thickness = if isActive then 3 else 1.5
			view.stroke.Transparency = if isActive then 0 else 0.5
		end
		local held = ClientState.my("HeldItem")
		local item = Items.get(if typeof(held) == "string" and held ~= "" then held else nil)

		local immunity = ClientState.my("Immunity") or 0
		fill.Size = UDim2.fromScale(math.clamp(immunity / Config.IMMUNITY_MAX, 0, 1), 1)
		barText.Text = string.format("Immunity  %d/%d", immunity, Config.IMMUNITY_MAX)

		local _, root = ClientState.myCharacter()
		local text = ""
		local keys = not touchMode
		if root then
			if ClientState.isZombie() then
				if ClientState.phase() == "Infection" then
					text = if keys then "[Z] back to spawn" else ""
				end
			else
				local ground = nearestGroundItem(root.Position)
				local groundItem = Items.get(ground)
				if BottomCenter.wizardNear(root.Position) then
					text = if keys
						then "Press [B] to trade with the wizard"
						else "Tap SHOP to trade with the wizard"
				elseif groundItem then
					text = (if keys then "Press [E] to pick up " else "Tap PICK UP: ") .. groundItem.name
				elseif item and keys then
					local verb = if item.kind == "Stream"
						then "[Hold click] spray"
						elseif item.kind == "Trap" then "[Click] drop one"
						elseif item.kind == "Melee" and item.hits then "[Click] swing  - hold it out to block"
						elseif item.kind == "Melee" then "Hold it toward zombies to keep them back"
						else "[Click] use"
					text = verb .. "   [G] drop   [1-3] switch"
				end
			end
		end
		hint.Text = text
	end
end

return BottomCenter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">BottomLeft</string>
              <string name="Source"><![CDATA[-- Bottom-left: your points, the speed boost and size they give you, and
-- anything changing your speed right now (energy drink, freeze, stun).
-- Plus a 2x score timer when one is running.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local BottomLeft = {}

local ICE = Color3.fromHex("8FD3FF")

function BottomLeft.build(parent: Instance): () -> ()
	local box = UIKit.panel({
		Name = "ScoreBox",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(220, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, { UIKit.padding(12, 8), UIKit.list(Enum.FillDirection.Vertical, 2) })
	local function line(name: string, order: number, height: number, props: { [string]: any }?): TextLabel
		local label = UIKit.label({
			Name = name,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			TextSize = height - 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = box,
		})
		local extra: { [string]: any } = props or {}
		for key, value in extra do
			(label :: any)[key] = value
		end
		return label
	end
	local points = line("Points", 1, 24, { Font = UIKit.HEAVY })
	local speed = line("Speed", 2, 18)
	local size = line("Size", 3, 18)
	local effect = line("Effect", 4, 16, { Visible = false })
	local boost = line("Boost", 5, 16, { TextColor3 = UIKit.GOLD, Visible = false })

	return function()
		local value = ClientState.my("Score") or 0
		points.Text = "Points: " .. Util.commas(value)
		local multiplier = Config.SPEED_MULTIPLIER(value)
		speed.Text = string.format("Speed boost: +%d%%", math.floor((multiplier - 1) * 100 + 0.5))
		size.Text = string.format("Size: %.2fx", ClientState.my("Scale") or 1)

		-- Compare your real walk speed with what your points alone give you.
		local _, _, humanoid = ClientState.myCharacter()
		local expected = RoundRules.walkSpeed(value, ClientState.isZombie())
		local ratio = if humanoid and expected > 0 then humanoid.WalkSpeed / expected else 1
		effect.Visible = math.abs(ratio - 1) > 0.03
		if ratio < 0.01 then
			effect.Text = "Stunned!"
			effect.TextColor3 = ICE
		elseif ratio > 1 then
			effect.Text = string.format("Speed right now: x%.2f", ratio)
			effect.TextColor3 = UIKit.GOLD
		else
			effect.Text = string.format("Slowed: x%.2f", ratio)
			effect.TextColor3 = ICE
		end

		local endsAt = ClientState.my("BoostEndsAt")
		local left = if typeof(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		boost.Visible = left > 0
		if left > 0 then
			boost.Text = "2x score  " .. Util.clock(left)
		end
	end
end

return BottomLeft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Center</string>
              <string name="Source"><![CDATA[-- Center screen: the big "Survivors Win!!!" / "Zombies Win!!!" text, plus
-- short toasts under the banner.

local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local Center = {}

function Center.buildWinText(parent: Instance): () -> ()
	local label = UIKit.label({
		Name = "WinText",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.9, 0.2),
		TextScaled = true,
		Font = UIKit.HEAVY,
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	})
	UIKit.new("UITextSizeConstraint", { MaxTextSize = 96, Parent = label })
	UIKit.textStroke(4).Parent = label
	local scale = UIKit.new("UIScale", { Scale = 1, Parent = label })

	local shown = ""
	return function()
		local winner = ClientState.attr("Winner")
		local text = if winner == "Survivors"
			then "Survivors Win!!!"
			elseif winner == "Zombies" then "Zombies Win!!!"
			else ""
		if text ~= shown then
			shown = text
			label.Visible = text ~= ""
			label.Text = text
			if text ~= "" then
				scale.Scale = 0.4
				TweenService:Create(
					scale,
					TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Scale = 1 }
				):Play()
			end
		end
	end
end

function Center.buildToasts(parent: Instance): (text: string, hex: string?) -> ()
	local stack = UIKit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(420, 120),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center) })

	local order = 0
	return function(text: string, hex: string?)
		order += 1
		local toast = UIKit.panel({
			Name = "Toast",
			LayoutOrder = order,
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = stack,
		}, { UIKit.padding(14, 0) })
		local label = UIKit.label({
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 17,
			Text = text,
			TextColor3 = if hex then Color3.fromHex(hex) else UIKit.WHITE,
			Parent = toast,
		})
		local toasts = stack:GetChildren()
		local count = 0
		for _, child in toasts do
			if child:IsA("Frame") then
				count += 1
			end
		end
		if count > 3 then
			local oldest: Frame? = nil
			for _, child in toasts do
				if child:IsA("Frame") and (not oldest or child.LayoutOrder < oldest.LayoutOrder) then
					oldest = child
				end
			end
			if oldest then
				oldest:Destroy()
			end
		end
		task.delay(3, function()
			if toast.Parent then
				local info = TweenInfo.new(0.4)
				TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
				TweenService:Create(label, info, { TextTransparency = 1 }):Play()
				task.wait(0.45)
				toast:Destroy()
			end
		end)
	end
end

return Center
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Builds the whole HUD in code and keeps it up to date.
--   left side: buttons       top-center: countdown      top-right: counts + leaderboard
--   bottom-left: points      bottom-center: item slot   bottom-right: chat
--   center: win text, toasts, shop / settings / trophy / quick start windows
--   over your character: "+10" when your points change

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local AdminPanel = require(script.Parent.AdminPanel)
local Banner = require(script.Parent.Banner)
local BottomCenter = require(script.Parent.BottomCenter)
local BottomLeft = require(script.Parent.BottomLeft)
local Center = require(script.Parent.Center)
local ChatSetup = require(script.Parent.Parent.ChatSetup)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local InputController = require(script.Parent.Parent.InputController)
local MobileButtons = require(script.Parent.MobileButtons)
local QuickStart = require(script.Parent.QuickStart)
local ScorePopups = require(script.Parent.ScorePopups)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopPanel = require(script.Parent.ShopPanel)
local SidePanels = require(script.Parent.SidePanels)
local TopLeft = require(script.Parent.TopLeft)
local TopRight = require(script.Parent.TopRight)
local UIKit = require(script.Parent.UIKit)

local Hud = {}

local player = Players.LocalPlayer

local function hideDefaultGui()
	for _, kind in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health } do
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(kind, false)
			end)
			if ok then
				break
			end
			task.wait(0.5)
		end
	end
end

function Hud.start()
	task.spawn(hideDefaultGui)

	local gui = UIKit.new("ScreenGui", {
		Name = "BrainTagHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local uiScale = UIKit.new("UIScale", { Parent = gui })
	local function rescale()
		local camera = workspace.CurrentCamera
		if camera then
			uiScale.Scale = math.clamp(camera.ViewportSize.Y / 760, 0.62, 1)
		end
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	local touchMode = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local toast = Center.buildToasts(gui)
	ScorePopups.start()
	ShopPanel.build(gui, toast)
	local openQuick, quickOpen = QuickStart.build(gui, touchMode, function()
		Remotes.event("TutorialDone"):FireServer()
	end)
	local settings = SidePanels.buildSettings(gui, openQuick)
	local trophy = SidePanels.buildTrophy(gui)
	local admin = AdminPanel.build(gui, toast)

	local function closeAll()
		ShopPanel.close()
		settings.close()
		trophy.close()
		admin.close()
	end

	local function toggleShop()
		if ShopPanel.isOpen() then
			ShopPanel.close()
			return
		end
		if ClientState.isZombie() then
			toast("Zombies can't shop!", Config.COLORS.ZombieText)
			return
		end
		closeAll()
		local _, root = ClientState.myCharacter()
		local atWizard = root ~= nil and BottomCenter.wizardNear(root.Position)
		ShopPanel.open(if atWizard then "Wizard" else "Items")
	end

	TopLeft.build(gui, {
		menu = function()
			closeAll()
			openQuick()
		end,
		shop = toggleShop,
		settings = function()
			local wasOpen = settings.isOpen()
			closeAll()
			if not wasOpen then
				settings.open()
			end
		end,
		trophy = function()
			local wasOpen = trophy.isOpen()
			closeAll()
			if not wasOpen then
				trophy.open()
			end
		end,
		chat = function()
			ChatSetup.setVisible(not ChatSetup.isVisible())
		end,
	})

	local updaters = {
		Banner.build(gui),
		TopRight.build(gui),
		BottomCenter.build(gui, touchMode),
		BottomLeft.build(gui),
		Center.buildWinText(gui),
	}
	if touchMode then
		table.insert(updaters, MobileButtons.build(gui))
	end

	InputController.onShop = toggleShop
	InputController.isMenuOpen = function()
		return ShopPanel.isOpen() or settings.isOpen() or trophy.isOpen() or quickOpen() or admin.isOpen()
	end

	Remotes.event("Toast").OnClientEvent:Connect(function(text: string, hex: string?)
		if typeof(text) == "string" then
			toast(text, hex)
		end
	end)

	-- First visit: show the quick start once the server has loaded our data.
	task.spawn(function()
		local me = ClientState.participants:WaitForChild(ClientState.myId(), 60)
		if me and me:GetAttribute("SeenTutorial") ~= true then
			openQuick()
		end
	end)

	task.spawn(function()
		while true do
			for _, update in updaters do
				local ok, err = pcall(function()
					update()
					return true
				end)
				if not ok then
					warn("[Hud] " .. tostring(err))
				end
			end
			ShopPanel.update()
			trophy.update()
			admin.update()

			-- Close the shop if you turned into a zombie or walked away from the wizard.
			if ShopPanel.isOpen() then
				local _, root = ClientState.myCharacter()
				if ClientState.isZombie() then
					ShopPanel.close()
				elseif
					ShopPanel.mode() == "Wizard" and (not root or not BottomCenter.wizardNear(root.Position))
				then
					ShopPanel.close()
				end
			end

			-- Your own name tag is lime green (only on your screen).
			local character = player.Character
			local head = character and character:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("NameTag")
			local label = tag and tag:FindFirstChild("Label") :: TextLabel?
			if label then
				label.TextColor3 = UIKit.LIME
			end

			task.wait(0.1)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">MobileButtons</string>
              <string name="Source"><![CDATA[-- On-screen buttons for phones and tablets: USE (hold), PICK UP, DROP, SHOP,
-- and RETURN for zombies. Placed bottom-right.

local ClientState = require(script.Parent.Parent.ClientState)
local InputController = require(script.Parent.Parent.InputController)
local UIKit = require(script.Parent.UIKit)

local MobileButtons = {}

local function round(parent: Instance, text: string, size: number, position: UDim2, color: Color3): TextButton
	local button = UIKit.button({
		Text = text,
		TextSize = if size > 70 then 22 else 14,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.15,
		Parent = parent,
	})
	local corner = button:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(0.5, 0) -- full circle
	end
	return button
end

function MobileButtons.build(parent: Instance): () -> ()
	local cluster = UIKit.new("Frame", {
		Name = "MobileButtons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -100),
		Size = UDim2.fromOffset(200, 200),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local use = round(cluster, "USE", 86, UDim2.fromOffset(140, 140), UIKit.ACCENT)
	use.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			InputController.useStart()
		end
	end)
	use.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			InputController.useStop()
		end
	end)

	local pick = round(cluster, "PICK\nUP", 56, UDim2.fromOffset(52, 150), UIKit.PANEL)
	pick.Activated:Connect(InputController.pickUp)
	local drop = round(cluster, "DROP", 50, UDim2.fromOffset(78, 92), UIKit.PANEL)
	drop.Activated:Connect(InputController.drop)
	local shop = round(cluster, "SHOP", 50, UDim2.fromOffset(140, 66), UIKit.PANEL)
	shop.Activated:Connect(InputController.shop)
	local back = round(cluster, "RETURN", 70, UDim2.fromOffset(140, 140), UIKit.RED)
	back.Activated:Connect(InputController.zombieReturn)

	return function()
		local zombie = ClientState.isZombie()
		use.Visible = not zombie
		pick.Visible = not zombie
		drop.Visible = not zombie
		shop.Visible = not zombie
		back.Visible = zombie and ClientState.phase() == "Infection"
	end
end

return MobileButtons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">QuickStart</string>
              <string name="Source"><![CDATA[-- The "Quick start" card shown on your first visit (and from the menu button).

local UIKit = require(script.Parent.UIKit)

local QuickStart = {}

function QuickStart.build(parent: Instance, touchMode: boolean, onDone: () -> ()): (() -> (), () -> boolean)
	local card = UIKit.panel({
		Name = "QuickStart",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 30,
		Parent = parent,
	}, { UIKit.padding(22, 18), UIKit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center) })
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(440, 600), Parent = card })

	local function line(order: number, text: string, size: number, font: Enum.Font, color: Color3?)
		UIKit.label({
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = text,
			TextSize = size,
			Font = font,
			TextColor3 = color or UIKit.WHITE,
			TextWrapped = true,
			RichText = true,
			ZIndex = 31,
			Parent = card,
		})
	end

	line(1, "Quick start", 30, UIKit.HEAVY)
	line(
		2,
		"Everyone starts human. When the outbreak hits, some players turn into zombies. Survive until the timer runs out, or infect every human.",
		17,
		UIKit.FONT,
		UIKit.MUTED
	)
	local controls: { string } = if touchMode
		then {
			"<b>Thumbstick</b>  move",
			"<b>USE</b>  swing or fire your item",
			"<b>PICK UP / DROP</b>  grab or let go of an item",
			"<b>SHOP</b>  buy items (and trade with the wizard)",
			"<b>RETURN</b>  zombies: back to spawn",
		}
		else {
			"<b>WASD / Arrows</b>  move",
			"<b>Mouse</b>  aim     <b>Click</b>  use item",
			"<b>B</b>  shop (or the wizard, when you stand next to him)",
			"<b>E</b>  pick up     <b>G</b>  drop",
			"<b>Z</b>  zombies: back to spawn",
		}
	for i, text in controls do
		line(2 + i, text, 18, UIKit.BOLD)
	end
	line(
		10,
		"Tip: walk into furniture to push it (bigger players push harder). A held weapon pushes too. Jam a couch into a doorway to build a barricade!",
		17,
		UIKit.BOLD,
		UIKit.LIME
	)
	UIKit.button({
		LayoutOrder = 11,
		Text = "Got it",
		Size = UDim2.fromOffset(160, 42),
		BackgroundColor3 = UIKit.GOOD,
		TextSize = 22,
		ZIndex = 31,
		Parent = card,
	}, function()
		card.Visible = false
		onDone()
	end)

	local function open()
		card.Visible = true
	end
	local function isOpen(): boolean
		return card.Visible
	end
	return open, isOpen
end

return QuickStart
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">ScorePopups</string>
              <string name="Source"><![CDATA[-- Little "+10" numbers that float up from your character whenever your
-- points change (survival points every few seconds, eating someone,
-- rewards), only on your screen. Losses float up in red.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local ScorePopups = {}

local player = Players.LocalPlayer
local RISE = TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.8)
local LOSS = Color3.fromHex(Config.COLORS.ZombieText)

local random = Random.new()

local function pop(amount: number)
	local _, root = ClientState.myCharacter()
	if not root then
		return
	end
	local board = UIKit.new("BillboardGui", {
		Name = "ScorePopup",
		Adornee = root,
		Size = UDim2.fromOffset(160, 120),
		AlwaysOnTop = true,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local x = random:NextInteger(-18, 18)
	local label = UIKit.label({
		Text = (if amount > 0 then "+" else "-") .. Util.commas(math.abs(amount)),
		Font = UIKit.HEAVY,
		TextSize = if math.abs(amount) >= 100 then 30 else 24,
		TextColor3 = if amount > 0 then UIKit.LIME else LOSS,
		TextStrokeTransparency = 0.25,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, x, 0.5, -14),
		Size = UDim2.new(1, 0, 0, 32),
		Parent = board,
	})
	TweenService:Create(label, RISE, { Position = UDim2.new(0.5, x, 0, 32) }):Play()
	TweenService:Create(label, FADE, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.5, function()
		board:Destroy()
	end)
end

function ScorePopups.start()
	task.spawn(function()
		local me = ClientState.participants:WaitForChild(ClientState.myId(), 120)
		if not me then
			return
		end
		local last = (me:GetAttribute("Score") :: number?) or 0
		local pending = 0
		me:GetAttributeChangedSignal("Score"):Connect(function()
			local value = (me:GetAttribute("Score") :: number?) or 0
			local change = value - last
			last = value
			if change == 0 then
				return
			end
			-- Changes in the same moment (a reward and its bonus) show as one.
			if pending == 0 then
				task.delay(0.05, function()
					local total = pending
					pending = 0
					if total ~= 0 then
						pop(total)
					end
				end)
			end
			pending += change
		end)
	end)
end

return ScorePopups
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[-- The shop window. Tabs: Items (spend score), Skins (score, Robux or VIP) and
-- Robux (game passes and developer products). Opened next to the wizard, it
-- shows his rare stock instead. The server validates every purchase.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Sounds = require(script.Parent.Parent.Sounds)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

type Mode = "Items" | "Wizard" | "Skins" | "Robux"

-- Filled in by build().
local ShopPanel = {
	open = function(_mode: Mode) end,
	close = function() end,
	isOpen = function(): boolean
		return false
	end,
	update = function() end,
	mode = function(): Mode
		return "Items"
	end,
}

local player = Players.LocalPlayer
local money = Config.MONETIZATION
local buyItemRemote = Remotes.func("BuyItem")
local buySkinRemote = Remotes.func("BuySkin")

local PASSES = {
	{
		key = "VIP",
		name = "VIP",
		description = "Gold name and [VIP] chat tag, +20% score, VIP skins.",
		preview = "skin:Royal",
	},
	{
		key = "DoubleScore",
		name = "Double Score",
		description = "+100% score from every reward. Forever.",
		preview = "item:GoldenDrumstick",
	},
	{
		key = "StarterKit",
		name = "Starter Kit",
		description = "Start every round holding a Bat.",
		preview = "item:Bat",
	},
	{
		key = "Lucky",
		name = "Lucky",
		description = "Rare roll chance 5% -> 15% on every purchase.",
		preview = "item:RarePotatoGun",
	},
}

local PRODUCTS = {
	{
		key = "InstantAncientSpear",
		name = "Ancient Spear",
		description = "Super rare. The only weapon that strikes.",
		preview = "item:AncientSpear",
	},
	{
		key = "InstantBat",
		name = "Instant Bat",
		description = "A Bat in your hand right now.",
		preview = "item:Bat",
	},
	{
		key = "InstantSpear",
		name = "Instant Spear",
		description = "A Spear in your hand right now.",
		preview = "item:Spear",
	},
	{
		key = "InstantShotgun",
		name = "Instant Shotgun",
		description = "The big one. Right now.",
		preview = "item:Shotgun",
	},
	{
		key = "ImmunityShot",
		name = "Immunity Shot",
		description = "+50 immunity right now.",
		preview = "item:Pill",
	},
	{
		key = "ScoreBoost30",
		name = "2x Score, 30 min",
		description = "Double every reward for 30 minutes. Stacks.",
		preview = "item:Drumstick",
	},
}

local prices: { [string]: number } = {}

local function fetchPrice(kind: "Product" | "GamePass", id: number, onDone: () -> ())
	local cacheKey = kind .. id
	if prices[cacheKey] or id == 0 then
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(
				id,
				if kind == "GamePass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and info and typeof(info.PriceInRobux) == "number" then
			prices[cacheKey] = info.PriceInRobux
			onDone()
		end
	end)
end

local function priceText(kind: "Product" | "GamePass", id: number): string
	local price = prices[kind .. id]
	return if price then "R$ " .. price else "Robux"
end

local function buildPreview(spec: string): Model?
	local kind, id = string.match(spec, "^(%a+):(%w+)$")
	if kind == "item" and id then
		return ItemModels.build(id)
	elseif kind == "skin" and id then
		local skin = Skins.get(id)
		if skin then
			return CharacterLook.preview(skin.id, skin.team)
		end
	end
	return nil
end

function ShopPanel.build(parent: Instance, toast: (string, string?) -> ())
	local mode: Mode = "Items"
	local render: () -> ()

	local window, content, heading = UIKit.modal(parent, "Shop", 780, 520, function()
		ShopPanel.close()
	end)

	local scoreLabel = UIKit.label({
		Name = "Score",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -54, 0, 12),
		Size = UDim2.fromOffset(220, 28),
		TextSize = 18,
		TextColor3 = UIKit.GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 22,
		Parent = window,
	})

	-- Hovering a card shows a tooltip like the original's: what it does, then
	-- "Price:" and the price, green if you can afford it and red if not. It
	-- sits above the card (below when there's no room), arrow pointing at it.
	local TIP_COLOR = Color3.fromRGB(26, 27, 31)
	local tipArrow = UIKit.new("Frame", {
		Name = "TipArrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = TIP_COLOR,
		BorderSizePixel = 0,
		Rotation = 45,
		Size = UDim2.fromOffset(16, 16),
		Visible = false,
		ZIndex = 39,
		Parent = window,
	}, { UIKit.stroke(UIKit.WHITE, 2, 0) })
	local tip = UIKit.new("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = TIP_COLOR,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(330, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 40,
		Parent = window,
	}, {
		UIKit.corner(10),
		UIKit.stroke(UIKit.WHITE, 2, 0),
		UIKit.padding(18, 14),
		UIKit.list(Enum.FillDirection.Vertical, 4),
	})
	local tipText = UIKit.label({
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = UIKit.FONT,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 41,
		Parent = tip,
	})
	local tipHead = UIKit.label({
		LayoutOrder = 2,
		Text = "Price:",
		Size = UDim2.new(1, 0, 0, 30),
		Font = UIKit.HEAVY,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		ZIndex = 41,
		Parent = tip,
	})
	local tipPrice = UIKit.label({
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 26),
		Font = UIKit.HEAVY,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 41,
		Parent = tip,
	})
	local tipOwner: GuiObject? = nil
	local function hideTip(owner: GuiObject?)
		if owner == nil or owner == tipOwner then
			tipOwner = nil
			tip.Visible = false
			tipArrow.Visible = false
		end
	end
	local function showTip(owner: GuiObject, text: string, price: string, priceColor: Color3)
		tipOwner = owner
		tipText.Text = text
		tipHead.Visible = price ~= ""
		tipPrice.Visible = price ~= ""
		tipPrice.Text = price
		tipPrice.TextColor3 = priceColor
		-- Screen pixels -> this window's units (the HUD's UIScale).
		local uiScale = parent:FindFirstChildOfClass("UIScale")
		local scale = if uiScale then (uiScale :: UIScale).Scale else 1
		local rel = (owner.AbsolutePosition - window.AbsolutePosition) / scale
		local size = owner.AbsoluteSize / scale
		local x = rel.X + size.X / 2
		if rel.Y > 230 then
			tip.AnchorPoint = Vector2.new(0.5, 1)
			tip.Position = UDim2.fromOffset(x, rel.Y - 14)
			tipArrow.Position = UDim2.fromOffset(x, rel.Y - 14)
		else
			tip.AnchorPoint = Vector2.new(0.5, 0)
			tip.Position = UDim2.fromOffset(x, rel.Y + size.Y + 14)
			tipArrow.Position = UDim2.fromOffset(x, rel.Y + size.Y + 14)
		end
		tip.Visible = true
		tipArrow.Visible = true
	end
	local PRICE_GREEN = Color3.fromRGB(46, 204, 113)

	local tabBar = UIKit.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = 21,
		Parent = content,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8) })

	local body = UIKit.new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 1, -42),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 21,
		Parent = content,
	})

	local tabButtons: { [string]: TextButton } = {}
	local function tab(name: string, order: number, onClick: () -> ()): TextButton
		local button = UIKit.button({
			Name = name,
			Text = name,
			LayoutOrder = order,
			Size = UDim2.fromOffset(104, 32),
			TextSize = 17,
			ZIndex = 22,
			Parent = tabBar,
		}, onClick)
		tabButtons[name] = button
		return button
	end
	for i, name in { "Items", "Skins", "Robux" } do
		tab(name, i, function()
			mode = name :: Mode
			render()
		end)
	end

	body:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		hideTip(nil)
	end)

	local function clearBody()
		hideTip(nil)
		for _, child in body:GetChildren() do
			child:Destroy()
		end
		UIKit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(168, 222),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = body,
		})
	end

	type CardSpec = {
		order: number,
		title: string,
		price: string,
		priceColor: Color3?,
		description: string,
		tip: string?, -- the hover tooltip's text (the description if nil)
		tipPrice: string?, -- the price as the tooltip shows it (the price if nil)
		affordable: boolean?, -- tooltip price in green (red if false)
		preview: Model?,
		button: string,
		buttonColor: Color3?,
		enabled: boolean,
		onClick: (() -> ())?,
	}

	local CARD = Color3.fromRGB(44, 46, 52)
	local CARD_HOVER = Color3.fromRGB(58, 61, 69)
	local function card(spec: CardSpec)
		local outline = UIKit.stroke(Color3.fromRGB(215, 219, 226), 2, 1)
		local frame = UIKit.new("Frame", {
			LayoutOrder = spec.order,
			BackgroundColor3 = CARD,
			BorderSizePixel = 0,
			ZIndex = 22,
			Parent = body,
		}, { UIKit.corner(10), outline })
		-- Hover: the card lights up and the tooltip shows.
		frame.MouseEnter:Connect(function()
			frame.BackgroundColor3 = CARD_HOVER;
			(outline :: UIStroke).Transparency = 0.1
			showTip(
				frame,
				spec.tip or spec.description,
				spec.tipPrice or spec.price,
				if spec.affordable == false then UIKit.RED else PRICE_GREEN
			)
		end)
		frame.MouseLeave:Connect(function()
			frame.BackgroundColor3 = CARD;
			(outline :: UIStroke).Transparency = 1
			hideTip(frame)
		end)
		local previewBox = UIKit.new("Frame", {
			Name = "Preview",
			BackgroundColor3 = Color3.fromRGB(60, 63, 70),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 0, 86),
			ZIndex = 22,
			Parent = frame,
		}, { UIKit.corner(8) })
		if spec.preview then
			-- Skins (CharacterLook previews) are shown from above, like in game.
			UIKit.viewport(previewBox, spec.preview, { ZIndex = 23 }, spec.preview.Name == "Preview")
		end
		UIKit.label({
			Position = UDim2.fromOffset(10, 98),
			Size = UDim2.new(1, -20, 0, 20),
			Text = spec.title,
			TextSize = 17,
			Font = UIKit.HEAVY,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.label({
			Position = UDim2.fromOffset(10, 118),
			Size = UDim2.new(1, -20, 0, 16),
			Text = spec.price,
			TextSize = 15,
			TextColor3 = spec.priceColor or UIKit.GOLD,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.label({
			Position = UDim2.fromOffset(10, 136),
			Size = UDim2.new(1, -20, 0, 42),
			Text = spec.description,
			TextSize = 13,
			Font = UIKit.FONT,
			TextColor3 = UIKit.MUTED,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -16, 0, 32),
			Text = spec.button,
			TextSize = 16,
			BackgroundColor3 = if spec.enabled
				then (spec.buttonColor or UIKit.GOOD)
				else Color3.fromRGB(80, 82, 88),
			AutoButtonColor = spec.enabled,
			ZIndex = 23,
			Parent = frame,
		}, function()
			if spec.enabled and spec.onClick then
				spec.onClick()
			end
		end)
	end

	local function renderItems(fromWizard: boolean)
		local score = ClientState.my("Score") or 0
		local order: { string } = if fromWizard then Items.wizardOrder else Items.shopOrder
		for i, id in order do
			local item = Items.get(id) :: Items.Item
			local price = (if fromWizard then item.wizardPrice else item.price) or 0
			local affordable = score >= price
			card({
				order = i,
				title = item.name,
				price = Util.commas(price) .. " score",
				priceColor = if affordable then UIKit.GOLD else UIKit.RED,
				description = item.description .. (if item.rare then "  (5% chance: rare!)" else ""),
				tip = item.description .. (if item.rare
					then string.format(
						"\n• %d%% chance to be rare",
						math.floor(Config.RARE_CHANCE * 100 + 0.5)
					)
					else ""),
				tipPrice = Util.commas(price) .. " Score",
				affordable = affordable,
				preview = ItemModels.build(id),
				button = "Buy",
				enabled = affordable,
				onClick = function()
					local ok, okResult, message = pcall(function()
						return buyItemRemote:InvokeServer(id, fromWizard)
					end)
					if ok then
						Sounds.play(if okResult then "Buy" else "Error")
						toast(
							tostring(message),
							if okResult then Config.COLORS.Good else Config.COLORS.ZombieText
						)
					end
					task.delay(0.2, render)
				end,
			})
		end
	end

	local function prompt(kind: "Product" | "GamePass", key: string)
		local id = if kind == "GamePass" then money.GamePasses[key] else money.Products[key]
		if not id or id == 0 then
			toast("Not set up yet: add its id to Config.MONETIZATION", Config.COLORS.ZombieText)
			return
		end
		if kind == "GamePass" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end

	local function renderSkins()
		local equipped = ClientState.my("HumanSkin")
		local score = ClientState.my("Score") or 0
		for i, skin in Skins.forTeam("Human") do
			local owned = ClientState.owns("OwnedSkins", skin.id)
				or skin.default == true
				or (skin.pass ~= nil and ClientState.owns("Passes", skin.pass))
			local price, button, enabled = "", "", true
			if equipped == skin.id then
				price, button, enabled = "Owned", "Equipped", false
			elseif owned then
				price, button = "Owned", "Equip"
			elseif skin.scorePrice then
				price = Util.commas(skin.scorePrice) .. " score"
				button = "Unlock"
				enabled = score >= skin.scorePrice
			elseif skin.product then
				local id = money.Products[skin.product] or 0
				fetchPrice("Product", id, render)
				price, button = priceText("Product", id), "Buy"
			elseif skin.pass then
				price, button = "VIP pass", "Get VIP"
			end
			card({
				order = i,
				title = skin.name,
				price = price,
				priceColor = if owned then UIKit.LIME else UIKit.GOLD,
				description = if skin.team == "Zombie" then "Zombie skin" else "Human skin",
				affordable = owned or enabled,
				preview = CharacterLook.preview(skin.id, skin.team),
				button = button,
				buttonColor = if skin.product or skin.pass then UIKit.ACCENT else UIKit.GOOD,
				enabled = enabled,
				onClick = function()
					local ok, status, message = pcall(function()
						return buySkinRemote:InvokeServer(skin.id)
					end)
					if not ok then
						return
					end
					if status == "prompt" then
						prompt("Product", message)
					elseif status == "promptPass" then
						prompt("GamePass", message)
					else
						Sounds.play(if status == "error" then "Error" else "Buy")
						toast(
							tostring(message),
							if status == "error" then Config.COLORS.ZombieText else Config.COLORS.Good
						)
					end
					task.delay(0.3, render)
				end,
			})
		end
	end

	local function renderRobux()
		local shown = 0
		local studio = RunService:IsStudio()
		local order = 0
		local function addCard(
			kind: "Product" | "GamePass",
			entry: { key: string, name: string, description: string, preview: string }
		)
			local id = (if kind == "GamePass" then money.GamePasses[entry.key] else money.Products[entry.key])
				or 0
			if id == 0 and not studio then
				return
			end
			order += 1
			shown += 1
			local owned = kind == "GamePass" and ClientState.owns("Passes", entry.key)
			fetchPrice(kind, id, render)
			card({
				order = order,
				title = entry.name,
				price = if owned then "Owned" elseif id == 0 then "Not set up" else priceText(kind, id),
				priceColor = if owned then UIKit.LIME else UIKit.GOLD,
				description = entry.description .. (if kind == "GamePass" then "  (permanent)" else ""),
				preview = buildPreview(entry.preview),
				button = if owned then "Owned" elseif id == 0 then "Needs an id (README)" else "Buy",
				buttonColor = UIKit.ACCENT,
				enabled = not owned and id ~= 0,
				onClick = function()
					prompt(kind, entry.key)
				end,
			})
		end
		for _, entry in PASSES do
			addCard("GamePass", entry)
		end
		for _, entry in PRODUCTS do
			addCard("Product", entry)
		end
		if shown == 0 then
			UIKit.label({
				Text = "Coming soon!",
				TextSize = 22,
				Size = UDim2.fromOffset(168, 222),
				ZIndex = 22,
				Parent = body,
			})
		end
	end

	render = function()
		if not window.Visible then
			return
		end
		clearBody()
		local wizard = mode == "Wizard"
		heading.Text = if wizard then "Wizard's Wares" else "Shop"
		tabBar.Visible = not wizard
		body.Position = UDim2.fromOffset(0, if wizard then 0 else 42)
		body.Size = UDim2.new(1, 0, 1, if wizard then 0 else -42)
		for name, button in tabButtons do
			local selected = name == mode
			button.BackgroundColor3 = if selected then UIKit.ACCENT else Color3.fromRGB(70, 72, 78)
		end
		if mode == "Items" then
			renderItems(false)
		elseif mode == "Wizard" then
			renderItems(true)
		elseif mode == "Skins" then
			renderSkins()
		else
			renderRobux()
		end
	end

	local lastScore = -1
	ShopPanel.update = function()
		if not window.Visible then
			return
		end
		local score = ClientState.my("Score") or 0
		scoreLabel.Text = "Score: " .. Util.commas(score)
		if score ~= lastScore then
			lastScore = score
			render()
		end
	end

	ShopPanel.open = function(newMode: Mode)
		mode = newMode
		window.Visible = true
		lastScore = -1
		render()
	end

	ShopPanel.close = function()
		hideTip(nil)
		window.Visible = false
	end

	ShopPanel.isOpen = function(): boolean
		return window.Visible
	end

	ShopPanel.mode = function(): Mode
		return mode
	end

	MarketplaceService.PromptProductPurchaseFinished:Connect(function()
		task.delay(1, render)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function()
		task.delay(1, render)
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">SidePanels</string>
              <string name="Source"><![CDATA[-- The settings window (sound, camera height, ping/fps line) and the trophy
-- window (your stats and the all-time top 10).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CameraController = require(script.Parent.Parent.CameraController)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(script.Parent.Parent.Sounds)
local TopRight = require(script.Parent.TopRight)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local SidePanels = {}

export type Panel = { open: () -> (), close: () -> (), isOpen: () -> boolean, update: () -> () }

local function row(parent: Instance, order: number, title: string): Frame
	local frame = UIKit.new("Frame", {
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		ZIndex = 21,
		Parent = parent,
	})
	UIKit.label({
		Text = title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.45, 0, 1, 0),
		ZIndex = 22,
		Parent = frame,
	})
	local options = UIKit.new("Frame", {
		Name = "Options",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		ZIndex = 22,
		Parent = frame,
	}, {
		UIKit.list(
			Enum.FillDirection.Horizontal,
			6,
			Enum.HorizontalAlignment.Right,
			Enum.VerticalAlignment.Center
		),
	})
	return options
end

-- A row of mutually exclusive choices.
local function choices(parent: Instance, labels: { string }, current: () -> string, pick: (string) -> ())
	local buttons: { [string]: TextButton } = {}
	local function refresh()
		for label, button in buttons do
			button.BackgroundColor3 = if label == current() then UIKit.ACCENT else Color3.fromRGB(70, 72, 78)
		end
	end
	for i, label in labels do
		buttons[label] = UIKit.button({
			Text = label,
			LayoutOrder = i,
			Size = UDim2.fromOffset(78, 32),
			TextSize = 15,
			ZIndex = 23,
			Parent = parent,
		}, function()
			pick(label)
			refresh()
		end)
	end
	refresh()
end

function SidePanels.buildSettings(parent: Instance, openHelp: () -> ()): Panel
	local panel: Panel
	local window, content = UIKit.modal(parent, "Settings", 440, 330, function()
		panel.close()
	end)
	UIKit.list(Enum.FillDirection.Vertical, 8).Parent = content

	choices(row(content, 1, "Sound effects"), { "On", "Off" }, function()
		return if Sounds.enabled() then "On" else "Off"
	end, function(choice)
		Sounds.setEnabled(choice == "On")
	end)

	choices(row(content, 2, "Camera"), { "Close", "Normal", "Far" }, function()
		for name, height in Config.CAMERA_ZOOMS do
			if height == CameraController.height() then
				return name :: string
			end
		end
		return "Normal"
	end, function(choice)
		CameraController.setHeight((Config.CAMERA_ZOOMS :: { [string]: number })[choice])
	end)

	choices(row(content, 3, "Ping / FPS"), { "On", "Off" }, function()
		return if TopRight.statsVisible() then "On" else "Off"
	end, function(choice)
		TopRight.setStatsVisible(choice == "On")
	end)

	UIKit.button({
		LayoutOrder = 4,
		Text = "How to play",
		Size = UDim2.fromOffset(160, 36),
		ZIndex = 22,
		Parent = content,
	}, function()
		panel.close()
		openHelp()
	end)

	panel = {
		open = function()
			window.Visible = true
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function() end,
	}
	return panel
end

function SidePanels.buildTrophy(parent: Instance): Panel
	local panel: Panel
	local window, content = UIKit.modal(parent, "Trophies", 520, 500, function()
		panel.close()
	end)
	UIKit.list(Enum.FillDirection.Vertical, 6).Parent = content

	local stats = UIKit.label({
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 18,
		RichText = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = content,
	})
	UIKit.label({
		LayoutOrder = 2,
		Text = "All-time best scores",
		Size = UDim2.new(1, 0, 0, 30),
		TextSize = 22,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = content,
	})
	local board = UIKit.label({
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 17,
		Font = UIKit.FONT,
		RichText = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 22,
		Parent = content,
	})

	panel = {
		open = function()
			window.Visible = true
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function()
			if not window.Visible then
				return
			end
			stats.Text = string.format(
				"Best <b>%s</b>     Wins <b>%d</b>     Infections <b>%d</b>     Rounds <b>%d</b>",
				Util.commas(ClientState.my("BestScore") or 0),
				ClientState.my("Wins") or 0,
				ClientState.my("Infections") or 0,
				ClientState.my("RoundsPlayed") or 0
			)
			local ok, rows = pcall(function()
				return HttpService:JSONDecode(ClientState.attr("TopScores") or "[]")
			end)
			if ok and typeof(rows) == "table" and #rows > 0 then
				local lines = {}
				for i, entry in rows do
					table.insert(
						lines,
						string.format(
							"%d.  %s  <b>%s</b>",
							i,
							tostring(entry.name),
							Util.commas(tonumber(entry.score) or 0)
						)
					)
				end
				board.Text = table.concat(lines, "\n")
			else
				board.Text = "No best scores saved yet. (Saving needs a published place with API access.)"
			end
		end,
	}
	return panel
end

return SidePanels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">TopLeft</string>
              <string name="Source"><![CDATA[-- Left side bar: five big square icon buttons stacked down the left edge
-- (info, shop, settings, trophy, chat).

local UIKit = require(script.Parent.UIKit)

local TopLeft = {}

TopLeft.BUTTON = 66 -- button size (pixels before UI scaling)
TopLeft.GAP = 8

export type Actions = {
	menu: () -> (),
	shop: () -> (),
	settings: () -> (),
	trophy: () -> (),
	chat: () -> (),
}

function TopLeft.build(parent: Instance, actions: Actions)
	local bar = UIKit.new("Frame", {
		Name = "SideBar",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.fromOffset(TopLeft.BUTTON, 5 * (TopLeft.BUTTON + TopLeft.GAP)),
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, TopLeft.GAP) })

	local buttons: { { icon: string, action: () -> (), accent: boolean?, name: string } } = {
		{ icon = "i", action = actions.menu, accent = true, name = "Info" }, -- how to play
		{ icon = "🛒", action = actions.shop, name = "Shop" },
		{ icon = "⚙", action = actions.settings, name = "Settings" },
		{ icon = "🏆", action = actions.trophy, name = "Trophy" },
		{ icon = "💬", action = actions.chat, name = "Chat" },
	}
	for i, b in buttons do
		UIKit.button({
			Name = b.name,
			Text = b.icon,
			TextSize = if b.name == "Info" then 44 else 34,
			Font = if b.name == "Info" then Enum.Font.GothamBlack else UIKit.BOLD,
			LayoutOrder = i,
			Size = UDim2.fromOffset(TopLeft.BUTTON, TopLeft.BUTTON),
			BackgroundColor3 = if b.accent then UIKit.ACCENT else UIKit.PANEL,
			BackgroundTransparency = if b.accent then 0 else UIKit.PANEL_TRANSPARENCY,
			Parent = bar,
		}, b.action)
	end
end

return TopLeft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">TopRight</string>
              <string name="Source"><![CDATA[-- Top-right: ping/fps, "N Survivors" (white) over "N Zombies" (red), and a
-- collapsible top-10 leaderboard with your own name in lime green.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local TopRight = {}

local ROWS = 10
local HUMAN_DOT = Color3.fromHex("F2C79A")
local ZOMBIE_DOT = Color3.fromHex("7BC043")

local showStats = true

function TopRight.setStatsVisible(on: boolean)
	showStats = on
end

function TopRight.statsVisible(): boolean
	return showStats
end

function TopRight.build(parent: Instance): () -> ()
	local column = UIKit.new("Frame", {
		Name = "TopRight",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(240, 400),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Right) })

	local stats = UIKit.label({
		Name = "Stats",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(240, 16),
		TextSize = 13,
		Font = UIKit.FONT,
		TextColor3 = UIKit.MUTED,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	local survivors = UIKit.label({
		Name = "Survivors",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(240, 32),
		TextSize = 30,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = survivors
	local zombies = UIKit.label({
		Name = "Zombies",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(240, 32),
		TextSize = 30,
		Font = UIKit.HEAVY,
		TextColor3 = UIKit.RED,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = zombies

	local expanded = true
	local toggle = UIKit.button({
		Name = "LeaderboardToggle",
		LayoutOrder = 4,
		Size = UDim2.fromOffset(150, 26),
		Text = "^  Leaderboard",
		TextSize = 16,
		BackgroundColor3 = UIKit.PANEL,
		BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
		Parent = column,
	})
	local board = UIKit.panel({
		Name = "Leaderboard",
		LayoutOrder = 5,
		Size = UDim2.fromOffset(220, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = column,
	}, { UIKit.padding(8, 6), UIKit.list(Enum.FillDirection.Vertical, 2) })

	toggle.Activated:Connect(function()
		expanded = not expanded
		board.Visible = expanded
		toggle.Text = (if expanded then "^" else "v") .. "  Leaderboard"
	end)

	local rows = {}
	for i = 1, ROWS do
		local row = UIKit.new("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 20),
			Visible = false,
			Parent = board,
		})
		local dot = UIKit.new("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(8, 8),
			BorderSizePixel = 0,
			Parent = row,
		}, { UIKit.corner(4) })
		local name = UIKit.label({
			Name = "Name",
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -84, 1, 0),
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local score = UIKit.label({
			Name = "Score",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 70, 1, 0),
			TextSize = 15,
			Font = UIKit.FONT,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		rows[i] = { frame = row, dot = dot, name = name, score = score }
	end

	local frames, fps = 0, 60
	local windowStart = os.clock()
	RunService.RenderStepped:Connect(function()
		frames += 1
		local now = os.clock()
		if now - windowStart >= 1 then
			fps = frames / (now - windowStart)
			frames, windowStart = 0, now
		end
	end)

	return function()
		stats.Visible = showStats
		if showStats then
			local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000)
			stats.Text = string.format("ping %d ms  |  %d fps", ping, math.floor(fps + 0.5))
		end
		local s = ClientState.attr("Survivors") or 0
		local z = ClientState.attr("Zombies") or 0
		survivors.Text = string.format("%d %s", s, if s == 1 then "Survivor" else "Survivors")
		zombies.Text = string.format("%d %s", z, if z == 1 then "Zombie" else "Zombies")

		local list = ClientState.rows()
		for i, row in rows do
			local entry = list[i]
			row.frame.Visible = entry ~= nil
			if entry then
				row.name.Text = entry.name
				row.name.TextColor3 = if entry.isMe
					then UIKit.LIME
					elseif entry.vip then UIKit.GOLD
					else UIKit.WHITE
				row.score.Text = Util.commas(entry.score)
				row.score.TextColor3 = if entry.isMe then UIKit.LIME else UIKit.WHITE
				row.dot.BackgroundColor3 = if entry.team == "Zombie" then ZOMBIE_DOT else HUMAN_DOT
			end
		end
	end
end

return TopRight
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[-- Tiny UI toolkit: every HUD element is built in code with these helpers.
-- Style: BuilderSans, white text, dark translucent rounded panels.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(script.Parent.Parent.Sounds)

local UIKit = {}

UIKit.FONT = Enum.Font.BuilderSans
UIKit.BOLD = Enum.Font.BuilderSansBold
UIKit.HEAVY = Enum.Font.BuilderSansExtraBold
UIKit.PANEL = Color3.fromHex(Config.COLORS.Panel)
UIKit.PANEL_TRANSPARENCY = 0.25
UIKit.WHITE = Color3.new(1, 1, 1)
UIKit.MUTED = Color3.fromRGB(190, 194, 200)
UIKit.LIME = Color3.fromHex(Config.COLORS.SelfName)
UIKit.RED = Color3.fromHex(Config.COLORS.ZombieText)
UIKit.GOLD = Color3.fromHex(Config.COLORS.VipName)
UIKit.ACCENT = Color3.fromHex(Config.COLORS.Accent)
UIKit.GOOD = Color3.fromHex(Config.COLORS.Good)

type Props = { [string]: any }

-- Creates an instance, applies properties (Parent last) and adds children.
function UIKit.new(className: string, props: Props?, children: { any }?): any
	local instance = Instance.new(className) :: any
	local parent = nil
	local given: Props = props or {}
	local kids: { any } = children or {}
	for key, value in given do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in kids do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.corner(radius: number?): Instance
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UIKit.stroke(color: Color3?, thickness: number?, transparency: number?): Instance
	return UIKit.new("UIStroke", {
		Color = color or UIKit.WHITE,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.textStroke(thickness: number?): Instance
	return UIKit.new("UIStroke", {
		Color = Color3.fromRGB(15, 15, 18),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UIKit.padding(px: number, vertical: number?): Instance
	local v = vertical or px
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, v),
		PaddingBottom = UDim.new(0, v),
	})
end

function UIKit.list(
	direction: Enum.FillDirection?,
	padding: number?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): Instance
	return UIKit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UIKit.panel(props: Props, children: { any }?): Frame
	local merged: Props = {
		BackgroundColor3 = UIKit.PANEL,
		BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	local frame = UIKit.new("Frame", merged, children)
	UIKit.corner(8).Parent = frame
	return frame
end

function UIKit.label(props: Props): TextLabel
	local merged: Props = {
		BackgroundTransparency = 1,
		Font = UIKit.BOLD,
		TextColor3 = UIKit.WHITE,
		TextSize = 18,
		Text = "",
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	return UIKit.new("TextLabel", merged)
end

function UIKit.button(props: Props, onClick: (() -> ())?): TextButton
	local merged: Props = {
		BackgroundColor3 = UIKit.ACCENT,
		BorderSizePixel = 0,
		Font = UIKit.HEAVY,
		TextColor3 = UIKit.WHITE,
		TextSize = 18,
		AutoButtonColor = true,
	}
	for key, value in props do
		merged[key] = value
	end
	local button = UIKit.new("TextButton", merged)
	UIKit.corner(8).Parent = button
	button.Activated:Connect(function()
		Sounds.play("UiClick")
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- A centered modal window with a title bar and a close button. Returns the
-- window and its content frame.
function UIKit.modal(
	parent: Instance,
	title: string,
	width: number,
	height: number,
	onClose: () -> ()
): (Frame, Frame, TextLabel)
	local window = UIKit.panel({
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.94, 0, 0.86, 0),
		BackgroundTransparency = 0.08,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(width, height), Parent = window })
	local heading = UIKit.label({
		Name = "Title",
		Text = title,
		TextSize = 26,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -80, 0, 36),
		ZIndex = 21,
		Parent = window,
	})
	UIKit.button({
		Name = "Close",
		Text = "X",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Color3.fromRGB(70, 72, 78),
		ZIndex = 22,
		Parent = window,
	}, onClose)
	local content = UIKit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -64),
		ZIndex = 21,
		Parent = window,
	})
	return window, content, heading
end

-- Renders a 3D model inside a ViewportFrame, framed from above at an angle.
-- `fromAbove` looks straight down with the front up, like the game camera.
function UIKit.viewport(parent: Instance, model: Model, props: Props?, fromAbove: boolean?): ViewportFrame
	local merged: Props = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(205, 205, 205),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.3, -1, -0.4),
	}
	local given: Props = props or {}
	for key, value in given do
		merged[key] = value
	end
	local frame = UIKit.new("ViewportFrame", merged)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = frame
	frame.CurrentCamera = camera
	model.Parent = frame
	local cf, size = model:GetBoundingBox()
	local radius = math.max(size.Magnitude / 2, 0.5)
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.08
	if fromAbove then
		camera.CFrame = CFrame.lookAt(cf.Position + Vector3.yAxis * distance, cf.Position, -Vector3.zAxis)
	else
		local from = cf.Position + Vector3.new(0.45, 1, 0.75).Unit * distance
		camera.CFrame = CFrame.lookAt(from, cf.Position)
	end
	frame.Parent = parent
	return frame
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>

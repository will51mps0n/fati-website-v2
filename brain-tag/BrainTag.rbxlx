local function buildHaunted(): Layout
	local layout = newLayout("Haunted", "The Haunted House")
	layout.theme = "Haunted"
	layout.roofs = true
	layout.bounds = rect(-180, -170, 180, 170)
	addHouse(layout, "Manor", MANOR, -120, -120, false, "Blue", "Huge")
	addHouse(layout, "Crypt", CRYPT, 130, -160, false, "Orange", "Small")
	addHouse(layout, "Shed", GARDEN_SHED, -170, 60, false, "Orange", "Small")
	addHouse(layout, "Outhouse1", OUTHOUSE, -170, -100, false, "Orange", "Small")
	addHouse(layout, "Outhouse2", OUTHOUSE, -170, -20, false, "Orange", "Small")
	addHouse(layout, "Outhouse3", OUTHOUSE, -90, -160, true, "Orange", "Small")
	addHouse(layout, "Outhouse4", OUTHOUSE, -30, -160, true, "Orange", "Small")
	addHouse(layout, "Outhouse5", OUTHOUSE, 30, -160, true, "Orange", "Small")
	addHouse(layout, "Outhouse6", OUTHOUSE, 160, -60, false, "Orange", "Small")
	addHouse(layout, "Outhouse7", OUTHOUSE, 160, 30, false, "Orange", "Small")
	addHouse(layout, "Outhouse8", OUTHOUSE, -60, 140, true, "Orange", "Small")
	-- Yards: wall-less rooms (graveyard, pumpkin patch) and outdoor pieces.
	local function yardRoom(name: string, floor: string, x1: number, z1: number, x2: number, z2: number)
		table.insert(layout.rooms, { name = name, floor = floor, rect = rect(x1, z1, x2, z2), house = "" })
	end
	local function outdoor(kind: string, x: number, z: number, rot: number?)
		table.insert(layout.furniture, { kind = kind, x = x, z = z, rot = rot or 0, house = "" })
	end

		pt(-80, 100),
		pt(110, 105),
	}
	layout.zombieSpawns = { pt(-165, 162), pt(170, 162) }
	layout.start = pt(0, 122) -- the front lawn
	layout.wizardSpots = { pt(-130, -128), pt(160, -20), pt(-160, 128), pt(40, -136) }
	return layout
end


-- Display order in the shops.
-- How each held melee weapon holds zombies and furniture back (ItemService's
-- shaftStep and FurniturePush): { firmness, guard }. The bat is short but
-- stiff and thick; the pool noodle is long, fat and soft, so zombies squeeze
-- past it; spears and the katana are thin.
local SOLIDITY: { [string]: { number } } = {
	Stick = { 0.8, 0.45 },
	Bat = { 1.7, 0.9 },
	Swordfish = { 1.0, 0.6 },
	Spear = { 1.1, 0.35 },
	AncientSpear = { 1.3, 0.4 },
	RubberChicken = { 0.45, 0.6 },
	PoolNoodle = { 0.35, 0.9 },
	Baguette = { 0.7, 0.5 },
	FryingPan = { 1.5, 1.0 },
	GoldenPan = { 1.8, 1.1 },
	Crowbar = { 1.4, 0.4 },
	Plunger = { 0.9, 0.6 },
	Lollipop = { 1.2, 1.0 },
	Katana = { 1.0, 0.35 },
	InflatableHammer = { 0.5, 1.3 },
}
for id, values in SOLIDITY do
	local item = Items[id]
	if item then
		item.firmness, item.guard = values[1], values[2]
	end
end

local SHOP_ORDER = {
	"Stick",
	"Pill",
	"RubberChicken",
	"EnergyDrink",
	"PoolNoodle",
	"BananaPeel",
	"Bat",
	"Slingshot",
	"Baguette",
	"Drumstick",
	"FryingPan",
	"WaterGun",
	"PotatoGun",
	"Crowbar",
	"Plunger",
	"Lollipop",
	"Swordfish",
	"SnowballLauncher",
	"Spear",
	"Katana",
	"ConfettiCannon",
	"BubbleGun",
	"LeafBlower",
	"DuckLauncher",
	"Shotgun",
}
local WIZARD_ORDER = { "GoldenDrumstick", "RarePotatoGun", "GoldenPan", "AncientSpear", "InflatableHammer" }

local module = {
	all = Items,
	shopOrder = SHOP_ORDER,
	wizardOrder = WIZARD_ORDER,
}

function module.get(id: string?): Item?
	if id == nil then
		return nil
	end
	return Items[id]
end

-- Items that can be scattered on the ground, as { id, weight } pairs.
function module.groundTable(): { { id: string, weight: number } }
	local list = {}
	for id, item in Items do
		if item.groundWeight and item.groundWeight > 0 then
			table.insert(list, { id = id, weight = item.groundWeight })
		end
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

return module
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Knockback</string>
          <string name="Source"><![CDATA[-- A short horizontal shove. Runs on whichever machine simulates the character:
-- the owning client for players (the server asks it to via a remote) and the
-- server for test bots. A LinearVelocity is used because a Humanoid instantly
-- cancels velocity that is simply assigned to its root.

local RunService = game:GetService("RunService")

local Knockback = {}

function Knockback.apply(character: Model, velocity: Vector3, seconds: number)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	if flat.Magnitude < 0.01 or seconds <= 0 then
		return
	end

	local old = root:FindFirstChild("KnockbackForce")
	if old then
		old:Destroy()
	end
	local attachment = root:FindFirstChild("KnockbackAttachment") :: Attachment?
	if not attachment then
		local created = Instance.new("Attachment")
		created.Name = "KnockbackAttachment"
		created.Parent = root
		attachment = created
	end

	local force = Instance.new("LinearVelocity")
	force.Name = "KnockbackForce"
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	force.PrimaryTangentAxis = Vector3.xAxis
	force.SecondaryTangentAxis = Vector3.zAxis
	force.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	force.MaxForce = math.max(root.AssemblyMass, 1) * 4000
	force.PlaneVelocity = Vector2.new(flat.X, flat.Z)
	force.Parent = root

	local started = os.clock()
	local connection: RBXScriptConnection
	connection = RunService.Heartbeat:Connect(function()
		local t = (os.clock() - started) / seconds
		if t >= 1 or force.Parent == nil then
			connection:Disconnect()
			force:Destroy()
			return
		end
		local k = 1 - t
		force.PlaneVelocity = Vector2.new(flat.X * k, flat.Z * k)
	end)
end

return Knockback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Every map as plain data, in studs. X grows to the right and Z grows DOWN
-- the screen (the camera looks straight down with -Z as "up"). MapBuilder
-- turns a layout into Parts; tests/ checks every layout and tools/ draws them.
--
-- Neighborhood: a road across the middle bulging around a small island
-- house, with a large house above and the same plan turned 180 degrees below.
-- Mansion: one big house modeled on the original's (orange brick rooms,
-- a concrete garage), a pool and an orange shed out back, the road in front.

export type Rect = { x1: number, z1: number, x2: number, z2: number }
export type Range = { number }
export type Point = { x: number, z: number }

export type Wall = {
	x1: number,
	z1: number,
	x2: number,
	z2: number,
	horizontal: boolean,
	gaps: { Range }, -- doorway openings along the wall axis
	windows: { Range },
	house: string,
}

export type WallPiece = {
	rect: Rect, -- full footprint including thickness
	window: boolean,
	house: string,
	horizontal: boolean,
}

export type Room = { name: string, floor: string, rect: Rect, house: string }
export type FurnitureSpot = { kind: string, x: number, z: number, rot: number, house: string }
export type House = { id: string, rect: Rect, outline: string, size: string }
export type Bush = { x: number, z: number, r: number, color: string }
export type Door = {
	x: number,
	z: number,
	horizontal: boolean,
	width: number,
	house: string,
	exterior: boolean,
}
export type Island = { walk: Rect, grass: Rect }

export type Layout = {
	name: string,
	title: string,
	bounds: Rect,
	houses: { House },
	walls: { Wall },
	rooms: { Room },
	furniture: { FurnitureSpot },
	itemSpots: { Point },
	road: { sidewalks: { Rect }, asphalt: { Rect }, centerLines: { Rect }, edgeLines: { Rect } },
	islands: { Island },
	paths: { Rect },
	patios: { Rect },
	pools: { Rect },
	bushes: { Bush },
	humanSpawns: { Point },
	zombieSpawns: { Point },
	wizardSpots: { Point },
}

local MapLayout = {}

MapLayout.WALL_THICKNESS = 3
MapLayout.WALL_HEIGHT = 12
MapLayout.MAX_WALL_PIECE = 8 -- breakable segment length

-- Surface heights (top Y) so overlapping flat layers never z-fight.
MapLayout.HEIGHTS = {
	Grass = 0,
	Dirt = 0.05,
	Sidewalk = 0.1,
	Patio = 0.12,
	Asphalt = 0.15,
	RoadLine = 0.18,
	IslandWalk = 0.2,
	IslandGrass = 0.25,
	Floor = 0.3,
	FloorDetail = 0.33,
	Rug = 0.36,
	PoolRim = 0.45,
}

-- Picked from screenshots of the original.
MapLayout.COLORS = {
	Grass = "4FB35F",
	Outside = "3B6E45", -- beyond the boundary wall
	BoundaryBrick = "B5653A",
	BoundaryCap = "5B3420",
	GrassTuft = "3E9A4E",
	Flower = "F48FB1",
	FlowerCenter = "FFE066",
	Pebble = "9EA7AD",
	Twig = "8B6A43",
	Dirt = "C27B45",
	DirtSpeck = "A86434",
	Sidewalk = "A9BEC4",
	SidewalkSpeck = "93A9B0",
	Asphalt = "474749",
	CenterLine = "F2C230",
	EdgeLine = "F4F4F4",
	Wall = "4A4A4A",
	OutlineBlue = "A3CCDB",
	OutlineOrange = "E8762C",
	Window = "BFE6F5",
	Brick = "D88B53",
	BrickMortar = "EDBB8E",
	Tile = "9EB1BE",
	TileAlt = "B9C8D2",
	Wood = "B07A45",
	WoodLine = "8E5F31",
	Concrete = "BCC3C8",
	ConcreteSpeck = "A5ADB3",
	PoolWater = "4FB3E8",
	PoolRim = "E6EEF2",
	BushGreen = "43A85A",
	BushOrange = "E8913A",
	ZombiePit = "6B2D2D",
}

local T = MapLayout.WALL_THICKNESS

-- Plans ------------------------------------------------------------------------------
-- Plans are in house-local coordinates with (0, 0) at the top-left corner of
-- the wall centerlines.

type PlanWall = { x1: number, z1: number, x2: number, z2: number, gaps: { Range }, windows: { Range } }
type PlanRoom = { name: string, floor: string, x1: number, z1: number, x2: number, z2: number }
type PlanPiece = { kind: string, x: number, z: number, rot: number }
type Plan = {
	w: number,
	d: number,
	walls: { PlanWall },
	rooms: { PlanRoom },
	furniture: { PlanPiece },
	items: { Point },
}

local function wall(
	x1: number,
	z1: number,
	x2: number,
	z2: number,
	gaps: { Range }?,
	windows: { Range }?
): PlanWall
	return { x1 = x1, z1 = z1, x2 = x2, z2 = z2, gaps = gaps or {}, windows = windows or {} }
end

local function room(name: string, floor: string, x1: number, z1: number, x2: number, z2: number): PlanRoom
	return { name = name, floor = floor, x1 = x1, z1 = z1, x2 = x2, z2 = z2 }
end

local function piece(kind: string, x: number, z: number, rot: number?): PlanPiece
	return { kind = kind, x = x, z = z, rot = rot or 0 }
end

local function rect(x1: number, z1: number, x2: number, z2: number): Rect
	return { x1 = math.min(x1, x2), z1 = math.min(z1, z2), x2 = math.max(x1, x2), z2 = math.max(z1, z2) }
end

local function pt(x: number, z: number): Point
	return { x = x, z = z }
end

-- 140 x 84: bedroom, bathroom and kitchen on top, a hallway across the middle,
-- living and dining rooms at the front (bottom, facing the road).
local LARGE: Plan = {
	w = 140,
	d = 84,
	walls = {
		wall(0, 0, 140, 0, { { 120, 128 } }, { { 8, 20 }, { 30, 42 }, { 56, 72 } }), -- back, kitchen door
		wall(0, 84, 140, 84, { { 15, 23 } }, { { 36, 60 }, { 82, 112 } }), -- front door
		wall(0, 0, 0, 84, nil, { { 8, 28 }, { 56, 76 } }),
		wall(140, 0, 140, 84, { { 38, 46 } }, { { 8, 28 }, { 58, 78 } }), -- hallway side door
		wall(0, 36, 140, 36, { { 20, 27 }, { 61, 68 }, { 105, 112 } }),
		wall(0, 48, 140, 48, { { 30, 37 }, { 100, 107 } }),
		wall(48, 0, 48, 36),
		wall(82, 0, 82, 36),
		wall(70, 48, 70, 84),
	},
	rooms = {
		room("Bedroom", "Wood", 0, 0, 48, 36),
		room("Bathroom", "Tile", 48, 0, 82, 36),
		room("Kitchen", "Tile", 82, 0, 140, 36),
		room("Hallway", "Brick", 0, 36, 140, 48),
		room("Living Room", "Wood", 0, 48, 70, 84),
		room("Dining Room", "Brick", 70, 48, 140, 84),
	},
	furniture = {
		-- Bedroom
		piece("Bed", 7, 8),
		piece("Wardrobe", 16, 3.3),
		piece("Bookshelf", 30, 3),
		piece("Dresser", 45.2, 14, 270),
		piece("Desk", 36, 18),
		piece("Lamp", 12, 14.5),
		piece("Armchair", 40, 28),
		piece("Box", 16, 29),
		piece("Box", 16, 26),
		piece("Plant", 44, 4),
		piece("Picture", 8, 30),
		piece("Beanbag", 28, 28),
		-- Bathroom
		piece("Bathtub", 65, 4.5),
		piece("Toilet", 52, 14, 90),
		piece("Toilet", 52, 20, 90),
		piece("Sink", 78.5, 14, 270),
		piece("Washer", 78.5, 22),
		piece("Box", 76, 30),
		-- Kitchen
		piece("Fridge", 87, 4),
		piece("Stove", 93, 3.5),
		piece("Sink", 99, 3.2),
		piece("Crate", 106, 4),
		piece("Barrel", 137, 4),
		piece("TrashCan", 131, 4),
		piece("Table", 116, 20),
		piece("Chair", 110, 20, 90),
		piece("Chair", 122, 20, 270),
		piece("Chair", 116, 15, 0),
		piece("Chair", 116, 25, 180),
		piece("Box", 134, 30),
		piece("Box", 134, 26.6),
		-- Hallway
		piece("Plant", 4, 40),
		piece("Lamp", 80, 43),
		piece("Box", 128, 44),
		-- Living room
		piece("Couch", 38, 64),
		piece("Armchair", 24, 70, 90),
		piece("Rug", 38, 72),
		piece("CoffeeTable", 38, 71),
		piece("Bookshelf", 67, 70, 270),
		piece("Piano", 52, 79.5),
		piece("TVStand", 52, 50.6),
		piece("Lamp", 28, 60),
		piece("Aquarium", 8, 81),
		piece("Box", 5, 52),
		piece("Box", 8, 52),
		piece("Box", 5, 55),
		piece("Plant", 66, 52),
		-- Dining room
		piece("Table", 104, 66),
		piece("Chair", 98, 66, 90),
		piece("Chair", 110, 66, 270),
		piece("Chair", 104, 61, 0),
		piece("Chair", 104, 71, 180),
		piece("PoolTable", 122, 60),
		piece("Couch", 122, 78, 180),
		piece("Armchair", 78, 56),
		piece("Crate", 88, 56),
		piece("Arcade", 136, 66),
		piece("Box", 136, 52),
		piece("Box", 132.6, 52),
		piece("Plant", 75, 80),
		piece("Picture", 90, 80),
	},
	items = {
		pt(24, 18),
		pt(70, 22),
		pt(100, 25),
		pt(40, 42),
		pt(90, 42),
		pt(40, 76),
		pt(88, 66),
	},
}

-- 40 x 28 on the road island: a washroom and a den.
local SMALL: Plan = {
	w = 40,
	d = 28,
	walls = {
		wall(0, 0, 40, 0, { { 28, 35 } }, { { 5, 15 } }),
		wall(0, 28, 40, 28, { { 6, 13 } }, { { 25, 36 } }),
		wall(0, 0, 0, 28, nil, { { 8, 20 } }),
		wall(40, 0, 40, 28, nil, { { 8, 20 } }),
		wall(22, 0, 22, 28, { { 10, 17 } }),
	},
	rooms = {
		room("Washroom", "Tile", 0, 0, 22, 28),
		room("Den", "Wood", 22, 0, 40, 28),
	},
	furniture = {
		piece("Toilet", 4, 4),
		piece("Sink", 17, 3.2),

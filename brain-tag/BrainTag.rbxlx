          <string name="Name">RbxCharacterSounds</string>
          <string name="Source"><![CDATA[-- Intentionally empty. A LocalScript with this name replaces Roblox's default
-- character sounds (footsteps, jump, landing), so Brain Tag stays footstep-free.
]]></string>

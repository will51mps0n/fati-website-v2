		pt(88, 66),
	},
}

-- 40 x 28 on the road island: a washroom and a den.
local SMALL: Plan = {
	w = 40,
	d = 28,
	walls = {
		wall(0, 0, 40, 0, { { 28, 35 } }, { { 5, 15 } }),
		wall(0, 28, 40, 28, { { 6, 13 } }, { { 25, 36 } }),
		wall(0, 0, 0, 28, nil, { { 8, 20 } }),
		wall(40, 0, 40, 28, nil, { { 8, 20 } }),
		wall(22, 0, 22, 28, { { 10, 17 } }),
	},

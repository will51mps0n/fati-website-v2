-- Assembly -------------------------------------------------------------------------------

local function newLayout(name: string, title: string): Layout
	return {
		name = name,
		title = title,
		bounds = rect(-210, -200, 210, 200),
		houses = {},
		walls = {},
		rooms = {},
		furniture = {},
		itemSpots = {},
		road = { sidewalks = {}, asphalt = {}, centerLines = {}, edgeLines = {} },
		islands = {},
		paths = {},
		patios = {},
		pools = {},
		bushes = {},
		humanSpawns = {},
		zombieSpawns = {},
		wizardSpots = {},
		start = { x = 0, z = 0 },
	}
end

local function addHouse(
	layout: Layout,
	id: string,
	plan: Plan,
	ox: number,
	oz: number,
	rotated: boolean,
	outline: string,
	size: string
)
	local function px(x: number): number
		return ox + (if rotated then plan.w - x else x)
	end
	local function pz(z: number): number
		return oz + (if rotated then plan.d - z else z)
	end
	local function mapRanges(ranges: { Range }, f: (number) -> number): { Range }
		local out = {}
		for _, r in ranges do
			local a, b = f(r[1]), f(r[2])
			table.insert(out, { math.min(a, b), math.max(a, b) })
		end
		table.sort(out, function(a, b)
			return a[1] < b[1]
		end)
		return out
	end

	table.insert(
		layout.houses,
		{ id = id, rect = rect(px(0), pz(0), px(plan.w), pz(plan.d)), outline = outline, size = size }
	)

	for _, w in plan.walls do
		local horizontal = w.z1 == w.z2
		local f = if horizontal then px else pz
		table.insert(layout.walls, {
			x1 = math.min(px(w.x1), px(w.x2)),
			z1 = math.min(pz(w.z1), pz(w.z2)),
			x2 = math.max(px(w.x1), px(w.x2)),
			z2 = math.max(pz(w.z1), pz(w.z2)),
			horizontal = horizontal,
			gaps = mapRanges(w.gaps, f),
			windows = mapRanges(w.windows, f),
			house = id,
		})
	end

	for _, r in plan.rooms do
		table.insert(layout.rooms, {
			name = r.name,
			floor = r.floor,
			rect = rect(px(r.x1), pz(r.z1), px(r.x2), pz(r.z2)),
			house = id,
		})
	end

	for _, p in plan.furniture do
		local rot = if rotated then (p.rot + 180) % 360 else p.rot
		table.insert(layout.furniture, { kind = p.kind, x = px(p.x), z = pz(p.z), rot = rot, house = id })
	end

	for _, spot in plan.items do
		table.insert(layout.itemSpots, pt(px(spot.x), pz(spot.z)))
	end
end

-- Point reflection through the map center, used to mirror yards.
local function mirrorRects(list: { Rect }): { Rect }
	local out = table.clone(list)
	for _, r in list do
		table.insert(out, rect(-r.x2, -r.z2, -r.x1, -r.z1))
	end
	return out
end

local function mirrorPoints(list: { Point }): { Point }
	local out = table.clone(list)
	for _, p in list do
		table.insert(out, pt(-p.x, -p.z))
	end
	return out
end

local function bush(x: number, z: number, r: number, color: string): Bush
	return { x = x, z = z, r = r, color = color }
end

-- Neighborhood ------------------------------------------------------------------------------

local function buildNeighborhood(): Layout
	local layout = newLayout("Neighborhood", "The Neighborhood")
	layout.bounds = rect(-150, -182, 150, 182) -- brick wall just outside this
	local B = layout.bounds
	addHouse(layout, "North", LARGE, -110, -150, false, "Blue", "Large")
	addHouse(layout, "South", LARGE, -30, 66, true, "Orange", "Large")
	addHouse(layout, "Island", SMALL, -20, -14, false, "Blue", "Small")

	layout.road = {
		sidewalks = { rect(B.x1, -20, B.x2, 20), rect(-52, -46, 52, 46) },
		asphalt = { rect(B.x1, -14, B.x2, 14), rect(-46, -40, 46, 40) },
		centerLines = {
			rect(B.x1, -0.8, -46, -0.4),
			rect(B.x1, 0.4, -46, 0.8),
			rect(46, -0.8, B.x2, -0.4),
			rect(46, 0.4, B.x2, 0.8),
		},
		edgeLines = {
			rect(B.x1, -13.2, -46, -12.8),
			rect(46, -13.2, B.x2, -12.8),
			rect(B.x1, 12.8, -46, 13.2),
			rect(46, 12.8, B.x2, 13.2),
			rect(-45, -39.2, 45, -38.8),
			rect(-45, 38.8, 45, 39.2),
			rect(-45.2, -39, -44.8, -13),
			rect(44.8, -39, 45.2, -13),
			rect(-45.2, 13, -44.8, 39),
			rect(44.8, 13, 45.2, 39),
		},
	}
	layout.islands = { { walk = rect(-30, -24, 30, 24), grass = rect(-27, -21, 27, 21) } }

	layout.paths = mirrorRects({
		rect(-95, -66, -87, -20), -- north front door
		rect(30, -112, 64, -104), -- north side door, east...
		rect(56, -112, 64, -20), -- ...then down to the road
		rect(10, -166, 18, -150), -- north kitchen door
		rect(0, -178, 28, -166), -- garden patch
	})

	local north = {
		bush(-130, -130, 4, "Green"),
		bush(-135, -88, 5, "Green"),
		bush(-125, -165, 4, "Orange"),
		bush(-136, -168, 5, "Green"),
		bush(-60, -168, 5, "Green"),
		bush(45, -168, 4, "Orange"),
		bush(95, -150, 6, "Green"),
		bush(134, -125, 5, "Orange"),
		bush(110, -62, 4, "Green"),
		bush(134, -168, 5, "Green"),
		bush(138, -82, 4, "Orange"),
		bush(-138, -112, 4, "Orange"),
		bush(-70, -40, 3, "Green"),
		bush(20, -56, 3, "Orange"),
	}
	for _, b in north do
		table.insert(layout.bushes, b)
		table.insert(layout.bushes, bush(-b.x, -b.z, b.r, if b.color == "Green" then "Orange" else "Green"))
	end

	layout.humanSpawns = mirrorPoints({
		pt(-132, -140),
		pt(-72, -172),
		pt(75, -172),
		pt(122, -150),
		pt(136, -45),
		pt(-136, -45),
		pt(-35, -56),
		pt(95, -95),
	})
	layout.zombieSpawns = { pt(-140, 0), pt(140, 0) }
	layout.start = pt(0, -32) -- on the road ring north of the island
	layout.wizardSpots = mirrorPoints({ pt(-108, -172), pt(136, -100), pt(-136, -150) })
	return layout
end

-- Mansion ----------------------------------------------------------------------------------

local function buildMansion(): Layout
	local layout = newLayout("Mansion", "The Mansion")
	layout.bounds = rect(-175, -148, 180, 186) -- brick wall just outside this
	local B = layout.bounds
	addHouse(layout, "Mansion", MANSION, -100, -40, false, "Blue", "Huge")
	addHouse(layout, "Shed", SHED, 110, -120, false, "Orange", "Small")

	layout.road = {
		sidewalks = { rect(B.x1, 142, B.x2, 182) },
		asphalt = { rect(B.x1, 148, B.x2, 176) },
		centerLines = { rect(B.x1, 161.4, B.x2, 161.8), rect(B.x1, 162.2, B.x2, 162.6) },
		edgeLines = { rect(B.x1, 149, B.x2, 149.4), rect(B.x1, 174.6, B.x2, 175) },
	}

	layout.paths = {
		rect(-4, 90, 4, 142), -- front door to the sidewalk
		rect(-150, 19, -100, 27), -- side door, west...
		rect(-150, 19, -142, 142), -- ...then down to the road
		rect(100, -111, 110, -103), -- patio to the shed door
		rect(124, -94, 132, -60), -- shed front door, north...
		rect(124, -60, 160, -52), -- ...and around to the yard
	}
	layout.patios = {
		rect(66, 90, 82, 142), -- driveway from the garage
		rect(-60, -110, 100, -50), -- pool deck behind the kitchen
		rect(68, -50, 76, -40), -- kitchen back door step
	}
	layout.pools = { rect(-40, -95, 40, -65) }

	layout.bushes = {
		bush(-150, -133, 6, "Green"),
		bush(-110, -136, 4, "Orange"),
		bush(-162, -90, 5, "Green"),
		bush(-163, -20, 4, "Orange"),
		bush(-163, 60, 5, "Green"),
		bush(-60, 125, 4, "Green"),
		bush(-30, 110, 3, "Orange"),
		bush(40, 112, 4, "Green"),
		bush(120, 120, 5, "Orange"),
		bush(160, 100, 4, "Green"),
		bush(167, 40, 5, "Green"),
		bush(168, -40, 4, "Orange"),
		bush(164, -133, 6, "Green"),
		bush(60, -136, 5, "Orange"),
		bush(-20, -136, 4, "Green"),
		bush(150, -138, 4, "Orange"),
	}

	layout.humanSpawns = {
		pt(-60, 116),
		pt(30, 128),
		pt(150, 125),
		pt(-162, 100),
		pt(-162, 30),
		pt(165, 70),
		pt(165, 5),
		pt(-162, -60),
		pt(165, -100),
		pt(-120, -138),
		pt(0, -135),
		pt(95, -136),
		pt(-80, 100),
		pt(110, 105),
	}
	layout.zombieSpawns = { pt(-165, 162), pt(170, 162) }
	layout.start = pt(0, 122) -- the front lawn
	layout.wizardSpots = { pt(-130, -128), pt(160, -20), pt(-160, 128), pt(40, -136) }
	return layout
end

MapLayout.maps = {
	Neighborhood = buildNeighborhood(),
	Mansion = buildMansion(),
} :: { [string]: Layout }
MapLayout.names = { "Neighborhood", "Mansion" }

local current: Layout = MapLayout.maps.Neighborhood

function MapLayout.current(): Layout
	return current
end

function MapLayout.get(name: string): Layout?
	return MapLayout.maps[name]
end

function MapLayout.use(name: string): Layout
	current = MapLayout.maps[name] or MapLayout.maps.Neighborhood
	return current
end

-- Derived geometry ------------------------------------------------------------------------

-- Splits a wall into solid pieces no longer than MAX_WALL_PIECE, skipping the
-- doorway gaps and splitting at window edges so each piece is fully a window
-- or fully plain wall.
function MapLayout.wallPieces(w: Wall): { WallPiece }
	local h = T / 2
	local a = (if w.horizontal then w.x1 else w.z1) - h
	local b = (if w.horizontal then w.x2 else w.z2) + h
	local across = if w.horizontal then w.z1 else w.x1

	local spans: { Range } = {}
	local cursor = a
	for _, gap in w.gaps do
		if gap[1] > cursor then
			table.insert(spans, { cursor, gap[1] })
		end
		cursor = math.max(cursor, gap[2])
	end
	if cursor < b then
		table.insert(spans, { cursor, b })
	end

	local cuts: { number } = {}
	for _, win in w.windows do
		table.insert(cuts, win[1])
		table.insert(cuts, win[2])
	end

	local pieces: { WallPiece } = {}
	for _, span in spans do
		local stops = { span[1] }
		for _, c in cuts do
			if c > span[1] + 0.01 and c < span[2] - 0.01 then
				table.insert(stops, c)
			end
		end
		table.insert(stops, span[2])
		table.sort(stops)
		for i = 1, #stops - 1 do
			local s, e = stops[i], stops[i + 1]
			local mid = (s + e) / 2
			local isWindow = false
			for _, win in w.windows do
				if mid > win[1] and mid < win[2] then
					isWindow = true
				end
			end
			local count = math.max(1, math.ceil((e - s) / MapLayout.MAX_WALL_PIECE - 0.001))
			local step = (e - s) / count
			for k = 0, count - 1 do
				local p1, p2 = s + step * k, s + step * (k + 1)
				local r = if w.horizontal
					then rect(p1, across - h, p2, across + h)
					else rect(across - h, p1, across + h, p2)
				table.insert(
					pieces,
					{ rect = r, window = isWindow, house = w.house, horizontal = w.horizontal }
				)
			end
		end
	end
	return pieces
end

function MapLayout.allWallPieces(layout: Layout): { WallPiece }
	local out = {}
	for _, w in layout.walls do
		for _, p in MapLayout.wallPieces(w) do
			table.insert(out, p)
		end
	end
	return out
end

-- Every doorway, at the center of its gap.
function MapLayout.doors(layout: Layout): { Door }
	local out = {}
	for _, w in layout.walls do
		local house: House? = nil
		for _, hs in layout.houses do
			if hs.id == w.house then
				house = hs
			end
		end
		for _, gap in w.gaps do
			local mid = (gap[1] + gap[2]) / 2
			local exterior = false
			if house then
				local r = house.rect
				exterior = if w.horizontal
					then (w.z1 == r.z1 or w.z1 == r.z2)
					else (w.x1 == r.x1 or w.x1 == r.x2)
			end
			table.insert(out, {
				x = if w.horizontal then mid else w.x1,
				z = if w.horizontal then w.z1 else mid,
				horizontal = w.horizontal,
				width = gap[2] - gap[1],
				house = w.house,
				exterior = exterior,
			})
		end
	end
	return out
end

function MapLayout.footprint(spot: FurnitureSpot, width: number, depth: number): Rect
	return rect(spot.x - width / 2, spot.z - depth / 2, spot.x + width / 2, spot.z + depth / 2)
end

-- The walkable inside of a room (wall centerlines pulled in by half a wall).
function MapLayout.roomInterior(r: Room): Rect
	local h = T / 2
	return rect(r.rect.x1 + h, r.rect.z1 + h, r.rect.x2 - h, r.rect.z2 - h)
end

-- Areas where grass decorations must not go.
function MapLayout.noDecorRects(layout: Layout): { Rect }
	local out: { Rect } = {}
	for _, hs in layout.houses do
		local r = hs.rect
		table.insert(out, rect(r.x1 - 3, r.z1 - 3, r.x2 + 3, r.z2 + 3))
	end
	for _, list in { layout.road.sidewalks, layout.paths, layout.patios, layout.pools } do
		for _, r in list do
			table.insert(out, r)
		end
	end
	for _, b in layout.bushes do
		table.insert(out, rect(b.x - b.r - 1, b.z - b.r - 1, b.x + b.r + 1, b.z + b.r + 1))
	end
	return out
end

function MapLayout.inRect(r: Rect, x: number, z: number, margin: number?): boolean
	local m = margin or 0
	return x >= r.x1 - m and x <= r.x2 + m and z >= r.z1 - m and z <= r.z2 + m
end

function MapLayout.rectsOverlap(a: Rect, b: Rect, margin: number?): boolean
	local m = margin or 0
	return a.x1 < b.x2 + m and b.x1 < a.x2 + m and a.z1 < b.z2 + m and b.z1 < a.z2 + m
end

return MapLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Parts</string>
          <string name="Source"><![CDATA[-- Part factory with Brain Tag's flat cartoon defaults: SmoothPlastic, no
-- shadows, smooth surfaces, anchored unless told otherwise.

export type PartProps = {
	name: string?,
	size: Vector3,
	cframe: CFrame,
	color: string | Color3,
	shape: Enum.PartType?,
	material: Enum.Material?,
	anchored: boolean?,
	canCollide: boolean?,
	canQuery: boolean?,
	transparency: number?,
	parent: Instance?,
}

local Parts = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> Y
local ALONG_Z = CFrame.Angles(0, math.rad(90), 0) -- cylinder axis X -> Z

Parts.UPRIGHT = UPRIGHT
Parts.ALONG_Z = ALONG_Z

local function toColor(c: string | Color3): Color3
	if typeof(c) == "Color3" then
		return c
	end
	return Color3.fromHex(c :: string)
end

function Parts.make(props: PartProps): Part
	local part = Instance.new("Part")
	part.Name = props.name or "Part"
	part.Shape = props.shape or Enum.PartType.Block
	part.Size = props.size
	part.CFrame = props.cframe
	part.Color = toColor(props.color)
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Anchored = props.anchored ~= false
	part.CanCollide = props.canCollide ~= false
	part.CanQuery = props.canQuery ~= false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Transparency = props.transparency or 0
	if props.parent then
		part.Parent = props.parent
	end
	return part
end

-- An upright cylinder, which reads as a circle from the top-down camera.
-- `center` is the middle of the cylinder.
function Parts.disc(
	name: string,
	center: Vector3,
	diameter: number,
	height: number,
	color: string | Color3,
	parent: Instance?
): Part
	return Parts.make({
		name = name,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(height, diameter, diameter),
		cframe = CFrame.new(center) * UPRIGHT,
		color = color,
		parent = parent,
	})
end

-- A flat slab covering a map rectangle, with its top surface at `topY`.
function Parts.slab(
	name: string,
	x1: number,
	z1: number,
	x2: number,
	z2: number,
	topY: number,
	thickness: number,
	color: string | Color3,
	parent: Instance?
): Part
	return Parts.make({
		name = name,
		size = Vector3.new(x2 - x1, thickness, z2 - z1),
		cframe = CFrame.new((x1 + x2) / 2, topY - thickness / 2, (z1 + z2) / 2),
		color = color,
		parent = parent,
	})
end

-- Turns a part into a weightless, non-colliding decoration of an assembly.
function Parts.makeVisual(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
end

-- Welds `part` to `base` at its current relative placement.
function Parts.weldInPlace(base: BasePart, part: BasePart): Weld
	local weld = Instance.new("Weld")
	weld.Name = "Weld"
	weld.Part0 = base
	weld.Part1 = part
	weld.C0 = base.CFrame:ToObjectSpace(part.CFrame)
	weld.Parent = part
	return weld
end

return Parts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Every RemoteEvent and RemoteFunction the game uses. The server creates them
-- at startup; clients wait for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	-- client -> server
	"UseItem", -- (action: "start" | "stop", aim: Vector3)
	"PickUp",
	"DropItem",
	"SelectSlot", -- (slot: number) which inventory slot is in your hand
	"ZombieReturn",
	"TutorialDone",
	-- server -> client
	"Knockback", -- (velocity: Vector3, seconds: number)
	"Announce", -- (text, hexColor?)
	"Fx", -- (kind, data)
	"Toast", -- (text, hexColor?)
}

-- Unreliable: frequent, small, fine to lose one now and then.
local UNRELIABLE = {
	"PushClaim", -- client -> server: { Model } of furniture it is pushing
	"Aim", -- client -> server: flat aim direction, about 10 times a second
}

local FUNCTIONS = {
	"BuyItem", -- (itemId, fromWizard) -> (ok, message)
	"BuySkin", -- (skinId) -> (status, message)
	"Admin", -- (action, data) -> (ok, message); admins only, see AdminService
}

local Remotes = {}

local folder: Instance
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	folder = existing or Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in UNRELIABLE do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("UnreliableRemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

function Remotes.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.unreliable(name: string): UnreliableRemoteEvent
	return folder:WaitForChild(name) :: UnreliableRemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">RoundRules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure round rules: who becomes a zombie, who won, and how much score a reward
-- is worth. No Roblox APIs, so tests/ can run this outside Studio.

local Config = require(script.Parent.Config)

local RoundRules = {}

-- How many first zombies to pick from `count` humans. Always leaves at least
-- one human so a round can't start already lost.
function RoundRules.firstZombieCount(count: number): number
	if count < 2 then
		return 0
	end
	local wanted = math.max(1, math.floor(count * Config.ZOMBIE_RATIO))
	return math.min(wanted, count - 1)
end

-- Weight for being picked as a first zombie. Never zero, so when everyone is
-- immune, pill-takers can still be chosen.
function RoundRules.zombieWeight(immunity: number): number
	local clamped = math.clamp(immunity, 0, Config.IMMUNITY_MAX)
	return 1 - clamped / Config.IMMUNITY_MAX * Config.IMMUNITY_WEIGHT
end

-- Weighted pick of `count` entries without replacement. `random` returns a
-- number in [0, 1).
function RoundRules.weightedPick<T>(
	entries: { T },
	weightOf: (T) -> number,
	count: number,
	random: () -> number
): { T }
	local pool = table.clone(entries)
	local picked = {}
	for _ = 1, math.min(count, #pool) do
		local total = 0
		for _, entry in pool do
			total += math.max(0, weightOf(entry))
		end
		local index = #pool
		if total <= 0 then
			index = math.clamp(math.floor(random() * #pool) + 1, 1, #pool)
		else
			local roll = random() * total
			for i, entry in pool do
				roll -= math.max(0, weightOf(entry))
				if roll < 0 then
					index = i
					break
				end
			end
		end
		table.insert(picked, table.remove(pool, index) :: T)
	end
	return picked
end

export type Winner = "Survivors" | "Zombies"

-- "Zombies" when no humans remain, "Survivors" when the timer ran out with any
-- human standing, otherwise nil (round continues).
function RoundRules.outcome(humans: number, secondsLeft: number): Winner?
	if humans <= 0 then
		return "Zombies"
	end
	if secondsLeft <= 0 then
		return "Survivors"
	end
	return nil
end

export type RewardBonuses = {
	drumstick: number?, -- 0.4 or 0.8 while holding one
	vip: boolean?,
	doubleScore: boolean?,
	boosted: boolean?,
}

-- Bonuses add together: a VIP holding a drumstick earns 1 + 0.4 + 0.2 = 1.6x.
function RoundRules.rewardMultiplier(bonuses: RewardBonuses): number
	local m = 1 + (bonuses.drumstick or 0)
	local money = Config.MONETIZATION
	if bonuses.vip then
		m += money.VIP_SCORE_BONUS
	end
	if bonuses.doubleScore then
		m += money.DOUBLE_SCORE_BONUS
	end
	if bonuses.boosted then
		m += money.BOOST_SCORE_BONUS
	end
	return m
end

function RoundRules.reward(base: number, bonuses: RewardBonuses): number
	return math.floor(base * RoundRules.rewardMultiplier(bonuses) + 0.5)
end

function RoundRules.scaleForScore(score: number): number
	return Config.SIZE_MULTIPLIER(score)
end

-- Pushing strength of one player: grows with the square of their size.
function RoundRules.pushStrength(scale: number): number
	return scale * scale
end

-- Fraction of walk speed a piece of `mass` moves at under `strength` (the
-- summed strength of everyone pushing it). 0 means it won't budge.
function RoundRules.pushFraction(mass: number, strength: number): number
	if strength <= 0 then
		return 0
	end
	return math.clamp(1 - mass / strength, 0, Config.PUSH_MAX_FRACTION)
end

function RoundRules.walkSpeed(score: number, isZombie: boolean): number
	local speed = Config.BASE_WALKSPEED * Config.SPEED_MULTIPLIER(score)
	if isZombie then
		speed *= Config.ZOMBIE_SPEED_FACTOR
	end
	return speed
end

return RoundRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Skins</string>
          <string name="Source"><![CDATA[--!strict
-- Cosmetic skins. Each one recolors the shirt, hair and face and can add a "hat"
-- (built from parts by CharacterLook). Unlock with score, Robux (developer
-- product key in Config.MONETIZATION.Products) or a game pass.

export type Team = "Human" | "Zombie"

export type Skin = {
	id: string,
	name: string,
	team: Team,
	shirt: string, -- body (hex color)
	hair: string, -- top of the head
	skin: string, -- the face crescent (and zombie arms)
	hat: string?, -- costume extras (CharacterLook STYLES or HATS)
	accent: string?, -- extra color some costumes use (ears, beak, plume...)
	scorePrice: number?,
	product: string?,
	pass: string?,
	default: boolean?,
	special: boolean?, -- given by the game (the alpha zombie), never sold or picked
	arms: string?, -- zombie forearms and hands (defaults to `skin`)
}

type Extra = {
	hat: string?,
	accent: string?,
	scorePrice: number?,
	product: string?,
	pass: string?,
	default: boolean?,
	special: boolean?,
	arms: string?,
}

local function skin(
	id: string,
	name: string,
	team: Team,
	shirt: string,
	hair: string,
	face: string,
	extra: Extra?
): Skin
	local e: Extra = extra or {}
	return {
		id = id,
		name = name,
		team = team,
		shirt = shirt,
		hair = hair,
		skin = face,
		hat = e.hat,
		accent = e.accent,
		scorePrice = e.scorePrice,
		product = e.product,
		pass = e.pass,
		default = e.default,
		special = e.special,
		arms = e.arms,
	}
end

local list: { Skin } = {
	-- Humans (Classic matches the original: tan shirt, brown hair, peach face)
	skin("Classic", "Classic", "Human", "C98B52", "A8743F", "F6C79A", { default = true }),
	skin("Chef", "Chef", "Human", "F2F2F2", "A8743F", "F6C79A", { hat = "ChefHat", scorePrice = 3000 }),
	skin("Ninja", "Ninja", "Human", "2E2E34", "1C1C20", "F6C79A", { hat = "Headband", scorePrice = 6000 }),
	skin("Pumpkin", "Pumpkin", "Human", "3F7F3A", "F08A24", "FFC36B", { hat = "Stem", scorePrice = 12000 }),
	skin("Duck", "Duck", "Human", "FFD93B", "FFE36A", "FFF3B0", { hat = "Bill", product = "SkinDuck" }),
	skin(
		"Astronaut",
		"Astronaut",
		"Human",
		"E8ECF2",
		"F7F9FC",
		"9FD8F5",
		{ hat = "Visor", product = "SkinAstronaut" }
	),
	skin("Royal", "Royal", "Human", "7B2CBF", "A8743F", "F6C79A", { hat = "Crown", pass = "VIP" }),
	skin(
		"Dog",
		"Dog",
		"Human",
		"C8955A",
		"B07A45",
		"E8C9A0",
		{ hat = "Dog", accent = "6B4226", product = "SkinDog" }
	),
	skin(
		"Cat",
		"Cat",
		"Human",
		"8E8E93",
		"A5A5AA",
		"F2F2F2",
		{ hat = "Cat", accent = "6E6E73", scorePrice = 8000 }
	),
	skin(
		"Bunny",
		"Bunny",
		"Human",
		"F4F4F4",
		"FFFFFF",
		"FFD6E0",
		{ hat = "Bunny", accent = "FFB3C7", scorePrice = 10000 }
	),
	skin(
		"Bear",
		"Bear",
		"Human",
		"8B5A2B",
		"7A4A22",
		"C8955A",
		{ hat = "Bear", accent = "5A3518", scorePrice = 7000 }
	),
	skin(
		"Panda",
		"Panda",
		"Human",
		"F4F4F4",
		"F4F4F4",
		"F4F4F4",
		{ hat = "Panda", accent = "1C1C1C", product = "SkinPanda" }
	),
	skin(
		"Frog",
		"Frog",
		"Human",
		"4CAF50",
		"5BBF5E",
		"A5D6A7",
		{ hat = "Frog", accent = "2E7D32", scorePrice = 9000 }
	),
	skin(
		"Penguin",
		"Penguin",
		"Human",
		"1C1C24",
		"1C1C24",
		"F4F4F4",
		{ hat = "Penguin", accent = "F39C12", scorePrice = 11000 }
	),
	skin(
		"Robot",
		"Robot",
		"Human",
		"95A5A6",
		"B0BEC5",
		"CFD8DC",
		{ hat = "Robot", accent = "00E5FF", product = "SkinRobot" }
	),
	skin("Pirate", "Pirate", "Human", "C0392B", "5A3A22", "F6C79A", { hat = "Pirate", scorePrice = 15000 }),
	skin(
		"Cowboy",
		"Cowboy",
		"Human",
		"D35400",
		"6B4226",
		"F6C79A",
		{ hat = "Cowboy", accent = "8B5A2B", scorePrice = 14000 }
	),
	skin(
		"Alien",
		"Alien",
		"Human",
		"7F8C8D",
		"8BC34A",
		"AED581",
		{ hat = "Alien", accent = "1C1C1C", product = "SkinAlien" }
	),
	skin(
		"Knight",
		"Knight",
		"Human",
		"7F8C8D",
		"BDC3C7",
		"F6C79A",
		{ hat = "Knight", accent = "C0392B", scorePrice = 20000 }
	),
	skin(
		"Shark",
		"Shark",
		"Human",
		"5D7B93",
		"6E8CA5",
		"F4F4F4",
		{ hat = "Shark", accent = "4A6378", product = "SkinShark" }
	),
	-- A guy with the classic awesome face on top of his head.
	skin(
		"Awesome",
		"Awesome Guy",
		"Human",
		"2F80ED",
		"FFCF1F",
		"FFCF1F",
		{ hat = "Awesome", accent = "7A1F45", product = "SkinAwesome" }
	),

	skin(
		"Donkey",
		"Donkey",
		"Human",
		"6E625A",
		"5E534C",
		"8C8079",
		{ hat = "Donkey", accent = "3F3631", scorePrice = 9500 }
	),

	-- Zombies: everyone looks the same, except the alpha.
	skin("ClassicZombie", "Classic", "Zombie", "6B8F5A", "4C6B33", "9CCB5A", { default = true }),
	-- The first zombies of each round: orange with red blotches, a gray head
	-- and red arms.
	skin("Alpha", "Alpha Zombie", "Zombie", "E39B4F", "5E5E63", "8A8A90", {
		hat = "Alpha",
		accent = "B8323A",
		arms = "C0453F",
		special = true,
	}),
}

local byId: { [string]: Skin } = {}
for _, skin in list do
	byId[skin.id] = skin
end

local Skins = {
	list = list,
	DEFAULT_HUMAN = "Classic",
	DEFAULT_ZOMBIE = "ClassicZombie",
}

function Skins.get(id: string?): Skin?
	if id == nil then
		return nil
	end
	return byId[id]
end

-- The skin to show for a team, falling back to the default when the chosen
-- one is missing or belongs to the other team.
function Skins.resolve(id: string?, team: Team): Skin
	local skin = Skins.get(id)
	if skin and skin.team == team then
		return skin
	end
	return byId[if team == "Zombie" then Skins.DEFAULT_ZOMBIE else Skins.DEFAULT_HUMAN]
end

function Skins.forTeam(team: Team): { Skin }
	local result = {}
	for _, skin in list do
		if skin.team == team and not skin.special then
			table.insert(result, skin)
		end
	end
	return result
end

return Skins
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Small helpers shared by server and client.

local Util = {}

function Util.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Unit vector on the ground plane, or nil when there is no horizontal part.
function Util.flatUnit(v: Vector3): Vector3?
	local f = Vector3.new(v.X, 0, v.Z)
	local m = f.Magnitude
	-- `m ~= m` catches NaN; huge catches infinity (both can come from exploiters).
	if m ~= m or m == math.huge or m < 1e-4 then
		return nil
	end
	return f.Unit
end

function Util.flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

function Util.color(hex: string): Color3
	return Color3.fromHex(hex)
end

-- 6729 -> "6,729"
function Util.commas(n: number): string
	local s = tostring(math.floor(n))
	local sign = ""
	if string.sub(s, 1, 1) == "-" then
		sign, s = "-", string.sub(s, 2)
	end
	local out = s
	while true do
		local replaced, count = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if count == 0 then
			break
		end
	end
	return sign .. out
end

-- 151 -> "2:31"
function Util.clock(seconds: number): string
	local s = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", s // 60, s % 60)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- The admin panel's server side. Every request is checked here: only admins
-- (Studio testers, the experience owner, Config.ADMIN_USER_IDS) get through,
-- and every argument is validated before it touches the game.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RoundManager = require(script.Parent.RoundManager)
local ShopService = require(script.Parent.ShopService)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local AdminService = {}

local MAX_SPEED_FACTOR = 5
local C = Config.CHARACTER

-- Where to stand someone of `scale` at a spot, feet on the floor (like spawns).
local function standAt(position: Vector3, scale: number): CFrame
	local y = MapLayout.HEIGHTS.Floor + C.HipHeight + C.RootHeight / 2 * scale + 0.3
	return CFrame.new(position.X, y, position.Z)
end
local MAX_POINTS = 10_000_000

function AdminService.isAdmin(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	if table.find(Config.ADMIN_USER_IDS, player.UserId) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank >= 254
end

-- "*" means everyone; otherwise one participant id.
local function targets(data: { [string]: any }): { Participant }
	local id = data.target
	if id == "*" then
		return Participants.all()
	end
	local p = if typeof(id) == "string" then Participants.get(id) else nil
	return if p then { p } else {}
end

local function number(value: any, low: number, high: number): number?
	if typeof(value) ~= "number" or value ~= value then
		return nil
	end
	return math.clamp(value, low, high)
end

local function names(list: { Participant }): string
	if #list == 1 then
		return list[1].name
	end
	return #list .. " players"
end

type Handler = (admin: Participant, data: { [string]: any }) -> (boolean, string)

local ACTIONS: { [string]: Handler } = {}

-- Items ---------------------------------------------------------------------------------

function ACTIONS.give(admin, data)
	local item = Items.get(if typeof(data.item) == "string" then data.item else nil)
	if not item then
		return false, "Unknown item"
	end
	if data.ground == true then
		local root = Participants.body(admin)
		if not root then
			return false, "You need a character to drop items"
		end
		ItemService.spawnGround(item.id, root.Position + root.CFrame.LookVector * 5)
		return true, item.name .. " dropped in front of you"
	end
	local list = targets(data)
	local given = 0
	for _, p in list do
		if p.team == "Human" then
			ItemService.give(p, item.id)
			given += 1
		end
	end
	if given == 0 then
		return false, "Only humans can hold items"
	end
	return true, string.format("Gave %s to %s", item.name, names(list))
end

-- Skins ---------------------------------------------------------------------------------

function ACTIONS.skin(_admin, data)
	local skin = Skins.get(if typeof(data.skin) == "string" then data.skin else nil)
	if not skin then
		return false, "Unknown skin"
	end
	local list = targets(data)
	for _, p in list do
		ShopService.grantSkin(p, skin.id) -- theirs to keep
		ShopService.equipSkin(p, skin)
	end
	return #list > 0, string.format("%s skin for %s", skin.name, names(list))
end

-- Players -------------------------------------------------------------------------------

function ACTIONS.speed(_admin, data)
	local factor = number(data.factor, 0, MAX_SPEED_FACTOR)
	if not factor then
		return false, "Bad speed"
	end
	local list = targets(data)
	for _, p in list do
		p.adminSpeed = factor
		CharacterService.refreshSpeed(p)
	end
	return #list > 0, string.format("Speed x%.2g for %s", factor, names(list))
end

function ACTIONS.points(_admin, data)
	local add = number(data.add, -MAX_POINTS, MAX_POINTS)
	local set = number(data.set, 0, MAX_POINTS)
	if not add and not set then
		return false, "Bad points"
	end
	local list = targets(data)
	for _, p in list do
		Participants.setScore(p, if set then set else p.score + (add or 0))
		CharacterService.refreshSize(p)
		CharacterService.refreshSpeed(p)
	end
	local what = if set then "set to " .. Util.commas(set) else string.format("%+d", add or 0)
	return #list > 0, string.format("Points %s for %s", what, names(list))
end

function ACTIONS.immunity(_admin, data)
	local value = number(data.value, 0, Config.IMMUNITY_MAX)
	if not value then
		return false, "Bad immunity"
	end
	local list = targets(data)
	for _, p in list do
		Participants.setImmunity(p, value)
	end
	return #list > 0, string.format("Immunity %d for %s", value, names(list))
end

function ACTIONS.team(_admin, data)
	local team = data.team
	if team ~= "Human" and team ~= "Zombie" then
		return false, "Bad team"
	end
	local list = targets(data)
	for _, p in list do
		RoundManager.setTeam(p, team)
	end
	return #list > 0, string.format("%s now %s", names(list), if team == "Zombie" then "zombie" else "human")
end

function ACTIONS.bring(admin, data)
	local root = Participants.body(admin)
	if not root then
		return false, "You need a character"
	end
	local list = targets(data)
	for i, p in list do
		if p ~= admin then
			local angle = i / math.max(1, #list) * math.pi * 2
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * 6
			CharacterService.place(p, standAt(root.Position + offset * math.max(1, p.scale), p.scale))
		end
	end
	return #list > 0, "Brought " .. names(list)
end

function ACTIONS.goTo(admin, data)
	local list = targets(data)
	local target = list[1]
	local root = target and Participants.body(target)
	if not target or target == admin or not root then
		return false, "Pick one other player"
	end
	CharacterService.place(
		admin,
		standAt(root.Position + Vector3.new(6 * math.max(1, target.scale), 0, 0), admin.scale)
	)
	return true, "Went to " .. target.name
end

function ACTIONS.respawn(_admin, data)
	local list = targets(data)
	for _, p in list do
		RoundManager.respawn(p)
	end
	return #list > 0, "Respawned " .. names(list)
end

-- Round ---------------------------------------------------------------------------------

function ACTIONS.skip()
	if RoundManager.skipPhase() then
		return true, "Skipped to the next phase"
	end
	return false, "Nothing to skip right now"
end

function ACTIONS.time(_admin, data)
	local seconds = number(data.seconds, -600, 600)
	if not seconds then
		return false, "Bad time"
	end
	if RoundManager.addTime(seconds) then
		return true, string.format("%+d seconds", seconds)
	end
	return false, "No timer to change right now"
end

function ACTIONS.nextMap()
	if RoundManager.queueNextMap() then
		return true, "Next round loads the next map"
	end
	return false, "Only one map is in the rotation"
end

function ACTIONS.resetFurniture()
	FurnitureService.resetAll()
	return true, "Furniture put back"
end

function ACTIONS.clearItems()
	ItemService.clearGround()
	return true, "Ground items removed"
end

local function handle(player: Player, action: unknown, data: unknown): (boolean, string)
	if not AdminService.isAdmin(player) then
		return false, "Not an admin"
	end
	local admin = Participants.fromPlayer(player)
	local handler = if typeof(action) == "string" then ACTIONS[action] else nil
	if not admin or not handler then
		return false, "Unknown command"
	end
	local args: { [string]: any } = if typeof(data) == "table" then data :: any else {}
	local ok, success, message = pcall(handler, admin, args)
	if not ok then
		warn("[Admin] " .. tostring(action) .. " failed: " .. tostring(success))
		return false, "That failed (see server output)"
	end
	return success, message
end

function AdminService.init()
	Remotes.func("Admin").OnServerInvoke = handle
	Participants.onAdded(function(p)
		if p.player and AdminService.isAdmin(p.player) then
			p.state:SetAttribute("Admin", true)
		end
	end)
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Announcer</string>
          <string name="Source"><![CDATA[-- Server -> client messages: yellow system lines in chat, short on-screen
-- toasts, and visual/sound effects that every client plays locally.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Announcer = {}

local announce = Remotes.event("Announce")
local toast = Remotes.event("Toast")
local fx = Remotes.event("Fx")

function Announcer.chat(text: string, hex: string?)
	announce:FireAllClients(text, hex or Config.COLORS.SystemMessage)
end

function Announcer.toast(player: Player?, text: string, hex: string?)
	if player then
		toast:FireClient(player, text, hex)
	else
		toast:FireAllClients(text, hex)
	end
end

function Announcer.fx(kind: string, data: { [string]: any })
	fx:FireAllClients(kind, data)
end

return Announcer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- Bots that fill every round (Config.BOTS_MIN to BOTS_MAX of them, fewer
-- when real players join). They count as participants for every rule and
-- wear random skins. Each has a level from 3 to 6; Mario Robles is a 6 and
-- most of the roster is 5 or 6:
--   * zombies spread out over different humans, lead their target, and
--     remember where a human hid. A human they can't reach (barricaded in)
--     draws a crowd: the pack picks one door, lines up outside it and
--     shoves through together (pushers in a line add their strength)
--   * humans grab the odd item (some start with one), hold weapons out
--     toward close zombies (weapons are solid; a few can swing), flee
--     toward open ground away from every zombie, and hide in bushes
-- Movement never aims through walls: straight lines are checked with a
-- body-wide sweep, everything else uses pathfinding, and a bot that stops
-- making progress steps sideways and replans.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Bushes = require(ReplicatedStorage.Shared.Bushes)
local BushService = require(script.Parent.BushService)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local Config = require(ReplicatedStorage.Shared.Config)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local RoundManager = require(script.Parent.RoundManager)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local BotService = {}

type Level = {
	think: number, -- seconds between decisions
	speed: number, -- walk speed multiplier
	sight: number, -- zombie: how far away it notices humans
	lead: number, -- zombie: seconds of target movement it predicts
	memory: number, -- zombie: seconds it keeps hunting where a human vanished
	stuck: number, -- zombie: seconds without progress before pressing Z
	flee: number, -- human: zombie distance that starts a run
	directions: number, -- human: escape directions considered
	hide: number, -- human: chance to be a bush hider
}

local LEVELS: { [number]: Level } = {
	[3] = {
		think = 0.25,
		speed = 1,
		sight = 120,
		lead = 0.4,
		memory = 3,
		stuck = 5,
		flee = 45,
		directions = 8,
		hide = 0.35,
	},
	[4] = {
		think = 0.18,
		speed = 1.02,
		sight = 200,
		lead = 0.55,
		memory = 5,
		stuck = 4,
		flee = 55,
		directions = 10,
		hide = 0.45,
	},
	[5] = {
		think = 0.14,
		speed = 1.05,
		sight = 400,
		lead = 0.7,
		memory = 7,
		stuck = 3,
		flee = 65,
		directions = 12,
		hide = 0.5,
	},
	[6] = {
		think = 0.11,
		speed = 1.08,
		sight = 600,
		lead = 0.8,
		memory = 9,
		stuck = 2.5,
		flee = 75,
		directions = 12,
		hide = 0.55,
	},
}

-- Name and level. Bots join in this order.
local ROSTER: { { name: string, level: number } } = {
	{ name = "Mario Robles", level = 6 },
	{ name = "Fart Butt", level = 5 },
	{ name = "Poop Face", level = 5 },
	{ name = "Fat Guy", level = 4 },
	{ name = "Booger Bob", level = 6 },
	{ name = "Stinky Pete", level = 5 },
	{ name = "Captain Wedgie", level = 4 },
	{ name = "Toilet Ted", level = 3 },
	{ name = "Sir Toots-a-Lot", level = 6 },
	{ name = "Sweaty Steve", level = 5 },
	{ name = "Moldy Cheese", level = 4 },
	{ name = "Burp Master", level = 5 },
	{ name = "Snot Rocket", level = 6 },
	{ name = "Diaper Dan", level = 3 },
	{ name = "Barf Bag", level = 5 },
	{ name = "Lord Stinkbottom", level = 6 },
	{ name = "Cheesy Feet", level = 4 },
	{ name = "Greasy Gary", level = 5 },
	{ name = "Wet Sock", level = 3 },
	{ name = "Professor Poot", level = 6 },
	{ name = "Nacho Breath", level = 4 },
	{ name = "Big Nose Ned", level = 5 },
	{ name = "Soggy Waffle", level = 3 },
	{ name = "Chunky Monkey", level = 4 },
	{ name = "Gassy Gus", level = 5 },
	{ name = "Pickle Pants", level = 4 },
	{ name = "Smelly Kelly", level = 5 },
	{ name = "Belly Flop Bob", level = 3 },
	{ name = "Turbo Toot", level = 6 },
	{ name = "Stinkerbell", level = 5 },
}

-- Cheap, common weapons a bot may start a round with (never rare ones).
local STARTER_WEAPONS = { "Stick", "RubberChicken", "PoolNoodle", "Bat", "Baguette" }

local rng = Random.new()

-- Shared view of the world, refreshed at most 10 times a second -------------------------

type Seen = { p: Participant, position: Vector3, velocity: Vector3, hidden: boolean }

local seenAt = 0
local seenHumans: { Seen } = {}
local seenZombies: { Seen } = {}
local chasing: { [string]: Participant } = {} -- bot id -> the human it hunts

local function look()
	local now = os.clock()
	if now - seenAt < 0.1 then
		return
	end
	seenAt = now
	table.clear(seenHumans)
	table.clear(seenZombies)
	for _, p in Participants.all() do
		local root = Participants.body(p)
		if root then
			local entry = {
				p = p,
				position = root.Position,
				velocity = Util.flat(root.AssemblyLinearVelocity),
				hidden = BushService.hidden(p),
			}
			table.insert(if p.team == "Zombie" then seenZombies else seenHumans, entry)
		end
	end
end

-- Barricades ---------------------------------------------------------------------------
-- A human the zombies can't reach is "fortified" for a few seconds: zombies
-- rally on them instead of spreading out, and break in through one door.
local fortified: { [Participant]: number } = setmetatable({}, { __mode = "k" }) :: any -- human -> until
local sieging: { [string]: { [string]: number } } = {} -- door -> bot id -> last push
local leaning: { [Participant]: number } = setmetatable({}, { __mode = "k" }) :: any -- bot -> last shove
local doorsOf = ""
local doorList: { MapLayout.Door } = {}

local function doors(): { MapLayout.Door }
	local layout = MapLayout.current()
	if doorsOf ~= layout.name then
		doorsOf = layout.name
		doorList = MapLayout.doors(layout)
		table.clear(sieging)
	end
	return doorList
end

local function doorKey(door: MapLayout.Door): string
	return string.format("%d,%d", math.floor(door.x + 0.5), math.floor(door.z + 0.5))
end

-- Unit vector across a door, toward the side `toward` is on.
local function across(door: MapLayout.Door, toward: Vector3): Vector3
	if door.horizontal then
		return Vector3.new(0, 0, if toward.Z >= door.z then 1 else -1)
	end
	return Vector3.new(if toward.X >= door.x then 1 else -1, 0, 0)
end

-- Zombies pushing on this door right now.
local function pushingDoor(key: string, now: number): number
	local count = 0
	local pushers: { [string]: number } = sieging[key] or {}
	for _, seen in pushers do
		if now - seen < 1 then
			count += 1
		end
	end
	return count
end

local function chasers(target: Participant, except: string): number
	local count = 0
	for id, p in chasing do
		if p == target and id ~= except then
			count += 1
		end
	end
	return count
end

-- Pathfinding is the expensive part: share a budget across all bots.
local PATHS_PER_SECOND = 30
local tokens, tokensAt = PATHS_PER_SECOND, os.clock()

local function takePathToken(): boolean
	local now = os.clock()
	tokens = math.min(PATHS_PER_SECOND, tokens + (now - tokensAt) * PATHS_PER_SECOND)
	tokensAt = now
	if tokens >= 1 then
		tokens -= 1
		return true
	end
	return false
end

local function inBounds(v: Vector3, margin: number): boolean
	return MapLayout.inRect(MapLayout.current().bounds, v.X, v.Z, -margin)
end

local function randomSpot(): Vector3
	local layout = MapLayout.current()
	local list = if rng:NextNumber() < 0.6 then layout.itemSpots else layout.humanSpawns
	local spot = list[rng:NextInteger(1, #list)]
	return Vector3.new(spot.x, 2, spot.z)
end

local function nearestBush(from: Vector3, range: number): Vector3?
	local best: Vector3? = nil
	local bestDistance = range
	for _, leaves in Bushes.leaves() do
		local d = Util.flatDistance(leaves.Position, from)
		if d < bestDistance then
			best, bestDistance = Vector3.new(leaves.Position.X, from.Y, leaves.Position.Z), d
		end
	end
	return best
end

local function nearestItem(from: Vector3, range: number): Vector3?
	local folder = workspace:FindFirstChild("GroundItems")
	if not folder then
		return nil
	end
	local best: Vector3? = nil
	local bestDistance = range
	for _, model in folder:GetChildren() do
		local x, z = model:GetAttribute("SpotX"), model:GetAttribute("SpotZ")
		local item = Items.get(model:GetAttribute("ItemId") :: string?)
		-- Bots leave the good stuff for players: only cheap, common items.
		local common = item ~= nil
			and not item.isRare
			and (item.price or math.huge) <= Config.BOT_MAX_ITEM_PRICE
		if common and typeof(x) == "number" and typeof(z) == "number" then
			local spot = Vector3.new(x, from.Y, z)
			local d = Util.flatDistance(spot, from)
			if d < bestDistance then
				best, bestDistance = spot, d
			end
		end
	end
	return best
end

-- Can a zombie at `from` see this human?
local function visible(entry: Seen, from: Vector3): boolean
	return not entry.hidden or Util.flatDistance(entry.position, from) <= Config.BUSH_REVEAL_DISTANCE
end

-- One bot ---------------------------------------------------------------------------------

local function brain(p: Participant, level: Level, seed: number)
	local random = Random.new(seed)
	local pathScale = 0
	local path: Path? = nil
	local waypoints: { PathWaypoint } = {}
	local waypointIndex = 1
	local pathGoal: Vector3? = nil
	local computedAt = 0
	local wanderGoal: Vector3? = nil
	local wanderUntil = 0
	local progressAt = os.clock()
	local progressFrom = Vector3.zero
	local detour: Vector3? = nil
	local detourUntil = 0
	local lastSeen: Vector3? = nil
	local lastSeenAt = 0
	local armedRound = -1
	local hider = random:NextNumber() < level.hide
	local pathFailed = false -- the last path asked for doesn't reach its goal
	local leanFrom = 0 -- when we started leaning on furniture that won't give
	type Siege = {
		door: MapLayout.Door,
		key: string,
		across: Vector3, -- unit, from outside the door toward the human
		center: Vector3,
		goal: Vector3,
		committed: boolean,
		startedAt: number,
		movedAt: number,
		from: Vector3,
	}
	local siege: Siege? = nil
	local badDoors: { [string]: number } = {} -- doors that wouldn't give -> until

	local function radius(): number
		return 0.9 * p.scale
	end

	-- A short step in the open direction closest to `toward` (unsticking).
	local function sidestep(root: BasePart, toward: Vector3): Vector3?
		local want = Util.flatUnit(toward - root.Position) or Vector3.xAxis
		local best: Vector3? = nil
		local bestScore = -math.huge
		for i = 0, 7 do
			local angle = i / 8 * math.pi * 2 + random:NextNumber(-0.2, 0.2)
			local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
			local spot = root.Position + dir * 7
			if inBounds(spot, 3) and Combat.clearWide(root.Position, spot, radius()) then
				local score = dir:Dot(want) + random:NextNumber(0, 0.6)
				if score > bestScore then
					best, bestScore = spot, score
				end
			end
		end
		return best
	end

	local function followPath(goal: Vector3, root: BasePart, humanoid: Humanoid, pushThrough: boolean)
		local now = os.clock()
		if not path or math.abs(p.scale - pathScale) > 0.2 then
			pathScale = p.scale
			path = PathfindingService:CreatePath({
				AgentRadius = 1.4 * p.scale,
				AgentHeight = 4,
				AgentCanJump = false,
				WaypointSpacing = 4,
			})
			pathGoal = nil
		end
		local stale = not pathGoal or now - computedAt > 1.2 or (goal - (pathGoal :: Vector3)).Magnitude > 6
		if stale and takePathToken() then
			pathGoal, computedAt = goal, now
			local ok = pcall(function()
				(path :: Path):ComputeAsync(root.Position, goal)
			end)
			if ok and (path :: Path).Status == Enum.PathStatus.Success then
				waypoints = (path :: Path):GetWaypoints()
				waypointIndex = math.min(2, #waypoints)
				pathFailed = false
			else
				waypoints = {}
				pathFailed = true
			end
		end
		-- Skip ahead to the farthest waypoint we can walk straight to.
		local ahead = math.min(#waypoints, waypointIndex + 4)
		while ahead > waypointIndex do
			if Combat.clearWide(root.Position, waypoints[ahead].Position, radius()) then
				waypointIndex = ahead
				break
			end
			ahead -= 1
		end
		local waypoint = waypoints[waypointIndex]
		if
			waypoint
			and Util.flatDistance(waypoint.Position, root.Position) < 2
			and waypointIndex < #waypoints
		then
			waypointIndex += 1
			waypoint = waypoints[waypointIndex]
		end
		if waypoint then
			humanoid:MoveTo(waypoint.Position)
		elseif pushThrough and Combat.clearWide(root.Position, goal, radius(), true) then
			humanoid:MoveTo(goal) -- only furniture in the way: shove through it
		else
			local step = sidestep(root, goal)
			if step then
				humanoid:MoveTo(step)
			end
		end
	end

	-- Straight there when the way is open for our whole body, else a path.
	local function goTo(goal: Vector3, root: BasePart, humanoid: Humanoid, pushThrough: boolean)
		local now = os.clock()
		if detour and now < detourUntil then
			humanoid:MoveTo(detour)
			return
		end
		detour = nil
		local distance = Util.flatDistance(goal, root.Position)
		if distance < 45 and Combat.clearWide(root.Position, goal, radius()) then
			humanoid:MoveTo(goal)
			pathGoal = nil
		elseif pushThrough and distance < 18 and Combat.clearWide(root.Position, goal, radius(), true) then
			humanoid:MoveTo(goal) -- a barricade, not a wall: lean on it
		else
			followPath(goal, root, humanoid, pushThrough)
		end
	end

	-- Leaning on something that can give: furniture right where we're
	-- walking (in reach of body or arms), or the back of another zombie
	-- that is leaning on something (a queue: our strength adds to theirs).
	local function leaningOn(root: BasePart, humanoid: Humanoid): boolean
		local dir = Util.flatUnit(humanoid.MoveDirection)
		if not dir then
			return false
		end
		local probe, size = FurniturePush.moverProbe(root, dir, p.scale)
		if #FurnitureService.findInBox(probe, size + Vector3.new(0, 0, 1.5 * p.scale)) > 0 then
			return true
		end
		local now = os.clock()
		for _, entry in seenZombies do
			if entry.p ~= p and now - (leaning[entry.p] or 0) < 1 then
				local rel = Util.flat(entry.position - root.Position)
				local along = rel:Dot(dir)
				if along > 0.5 and along < 4 * p.scale and (rel - dir * along).Magnitude < 2.5 * p.scale then
					return true
				end
			end
		end
		return false
	end

	-- No progress for a moment while trying to move: step aside, then
	-- replan. A zombie leaning on furniture keeps shoving for a while
	-- instead (the others are on their way to help).
	local function checkProgress(root: BasePart, goal: Vector3?, humanoid: Humanoid)
		local now = os.clock()
		if (root.Position - progressFrom).Magnitude > 1.2 then
			progressFrom, progressAt = root.Position, now
			leanFrom = 0
			return
		end
		if goal and now - progressAt > 0.9 and not (detour and now < detourUntil) then
			if p.team == "Zombie" and leaningOn(root, humanoid) then
				if leanFrom == 0 then
					leanFrom = now
				end
				if now - leanFrom < 6 then
					progressAt = now
					leaning[p] = now
					local target = chasing[p.id]
					if target then
						fortified[target] = now + 8
					end
					return
				end
			end
			leanFrom = 0
			detour = sidestep(root, goal)
			detourUntil = now + 0.7
			pathGoal = nil
			progressAt = now
		end
	end

	-- Breaking in. When no path reaches `goal` and walls stand between us,
	-- furniture is blocking every way in: walk to just outside the door
	-- closest to it (the door the other zombies already use, if any), then
	-- shove straight through. Returns false when there's nothing to break.
	local function breach(goal: Vector3, root: BasePart, humanoid: Humanoid): boolean
		local now = os.clock()
		local here = root.Position
		local r = radius()
		local s = siege
		if s and Util.flatDistance(s.goal, goal) > 15 then
			s = nil
		end
		if not s then
			local failed = pathFailed
				and pathGoal ~= nil
				and Util.flatDistance(pathGoal :: Vector3, goal) < 10
			if not failed or Combat.clearWide(here, goal, r, true) then
				siege = nil
				return false
			end
			local best: MapLayout.Door? = nil
			local bestScore = math.huge
			for _, door in doors() do
				local key = doorKey(door)
				if (badDoors[key] or 0) > now or door.width < r * 2 + 0.6 then
					continue
				end
				local center = Vector3.new(door.x, here.Y, door.z)
				local d = Util.flatDistance(center, goal)
				if d > 70 then
					continue
				end
				local n = across(door, goal)
				if not Combat.clearWide(center + n * 2.5, goal, r * 0.8, true) then
					continue -- this door doesn't lead to them
				end
				local outside = center - n * (4 + r)
				local score = d + 0.5 * Util.flatDistance(outside, here) - 12 * pushingDoor(key, now)
				if score < bestScore then
					best, bestScore = door, score
				end
			end
			if not best then
				return false
			end
			s = {
				door = best,
				key = doorKey(best),
				across = across(best, goal),
				center = Vector3.new(best.x, here.Y, best.z),
				goal = goal,
				committed = false,
				startedAt = now,
				movedAt = now,
				from = here,
			}
		end
		assert(s, "siege")
		siege = s
		s.goal = goal
		local target = chasing[p.id]
		if target then
			fortified[target] = now + 8
		end

		local rel = Util.flat(here - s.center)
		local into = rel:Dot(s.across)
		local side = (rel - s.across * into).Magnitude
		if into > 1 + r and into < 10 and side < s.door.width / 2 + 2 then
			siege = nil -- through the door: go get them
			return false
		end
		if not s.committed then
			local outside = s.center - s.across * (4 + r)
			-- Close enough to join the line (zombies already queued there are
			-- in the way of the exact spot): lean in behind them.
			local near = Util.flatDistance(outside, here) < 8 + 2 * r
				or (into > -(5 + r) and into < 1 and side < s.door.width / 2)
			if near and Combat.clearWide(here, s.center, r * 0.8, true) then
				s.committed, s.movedAt, s.from = true, now, here
			else
				goTo(outside, root, humanoid, true)
				checkProgress(root, outside, humanoid)
				if now - s.startedAt > 20 then
					badDoors[s.key] = now + 10 -- can't get to that door
					siege = nil
				end
				return true
			end
		end
		-- Lined up: lean straight in through the doorway, no sidestepping.
		local pushers = sieging[s.key] or {}
		sieging[s.key] = pushers
		pushers[p.id] = now
		leaning[p] = now
		detour = nil
		humanoid:MoveTo(s.center + s.across * (5 + r))
		progressAt = now
		if (here - s.from).Magnitude > 1 then
			s.from, s.movedAt = here, now
		end
		if now - s.movedAt > 8 then
			badDoors[s.key] = now + 12 -- it won't give: try another way
			siege = nil
		end
		return true
	end

	local function face(root: BasePart, humanoid: Humanoid, direction: Vector3?)
		if direction then
			humanoid.AutoRotate = false
			root.CFrame = CFrame.lookAt(root.Position, root.Position + direction)
			p.aim = direction
		else
			humanoid.AutoRotate = true
			local facing = Util.flatUnit(root.CFrame.LookVector)
			if facing then
				p.aim = facing
			end
		end
	end

	while Participants.get(p.id) == p do
		task.wait(level.think * random:NextNumber(0.85, 1.15))
		local root, humanoid = Participants.body(p)
		if not root or not humanoid then
			continue
		end
		look()
		local now = os.clock()
		local here = root.Position
		local phase = RoundManager.phase()

		local function wander()
			if not wanderGoal or now > wanderUntil or Util.flatDistance(wanderGoal, here) < 4 then
				wanderGoal = randomSpot()
				wanderUntil = now + random:NextNumber(6, 12)
			end
			goTo(wanderGoal :: Vector3, root, humanoid, false)
			checkProgress(root, wanderGoal, humanoid)
		end

		if p.team == "Zombie" then
			face(root, humanoid, nil)
			-- Pick a human: close ones first, but spread out so the pack
			-- surrounds people instead of queueing behind each other.
			local best: Seen? = nil
			local bestScore = math.huge
			-- A barricaded human pulls the pack together instead (up to 6).
			for _, entry in seenHumans do
				local d = Util.flatDistance(entry.position, here)
				if d <= level.sight and visible(entry, here) then
					local others = chasers(entry.p, p.id)
					local rally = (fortified[entry.p] or 0) > now and others < 6
					local score = d
						+ (if rally then -15 - 10 * others else 14 * others)
						- (if chasing[p.id] == entry.p then 8 else 0)
					if score < bestScore then
						best, bestScore = entry, score
					end
				end
			end
			if best then
				chasing[p.id] = best.p
				local d = Util.flatDistance(best.position, here)
				local lead = best.velocity * level.lead * math.clamp(d / 25, 0, 1)
				local goal = best.position + lead
				lastSeen, lastSeenAt = goal, now
				if not breach(best.position, root, humanoid) then
					goTo(goal, root, humanoid, true)
					checkProgress(root, goal, humanoid)
				end
			elseif lastSeen and now - lastSeenAt < level.memory then
				chasing[p.id] = nil
				if not breach(lastSeen, root, humanoid) then
					goTo(lastSeen, root, humanoid, true)
					checkProgress(root, lastSeen, humanoid)
				end
			else
				chasing[p.id] = nil
				lastSeen = nil
				siege = nil
				wander()
			end
			if now - progressAt > level.stuck then
				RoundManager.zombieReturn(p)
				progressAt = now
			end
			continue
		end
		chasing[p.id] = nil

		-- Human ----------------------------------------------------------------------
		local round = RoundManager.roundNumber()
		if phase == "Prep" and armedRound ~= round then
			armedRound = round -- one roll per round: only some bots start armed
			if not p.heldItem and random:NextNumber() < Config.BOT_WEAPON_CHANCE then
				ItemService.give(p, STARTER_WEAPONS[random:NextInteger(1, #STARTER_WEAPONS)])
			end
		end
		local item = Items.get(p.heldItem)

		-- The zombies this bot can see, and the closest one.
		local threats: { Seen } = {}
		local closest: Seen? = nil
		local closestDistance = math.huge
		for _, entry in seenZombies do
			if not entry.hidden or Util.flatDistance(entry.position, here) <= Config.BUSH_REVEAL_DISTANCE then
				local d = Util.flatDistance(entry.position, here)
				if d <= level.flee then
					table.insert(threats, entry)
				end
				if d < closestDistance then
					closest, closestDistance = entry, d
				end
			end
		end

		-- Armed: hold the weapon out toward a close zombie (it's solid) and swing.
		local guarding = false
		if closest and item then
			local reach = if item.kind == "Projectile"
				then 45
				else (item.reach or 5) * math.max(1, p.scale * 0.9) + 3
			if closestDistance <= reach then
				local aim = Util.flatUnit(closest.position + closest.velocity * 0.15 - here)
				if aim then
					guarding = item.kind == "Melee"
					face(root, humanoid, aim)
					ItemService.botUse(p, aim)
				end
			end
		end
		if not guarding then
			face(root, humanoid, nil)
		end

		local hidden = BushService.hidden(p)
		if hidden and (not closest or closestDistance > Config.BUSH_REVEAL_DISTANCE + 4) then
			humanoid:MoveTo(here) -- stay still and hope
		elseif #threats > 0 then
			local bush = if hider and not hidden then nearestBush(here, 30) else nil
			if bush and closest and Util.flatDistance(bush, here) < closestDistance * 0.8 then
				goTo(bush, root, humanoid, false)
				checkProgress(root, bush, humanoid)
			else
				-- Escape: try directions, keep the ones our body fits through,
				-- and pick the spot farthest from where the zombies are going,
				-- preferring open ground over dead ends.
				local stride = 12 + p.scale * 2
				local candidates: { { spot: Vector3, score: number } } = {}
				for i = 0, level.directions - 1 do
					local angle = i / level.directions * math.pi * 2 + random:NextNumber(-0.15, 0.15)
					local spot = here + Vector3.new(math.cos(angle), 0, math.sin(angle)) * stride
					if inBounds(spot, 5) and Combat.clearWide(here, spot, radius()) then
						local score = math.huge
						for _, zombie in threats do
							local future = zombie.position + zombie.velocity * 0.6
							score = math.min(score, Util.flatDistance(spot, future))
						end
						table.insert(candidates, { spot = spot, score = score })
					end
				end
				table.sort(candidates, function(a, b)
					return a.score > b.score
				end)
				local best: Vector3? = nil
				local bestScore = -math.huge
				for i = 1, math.min(3, #candidates) do
					local c = candidates[i]
					local open = 0
					for j = 0, 3 do
						local angle = j / 4 * math.pi * 2
						if
							Combat.clearWide(
								c.spot,
								c.spot + Vector3.new(math.cos(angle), 0, math.sin(angle)) * 10,
								radius()
							)
						then
							open += 1
						end
					end
					local score = c.score + open * 3
					if score > bestScore then
						best, bestScore = c.spot, score
					end
				end
				if best then
					humanoid:MoveTo(best)
					pathGoal = nil
				elseif closest then
					local step = sidestep(root, here + (here - closest.position))
					if step then
						humanoid:MoveTo(step)
					end
				end
			end
		elseif phase == "Prep" and not p.heldItem then
			local spot = nearestItem(here, 90)
			if spot then
				if Util.flatDistance(spot, here) < Config.PICKUP_RADIUS then
					ItemService.pickUp(p)
				else
					goTo(spot, root, humanoid, false)
					checkProgress(root, spot, humanoid)
				end
			else
				wander()
			end
		else
			wander()
		end
	end
	chasing[p.id] = nil
end

-- Roster ----------------------------------------------------------------------------------

local active: { [number]: Participant } = {} -- roster index -> bot
local nextId = 0

local function randomSkin(team: Skins.Team): string
	local list = Skins.forTeam(team)
	return list[rng:NextInteger(1, #list)].id
end

-- Only a few bots dress up (Config.BOTS_WITH_SKINS); the rest look classic.
local function dressedUp(): number
	local count = 0
	for _, p in active do
		if p.humanSkin ~= Skins.DEFAULT_HUMAN then
			count += 1
		end
	end
	return count
end

local function addBot(index: number)
	local entry = ROSTER[index]
	local level = LEVELS[entry.level] or LEVELS[5]
	nextId += 1
	local p = Participants.add({
		id = "B" .. nextId,
		name = entry.name,
		isBot = true,
	})
	if dressedUp() < Config.BOTS_WITH_SKINS and rng:NextNumber() < 0.35 then
		repeat
			p.humanSkin = randomSkin("Human")
		until p.humanSkin ~= Skins.DEFAULT_HUMAN
	end
	p.adminSpeed = level.speed
	p.state:SetAttribute("BotLevel", entry.level)
	Participants.publish(p)
	if p.character then
		CharacterService.applyLook(p)
	end
	CharacterService.refreshSpeed(p)
	active[index] = p
	task.spawn(brain, p, level, nextId * 97 + os.time())
end

-- How many bots this round: a random count in range, leaving room for
-- real players.
local function wanted(): number
	local players = #Players:GetPlayers()
	local room = math.max(0, Config.MAX_PARTICIPANTS - players)
	return math.min(rng:NextInteger(Config.BOTS_MIN, Config.BOTS_MAX), room, #ROSTER)
end

local function rebalance()
	local target = wanted()
	local count = 0
	for _ in active do
		count += 1
	end
	-- Add in roster order (Mario Robles first), remove from the end.
	for index = 1, #ROSTER do
		if count >= target then
			break
		end
		if not active[index] then
			addBot(index)
			count += 1
		end
	end
	for index = #ROSTER, 2, -1 do
		if count <= target then
			break
		end
		local p = active[index]
		if p then
			active[index] = nil
			Participants.remove(p)
			count -= 1
		end
	end
end

function BotService.start()
	if not Config.BOTS then
		return
	end
	rebalance()
	print("[Bots] bots are playing. Set Config.BOTS = false to turn them off.")
	-- A fresh mix of bots for every round.
	local state = ReplicatedStorage:WaitForChild("BrainTagState")
	state:GetAttributeChangedSignal("Phase"):Connect(function()
		if state:GetAttribute("Phase") == "Prep" then
			rebalance()
		end
	end)
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">BushService</string>
          <string name="Source"><![CDATA[-- Flags characters standing in a bush (character attribute "InBush") so bots
-- can't see them. Clients work out the visual side (name tags, see-through
-- canopy) themselves from the same shared geometry.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Bushes = require(ReplicatedStorage.Shared.Bushes)
local Config = require(ReplicatedStorage.Shared.Config)
local Participants = require(script.Parent.Participants)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local BushService = {}

local INTERVAL = 0.1

function BushService.hidden(p: Participant): boolean
	local character = p.character
	return character ~= nil and character:GetAttribute(Bushes.ATTRIBUTE) == true
end

-- Whether someone at `from` can spot `p`: always, unless `p` is in a bush
-- and the looker is farther than the reveal distance.
function BushService.visibleFrom(p: Participant, from: Vector3): boolean
	if not BushService.hidden(p) then
		return true
	end
	local root = Participants.body(p)
	return root ~= nil and Util.flatDistance(root.Position, from) <= Config.BUSH_REVEAL_DISTANCE
end

function BushService.init()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < INTERVAL then
			return
		end
		elapsed = 0
		for _, p in Participants.all() do
			local character = p.character
			if character then
				local root = Participants.body(p)
				local hidden = root ~= nil and Bushes.coverAt(root.Position) ~= nil
				if character:GetAttribute(Bushes.ATTRIBUTE) ~= hidden then
					character:SetAttribute(Bushes.ATTRIBUTE, hidden)
				end
			end
		end
	end)
end

return BushService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[-- Spawns and dresses characters. Every player and bot uses the same custom
-- rig: an invisible collision box (HumanoidRootPart) with a Humanoid, wearing
-- the flat blob look from CharacterLook. Avatars, clothes and accessories are
-- never loaded.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Config = require(ReplicatedStorage.Shared.Config)
local Parts = require(ReplicatedStorage.Shared.Parts)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Participants = require(script.Parent.Participants)

local C = Config.CHARACTER

local CharacterService = {}

type Participant = Participants.Participant

-- Called when a character died or vanished and needs a new one. RoundManager
-- sets this so it can choose the right spawn for the current phase.
CharacterService.onNeedRespawn = function(_p: Participant) end

-- Called after a participant's size changed, so the held item can be
-- re-attached at the new grip. ItemService sets this.
CharacterService.onResized = function(_p: Participant) end

local template: Model

function CharacterService.buildTemplate()
	local existing = StarterPlayer:FindFirstChild("StarterCharacter")
	if existing then
		existing:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "StarterCharacter"

	local root = Parts.make({
		name = "HumanoidRootPart",
		size = Vector3.new(C.RootWidth, C.RootHeight, C.RootWidth),
		cframe = CFrame.new(0, 5, 0),
		color = "FFFFFF",
		transparency = 1,
		anchored = false,
		parent = model,
	})
	root.CanQuery = true -- the hitbox for potatoes and line-of-sight checks
	model.PrimaryPart = root

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = C.HipHeight
	humanoid.WalkSpeed = Config.BASE_WALKSPEED
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.Parent = model

	CharacterLook.apply(model, root, nil, "Human", 1)
	model.Parent = StarterPlayer
	template = model
end

local function nameColor(p: Participant): Color3
	if p.passes.VIP then
		return Color3.fromHex(Config.COLORS.VipName)
	end
	return Color3.fromHex(Config.COLORS.OtherName)
end

local function updateNameTag(p: Participant)
	local character = p.character
	if not character then
		return
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local tag = head:FindFirstChild("NameTag") :: BillboardGui?
	if not tag then
		local gui = Instance.new("BillboardGui")
		gui.Name = "NameTag"
		gui.Size = UDim2.fromOffset(220, 24)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 1000
		gui.ResetOnSpawn = false
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.BuilderSansBold
		label.TextSize = 16
		label.TextStrokeTransparency = 0.35
		label.TextStrokeColor3 = Color3.fromRGB(20, 20, 20)
		label.Parent = gui
		gui.Parent = head
		tag = gui
	end
	assert(tag, "tag")
	tag.Adornee = head
	-- World offset toward -Z = "up" on the top-down screen.
	tag.StudsOffsetWorldSpace = Vector3.new(0, 1, -(C.BodyWidth * 0.5 + 0.7) * p.scale)
	tag:SetAttribute("ParticipantId", p.id)
	local label = tag:FindFirstChild("Label") :: TextLabel
	label.Text = (if p.passes.VIP then "[VIP] " else "") .. p.name
	label.TextColor3 = nameColor(p)
end

function CharacterService.skinFor(p: Participant): string
	-- Every zombie looks the same, except the round's alpha.
	if p.team == "Zombie" then
		return if p.alpha or p.zombieSkin == "Alpha" then "Alpha" else Skins.DEFAULT_ZOMBIE
	end
	return p.humanSkin
end

-- An invisible cylinder the size of the drawn body. Only other characters'
-- shells collide with it (see WorldSetup), so characters bump into each
-- other while the narrow root box still decides what fits through doors.
local function addShell(character: Model, root: BasePart, scale: number)
	local old = character:FindFirstChild("Shell")
	if old then
		old:Destroy()
	end
	local diameter = C.ShellDiameter * scale
	local shell = Instance.new("Part")
	shell.Name = "Shell"
	shell.Shape = Enum.PartType.Cylinder
	shell.Size = Vector3.new(C.RootHeight * scale, diameter, diameter)
	shell.CFrame = root.CFrame * Parts.UPRIGHT
	shell.Transparency = 1
	shell.Massless = true
	shell.CanCollide = true
	shell.CanQuery = false
	shell.CanTouch = true -- your client plays a bump sound on contact
	shell.CastShadow = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = shell
	weld.Parent = shell
	shell.Parent = character
	shell.CollisionGroup = "CharacterShells"
end

-- Rebuilds the look for the participant's team, skin and size.
function CharacterService.applyLook(p: Participant)
	local character = p.character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	root.Size = Vector3.new(C.RootWidth, C.RootHeight, C.RootWidth) * p.scale
	-- Hip height stays fixed while the body grows, so even giant players keep
	-- their collision box low enough to bump into benches and coffee tables.
	humanoid.HipHeight = C.HipHeight
	CharacterLook.apply(character, root, CharacterService.skinFor(p), p.team, p.scale)
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = "Characters"
		end
	end
	addShell(character, root, p.scale)
	character:SetAttribute("Team", p.team)
	updateNameTag(p)
end

function CharacterService.refreshNameTag(p: Participant)
	updateNameTag(p)
end

-- Size follows score live: call after a participant's score changes. Only
-- rebuilds the look when the size really changed.
function CharacterService.refreshSize(p: Participant)
	local scale = RoundRules.scaleForScore(p.score)
	if math.abs(scale - p.scale) < 0.01 then
		return
	end
	p.scale = scale
	p.state:SetAttribute("Scale", scale)
	CharacterService.applyLook(p)
	CharacterService.onResized(p)
end

function CharacterService.refreshSpeed(p: Participant)
	local _, humanoid = Participants.body(p)
	if not humanoid then
		return
	end
	local now = os.clock()
	if now < p.stunUntil then
		humanoid.WalkSpeed = 0
		return
	end
	local speed = RoundRules.walkSpeed(p.score, p.team == "Zombie") * p.adminSpeed
	if now < p.boostUntil then
		speed *= p.boostFactor
	end
	if now < p.slowUntil then
		speed *= p.slowFactor
	end
	humanoid.WalkSpeed = speed
end

-- Speeds a participant up (energy drink) or down (snowball) for a while.
function CharacterService.speedEffect(p: Participant, factor: number, seconds: number)
	local untilTime = os.clock() + seconds
	if factor >= 1 then
		p.boostFactor, p.boostUntil = factor, math.max(p.boostUntil, untilTime)
	else
		p.slowFactor, p.slowUntil = factor, math.max(p.slowUntil, untilTime)
	end
	CharacterService.refreshSpeed(p)
	task.delay(seconds + 0.05, function()
		CharacterService.refreshSpeed(p)
	end)
end

local function setup(p: Participant, character: Model)
	p.character = character
	character:SetAttribute("ParticipantId", p.id)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	assert(humanoid, "character has no Humanoid")
	humanoid.AutoRotate = p.isBot -- players face the mouse from their client
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	CharacterService.applyLook(p)
	CharacterService.refreshSpeed(p)
	humanoid.Died:Connect(function()
		task.delay(2, function()
			if Participants.get(p.id) == p and p.character == character then
				CharacterService.onNeedRespawn(p)
			end
		end)
	end)
end

local function spawnBot(p: Participant, at: CFrame): Model
	local character = template:Clone()
	character.Name = p.name
	character:PivotTo(at)
	character.Parent = workspace:WaitForChild("Bots")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	setup(p, character)
	return character
end

local function spawnPlayer(p: Participant, at: CFrame): Model?
	local player = p.player
	if not player or player.Parent ~= Players then
		return nil
	end
	player:LoadCharacter()
	local character = player.Character
	if not character or Participants.get(p.id) ~= p then
		return nil
	end
	setup(p, character)
	character:PivotTo(at)
	return character
end

-- Gives the participant a fresh character standing at `at`.
function CharacterService.spawn(p: Participant, at: CFrame): Model?
	if p.spawning then
		return nil -- a spawn is already in progress (LoadCharacter yields)
	end
	p.spawning = true
	local ok, result = pcall(function(): Model?
		if p.isBot then
			if p.character then
				p.character:Destroy()
			end
			return spawnBot(p, at)
		end
		return spawnPlayer(p, at)
	end)
	p.spawning = false
	if not ok then
		warn("[Characters] spawn failed for " .. p.name .. ": " .. tostring(result))
		return nil
	end
	return result
end

-- Moves an existing living character, or spawns one if there is none.
function CharacterService.place(p: Participant, at: CFrame)
	if p.spawning then
		return
	end
	local root = Participants.body(p)
	if not root or not p.character then
		CharacterService.spawn(p, at)
		return
	end
	p.character:PivotTo(at)
	root.AssemblyLinearVelocity = Vector3.zero
end

function CharacterService.init()
	Players.PlayerAdded:Connect(function(player)
		player.CanLoadCharacterAppearance = false
	end)
	for _, player in Players:GetPlayers() do
		player.CanLoadCharacterAppearance = false
	end
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[-- Shoves and stuns. Weapons never kill: they push zombies away and freeze
-- them for a moment. Players' characters are simulated by their own clients,
-- so their shove is sent to them; bots are shoved right here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local Knockback = require(ReplicatedStorage.Shared.Knockback)
local MapBuilder = require(script.Parent.MapBuilder)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local Combat = {}

local knockbackRemote = Remotes.event("Knockback")
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Include
local solidParams = RaycastParams.new()
solidParams.FilterType = Enum.RaycastFilterType.Include

function Combat.init()
	wallParams.FilterDescendantsInstances = { MapBuilder.wallsFolder() }
	solidParams.FilterDescendantsInstances = { MapBuilder.wallsFolder(), workspace:WaitForChild("Furniture") }
end

-- Like lineOfSight, but furniture blocks too (used for infection, so a
-- barricade always protects the people behind it).
function Combat.clearPath(from: Vector3, to: Vector3): boolean
	-- Low enough to hit every piece of furniture, whatever the players' size.
	local y = MapLayout.HEIGHTS.Floor + 1.4
	local a = Vector3.new(from.X, y, from.Z)
	local b = Vector3.new(to.X, y, to.Z)
	return workspace:Raycast(a, b - a, solidParams) == nil
end

-- Like clearPath, but for a body `radius` wide, so bots never try to squeeze
-- past a wall corner. With `wallsOnly`, furniture doesn't count (a zombie
-- may shove through a barricade).
function Combat.clearWide(from: Vector3, to: Vector3, radius: number, wallsOnly: boolean?): boolean
	local y = MapLayout.HEIGHTS.Floor + 1.4
	local a = Vector3.new(from.X, y, from.Z)
	local direction = Vector3.new(to.X, y, to.Z) - a
	if direction.Magnitude < 0.05 then
		return true
	end
	return workspace:Spherecast(a, radius, direction, if wallsOnly then wallParams else solidParams) == nil
end

-- True when no (unbroken) wall stands between the two points.
function Combat.lineOfSight(from: Vector3, to: Vector3): boolean
	local y = math.max(from.Y, to.Y)
	local a = Vector3.new(from.X, y, from.Z)
	local b = Vector3.new(to.X, y, to.Z)
	return workspace:Raycast(a, b - a, wallParams) == nil
end

function Combat.wallParams(): RaycastParams
	return wallParams
end

-- `gentle` shoves (a zombie leaning on a held weapon) never cut short a
-- real hit that is still sending the zombie flying.
function Combat.knockback(
	target: Participant,
	velocity: Vector3,
	stun: number,
	seconds: number?,
	gentle: boolean?
)
	local root = Participants.body(target)
	local character = target.character
	if not root or not character then
		return
	end
	local now = os.clock()
	if gentle and now < target.knockedUntil then
		return
	end
	if stun > 0 then
		target.stunUntil = math.max(target.stunUntil, os.clock() + stun)
		CharacterService.refreshSpeed(target)
		task.delay(stun + 0.05, function()
			CharacterService.refreshSpeed(target)
		end)
	end
	local duration = seconds or Config.KNOCKBACK_SECONDS
	if not gentle then
		target.knockedUntil = now + duration
	end
	if target.player then
		knockbackRemote:FireClient(target.player, velocity, duration)
	else
		Knockback.apply(character, velocity, duration)
	end
end

-- Area blast (duck launcher): shoves everyone within `radius` away from the
-- center, with a classic (harmless) Roblox explosion for show.
function Combat.explode(at: Vector3, radius: number, knockback: number, stun: number)
	local boom = Instance.new("Explosion")
	boom.Position = at
	boom.BlastRadius = radius
	boom.BlastPressure = 0
	boom.DestroyJointRadiusPercent = 0
	boom.ExplosionType = Enum.ExplosionType.NoCraters
	boom.Parent = workspace
	for _, person in Participants.all() do
		local root = Participants.body(person)
		if root then
			local offset = Util.flat(root.Position - at)
			if offset.Magnitude <= radius and Combat.lineOfSight(at, root.Position) then
				local away = if offset.Magnitude > 0.1 then offset.Unit else Vector3.xAxis
				local falloff = 1 - offset.Magnitude / radius * 0.5
				Combat.knockback(person, away * knockback * falloff, stun)
			end
		end
	end
end

export type Hit = { target: Participant, direction: Vector3, distance: number }

-- Everyone else (zombies and humans) inside a cone in front of `attacker`,
-- not behind walls: weapons push people on both teams.
function Combat.peopleInCone(attacker: Participant, aim: Vector3, reach: number, arcDegrees: number): { Hit }
	local root = Participants.body(attacker)
	local hits = {}
	if not root then
		return hits
	end
	local cosHalf = math.cos(math.rad(arcDegrees / 2))
	local myRadius = root.Size.X / 2
	for _, other in Participants.all() do
		local zRoot = if other ~= attacker then Participants.body(other) else nil
		if zRoot then
			local offset = Util.flat(zRoot.Position - root.Position)
			local distance = offset.Magnitude
			local zRadius = zRoot.Size.X / 2
			if distance > 0.01 and distance <= reach + zRadius then
				local direction = offset.Unit
				local touching = distance <= myRadius + zRadius + 0.6
				if
					(touching or direction:Dot(aim) >= cosHalf)
					and Combat.lineOfSight(root.Position, zRoot.Position)
				then
					table.insert(hits, { target = other, direction = direction, distance = distance })
				end
			end
		end
	end
	return hits
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Saves each player's score, stats, skins and purchases with DataStoreService.
--
-- Safety rules:
--  * Every DataStore call is wrapped in pcall and retried with backoff.
--  * If a player's data fails to load, the session uses defaults and is NEVER
--    saved, so a hiccup can't overwrite real progress with zeros.
--  * In Studio without "Enable Studio Access to API Services" (Game Settings >
--    Security), saving is off for the session and a single warning explains why.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Skins = require(ReplicatedStorage.Shared.Skins)

local DataService = {}

local VERSION = 1
local MAX_RECEIPTS = 100

export type Profile = {
	Version: number,
	Score: number,
	Wins: number,
	Infections: number,
	RoundsPlayed: number,
	OwnedSkins: { [string]: boolean },
	HumanSkin: string,
	ZombieSkin: string,
	SeenTutorial: boolean,
	BoostEndsAt: number,
	PendingItems: { string },
	Receipts: { [string]: number },
}

type Session = {
	data: Profile,
	loaded: boolean, -- false = defaults after a failed load; never saved
	saving: boolean,
}

local sessions: { [Player]: Session } = {}
local store: DataStore? = nil
local orderedStore: OrderedDataStore? = nil
local available = false
local warned = false

local function defaults(): Profile
	return {
		Version = VERSION,
		Score = 0,
		Wins = 0,
		Infections = 0,
		RoundsPlayed = 0,
		OwnedSkins = { [Skins.DEFAULT_HUMAN] = true, [Skins.DEFAULT_ZOMBIE] = true },
		HumanSkin = Skins.DEFAULT_HUMAN,
		ZombieSkin = Skins.DEFAULT_ZOMBIE,
		SeenTutorial = false,
		BoostEndsAt = 0,
		PendingItems = {},
		Receipts = {},
	}
end

-- Fills in any fields added after a player's data was first saved.
local function reconcile(saved: any): Profile
	local data = defaults()
	if type(saved) ~= "table" then
		return data
	end
	for key, value in saved do
		if (data :: any)[key] ~= nil and type(value) == type((data :: any)[key]) then
			(data :: any)[key] = value
		end
	end
	data.OwnedSkins[Skins.DEFAULT_HUMAN] = true
	data.OwnedSkins[Skins.DEFAULT_ZOMBIE] = true
	return data
end

local function warnOnce(message: string)
	if not warned then
		warned = true
		warn("[Data] " .. message)
	end
end

local function retry<T>(label: string, fn: () -> T): (boolean, T?)
	local lastError
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		task.wait(attempt * 1.5)
	end
	warn(string.format("[Data] %s failed: %s", label, tostring(lastError)))
	return false, nil
end

local function key(player: Player): string
	return "u_" .. player.UserId
end

function DataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
		local okOrdered, ordered = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.LEADERBOARD_STORE_NAME)
		end)
		if okOrdered then
			orderedStore = ordered
		end
		-- A cheap read tells us whether DataStores actually work here.
		local probe = pcall(function()
			(store :: DataStore):GetAsync("__probe")
		end)
		available = probe
	end
	if not available then
		if RunService:IsStudio() then
			warnOnce(
				"Saving is OFF in this test. To save in Studio: publish the place (File > Publish to Roblox), then Game Settings > Security > Enable Studio Access to API Services."
			)
		else
			warnOnce("DataStores are unavailable right now; this server will not save.")
		end
	end

	game:BindToClose(function()
		local threads = {}
		for player in sessions do
			table.insert(
				threads,
				task.spawn(function()
					DataService.save(player)
				end)
			)
		end
		-- Give saves time to finish (BindToClose allows about 30 seconds).
		local deadline = os.clock() + 25
		while os.clock() < deadline do
			local busy = false
			for _, session in sessions do
				if session.saving then
					busy = true
				end
			end
			if not busy then
				break
			end
			task.wait(0.25)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_SECONDS)
			for player in sessions do
				task.spawn(DataService.save, player)
			end
		end
	end)
end

function DataService.isAvailable(): boolean
	return available
end

-- Loads (yields). Always returns a profile; check `isSaved` to know whether
-- it came from the DataStore.
function DataService.load(player: Player): Profile
	local session: Session = { data = defaults(), loaded = false, saving = false }
	if available and store then
		local ok, saved = retry("load " .. player.UserId, function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok then
			session.data = reconcile(saved)
			session.loaded = true
		end
	end
	if player.Parent ~= Players then
		-- They left while we were loading: never register (or autosave) this
		-- stale copy, or it could overwrite progress made in another server.
		return session.data
	end
	sessions[player] = session
	return session.data
end

function DataService.get(player: Player): Profile?
	local session = sessions[player]
	return session and session.data
end

function DataService.isSaved(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and session.loaded
end

-- Keeps the receipt log small: drops the oldest entries past MAX_RECEIPTS.
local function trimReceipts(data: Profile)
	local list = {}
	for id, at in data.Receipts do
		table.insert(list, { id = id, at = at })
	end
	if #list <= MAX_RECEIPTS then
		return
	end
	table.sort(list, function(a, b)
		return a.at > b.at
	end)
	for i = MAX_RECEIPTS + 1, #list do
		data.Receipts[list[i].id] = nil
	end
end

-- Writes the player's profile. Returns true when it reached the DataStore.
function DataService.save(player: Player): boolean
	local session = sessions[player]
	if not session or not session.loaded or not available or not store then
		return false
	end
	while session.saving do
		task.wait(0.1)
	end
	session.saving = true
	trimReceipts(session.data)
	local snapshot = table.clone(session.data)
	local ok = retry("save " .. player.UserId, function()
		(store :: DataStore):UpdateAsync(key(player), function()
			return snapshot
		end)
		return true
	end)
	if ok and orderedStore then
		pcall(function()
			(orderedStore :: OrderedDataStore):SetAsync(tostring(player.UserId), math.floor(snapshot.Score))
		end)
	end
	session.saving = false
	return ok
end

function DataService.release(player: Player)
	DataService.save(player)
	sessions[player] = nil
end

-- Top scores across all servers, best first: { { userId, score } }.
function DataService.topScores(count: number): { { userId: number, score: number } }
	local result = {}
	if not available or not orderedStore then
		return result
	end
	local ok, page = pcall(function()
		return (orderedStore :: OrderedDataStore):GetSortedAsync(false, count):GetCurrentPage()
	end)
	if ok and page then
		for _, entry in page do
			local id = tonumber(entry.key)
			if id then
				table.insert(result, { userId = id, score = entry.value })
			end
		end
	end
	return result
end

Players.PlayerRemoving:Connect(function(player)
	if sessions[player] then
		DataService.release(player)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">FurnitureBuilder</string>
          <string name="Source"><![CDATA[-- Builds one furniture piece: an invisible-to-physics stack of colored details
-- welded onto a single "Body" part that carries all the mass and collision.
-- Details are designed to read clearly from straight above.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureSpecs = require(ReplicatedStorage.Shared.FurnitureSpecs)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)

local FurnitureBuilder = {}

-- Context passed to each design: adds parts relative to the body center.
type Ctx = {
	w: number,
	d: number,
	h: number,
	body: Part,
	model: Model,
	-- Block whose top sits `raise` studs above the body's top.
	top: (
		self: Ctx,
		x: number,
		z: number,
		sx: number,
		sz: number,
		raise: number,
		thickness: number,
		color: string,
		yaw: number?
	) -> Part,
	disc: (
		self: Ctx,
		x: number,
		z: number,
		diameter: number,
		raise: number,
		thickness: number,
		color: string
	) -> Part,
	ball: (self: Ctx, x: number, y: number, z: number, diameter: number, color: string) -> Part,
}

local function newCtx(model: Model, body: Part, w: number, d: number, h: number): Ctx
	local ctx = { w = w, d = d, h = h, body = body, model = model } :: any

	function ctx.top(self: Ctx, x, z, sx, sz, raise, thickness, color, yaw)
		local y = self.h / 2 + raise - thickness / 2
		local part = Parts.make({
			name = "Detail",
			size = Vector3.new(sx, thickness, sz),
			cframe = self.body.CFrame * CFrame.new(x, y, z) * CFrame.Angles(0, yaw or 0, 0),
			color = color,
			parent = self.model,
		})
		return part
	end

	function ctx.disc(self: Ctx, x, z, diameter, raise, thickness, color)
		local y = self.h / 2 + raise - thickness / 2
		return Parts.make({
			name = "Detail",
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(thickness, diameter, diameter),
			cframe = self.body.CFrame * CFrame.new(x, y, z) * Parts.UPRIGHT,
			color = color,
			parent = self.model,
		})
	end

	function ctx.ball(self: Ctx, x, y, z, diameter, color)
		return Parts.make({
			name = "Detail",
			shape = Enum.PartType.Ball,
			size = Vector3.one * diameter,
			cframe = self.body.CFrame * CFrame.new(x, y, z),
			color = color,
			parent = self.model,
		})
	end

	return ctx :: Ctx
end

type Design = { body: string, transparentBody: boolean?, draw: (ctx: Ctx) -> () }

local BOOK_COLORS = { "C0392B", "2E86C1", "27AE60", "F1C40F", "8E44AD", "E67E22", "16A085", "D35400" }

local DESIGNS: { [string]: Design } = {
	Couch = {
		body = "3C8DBC",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.5, c.w, 1.0, 0.7, 0.8, "2F7099") -- backrest
			for side = -1, 1, 2 do
				c:top(side * (c.w / 2 - 0.45), 0.2, 0.9, c.d - 0.4, 0.5, 0.6, "2F7099") -- arms
				c:top(side * (c.w / 4 - 0.2), 0.45, c.w / 2 - 1.3, c.d - 1.3, 0.15, 0.2, "5BA7D6") -- cushions
				c:top(side * (c.w / 4 - 0.2), 0.45, c.w / 2 - 1.8, 0.12, 0.17, 0.2, "4A93C2") -- cushion seam
			end
			c:top(c.w / 2 - 1.6, -0.2, 1.2, 1.0, 0.35, 0.3, "F1C40F", 0.3) -- throw pillow
		end,
	},
	Armchair = {
		body = "4E9A3E",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.45, c.w, 0.9, 0.7, 0.8, "3D7D30")
			for side = -1, 1, 2 do
				c:top(side * (c.w / 2 - 0.35), 0.2, 0.7, c.d - 0.4, 0.5, 0.6, "3D7D30")
			end
			c:top(0, 0.45, c.w - 1.6, c.d - 1.3, 0.15, 0.2, "6CBF5A")
		end,
	},
	Fridge = {
		body = "EEF1F4",
		draw = function(c)
			c:top(0, -0.3, c.w - 0.4, 0.12, 0.03, 0.06, "B9C0C8") -- door split
			c:top(c.w / 2 - 0.7, c.d / 2 - 0.25, 0.25, 0.5, 0.06, 0.1, "8A939C") -- handle
			c:top(0, 0, c.w - 0.3, c.d - 0.3, 0.01, 0.02, "F7F9FA")
			c:disc(-0.9, 0.6, 0.4, 0.05, 0.06, "E5484D") -- fridge magnets
			c:disc(-0.3, 0.9, 0.35, 0.05, 0.06, "3498DB")
			c:top(0.6, 0.7, 0.6, 0.45, 0.05, 0.06, "FFE14D", 0.2) -- a note
		end,
	},
	Stove = {
		body = "E6E6E6",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.3, c.w, 0.6, 0.35, 0.4, "BDBDBD") -- control strip
			for i = -1, 1 do
				c:disc(i * 1.1, -c.d / 2 + 0.3, 0.3, 0.42, 0.08, "333333") -- knobs
			end
			c:disc(0.9, 0.95, 0.95, 0.5, 0.5, "7F8C8D") -- a pot on the front burner
			c:disc(0.9, 0.95, 0.75, 0.52, 0.5, "C0392B")
			for _, x in { -0.9, 0.9 } do
				for _, z in { -0.35, 0.95 } do
					c:disc(x, z, 1.1, 0.06, 0.08, "3A3A3A")
					c:disc(x, z, 0.5, 0.08, 0.08, "6B6B6B")
				end
			end
		end,
	},
	Sink = {
		body = "C9D1D9",
		draw = function(c)
			c:top(0, 0.25, c.w - 1.4, c.d - 1.2, 0.03, 0.06, "8FA6BC") -- basin
			c:top(0, -c.d / 2 + 0.35, 0.3, 0.7, 0.4, 0.4, "8A939C") -- faucet
		end,
	},
	Toilet = {
		body = "F2F4F6",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.5, c.w, 1.0, 0.5, 0.6, "E1E6EB") -- tank
			c:disc(0, 0.45, 2.1, 0.04, 0.08, "DCE3E9") -- seat
			c:disc(0, 0.45, 1.3, 0.06, 0.08, "A8D4EE") -- water
			c:disc(c.w / 2 + 0.2, -c.d / 2 + 0.6, 0.7, -0.4, 0.5, "FFFFFF") -- paper roll
		end,
	},
	Bathtub = {
		body = "F4F7FA",
		draw = function(c)
			c:top(0, 0, c.w - 1.0, c.d - 1.0, 0.03, 0.06, "A9D6F0")
			c:top(c.w / 2 - 0.4, 0, 0.4, 0.5, 0.3, 0.3, "8A939C") -- tap
			c:ball(-1.5, c.h / 2 + 0.15, 0.3, 0.6, "FFD93B") -- rubber duck
			c:ball(-1.25, c.h / 2 + 0.35, 0.3, 0.35, "FFD93B")
			c:top(-1.0, 0.3, 0.2, 0.15, 0.4, 0.1, "F28C1C")
			for i = 1, 4 do
				c:disc(1.6 - i * 0.5, -0.6 + (i % 2) * 0.4, 0.35, 0.08, 0.06, "FFFFFF") -- bubbles
			end
		end,
	},
	Bed = {
		body = "8E5A32",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.25, c.w, 0.5, 0.6, 0.7, "6B4226") -- headboard
			c:top(0, 0.1, c.w - 0.6, c.d - 0.8, 0.2, 0.3, "F5F5F5") -- mattress
			c:top(0, c.d * 0.18, c.w - 0.5, c.d * 0.6, 0.3, 0.35, "2FA84F") -- blanket (green, like the original)
			c:top(0, c.d * 0.18 - c.d * 0.3 + 0.2, c.w - 0.5, 0.4, 0.32, 0.36, "F2F2F2") -- folded sheet
			for side = -1, 1, 2 do
				c:top(side * 1.55, -c.d / 2 + 1.3, 2.6, 1.4, 0.45, 0.4, "FFFFFF") -- pillows
			end
			for row = 0, 2 do
				for col = -1, 1, 2 do
					c:top(col * 1.5, c.d * 0.02 + row * 1.6, 2.4, 0.06, 0.32, 0.36, "27924A") -- quilt lines
				end
			end
			c:ball(1.6, c.h / 2 + 0.55, -c.d / 2 + 2.6, 0.9, "A0582A") -- teddy bear
			c:ball(1.6, c.h / 2 + 0.75, -c.d / 2 + 2.05, 0.6, "A0582A")
		end,
	},
	Table = {
		body = "B07A45",
		draw = function(c)
			c:top(0, 0, c.w - 0.6, c.d - 0.6, 0.02, 0.04, "C08A55")
			for _, x in { -2.3, 0, 2.3 } do
				c:disc(x, 0, 1.3, 0.06, 0.06, "F4F4F4") -- plates
				c:disc(x, 0, 0.7, 0.08, 0.06, "E8E8E8")
			end
			c:disc(-1.2, 1.4, 0.45, 0.1, 0.1, "3498DB") -- cups
			c:disc(1.2, -1.4, 0.45, 0.1, 0.1, "E5484D")
		end,
	},
	CoffeeTable = {
		body = "9A6838",
		draw = function(c)
			c:top(0, 0, c.w - 0.5, c.d - 0.5, 0.02, 0.04, "B07A45")
		end,
	},
	Chair = {
		body = "C08A55",
		draw = function(c)
			c:top(0, -c.d / 2 + 0.2, c.w, 0.4, 0.8, 0.9, "8B5A2B")
			c:top(0, 0.2, c.w - 0.6, c.d - 0.9, 0.05, 0.06, "C0392B") -- seat cushion
		end,
	},
	Bookshelf = {
		body = "6B4226",
		draw = function(c)
			local count = 11
			local span = c.w - 0.6
			for i = 1, count do
				local x = -span / 2 + (i - 0.5) * span / count
				local depth = c.d - 0.7 - (i % 3) * 0.2 -- books of different sizes
				local raise = 0.04 + (i % 2) * 0.03
				c:top(
					x,
					0.15,
					span / count - 0.12,
					depth,
					raise,
					0.08,
					BOOK_COLORS[(i - 1) % #BOOK_COLORS + 1]
				)
			end
		end,
	},
	Box = {
		body = "C9A06A",
		draw = function(c)
			c:top(0, 0, 0.55, c.d, 0.02, 0.04, "E6CFA1") -- tape
			c:top(0, 0, c.w, 0.08, 0.02, 0.04, "A88350") -- flap seam
			c:top(0.75, 0.75, 0.7, 0.45, 0.03, 0.04, "F4F4F4") -- shipping label
		end,
	},
	-- Wooden crate with a diagonal brace, like the original's.
	Crate = {
		body = "C8955A",
		draw = function(c)
			local t = 0.4
			c:top(0, -c.d / 2 + t / 2, c.w, t, 0.03, 0.06, "8E5F33")
			c:top(0, c.d / 2 - t / 2, c.w, t, 0.03, 0.06, "8E5F33")
			c:top(-c.w / 2 + t / 2, 0, t, c.d, 0.03, 0.06, "8E5F33")
			c:top(c.w / 2 - t / 2, 0, t, c.d, 0.03, 0.06, "8E5F33")
			c:top(0, 0, (c.w - t) * 1.3, t, 0.03, 0.06, "8E5F33", math.rad(45))
		end,
	},
	Barrel = {
		body = "8B5A2B",
		transparentBody = true,
		draw = function(c)
			c:disc(0, 0, c.w, -0.05, c.h - 0.1, "8B5A2B")
			c:disc(0, 0, c.w * 0.82, 0.01, 0.06, "A0703F")
			c:disc(0, 0, c.w * 0.3, 0.03, 0.06, "6B4226")
		end,
	},
	Wardrobe = {
		body = "7A4A2A",
		draw = function(c)
			c:top(0, 0, c.w - 0.5, c.d - 0.5, 0.02, 0.04, "8E5A32")
			c:top(0, 0, 0.12, c.d - 0.5, 0.04, 0.06, "5A3520") -- door split
		end,
	},
	Piano = {
		body = "222222",
		draw = function(c)
			c:top(0, c.d / 2 - 0.55, c.w - 0.6, 0.9, 0.04, 0.06, "F4F4F4") -- keys
			for i = 1, 9 do
				local x = -c.w / 2 + 0.3 + (c.w - 0.6) * (i / 10)
				c:top(x, c.d / 2 - 0.75, 0.18, 0.5, 0.07, 0.06, "111111") -- black keys
			end
			c:top(0, -0.6, c.w - 1.2, 1.6, 0.03, 0.06, "333333") -- lid
		end,
	},
	PoolTable = {
		body = "6B4226",
		draw = function(c)
			c:top(0, 0, c.w - 1.2, c.d - 1.2, 0.03, 0.06, "2E8B57") -- felt
			for _, x in { -1, 0, 1 } do
				for _, z in { -1, 1 } do
					c:disc(x * (c.w / 2 - 0.6), z * (c.d / 2 - 0.6), 0.6, 0.06, 0.06, "111111") -- pockets
				end
			end
			c:disc(-2, 0, 0.45, 0.1, 0.1, "FFFFFF")
			c:disc(1.5, 0.4, 0.45, 0.1, 0.1, "E5484D")
			c:disc(2, -0.5, 0.45, 0.1, 0.1, "F2C230")
		end,
	},
	-- A big yellow supercar: tapered nose, black glass with shiny streaks,
	-- wing mirrors, a vented engine cover and a black tail (nose toward -Z).
	Car = {
		body = "F5C518",
		transparentBody = true,
		draw = function(c)
			local yellow, edge, black = "F5C518", "B8860B", "151515"
			c:top(0, 1.0, c.w, c.d - 2.2, -0.6, c.h - 0.8, edge) -- outline
			c:top(0, 1.0, c.w - 0.6, c.d - 3.0, -0.4, c.h - 0.6, yellow) -- hull
			c:top(0, -6.4, 6.8, 3.2, -0.65, c.h - 1.1, edge) -- nose outline
			c:top(0, -6.6, 6.2, 2.6, -0.6, c.h - 1.0, yellow) -- nose
			for side = -1, 1, 2 do
				c:top(side * 2.9, -6.0, 2.2, 2.6, -0.6, c.h - 1.0, yellow, side * 0.45) -- nose corners
				c:top(side * 2.6, -7.1, 1.4, 0.7, -0.55, 0.1, black, side * 0.4) -- front intakes
				c:top(side * 2.6, -2.6, 1.2, 2.6, 0, 0.4, black, side * 0.35) -- windshield corners
				c:top(side * 2.75, 0.4, 0.5, 4.4, 0, 0.3, black) -- side windows
				local shine = c:top(side * 2.75, -0.2, 0.12, 1.6, 0.02, 0.05, "FFFFFF")
				shine.Transparency = 0.4
				c:top(side * 4.7, -2.6, 1.4, 0.55, -0.5, 0.3, black, side * 0.45) -- wing mirrors
				c:top(side * 3.6, 2.6, 0.7, 2.4, -0.3, 0.1, black) -- side intakes
				c:top(side * 3.0, 4.6, 2.6, 4.2, -0.2, 0.3, yellow, side * 0.12) -- rear haunches
				c:top(side * 2.6, 7.55, 1.8, 0.3, -0.35, 0.1, "C0392B") -- tail lights
				for _, z in { -4.4, 4.6 } do
					c:top(side * 4.35, z, 0.6, 2.5, -1.6, 1.0, black) -- tyres peeking out
				end
			end
			c:top(0, -2.4, 5.6, 3.0, 0, 0.4, black) -- windshield
			-- Shiny streaks across the glass.
			for _, streak in { { -0.9, 0.35, 0.3 }, { 0.4, 0.22, 0.45 }, { 1.5, 0.15, 0.6 } } do
				local part = c:top(streak[1], -2.4, streak[2], 3.2, 0.03, 0.05, "FFFFFF", 0.7)
				part.Transparency = streak[3]
			end
			c:top(0, 0.2, 5.0, 2.6, 0.05, 0.4, yellow) -- roof
			c:top(0, 3.6, 4.6, 3.4, -0.1, 0.3, black) -- engine cover
			for i = 0, 3 do
				c:top(0, 2.4 + i * 0.75, 3.6, 0.3, 0, 0.1, "5E5E5E") -- vents
			end
			c:disc(0, 3.6, 1.4, 0.02, 0.1, "7A7A7A")
			c:top(0, 7.4, 7.6, 1.2, -0.4, 0.4, black) -- tail
			for side = -1, 1, 2 do
				c:disc(side * 0.8, 7.7, 0.6, -0.3, 0.2, "9A9A9A") -- exhausts
			end
		end,
	},
	Dresser = {
		body = "8E5A32",
		draw = function(c)
			c:top(0, 0, c.w - 0.4, c.d - 0.4, 0.02, 0.04, "A0703F")
			c:disc(-1, 0.3, 0.7, 0.04, 0.06, "D9E0E6") -- mirror stand
			c:disc(1.2, 0.2, 0.5, 0.06, 0.06, "E8C26A")
		end,
	},
	Washer = {
		body = "E8ECEF",
		draw = function(c)
			c:disc(0, 0.2, 2.0, 0.03, 0.06, "B9C3CC") -- door rim
			c:disc(0, 0.2, 1.5, 0.05, 0.06, "7FB8E0") -- window
			c:top(0, -c.d / 2 + 0.3, c.w, 0.5, 0.06, 0.08, "C9D1D9") -- control strip
		end,
	},
	Desk = {
		body = "A0703F",
		draw = function(c)
			c:top(0, 0, c.w - 0.4, c.d - 0.4, 0.02, 0.04, "B88A55")
			c:top(-1.2, -0.3, 1.8, 1.2, 0.06, 0.08, "2B2B30") -- laptop
			c:top(1.4, 0.2, 1.2, 0.9, 0.05, 0.06, "F4F4F4") -- papers
		end,
	},
	TVStand = {
		body = "5A3A22",
		draw = function(c)
			c:top(0, -0.2, c.w - 0.8, 0.6, 0.15, 0.2, "1C1C20") -- TV
		end,
	},
	Bench = {
		body = "A0703F",
		draw = function(c)
			for i = -1, 1 do
				c:top(0, i * 0.6, c.w, 0.45, 0.02, 0.04, "B88A55") -- slats
			end
		end,
	},
	Lamp = {
		body = "F2E2A0",
		transparentBody = true,
		draw = function(c)
			c:disc(0, 0, 0.9, -c.h + 0.6, 0.3, "6B6B6B") -- base
			c:disc(0, 0, c.w, -0.2, 0.6, "F2E2A0") -- shade
			c:disc(0, 0, 0.5, 0.0, 0.06, "FFF8D6")
		end,
	},
	Plant = {
		body = "B5653A",
		transparentBody = true,
		draw = function(c)
			c:disc(0, 0, 2.0, -0.6, c.h - 0.6, "B5653A") -- pot
			c:disc(0, 0, 1.6, -0.55, 0.1, "5A3A22") -- soil
			for i = 0, 5 do
				local a = i / 6 * math.pi * 2 + 0.4
				local leaf = if i % 2 == 0 then "3E9B3A" else "4FB848"
				c:ball(math.cos(a) * 0.6, c.h / 2 + 0.1, math.sin(a) * 0.6, 1.0, leaf)
			end
			c:ball(0, c.h / 2 + 0.45, 0, 0.5, "F48FB1") -- a flower
			c:ball(0, c.h / 2 + 0.6, 0, 0.22, "FFE066")
		end,
	},
	Picture = {
		body = "D4A93A",
		draw = function(c)
			c:top(0, 0, c.w - 0.7, c.d - 0.7, 0.03, 0.06, "7FB8E0") -- sky
			c:top(0, 0.55, c.w - 0.7, 0.6, 0.05, 0.06, "5BAA4A") -- hill
			c:disc(0.9, -0.35, 0.6, 0.07, 0.06, "FFD54A") -- sun
		end,
	},
	Beanbag = {
		body = "E74C3C",
		transparentBody = true,
		draw = function(c)
			c:disc(0, 0, c.w + 0.3, -0.25, c.h - 0.3, "A93226") -- outline
			c:disc(0, 0, c.w, -0.2, c.h - 0.3, "E74C3C")
			c:disc(0.3, 0.3, c.w * 0.55, -0.15, 0.1, "C0392B") -- the dent you sit in
		end,
	},
	TrashCan = {
		body = "7F8C8D",
		transparentBody = true,
		draw = function(c)
			c:disc(0, 0, c.w + 0.25, -0.1, c.h - 0.2, "4D5656")
			c:disc(0, 0, c.w, -0.05, c.h - 0.2, "95A5A6")
			c:disc(0, 0, c.w * 0.8, 0, 0.06, "7F8C8D") -- lid
			c:top(0, 0, c.w * 0.5, 0.25, 0.08, 0.1, "4D5656") -- handle
			c:top(0.5, 0.45, 0.6, 0.18, 0.12, 0.08, "F7DC6F", 0.6) -- a banana peel on top
		end,
	},
	Aquarium = {
		body = "7FC8F8",
		draw = function(c)
			c:top(0, 0, c.w - 0.4, c.d - 0.4, 0.02, 0.04, "4FA3D9") -- water
			c:top(0, c.d / 2 - 0.45, c.w - 0.5, 0.4, 0.03, 0.04, "E8D3A2") -- sand
			local fishes: { { x: number, z: number, color: string } } = {
				{ x = -1.6, z = -0.2, color = "F39C12" },
				{ x = 0.4, z = 0.3, color = "E74C3C" },
				{ x = 1.7, z = -0.4, color = "F1C40F" },
			}
			for i, fish in fishes do
				local x, z, color = fish.x, fish.z, fish.color
				c:top(x, z, 0.7, 0.35, 0.05 + i * 0.01, 0.04, color) -- fish
				c:top(x + 0.45, z, 0.25, 0.3, 0.05 + i * 0.01, 0.04, color, math.rad(45)) -- tails
			end
			c:top(-2.3, 0.6, 0.15, 0.8, 0.04, 0.05, "27AE60") -- seaweed
			c:disc(2.4, 0.5, 0.25, 0.07, 0.04, "FFFFFF") -- bubbles
			c:disc(2.2, 0.1, 0.18, 0.07, 0.04, "FFFFFF")
		end,
	},
	Arcade = {
		body = "6C3483",
		draw = function(c)
			c:top(0, -0.35, c.w - 0.6, 1.4, 0.04, 0.06, "111111") -- screen
			for i, color in { "E74C3C", "F1C40F", "2ECC71", "3498DB" } do
				c:top(-0.9 + i * 0.36, -0.35 + (i % 2) * 0.3, 0.25, 0.25, 0.06, 0.04, color) -- pixels
			end
			c:disc(-0.6, 0.85, 0.45, 0.2, 0.25, "E74C3C") -- joystick
			c:disc(0.4, 0.85, 0.3, 0.08, 0.08, "F1C40F") -- buttons
			c:disc(0.9, 0.85, 0.3, 0.08, 0.08, "3498DB")
		end,
	},
	VendingMachine = {
		body = "C0392B",
		draw = function(c)
			c:top(-0.4, 0, c.w - 1.6, c.d - 0.6, 0.03, 0.05, "B3E5FC") -- glass
			local colors = { "E74C3C", "3498DB", "2ECC71", "F1C40F", "9B59B6", "E67E22" }
			for row = 0, 2 do
				for col = 0, 2 do
					c:disc(
						-1.5 + col * 0.8,
						-0.8 + row * 0.8,
						0.45,
						0.06,
						0.04,
						colors[(row * 3 + col) % #colors + 1]
					) -- cans
				end
			end
			c:top(c.w / 2 - 0.55, -0.4, 0.5, 0.9, 0.05, 0.06, "2B2B30") -- coin slot panel
			c:top(c.w / 2 - 0.55, 0.6, 0.5, 0.25, 0.06, 0.06, "F1C40F")
		end,
	},
	Treadmill = {
		body = "3A3A3A",
		draw = function(c)
			c:top(0, 0.4, c.w - 0.8, c.d - 1.6, 0.02, 0.04, "222222") -- belt
			for i = -2, 2 do
				c:top(0, 0.4 + i * 1.1, c.w - 0.9, 0.06, 0.04, 0.03, "4A4A4A") -- belt slats
			end
			c:top(0, -c.d / 2 + 0.4, c.w, 0.8, 0.5, 0.5, "5D6D7E") -- console
			c:top(0, -c.d / 2 + 0.4, 1.0, 0.4, 0.52, 0.5, "2ECC71") -- display
		end,
	},
	-- Green rug with a pale border and a fringe on the short ends, like the original.
	Rug = {
		body = "A9C7B8",
		draw = function(c)
			c:top(0, 0, c.w - 0.8, c.d - 0.8, 0.02, 0.02, "2DB35A")
			c:top(0, 0, c.w - 1.6, c.d - 1.6, 0.04, 0.02, "34BF62")
			for i = 0, 11 do
				local z = -c.d / 2 + 0.5 + (c.d - 1) * i / 11
				for _, side in { -1, 1 } do
					c:top(side * (c.w / 2 + 0.25), z, 0.5, 0.08, 0.0, 0.02, "C9D9CF")
				end
			end
			c:disc(-c.w / 4, c.d / 5, 0.5, 0.06, 0.02, "1F8F45")
			c:disc(c.w / 4, -c.d / 5, 0.4, 0.06, 0.02, "1F8F45")
		end,
	},
}

local UPRIGHT_FRAME = CFrame.fromMatrix(Vector3.zero, Vector3.yAxis, Vector3.zAxis) -- X axis points up

export type Built = {
	model: Model,
	body: Part,
	kind: string,
	weight: FurnitureSpecs.Weight,
	decor: boolean,
	home: CFrame,
}

function FurnitureBuilder.build(spot: MapLayout.FurnitureSpot, parent: Instance): Built
	local spec = FurnitureSpecs.get(spot.kind)
	local design = DESIGNS[spot.kind]
	local floorTop = MapLayout.HEIGHTS.Floor
	local decor = spec.decor == true
	local baseY = if decor then MapLayout.HEIGHTS.Rug - spec.h / 2 else floorTop + spec.h / 2 + 0.02
	local home = CFrame.new(spot.x, baseY, spot.z) * CFrame.Angles(0, math.rad(spot.rot), 0)

	local model = Instance.new("Model")
	model.Name = spot.kind
	local body = Parts.make({
		name = "Body",
		size = Vector3.new(spec.w, spec.h, spec.d),
		cframe = home,
		color = design.body,
		transparency = if design.transparentBody then 1 else 0,
		parent = model,
	})
	model.PrimaryPart = body

	design.draw(newCtx(model, body, spec.w, spec.d, spec.h))

	if not design.transparentBody and not decor then
		-- A darker, slightly bigger copy just under the top: from above it
		-- draws the thick outline the original's furniture has.
		local base = Color3.fromHex(design.body)
		Parts.make({
			name = "Outline",
			size = Vector3.new(spec.w + 0.4, spec.h - 0.04, spec.d + 0.4),
			cframe = home * CFrame.new(0, -0.02, 0),
			color = Color3.new(base.R * 0.55, base.G * 0.55, base.B * 0.55),
			parent = model,
		})
	end

	if decor then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
			end
		end
		model.Parent = parent
		return {
			model = model,
			body = body,
			kind = spot.kind,
			weight = spec.weight,
			decor = true,
			home = home,
		}
	end

	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and part ~= body then
			Parts.makeVisual(part)
			Parts.weldInPlace(body, part)
		end
	end

	body.Anchored = false
	body.CollisionGroup = "Furniture"
	-- Low friction with weight 1: floors (friction 0, weight 100) let pieces
	-- glide at exactly the speed FurnitureService sets, while walls (friction
	-- 1, weight 100) grip them, so a barricade pressed into a doorway holds.
	body.CustomPhysicalProperties =
		PhysicalProperties.new(Config.FURNITURE_DENSITY[spec.weight], 0.3, 0, 1, 1)

	-- Stay upright but spin freely around the vertical axis.
	local attachment = Instance.new("Attachment")
	attachment.Name = "Upright"
	attachment.CFrame = UPRIGHT_FRAME
	attachment.Parent = body
	local align = Instance.new("AlignOrientation")
	align.Name = "KeepUpright"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.AlignType = Enum.AlignType.PrimaryAxisParallel
	align.Attachment0 = attachment
	align.CFrame = UPRIGHT_FRAME
	align.MaxTorque = 1e7
	align.Responsiveness = 40
	align.Parent = body

	model:SetAttribute("Weight", spec.weight)
	model:SetAttribute("OwnerUserId", 0)
	model.Parent = parent
	return { model = model, body = body, kind = spot.kind, weight = spec.weight, decor = false, home = home }
end

return FurnitureBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">FurnitureService</string>
          <string name="Source"><![CDATA[-- Owns every furniture piece: builds them, decides who simulates each one,
-- and resets them each round.
--
-- Responsiveness: when you push a piece, your client asks for it ("claim")
-- and the server hands you its physics, so it moves the instant you push
-- and stops the instant you stop, with no network lag. If anyone else pushes
-- the same piece (a zombie on the other side of a barricade, another player,
-- a bot), the server takes it back and resolves everyone's pushes itself, so
-- a barricade standoff is fair. Pieces nobody pushes stand perfectly still.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureBuilder = require(script.Parent.FurnitureBuilder)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

local FurnitureService = {}

type Piece = FurnitureBuilder.Built & {
	owner: Player?,
	lastClaim: number,
	pushers: { [string]: number }, -- participant id -> last time seen pushing
	contestedUntil: number,
	tugOfWar: boolean, -- contestedUntil came from two pushers, not a shove
	burst: Vector3,
	burstUntil: number,
	burstLength: number,
	lastGood: CFrame, -- last position that passed the anti-cheat checks
	lastGoodAt: number, -- when the piece last moved to lastGood
}

-- Someone who can push furniture. `reach` is set while they hold a melee
-- weapon, whose shaft (along `aim`) pushes too.
export type Mover = {
	root: BasePart,
	humanoid: Humanoid,
	id: string,
	scale: number,
	aim: Vector3,
	firmness: number?, -- held weapon's Items.firmness
	guard: number?, -- held weapon's Items.guard
	reach: number?,
	zombie: boolean?, -- a zombie's arms push furniture too
}

local OWNER = FurniturePush.OWNER_ATTRIBUTE
local CONTEST_SECONDS = 0.8

local pieces: { Piece } = {}
local byBody: { [BasePart]: Piece } = {}
local byModel: { [Instance]: Piece } = {}
local folder: Folder
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local getMovers: () -> { Mover } = function()
	return {}
end

local function serverOwns(piece: Piece)
	piece.owner = nil
	pcall(function()
		piece.body:SetNetworkOwner(nil)
	end)
	piece.model:SetAttribute(OWNER, 0)
end

local function stop(piece: Piece)
	local v = piece.body.AssemblyLinearVelocity
	piece.body.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
	piece.body.AssemblyAngularVelocity = Vector3.zero
end

-- Takes a piece back from a client (optionally blocking new claims for a
-- bit). In a tug of war the piece keeps moving: the server writes the
-- resolved velocity the same frame, so stopping it would only cause a snap.
local function revoke(piece: Piece, blockSeconds: number, halt: boolean?)
	if piece.owner then
		serverOwns(piece)
		if halt ~= false then
			stop(piece)
		end
	end
	piece.contestedUntil = math.max(piece.contestedUntil, os.clock() + blockSeconds)
end

-- True if anyone other than `id` pushed the piece in the last moment.
local function othersPushing(piece: Piece, id: string, now: number): boolean
	for other, seen in piece.pushers do
		if other ~= id and now - seen <= 0.3 then
			return true
		end
	end
	return false
end

local function grant(piece: Piece, player: Player)
	local ok = pcall(function()
		piece.body:SetNetworkOwner(player)
	end)
	if ok then
		piece.owner = player
		piece.model:SetAttribute(OWNER, player.UserId)
	end
end

function FurnitureService.build(layout: MapLayout.Layout)
	folder = workspace:WaitForChild("Furniture") :: Folder
	folder:ClearAllChildren()
	table.clear(pieces)
	table.clear(byBody)
	table.clear(byModel)
	for _, spot in layout.furniture do
		local built = FurnitureBuilder.build(spot, folder)
		if not built.decor then
			local piece = built :: Piece
			piece.owner = nil
			piece.lastClaim = 0
			piece.pushers = {}
			piece.contestedUntil = 0
			piece.tugOfWar = false
			piece.burst = Vector3.zero
			piece.burstUntil = 0
			piece.burstLength = 1
			piece.lastGood = built.home
			piece.lastGoodAt = 0
			table.insert(pieces, piece)
			byBody[built.body] = piece
			byModel[built.model] = piece
			serverOwns(piece)
		end
	end
	overlap.FilterDescendantsInstances = { folder }
end

-- A sudden shove (shotgun blast, potato hit): the server takes the piece and
-- moves it at `velocity`, easing to a stop over `seconds`.
function FurnitureService.shove(body: BasePart, velocity: Vector3, seconds: number)
	local piece = byBody[body]
	if not piece then
		return
	end
	revoke(piece, seconds + 0.2)
	piece.burst = Vector3.new(velocity.X, 0, velocity.Z)
	piece.burstLength = seconds
	piece.burstUntil = os.clock() + seconds
end

function FurnitureService.pieceOf(part: BasePart): FurnitureBuilder.Built?
	return byBody[part]
end

function FurnitureService.weightOf(body: BasePart): string?
	local piece = byBody[body]
	return piece and piece.weight
end

function FurnitureService.findInBox(cframe: CFrame, size: Vector3): { BasePart }
	local found = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, overlap) do
		if byBody[part] then
			table.insert(found, part)
		end
	end
	return found
end

function FurnitureService.resetAll()
	for _, piece in pieces do
		serverOwns(piece)
		piece.contestedUntil = 0
		piece.tugOfWar = false
		piece.burstUntil = 0
		table.clear(piece.pushers)
		piece.model:PivotTo(piece.home)
		piece.lastGood = piece.home
		piece.body.AssemblyLinearVelocity = Vector3.zero
		piece.body.AssemblyAngularVelocity = Vector3.zero
	end
end

-- A client asks to drive the pieces it is pushing.
local function onClaim(player: Player, list: unknown)
	if typeof(list) ~= "table" then
		return
	end
	local claims = list :: { unknown }
	if #claims > 16 then
		return
	end
	local p = Participants.fromPlayer(player)
	local root = p and Participants.body(p)
	if not p or not root then
		return
	end
	local now = os.clock()
	for _, model in claims do
		local piece = if typeof(model) == "Instance" then byModel[model] else nil
		if not piece or now < piece.contestedUntil or now < piece.burstUntil then
			continue
		end
		if piece.owner and piece.owner ~= player then
			revoke(piece, CONTEST_SECONDS, false) -- two players fighting over it: server decides
			continue
		end
		if othersPushing(piece, p.id, now) then
			continue -- someone else is on it too: the server settles that
		end
		-- Only pieces you could actually be touching (body or longest weapon).
		local range = piece.body.Size.Magnitude / 2 + root.Size.X / 2 + 12 * math.max(1, p.scale) + 3
		if Util.flatDistance(piece.body.Position, root.Position) > range then
			continue
		end
		piece.lastClaim = now
		if piece.owner ~= player then
			grant(piece, player)
		end
	end
end

-- Pushers in a line add up: someone walking into the back of another mover
-- heading the same way leans on them and lends them their strength (a
-- little less per link), so a queue of zombies at a barricade shoves as one.
type Lean = { dir: Vector3?, own: number, leaners: { number } }

local function leanGraph(movers: { Mover }): { Lean }
	local shell = Config.CHARACTER.ShellDiameter / 2
	local leans: { Lean } = {}
	for i, mover in movers do
		local move = mover.humanoid.MoveDirection
		local flat = Vector3.new(move.X, 0, move.Z)
		local moving = flat.Magnitude > 0.1 and mover.humanoid.WalkSpeed > 0
		leans[i] = {
			dir = if moving then flat.Unit else nil,
			own = RoundRules.pushStrength(mover.scale),
			leaners = {},
		}
	end
	for i, a in leans do
		local dir = a.dir
		if not dir then
			continue
		end
		local ra = shell * movers[i].scale
		local here = movers[i].root.Position
		local best, bestAlong = nil, math.huge
		for j, b in leans do
			local bDir = b.dir
			if j == i or not bDir or bDir:Dot(dir) < 0.3 then
				continue
			end
			local rb = shell * movers[j].scale
			local rel = movers[j].root.Position - here
			rel = Vector3.new(rel.X, 0, rel.Z)
			local along = rel:Dot(dir)
			local side = (rel - dir * along).Magnitude
			if along > 0.2 and along < ra + rb + 0.8 and side < (ra + rb) * 0.9 and along < bestAlong then
				best, bestAlong = j, along
			end
		end
		if best then
			table.insert(leans[best].leaners, i)
		end
	end
	return leans
end

-- Strength of mover `i` plus everyone leaning on it (and on them...); adds
-- every helper's id to `helpers`.
local function chained(
	movers: { Mover },
	leans: { Lean },
	i: number,
	helpers: { string },
	seen: { [number]: boolean }
): number
	seen[i] = true
	local total = leans[i].own
	for _, j in leans[i].leaners do
		if not seen[j] then
			table.insert(helpers, movers[j].id)
			total += chained(movers, leans, j, helpers, seen) * Config.PUSH_CHAIN_SHARE
		end
	end
	return total
end

local function collectPushes(now: number): FurniturePush.Pushes
	local pushes: FurniturePush.Pushes = {}
	local movers = getMovers()
	local leans = leanGraph(movers)
	for i, mover in movers do
		local humanoid, root = mover.humanoid, mover.root
		local walk = humanoid.WalkSpeed
		if walk <= 0 then
			continue
		end
		local dir = leans[i].dir
		local moving = dir ~= nil
		local strength = leans[i].own
		local helpers: { string } = {}
		if moving and #leans[i].leaners > 0 then
			strength = chained(movers, leans, i, helpers, {})
		end
		local touched: { [BasePart]: boolean } = {}
		local function pushing(piece: Piece)
			piece.pushers[mover.id] = now
			for _, id in helpers do
				piece.pushers[id] = now
			end
		end
		if dir then
			local probe, size = FurniturePush.moverProbe(root, dir, mover.scale)
			for _, part in workspace:GetPartBoundsInBox(probe, size, overlap) do
				local piece = byBody[part]
				if piece then
					touched[part] = true
					pushing(piece)
					FurniturePush.add(pushes, part, dir * walk, strength, probe.Position)
				end
			end
		end
		-- A zombie's arms are solid: walking, they push what they touch along
		-- with the body; standing or turning, they shove it out of the way.
		if mover.zombie then
			local probe, size = FurniturePush.armsProbe(
				root,
				mover.scale,
				CharacterLook.ZOMBIE_ARM_REACH,
				CharacterLook.ZOMBIE_ARM_SPAN
			)
			for _, part in workspace:GetPartBoundsInBox(probe, size, overlap) do
				local piece = byBody[part]
				if piece and not touched[part] then
					touched[part] = true
					if dir then
						pushing(piece)
						FurniturePush.add(pushes, part, dir * walk, strength, probe.Position)
					else
						local exit = FurniturePush.shaftExit(root.Position, probe.LookVector, part)
						FurniturePush.add(
							pushes,
							part,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							strength,
							nil
						)
					end
				end
			end
		end
		-- A held weapon's shaft is solid, same as on the client: it pushes
		-- what it touches along your path, or out of its way when you stand
		-- still or turn.
		if mover.reach then
			local grip = CharacterLook.grip(mover.scale)
			local hand = (root.CFrame * grip).Position
			local shaft, shaftSize = FurniturePush.itemProbe(root, grip, mover.aim, mover.reach, mover.guard)
			local firm = leans[i].own * (mover.firmness or 1)
			for _, part in workspace:GetPartBoundsInBox(shaft, shaftSize, overlap) do
				local piece = byBody[part]
				if piece and not touched[part] then
					if dir then
						-- Only walking counts as pushing for ownership: someone just
						-- standing near a piece with a weapon out shouldn't take it
						-- away from the player driving it.
						piece.pushers[mover.id] = now
						FurniturePush.add(pushes, part, dir * walk, firm, part.Position + mover.aim * 0.5)
					else
						local exit = FurniturePush.shaftExit(hand, mover.aim, part)
						FurniturePush.add(
							pushes,
							part,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							firm,
							nil
						)
					end
				end
			end
		end
	end
	-- A pushed piece pushes whatever it runs into, so a shove moves a whole
	-- barricade (two links deep).
	for _ = 1, 2 do
		for body, push in table.clone(pushes) do
			local velocity = FurniturePush.resolve(body, push)
			local ahead = Util.flatUnit(velocity)
			if ahead and velocity.Magnitude > 0.5 then
				local center = body.Position + ahead * (FurniturePush.extent(body, ahead) + 0.6)
				local side = Vector3.new(-ahead.Z, 0, ahead.X)
				local width = FurniturePush.extent(body, side) * 2 * 0.9
				local probe = CFrame.lookAt(center, center + ahead)
				for _, other in workspace:GetPartBoundsInBox(probe, Vector3.new(width, 2, 1.2), overlap) do
					if other ~= body and byBody[other] and not pushes[other] then
						FurniturePush.add(pushes, other, velocity, push.strength, center)
					end
				end
			end
		end
	end
	return pushes
end

-- Is a client-driven piece somewhere a legitimate push could have put it?
local function plausible(piece: Piece, now: number): boolean
	local body = piece.body
	local owner = piece.owner
	local p = owner and Participants.fromPlayer(owner)
	local root = p and Participants.body(p)
	if not p or not root then
		return false
	end
	local v = body.AssemblyLinearVelocity
	if Vector3.new(v.X, 0, v.Z).Magnitude > Config.FURNITURE_MAX_SPEED * 1.5 or v.Y > 8 then
		return false
	end
	if body.AssemblyAngularVelocity.Magnitude > 3 then
		return false
	end
	-- Client positions arrive in bursts, so compare against the time since
	-- the piece last moved, not one server frame (capped so a piece that sat
	-- still for a while can't jump far).
	local moved = Util.flatDistance(body.Position, piece.lastGood.Position)
	local elapsed = math.clamp(now - piece.lastGoodAt, 1 / 60, 0.3)
	if moved > Config.FURNITURE_MAX_SPEED * 1.6 * elapsed + 1.5 then
		return false -- teleported
	end
	local range = body.Size.Magnitude / 2 + root.Size.X / 2 + 14 * math.max(1, p.scale) + 6
	return Util.flatDistance(body.Position, root.Position) <= range
end

local function step(dt: number)
	local now = os.clock()
	local pushes = collectPushes(now)
	for _, piece in pieces do
		local body = piece.body
		if body.Parent == nil then
			continue
		end

		-- Who is pushing this piece right now (seen by the server)?
		local owner = piece.owner
		local ownerId = if owner then "P" .. owner.UserId else ""
		local active, someoneElse = 0, false
		for id, seen in piece.pushers do
			if now - seen > 0.3 then
				piece.pushers[id] = nil
			else
				active += 1
				if owner and id ~= ownerId then
					someoneElse = true
				end
			end
		end
		if now >= piece.contestedUntil then
			piece.tugOfWar = false
		end
		if active >= 2 or someoneElse then
			-- A tug of war: the server simulates it so both sides count.
			piece.tugOfWar = true
			revoke(piece, CONTEST_SECONDS, false)
		elseif not owner and piece.tugOfWar and now < piece.contestedUntil and active >= 1 then
			-- Keep the server in charge until the tug of war is really over.
			piece.contestedUntil = now + CONTEST_SECONDS
		elseif owner then
			if owner.Parent ~= Players or now - piece.lastClaim > Config.FURNITURE_RELEASE_SECONDS then
				revoke(piece, 0)
			elseif not plausible(piece, now) then
				-- Moved in a way no push could: put it back and take it away.
				revoke(piece, 1.5)
				piece.model:PivotTo(piece.lastGood)
			end
		end
		if piece.owner then
			-- Only advance when a new position has arrived (see plausible).
			if (body.Position - piece.lastGood.Position).Magnitude > 0.01 then
				piece.lastGood, piece.lastGoodAt = body.CFrame, now
			end
		end

		if piece.owner == nil then
			piece.lastGood, piece.lastGoodAt = body.CFrame, now
			local v = body.AssemblyLinearVelocity
			if now < piece.burstUntil then
				local k = (piece.burstUntil - now) / piece.burstLength
				body.AssemblyLinearVelocity =
					Vector3.new(piece.burst.X * k, math.min(v.Y, 0), piece.burst.Z * k)
			else
				local push = pushes[body]
				if push then
					local velocity, spin = FurniturePush.resolve(body, push)
					body.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(v.Y, 0), velocity.Z)
					body.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
				elseif
					math.abs(v.X) + math.abs(v.Z) > 0.02 or body.AssemblyAngularVelocity.Magnitude > 0.02
				then
					stop(piece) -- no sliding
				end
			end
		end
	end
end

function FurnitureService.start(movers: () -> { Mover })
	getMovers = movers
	Remotes.unreliable("PushClaim").OnServerEvent:Connect(onClaim)
	Players.PlayerRemoving:Connect(function(player)
		for _, piece in pieces do
			if piece.owner == player then
				revoke(piece, 0)
			end
		end
	end)
	RunService.Heartbeat:Connect(step)
end

return FurnitureService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Held items and items lying on the ground. Each human holds at most one
-- item (shown in their right hand). E picks up the nearest ground item, G
-- drops, left click uses. Becoming a zombie drops whatever you held.
-- Every use is validated and resolved here on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Combat = require(script.Parent.Combat)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local MapBuilder = require(script.Parent.MapBuilder)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Traps = require(script.Parent.Traps)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local ItemService = {}

local groundFolder: Folder
local rng = Random.new()

-- Hand models -------------------------------------------------------------------

local function attachHeld(p: Participant)
	local character = p.character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldItem")
	if old then
		old:Destroy()
	end
	if not p.heldItem or p.team ~= "Human" then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local model = ItemModels.build(p.heldItem)
	model.Name = "HeldItem"
	model:SetAttribute("ItemId", p.heldItem) -- clients read it for weapon force fields
	local handle = model.PrimaryPart :: BasePart
	local s = p.scale
	local grip = CharacterLook.grip(s)
	model:PivotTo(root.CFrame * grip)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			Parts.makeVisual(part)
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "GripWeld"
	weld.Part0 = root
	weld.Part1 = handle
	weld.C0 = grip
	weld.Parent = handle
	model.Parent = character
end

function ItemService.refreshHand(p: Participant)
	attachHeld(p)
end

local function setStreaming(p: Participant, itemId: string?)
	p.streaming = itemId ~= nil
	if p.character then
		p.character:SetAttribute("Spraying", itemId) -- clients draw the spray
	end
end

-- Inventory ----------------------------------------------------------------------------
-- Config.INVENTORY_SLOTS slots; the active one is in your hand. p.heldItem and
-- p.heldCharges mirror the active slot, so everything else just reads those.

local function publishSlots(p: Participant)
	for i = 1, Config.INVENTORY_SLOTS do
		local slot = p.slots[i]
		p.state:SetAttribute("Slot" .. i, if slot then slot.id else "")
		p.state:SetAttribute("Slot" .. i .. "Charges", if slot then slot.charges or 0 else 0)
	end
	p.state:SetAttribute("ActiveSlot", p.slot)
end

-- Puts the active slot's item in the hand.
local function equipActive(p: Participant)
	local slot = p.slots[p.slot]
	p.heldItem = if slot then slot.id else nil
	p.heldCharges = if slot then slot.charges else nil
	setStreaming(p, nil)
	p.state:SetAttribute("HeldItem", p.heldItem or "")
	p.state:SetAttribute("HeldCharges", p.heldCharges or 0)
	publishSlots(p)
	attachHeld(p)
end

-- Sets (or empties) the active slot.
local function setHeld(p: Participant, itemId: string?, charges: number?)
	if itemId then
		local item = Items.get(itemId)
		p.slots[p.slot] = { id = itemId, charges = charges or (item and item.charges) }
	else
		p.slots[p.slot] = nil
	end
	equipActive(p)
end

-- Charges left on the item in hand (peels, water, fuel).
local function setCharges(p: Participant, charges: number)
	p.heldCharges = charges
	local slot = p.slots[p.slot]
	if slot then
		slot.charges = charges
	end
	p.state:SetAttribute("HeldCharges", charges)
	publishSlots(p)
end

function ItemService.hasFreeSlot(p: Participant): boolean
	for i = 1, Config.INVENTORY_SLOTS do
		if not p.slots[i] then
			return true
		end
	end
	return false
end

function ItemService.carries(p: Participant, itemId: string): boolean
	for _, slot in p.slots do
		if slot.id == itemId then
			return true
		end
	end
	return false
end

-- Switches which slot is in your hand.
function ItemService.select(p: Participant, slot: number)
	if slot >= 1 and slot <= Config.INVENTORY_SLOTS and slot ~= p.slot then
		p.slot = slot
		equipActive(p)
	end
end

-- Ground items -----------------------------------------------------------------------

function ItemService.spawnGround(itemId: string, position: Vector3, charges: number?): Model
	local model = ItemModels.build(itemId)
	model.Name = itemId
	-- Built at the origin, so the bounding box center is the offset to undo.
	local center = model:GetBoundingBox().Position
	local y = MapLayout.HEIGHTS.Floor + 0.55
	local spin = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	model:PivotTo(CFrame.new(position.X, y, position.Z) * spin * CFrame.new(-center.X, 0, -center.Z))
	local ring = Parts.disc(
		"Ring",
		Vector3.new(position.X, MapLayout.HEIGHTS.Floor + 0.05, position.Z),
		4,
		0.06,
		"FFFFFF",
		model
	)
	ring.Transparency = 0.55
	ring.CanCollide = false
	ring.CanQuery = false
	model:SetAttribute("ItemId", itemId)
	model:SetAttribute("Charges", charges)
	model:SetAttribute("SpotX", position.X)
	model:SetAttribute("SpotZ", position.Z)
	model.Parent = groundFolder
	return model
end

local function groundSpot(model: Model): Vector3
	return Vector3.new(model:GetAttribute("SpotX") :: number, 0, model:GetAttribute("SpotZ") :: number)
end

function ItemService.clearGround()
	groundFolder:ClearAllChildren()
end

function ItemService.scatter()
	local count = rng:NextInteger(Config.GROUND_ITEMS_MIN, Config.GROUND_ITEMS_MAX)
	local spots = table.clone(MapLayout.current().itemSpots)
	local pool = Items.groundTable()
	local total = 0
	for _, entry in pool do
		total += entry.weight
	end
	for _ = 1, math.min(count, #spots) do
		local spot = table.remove(spots, rng:NextInteger(1, #spots)) :: MapLayout.Point
		local roll = rng:NextNumber() * total
		local chosen = pool[#pool].id
		for _, entry in pool do
			roll -= entry.weight
			if roll < 0 then
				chosen = entry.id
				break
			end
		end
		ItemService.spawnGround(chosen, Vector3.new(spot.x, 0, spot.z))
	end
end

-- Holding ----------------------------------------------------------------------------

-- Adds an item: into your hand if it's empty, else into the first free
-- slot. With every slot full, the item in your hand is dropped for it.
function ItemService.give(p: Participant, itemId: string, charges: number?)
	if p.slots[p.slot] then
		for i = 1, Config.INVENTORY_SLOTS do
			if not p.slots[i] then
				local item = Items.get(itemId)
				p.slots[i] = { id = itemId, charges = charges or (item and item.charges) }
				publishSlots(p)
				return
			end
		end
		ItemService.drop(p)
	end
	setHeld(p, itemId, charges)
end

function ItemService.drop(p: Participant)
	local itemId = p.heldItem
	if not itemId then
		return
	end
	local root = Participants.body(p)
	if root then
		local spot = root.Position + p.aim * (root.Size.X / 2 + 2)
		ItemService.spawnGround(itemId, spot, p.heldCharges)
	end
	setHeld(p, nil)
end

function ItemService.take(p: Participant)
	setHeld(p, nil)
end

function ItemService.pickUp(p: Participant)
	if p.team ~= "Human" then
		return
	end
	local root = Participants.body(p)
	if not root then
		return
	end
	local best: Model? = nil
	local bestDistance = Config.PICKUP_RADIUS * math.max(1, p.scale)
	for _, model in groundFolder:GetChildren() do
		if model:IsA("Model") then
			local d = Util.flatDistance(groundSpot(model), root.Position)
			if d <= bestDistance then
				best, bestDistance = model, d
			end
		end
	end
	if not best then
		return
	end
	local itemId = best:GetAttribute("ItemId") :: string
	local charges = best:GetAttribute("Charges")
	best:Destroy()
	ItemService.give(p, itemId, if typeof(charges) == "number" then charges else nil)
	Announcer.fx("Pickup", { position = root.Position })
end

-- Getting eaten loses everything you carry (items should be rare: mostly bought).
function ItemService.onInfected(p: Participant)
	table.clear(p.slots)
	equipActive(p)
end

-- Melee weapons without `hits` only keep zombies away while held; a click
-- does nothing.
local function canUse(item: Items.Item): boolean
	return item.kind ~= "Melee" or item.hits == true
end

-- Using ----------------------------------------------------------------------------

local function breakWallAhead(p: Participant, aim: Vector3, reach: number): boolean
	local root = Participants.body(p)
	if not root then
		return false
	end
	for _, angle in { 0, 0.18, -0.18 } do
		local direction = (CFrame.Angles(0, angle, 0) * aim) * reach
		local result = workspace:Raycast(root.Position, direction, Combat.wallParams())
		if result then
			local segment = MapBuilder.segmentOf(result.Instance)
			if segment and MapBuilder.breakSegment(segment) then
				local wall = segment.PrimaryPart
				if wall then
					Announcer.fx("WallBreak", { cframe = wall.CFrame, size = wall.Size })
				end
				return true
			end
		end
	end
	return false
end

local function use(p: Participant, item: Items.Item, aim: Vector3)
	local root = Participants.body(p)
	if not root then
		return
	end
	local kind = item.kind
	if kind == "Melee" or kind == "Blast" then
		local reach = (item.reach or 5) * math.max(1, p.scale * 0.9)
		for _, hit in Combat.peopleInCone(p, aim, reach, item.arc or 90) do
			local direction = if item.straight then aim else hit.direction
			Combat.knockback(hit.target, direction * (item.knockback or 50), item.stun or 0.3)
			local zRoot = Participants.body(hit.target)
			if zRoot and item.fx then
				Announcer.fx("Hit", { position = zRoot.Position, fx = item.fx })
			end
			if item.effect == "Plunge" then
				Announcer.fx(
					"Plunged",
					{ character = hit.target.character, seconds = item.effectSeconds or 1.5 }
				)
			end
		end
		if kind == "Blast" then
			Announcer.fx("Blast", { origin = root.Position, direction = aim, reach = reach, item = item.id })
			if item.breaksWalls then
				breakWallAhead(p, aim, reach)
			end
			-- The blast also throws furniture around (heavier pieces less).
			local center = root.Position + aim * (reach / 2)
			for _, body in
				FurnitureService.findInBox(
					CFrame.lookAt(center, center + aim),
					Vector3.new(reach * 0.9, 4, reach)
				)
			do
				local away = Util.flatUnit(body.Position - root.Position) or aim
				local mass = (Config.FURNITURE_MASS :: { [string]: number })[FurnitureService.weightOf(body) or "Medium"]
					or 0.45
				FurnitureService.shove(body, away * 28 * math.clamp(1 - mass / 1.6, 0.15, 1), 0.35)
			end
		else
			Announcer.fx("Swing", { character = p.character, item = item.id })
		end
	elseif kind == "Projectile" then
		Projectiles.fire(p, item, aim)
		Announcer.fx("Shoot", { character = p.character, item = item.id })
	elseif kind == "Trap" then
		Traps.place(root.Position - aim * (root.Size.X / 2 + 0.6), item, p)
		Announcer.fx("Drop", { position = root.Position })
		setCharges(p, (p.heldCharges or 1) - 1)
		if (p.heldCharges or 0) <= 0 then
			ItemService.take(p)
		end
	elseif kind == "Consumable" and item.speedBoost then
		CharacterService.speedEffect(p, item.speedBoost, item.boostSeconds or 8)
		ItemService.take(p)
		Announcer.fx("Gulp", { position = root.Position, character = p.character })
		if p.player then
			Announcer.toast(
				p.player,
				"Zoom! Faster for " .. (item.boostSeconds or 8) .. " seconds",
				Config.COLORS.Good
			)
		end
	elseif kind == "Consumable" then
		local before = p.immunity
		Participants.setImmunity(p, p.immunity + (item.immunity or 0))
		ItemService.take(p)
		Announcer.fx("Eat", { position = root.Position })
		if p.player then
			Announcer.toast(
				p.player,
				string.format("Immunity %d -> %d / %d", before, p.immunity, Config.IMMUNITY_MAX),
				Config.COLORS.Good
			)
		end
	elseif kind == "Passive" then
		if p.player then
			Announcer.toast(
				p.player,
				string.format("Hold this when the round ends: +%d%% score", (item.rewardBonus or 0) * 100)
			)
		end
	end
end

local function onUse(player: Player, action: unknown, aim: unknown)
	local p = Participants.fromPlayer(player)
	if not p or typeof(aim) ~= "Vector3" then
		return
	end
	local direction = Util.flatUnit(aim :: Vector3)
	if not direction then
		return
	end
	p.aim = direction
	if action == "stop" then
		setStreaming(p, nil)
		return
	end
	if action ~= "start" or p.team ~= "Human" then
		return
	end
	local item = Items.get(p.heldItem)
	if not item then
		return
	end
	if item.kind == "Stream" then
		setStreaming(p, item.id) -- sprays until "stop" (see streamStep)
		return
	end
	if not canUse(item) then
		return
	end
	local now = os.clock()
	if now < p.itemReadyAt then
		return
	end
	p.itemReadyAt = now + (item.cooldown or 0.5)
	use(p, item, direction)
end

-- Bots use their held item with the same rules and cooldowns as players
-- (streams spray for a moment).
function ItemService.botUse(p: Participant, aim: Vector3)
	local direction = Util.flatUnit(aim)
	local item = Items.get(p.heldItem)
	if not direction or not item or p.team ~= "Human" then
		return
	end
	p.aim = direction
	if item.kind == "Stream" then
		setStreaming(p, item.id)
		task.delay(0.6, function()
			if p.heldItem == item.id then
				setStreaming(p, nil)
			end
		end)
		return
	end
	if not canUse(item) then
		return
	end
	local now = os.clock()
	if now < p.itemReadyAt then
		return
	end
	p.itemReadyAt = now + (item.cooldown or 0.5)
	use(p, item, direction)
end

-- Held melee weapons are solid to people too: anyone else (zombie or human)
-- touching the shaft (within the item's `guard`) is shoved off it in short
-- pulses, so a stick held across a doorway keeps zombies out. Firm weapons
-- (bat, pan) hold people completely; soft ones (pool noodle) give, so they
-- squeeze past. A bigger holder holds harder, a bigger person pushes
-- through easier.
local SHAFT_INTERVAL = 1 / 15
local nextShaftStep = 0

local function shaftStep()
	local now = os.clock()
	if now < nextShaftStep then
		return
	end
	nextShaftStep = now + SHAFT_INTERVAL
	local people = Participants.all()
	for _, p in Participants.onTeam("Human") do
		local item = Items.get(p.heldItem)
		local root = Participants.body(p)
		if not item or item.kind ~= "Melee" or not root then
			continue
		end
		local reach = (item.reach or 5) * math.max(1, p.scale * 0.9)
		local guard = item.guard or 0.5
		local hand = (root.CFrame * CharacterLook.grip(p.scale)).Position
		local start = Vector3.new(hand.X, 0, hand.Z)
		for _, other in people do
			-- Players feel weapons through their own client's force field
			-- (smooth, no lag); the server pushes bots.
			local zRoot = if other ~= p and not other.player then Participants.body(other) else nil
			if zRoot then
				local z = Vector3.new(zRoot.Position.X, 0, zRoot.Position.Z)
				local along = math.clamp((z - start):Dot(p.aim), 0, reach)
				local offset = z - (start + p.aim * along)
				local radius = Config.CHARACTER.ShellDiameter / 2 * other.scale
				if
					offset.Magnitude < radius + guard and Combat.lineOfSight(root.Position, zRoot.Position)
				then
					local firmness = (item.firmness or 1) * math.clamp(p.scale / other.scale, 0.5, 2)
					local away = Util.flatUnit(offset) or p.aim
					-- Each pulse covers part of the tick: soft weapons leave long gaps
					-- the zombie walks through, firm ones short gaps to steer around.
					local seconds = SHAFT_INTERVAL * Config.SHAFT_PULSE_SHARE * math.min(1, firmness)
					local speed = Config.SHAFT_ZOMBIE_PUSH * math.min(firmness, 1.5)
					Combat.knockback(other, away * speed, 0, seconds, true)
				end
			end
		end
	end
end

-- Water gun and leaf blower: while held, push everyone in the cone a
-- little, many times a second. The leaf blower also blows light furniture.
local function streamStep()
	local now = os.clock()
	for _, p in Participants.onTeam("Human") do
		if not p.streaming then
			continue
		end
		local item = Items.get(p.heldItem)
		local root = Participants.body(p)
		if not item or item.kind ~= "Stream" or not root then
			setStreaming(p, nil)
			continue
		end
		if now < p.nextStreamTick then
			continue
		end
		p.nextStreamTick = now + (item.tick or 0.12)
		if item.charges then
			setCharges(p, (p.heldCharges or 1) - 1)
			if (p.heldCharges or 0) <= 0 then
				ItemService.take(p) -- out of water
			end
		end
		local reach = (item.reach or 14) * math.max(1, p.scale * 0.9)
		for _, hit in Combat.peopleInCone(p, p.aim, reach, item.arc or 30) do
			local falloff = 1 - hit.distance / (reach * 1.5)
			Combat.knockback(hit.target, p.aim * (item.knockback or 15) * falloff, item.stun or 0.1)
		end
		if item.fx == "Leaves" then
			local center = root.Position + p.aim * (reach / 2)
			local box = CFrame.lookAt(center, center + p.aim)
			for _, body in FurnitureService.findInBox(box, Vector3.new(reach * 0.6, 4, reach)) do
				local weight = FurnitureService.weightOf(body)
				if weight == "Light" or weight == "Medium" then
					FurnitureService.shove(body, p.aim * (if weight == "Light" then 12 else 6), 0.18)
				end
			end
		end
	end
end

function ItemService.init()
	groundFolder = workspace:WaitForChild("GroundItems") :: Folder
	CharacterService.onResized = attachHeld -- the grip moves with your size

	Remotes.event("UseItem").OnServerEvent:Connect(onUse)
	Remotes.unreliable("Aim").OnServerEvent:Connect(function(player, aim)
		local p = Participants.fromPlayer(player)
		local direction = if p and typeof(aim) == "Vector3" then Util.flatUnit(aim) else nil
		if p and direction then
			p.aim = direction
		end
	end)

	local lastAction: { [Player]: number } = {}
	local function throttled(player: Player): boolean
		local now = os.clock()
		if lastAction[player] and now - lastAction[player] < 0.2 then
			return true
		end
		lastAction[player] = now
		return false
	end

	Remotes.event("PickUp").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and not throttled(player) then
			ItemService.pickUp(p)
		end
	end)
	Remotes.event("DropItem").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and p.team == "Human" and not throttled(player) then
			ItemService.drop(p)
		end
	end)
	Remotes.event("SelectSlot").OnServerEvent:Connect(function(player, slot)
		local p = Participants.fromPlayer(player)
		if p and typeof(slot) == "number" and slot == math.floor(slot) then
			ItemService.select(p, slot)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)

	RunService.Heartbeat:Connect(shaftStep)
	RunService.Heartbeat:Connect(streamStep)
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the world, starts every service, and turns
-- joining players into participants.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes")) -- creates the remotes

local WorldSetup = require(script.Parent.WorldSetup)
WorldSetup.run()

local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)

local AdminService = require(script.Parent.AdminService)
local BotService = require(script.Parent.BotService)
local BushService = require(script.Parent.BushService)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local DataService = require(script.Parent.DataService)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local MapBuilder = require(script.Parent.MapBuilder)
local MonetizationService = require(script.Parent.MonetizationService)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local RoundManager = require(script.Parent.RoundManager)
local ShopService = require(script.Parent.ShopService)
local TopScores = require(script.Parent.TopScores)
local Traps = require(script.Parent.Traps)

local firstMap = MapLayout.use(Config.MAP_ROTATION[1])
MapBuilder.build(firstMap)
FurnitureService.build(firstMap)
CharacterService.buildTemplate()
CharacterService.init()

FurnitureService.start(function()
	local movers = {}
	for _, p in Participants.all() do
		local root, humanoid = Participants.body(p)
		if root and humanoid then
			local item = Items.get(p.heldItem)
			local melee = p.team == "Human" and item and item.kind == "Melee"
			table.insert(movers, {
				root = root,
				humanoid = humanoid,
				id = p.id,
				scale = p.scale,
				aim = p.aim,
				reach = if melee and item then (item.reach or 5) * math.max(1, p.scale * 0.9) else nil,
				firmness = if melee and item then item.firmness else nil,
				guard = if melee and item then item.guard else nil,
				zombie = p.team == "Zombie",
			})
		end
	end
	return movers
end)

Combat.init()
Projectiles.init()
Traps.init()
BushService.init()
ItemService.init()
ShopService.init()
DataService.init()
MonetizationService.init()
TopScores.start()
RoundManager.start()
AdminService.init()

local function onPlayerAdded(player: Player)
	player.CanLoadCharacterAppearance = false
	local profile = DataService.load(player) -- yields
	local passes = MonetizationService.ownedPasses(player) -- yields
	if player.Parent ~= Players then
		return
	end
	local p = Participants.add({
		id = Participants.playerId(player),
		name = player.DisplayName,
		player = player,
		isBot = false,
		profile = profile,
		passes = passes,
	})
	MonetizationService.applyPasses(p)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local p = Participants.fromPlayer(player)
	if p then
		Participants.remove(p)
	end
end)

BotService.start()
print("[Brain Tag] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds the neighborhood from MapLayout: grass with little details, dirt
-- paths, the road, house floors with patterns, outlined walls split into
-- breakable segments, windows, bushes and an invisible boundary.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)

local MapBuilder = {}

local COLORS = MapLayout.COLORS
local H = MapLayout.HEIGHTS
local WALL_HEIGHT = MapLayout.WALL_HEIGHT

type Rect = MapLayout.Rect
type Layout = MapLayout.Layout

local mapFolder: Folder
local wallsFolder: Folder? = nil
local brokenSegments: { Model } = {}

local function sub(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Thin detail lying on a surface whose top is `surfaceY`.
local function detail(
	name: string,
	x: number,
	z: number,
	sx: number,
	sz: number,
	surfaceY: number,
	color: string,
	parent: Instance,
	yaw: number?
): Part
	local part = Parts.make({
		name = name,
		size = Vector3.new(sx, 0.04, sz),
		cframe = CFrame.new(x, surfaceY + 0.015, z) * CFrame.Angles(0, yaw or 0, 0),
		color = color,
		canCollide = false,
		canQuery = false,
		parent = parent,
	})
	return part
end

local function flatDisc(
	name: string,
	x: number,
	z: number,
	diameter: number,
	surfaceY: number,
	color: string,
	parent: Instance
)
	local part = Parts.disc(name, Vector3.new(x, surfaceY + 0.02, z), diameter, 0.05, color, parent)
	part.CanCollide = false
	part.CanQuery = false
	return part
end

local function slab(name: string, r: Rect, topY: number, color: string, parent: Instance): Part
	return Parts.slab(name, r.x1, r.z1, r.x2, r.z2, topY, 0.4, color, parent)
end

-- Ground, decorations, paths -----------------------------------------------------

local function speckle(
	r: Rect,
	surfaceY: number,
	color: string,
	perArea: number,
	rng: Random,
	parent: Instance
)
	local count = math.floor((r.x2 - r.x1) * (r.z2 - r.z1) / perArea)
	for _ = 1, count do
		flatDisc(
			"Speck",
			rng:NextNumber(r.x1 + 0.4, r.x2 - 0.4),
			rng:NextNumber(r.z1 + 0.4, r.z2 - 0.4),
			rng:NextNumber(0.25, 0.5),
			surfaceY,
			color,
			parent
		)
	end
end

local function buildGround(parent: Instance, layout: Layout)
	-- Outside the brick wall: a darker field, far bigger than the playable
	-- area so the camera never sees past it (beyond it you'd see the sky).
	local outside = Parts.slab("Outside", -900, -900, 900, 900, H.Grass - 0.05, 4, COLORS.Outside, parent)
	outside.Name = "Outside"
	local b = layout.bounds
	local ground = Parts.slab("Grass", b.x1, b.z1, b.x2, b.z2, H.Grass, 4, COLORS.Grass, parent)
	ground.Name = "Ground"

	local decor = sub("GrassDetails", parent)
	local rng = Random.new(1337)
	local blocked = MapLayout.noDecorRects(layout)
	local bounds = layout.bounds
	local function isFree(x: number, z: number): boolean
		for _, r in blocked do
			if MapLayout.inRect(r, x, z, 1) then
				return false
			end
		end
		return true
	end

	local placed = 0
	local tries = 0
	while placed < 460 and tries < 6000 do
		tries += 1
		local x = rng:NextNumber(bounds.x1 + 3, bounds.x2 - 3)
		local z = rng:NextNumber(bounds.z1 + 3, bounds.z2 - 3)
		if isFree(x, z) then
			placed += 1
			local roll = rng:NextNumber()
			if roll < 0.5 then
				-- Tuft: three dark blades fanned out.
				for _, angle in { -0.5, 0, 0.5 } do
					detail("Tuft", x + angle * 0.5, z, 0.25, 1.1, H.Grass, COLORS.GrassTuft, decor, angle)
				end
			elseif roll < 0.7 then
				flatDisc("Flower", x, z, 1.0, H.Grass, COLORS.Flower, decor)
				flatDisc("FlowerCenter", x, z, 0.35, H.Grass + 0.03, COLORS.FlowerCenter, decor)
			elseif roll < 0.88 then
				flatDisc("Pebble", x, z, rng:NextNumber(0.5, 0.9), H.Grass, COLORS.Pebble, decor)
				if rng:NextNumber() < 0.5 then
					flatDisc(
						"Pebble",
						x + 0.8,
						z + 0.3,
						rng:NextNumber(0.35, 0.6),
						H.Grass,
						COLORS.Pebble,
						decor
					)
				end
			else
				local yaw = rng:NextNumber(0, math.pi)
				detail("Twig", x, z, 0.16, 1.5, H.Grass, COLORS.Twig, decor, yaw)
				detail("Twig", x + 0.3, z + 0.2, 0.12, 0.6, H.Grass, COLORS.Twig, decor, yaw + 0.8)
			end
		end
	end

	local paths = sub("Paths", parent)
	for _, r in layout.paths do
		slab("Dirt", r, H.Dirt, COLORS.Dirt, paths)
		speckle(r, H.Dirt, COLORS.DirtSpeck, 14, rng, paths)
	end

	local patios = sub("Patios", parent)
	for _, r in layout.patios do
		slab("Patio", r, H.Patio, COLORS.Concrete, patios)
		speckle(r, H.Patio, COLORS.ConcreteSpeck, 30, rng, patios)
	end
end

-- Pools: a white rim, blue water with light ripples, and an invisible wall
-- so nobody walks across the water.
local function buildPools(parent: Instance, layout: Layout)
	for _, r in layout.pools do
		local rim = { x1 = r.x1 - 1.5, z1 = r.z1 - 1.5, x2 = r.x2 + 1.5, z2 = r.z2 + 1.5 }
		slab("PoolRim", rim, H.PoolRim, COLORS.PoolRim, parent)
		slab("PoolWater", r, H.PoolRim + 0.02, COLORS.PoolWater, parent)
		local z = r.z1 + 3
		while z < r.z2 - 2 do
			detail(
				"Ripple",
				(r.x1 + r.x2) / 2 + math.sin(z) * 4,
				z,
				(r.x2 - r.x1) * 0.6,
				0.3,
				H.PoolRim + 0.02,
				"8FD3F5",
				parent
			)
			z += 5
		end
		Parts.make({
			name = "PoolWall",
			size = Vector3.new(r.x2 - r.x1 + 2, 6, r.z2 - r.z1 + 2),
			cframe = CFrame.new((r.x1 + r.x2) / 2, 3, (r.z1 + r.z2) / 2),
			color = "000000",
			transparency = 1,
			canQuery = false,
			parent = parent,
		})
	end
end

local function buildRoad(parent: Instance, layout: Layout)
	local road = layout.road
	local rng = Random.new(99)
	for _, r in road.sidewalks do
		slab("Sidewalk", r, H.Sidewalk, COLORS.Sidewalk, parent)
		speckle(r, H.Sidewalk, COLORS.SidewalkSpeck, 40, rng, parent)
	end
	for _, r in road.asphalt do
		slab("Asphalt", r, H.Asphalt, COLORS.Asphalt, parent)
	end
	for _, r in road.centerLines do
		slab("CenterLine", r, H.RoadLine, COLORS.CenterLine, parent)
	end
	for _, r in road.edgeLines do
		slab("EdgeLine", r, H.RoadLine, COLORS.EdgeLine, parent)
	end
	for _, island in layout.islands do
		slab("IslandWalk", island.walk, H.IslandWalk, COLORS.Sidewalk, parent)
		slab("IslandGrass", island.grass, H.IslandGrass, COLORS.Grass, parent)
	end

	for _, spawn in layout.zombieSpawns do
		flatDisc("ZombiePit", spawn.x, spawn.z, 11, H.RoadLine, COLORS.ZombiePit, parent)
		flatDisc("ZombiePitInner", spawn.x, spawn.z, 7, H.RoadLine + 0.03, "4A1C1C", parent)
	end
end

-- Floors ---------------------------------------------------------------------------

local function brickFloor(r: Rect, parent: Instance)
	slab("Brick", r, H.Floor, COLORS.Brick, parent)
	local row = 0
	local z = r.z1
	while z < r.z2 - 0.5 do
		local nextZ = math.min(z + 2.5, r.z2)
		if nextZ < r.z2 then
			detail("Mortar", (r.x1 + r.x2) / 2, nextZ, r.x2 - r.x1, 0.22, H.Floor, COLORS.BrickMortar, parent)
		end
		local x = r.x1 + (if row % 2 == 0 then 5 else 2.5)
		while x < r.x2 - 0.5 do
			detail("Joint", x, (z + nextZ) / 2, 0.22, nextZ - z, H.Floor, COLORS.BrickMortar, parent)
			x += 5
		end
		z = nextZ
		row += 1
	end
end

local function tileFloor(r: Rect, parent: Instance)
	slab("Tile", r, H.Floor, COLORS.Tile, parent)
	local size = 4
	local i = 0
	local x = r.x1
	while x < r.x2 - 0.01 do
		local x2 = math.min(x + size, r.x2)
		local j = 0
		local z = r.z1
		while z < r.z2 - 0.01 do
			local z2 = math.min(z + size, r.z2)
			if (i + j) % 2 == 1 then
				detail("TileAlt", (x + x2) / 2, (z + z2) / 2, x2 - x, z2 - z, H.Floor, COLORS.TileAlt, parent)
			end
			z = z2
			j += 1
		end
		x = x2
		i += 1
	end
end

local function woodFloor(r: Rect, parent: Instance, rng: Random)
	slab("Wood", r, H.Floor, COLORS.Wood, parent)
	local z = r.z1 + 2.5
	while z < r.z2 - 0.5 do
		detail("Plank", (r.x1 + r.x2) / 2, z, r.x2 - r.x1, 0.18, H.Floor, COLORS.WoodLine, parent)
		local x = r.x1 + rng:NextNumber(3, 12)
		while x < r.x2 - 2 do
			detail("PlankEnd", x, z - 1.25, 0.18, 2.5, H.Floor, COLORS.WoodLine, parent)
			x += rng:NextNumber(11, 17)
		end
		z += 2.5
	end
end

local function concreteFloor(r: Rect, parent: Instance, rng: Random)
	slab("Concrete", r, H.Floor, COLORS.Concrete, parent)
	speckle(r, H.Floor, COLORS.ConcreteSpeck, 12, rng, parent)
end

local function buildFloors(parent: Instance, layout: Layout)
	local rng = Random.new(7)
	for _, room in layout.rooms do
		local folder = sub(room.house .. " " .. room.name, parent)
		if room.floor == "Brick" then
			brickFloor(room.rect, folder)
		elseif room.floor == "Tile" then
			tileFloor(room.rect, folder)
		elseif room.floor == "Concrete" then
			concreteFloor(room.rect, folder, rng)
		else
			woodFloor(room.rect, folder, rng)
		end
	end
end

-- Walls ----------------------------------------------------------------------------

local function outlineColor(layout: Layout, houseId: string): string
	for _, house in layout.houses do
		if house.id == houseId then
			return if house.outline == "Orange" then COLORS.OutlineOrange else COLORS.OutlineBlue
		end
	end
	return COLORS.OutlineBlue
end

local function buildWalls(parent: Instance, layout: Layout)
	for i, piece in MapLayout.allWallPieces(layout) do
		local r = piece.rect
		local sx, sz = r.x2 - r.x1, r.z2 - r.z1
		local cx, cz = (r.x1 + r.x2) / 2, (r.z1 + r.z2) / 2
		local segment = Instance.new("Model")
		segment.Name = "WallSegment" .. i

		local wall = Parts.make({
			name = "Wall",
			size = Vector3.new(sx, WALL_HEIGHT, sz),
			cframe = CFrame.new(cx, WALL_HEIGHT / 2, cz),
			color = COLORS.Wall,
			parent = segment,
		})
		-- A slightly bigger, slightly lower slab: from above only its edge shows,
		-- which draws a colored outline around the whole wall shape.
		Parts.make({
			name = "Outline",
			size = Vector3.new(sx + 1, WALL_HEIGHT - 0.1, sz + 1),
			cframe = CFrame.new(cx, (WALL_HEIGHT - 0.1) / 2, cz),
			color = outlineColor(layout, piece.house),
			canCollide = false, -- keeps doorways at their designed width
			canQuery = false,
			parent = segment,
		})
		if piece.window then
			Parts.make({
				name = "Window",
				size = if piece.horizontal then Vector3.new(sx, 0.1, 1.2) else Vector3.new(1.2, 0.1, sz),
				cframe = CFrame.new(cx, WALL_HEIGHT + 0.05, cz),
				color = COLORS.Window,
				canCollide = false,
				canQuery = false,
				parent = segment,
			})
		end
		segment.PrimaryPart = wall
		segment:SetAttribute("House", piece.house)
		CollectionService:AddTag(segment, "Breakable")
		segment.Parent = parent
	end
end

-- Bushes and boundary -------------------------------------------------------------

-- Tall leaf cylinders you can walk into. Seen from the top-down camera they
-- cover anyone standing inside (see Bushes.luau).
local function buildBushes(parent: Instance, layout: Layout)
	local height = Config.BUSH_HEIGHT
	for _, bush in layout.bushes do
		local base = if bush.color == "Orange" then COLORS.BushOrange else COLORS.BushGreen
		local light = if bush.color == "Orange" then "F2AC62" else "5CBF67"
		local model = Instance.new("Model")
		model.Name = "Bush"
		local blobs = {
			{ 0, 0, bush.r * 2 },
			{ math.cos(0.7) * bush.r * 0.6, math.sin(0.7) * bush.r * 0.6, bush.r * 1.4 },
			{ math.cos(3.5) * bush.r * 0.6, math.sin(3.5) * bush.r * 0.6, bush.r * 1.3 },
		}
		local outline = if bush.color == "Orange" then "B5651E" else "2E7D3E"
		for _, blob in blobs do
			-- A darker, slightly bigger, slightly lower disc draws the outline.
			Parts.disc(
				"Outline",
				Vector3.new(bush.x + blob[1], (height - 0.1) / 2, bush.z + blob[2]),
				blob[3] + 0.7,
				height - 0.1,
				outline,
				model
			)
		end
		for _, blob in blobs do
			Parts.disc(
				"Leaves",
				Vector3.new(bush.x + blob[1], height / 2, bush.z + blob[2]),
				blob[3],
				height,
				base,
				model
			)
			Parts.disc(
				"Highlight",
				Vector3.new(bush.x + blob[1] - 0.2, height + 0.03, bush.z + blob[2] - 0.2),
				blob[3] * 0.6,
				0.06,
				light,
				model
			)
		end
		-- Walk-through and shoot-through: bushes only hide what's inside.
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
			end
		end
		model.Parent = parent
	end
end

-- A brick wall around the playable area so it's obvious where the map ends:
-- brick-textured tops with a dark cap line on the inside edge, plus an
-- invisible tall barrier on top so nothing is ever knocked over it.
local BOUNDARY_THICKNESS = 3
local BOUNDARY_HEIGHT = 8

type Side = { cx: number, cz: number, sx: number, sz: number, inward: Vector3 }

local function buildBoundary(parent: Instance, layout: Layout)
	local b = layout.bounds
	local t = BOUNDARY_THICKNESS
	local w, d = b.x2 - b.x1, b.z2 - b.z1
	local sides: { Side } = {
		{ cx = (b.x1 + b.x2) / 2, cz = b.z1 - t / 2, sx = w + t * 2, sz = t, inward = Vector3.zAxis },
		{ cx = (b.x1 + b.x2) / 2, cz = b.z2 + t / 2, sx = w + t * 2, sz = t, inward = -Vector3.zAxis },
		{ cx = b.x1 - t / 2, cz = (b.z1 + b.z2) / 2, sx = t, sz = d, inward = Vector3.xAxis },
		{ cx = b.x2 + t / 2, cz = (b.z1 + b.z2) / 2, sx = t, sz = d, inward = -Vector3.xAxis },
	}
	for _, side in sides do
		local cx, cz, sx, sz, inward = side.cx, side.cz, side.sx, side.sz, side.inward
		Parts.make({
			name = "BrickWall",
			size = Vector3.new(sx, BOUNDARY_HEIGHT, sz),
			cframe = CFrame.new(cx, BOUNDARY_HEIGHT / 2, cz),
			color = COLORS.BoundaryBrick,
			material = Enum.Material.Brick,
			parent = parent,
		})
		-- Dark line along the inside edge, like the outline on house walls.
		local edge = Vector3.new(cx, 0, cz) + inward * (t / 2 - 0.25)
		Parts.make({
			name = "WallCap",
			size = if inward.X == 0 then Vector3.new(sx, 0.1, 0.5) else Vector3.new(0.5, 0.1, sz),
			cframe = CFrame.new(edge.X, BOUNDARY_HEIGHT + 0.05, edge.Z),
			color = COLORS.BoundaryCap,
			canCollide = false,
			canQuery = false,
			parent = parent,
		})
		Parts.make({
			name = "Boundary",
			size = Vector3.new(sx, 40, sz),
			cframe = CFrame.new(cx, BOUNDARY_HEIGHT + 20, cz),
			color = "000000",
			transparency = 1,
			canQuery = false,
			parent = parent,
		})
	end
end

-- Public ----------------------------------------------------------------------------

-- Surface physics for furniture (see FurnitureBuilder): the weight-100 side
-- of a contact decides its friction.
local SLIPPERY = PhysicalProperties.new(0.7, 0, 0, 100, 1)
local GRIPPY = PhysicalProperties.new(0.7, 1, 0, 100, 1)

local function setPhysics(folder: Instance, properties: PhysicalProperties)
	for _, part in folder:GetDescendants() do
		if part:IsA("BasePart") and part.CanCollide then
			part.CustomPhysicalProperties = properties
		end
	end
end

-- Builds `layout`, replacing whatever map was there. The Walls folder is
-- kept (only emptied) so raycast filters that point at it stay valid.
function MapBuilder.build(layout: Layout)
	mapFolder = workspace:WaitForChild("Map") :: Folder
	local walls = wallsFolder or sub("Walls", mapFolder)
	wallsFolder = walls
	for _, child in mapFolder:GetChildren() do
		if child ~= walls then
			child:Destroy()
		end
	end
	walls:ClearAllChildren()
	table.clear(brokenSegments)

	local ground = sub("Ground", mapFolder)
	buildGround(ground, layout)
	local road = sub("Road", mapFolder)
	buildRoad(road, layout)
	local pools = sub("Pools", mapFolder)
	buildPools(pools, layout)
	local floors = sub("Floors", mapFolder)
	buildFloors(floors, layout)
	buildWalls(walls, layout)
	local bushes = sub("Bushes", mapFolder)
	buildBushes(bushes, layout)
	buildBoundary(sub("Boundary", mapFolder), layout)
	for _, folder in { ground, road, floors } do
		setPhysics(folder, SLIPPERY)
	end
	setPhysics(walls, GRIPPY)
	setPhysics(pools, GRIPPY)
	mapFolder:SetAttribute("MapName", layout.name)
end

function MapBuilder.wallsFolder(): Folder
	assert(wallsFolder, "MapBuilder.build has not run yet")
	return wallsFolder
end

-- Shotgun hit: hide a wall segment until the next round.
function MapBuilder.breakSegment(segment: Model): boolean
	if segment:GetAttribute("Broken") or not CollectionService:HasTag(segment, "Breakable") then
		return false
	end
	segment:SetAttribute("Broken", true)
	for _, part in segment:GetChildren() do
		if part:IsA("BasePart") then
			part:SetAttribute("WasCollide", part.CanCollide)
			part:SetAttribute("WasQuery", part.CanQuery)
			part.Transparency = 1
			part.CanCollide = false
			part.CanQuery = false
		end
	end
	table.insert(brokenSegments, segment)
	return true
end

function MapBuilder.restoreWalls()
	for _, segment in brokenSegments do
		segment:SetAttribute("Broken", nil)
		for _, part in segment:GetChildren() do
			if part:IsA("BasePart") then
				part.Transparency = 0
				part.CanCollide = part:GetAttribute("WasCollide") ~= false
				part.CanQuery = part:GetAttribute("WasQuery") ~= false
			end
		end
	end
	table.clear(brokenSegments)
end

-- Finds the breakable segment a part belongs to.
function MapBuilder.segmentOf(part: Instance): Model?
	local model = part:FindFirstAncestorOfClass("Model")
	if model and CollectionService:HasTag(model, "Breakable") then
		return model
	end
	return nil
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Robux purchases: game passes (permanent perks) and developer products
-- (one-off items, boosts and skins). Ids live in Config.MONETIZATION; any id
-- left at 0 is simply ignored.
--
-- ProcessReceipt follows Roblox's recommended pattern: a purchase is granted
-- once, recorded in the buyer's saved profile by its PurchaseId, and only
-- reported as granted after that profile is saved. If anything fails, Roblox
-- retries later and the receipt log prevents a double grant.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local ItemService = require(script.Parent.ItemService)
local Participants = require(script.Parent.Participants)
local Skins = require(ReplicatedStorage.Shared.Skins)
local ShopService = require(script.Parent.ShopService)

type Participant = Participants.Participant

local MonetizationService = {}

local money = Config.MONETIZATION

local function keyFor(map: { [string]: number }, id: number): string?
	for key, value in map do
		if value ~= 0 and value == id then
			return key
		end
	end
	return nil
end

-- Game passes ----------------------------------------------------------------------

-- Which configured passes this player owns (yields; call before spawning).
function MonetizationService.ownedPasses(player: Player): { [string]: boolean }
	local owned: { [string]: boolean } = {}
	for key, id in money.GamePasses do
		if id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and has then
				owned[key :: string] = true
			end
		end
	end
	return owned
end

local function applyPasses(p: Participant)
	-- Pass skins unlock automatically.
	for _, skin in Skins.list do
		if skin.pass and p.passes[skin.pass] then
			ShopService.grantSkin(p, skin.id)
		end
	end
	Participants.publish(p)
	CharacterService.refreshNameTag(p)
end

function MonetizationService.applyPasses(p: Participant)
	applyPasses(p)
end

-- Developer products -----------------------------------------------------------------

local function giveOrQueue(p: Participant, itemId: string)
	if p.team == "Human" and Participants.body(p) then
		ItemService.give(p, itemId)
		if p.player then
			Announcer.toast(p.player, "Delivered! It's in your inventory.", Config.COLORS.Good)
		end
	elseif p.profile then
		table.insert(p.profile.PendingItems, itemId)
		if p.player then
			Announcer.toast(p.player, "Saved for you: you'll get it next round.", Config.COLORS.Good)
		end
	end
end

type Handler = (p: Participant) -> ()

local HANDLERS: { [string]: Handler } = {
	InstantBat = function(p)
		giveOrQueue(p, "Bat")
	end,
	InstantSpear = function(p)
		giveOrQueue(p, "Spear")
	end,
	InstantShotgun = function(p)
		giveOrQueue(p, "Shotgun")
	end,
	InstantAncientSpear = function(p)
		giveOrQueue(p, "AncientSpear")
	end,
	ImmunityShot = function(p)
		Participants.setImmunity(p, p.immunity + money.IMMUNITY_SHOT_AMOUNT)
		if p.player then
			Announcer.toast(p.player, "Immunity boosted!", Config.COLORS.Good)
		end
	end,
	ScoreBoost30 = function(p)
		local now = os.time()
		p.boostEndsAt = math.max(now, p.boostEndsAt) + money.SCORE_BOOST_SECONDS
		if p.profile then
			p.profile.BoostEndsAt = p.boostEndsAt
		end
		p.state:SetAttribute("BoostEndsAt", p.boostEndsAt)
		if p.player then
			Announcer.toast(p.player, "2x score is active!", Config.COLORS.Good)
		end
	end,
}

-- Every skin sold as a product gets a handler that unlocks and equips it.
for _, skin in Skins.list do
	if skin.product then
		HANDLERS[skin.product] = function(p)
			ShopService.grantSkin(p, skin.id)
			ShopService.equipSkin(p, skin)
			if p.player then
				Announcer.toast(p.player, "Unlocked " .. skin.name .. "!", Config.COLORS.Good)
			end
		end
	end
end

local function processReceipt(receipt: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- retried when they rejoin
	end
	local p = Participants.fromPlayer(player)
	local profile = DataService.get(player)
	if not p or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local key = keyFor(money.Products, receipt.ProductId)
	local handler = key and HANDLERS[key]
	if not handler then
		warn(
			"[Shop] Unknown product id "
				.. tostring(receipt.ProductId)
				.. "; add it to Config.MONETIZATION.Products"
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptId = tostring(receipt.PurchaseId)
	if not profile.Receipts[receiptId] then
		local ok, err = pcall(function()
			(handler :: Handler)(p)
			return true
		end)
		if not ok then
			warn("[Shop] Grant failed: " .. tostring(err))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		profile.Receipts[receiptId] = os.time()
	end

	if DataService.isSaved(player) then
		if DataService.save(player) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Studio test purchases are free; with saving off, grant for this session.
	if RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local key = keyFor(money.GamePasses, passId)
		local p = Participants.fromPlayer(player)
		if key and p then
			p.passes[key] = true
			applyPasses(p)
			Announcer.toast(player, "Thanks! Your pass is active.", Config.COLORS.Good)
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Participants</string>
          <string name="Source"><![CDATA[-- Everyone taking part in rounds: real players and Studio test bots, behind
-- one interface. Each participant is mirrored into a Configuration under
-- ReplicatedStorage.BrainTagState.Participants so every client's HUD can read
-- teams, scores and held items.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Skins = require(ReplicatedStorage.Shared.Skins)

export type Team = "Human" | "Zombie"

export type Slot = { id: string, charges: number? }

export type Participant = {
	id: string,
	name: string,
	player: Player?,
	isBot: boolean,
	character: Model?,
	team: Team,
	score: number,
	immunity: number,
	scale: number,
	heldItem: string?, -- the item in the active slot (in your hand)
	slots: { [number]: Slot }, -- inventory: slot number -> item (missing = empty)
	slot: number, -- active slot
	humanSkin: string,
	zombieSkin: string,
	ownedSkins: { [string]: boolean },
	passes: { [string]: boolean },
	boostEndsAt: number,
	-- runtime only
	itemReadyAt: number,
	returnReadyAt: number,
	stunUntil: number,
	streaming: boolean, -- holding the button with a water gun / leaf blower
	nextStreamTick: number,
	heldCharges: number?, -- uses left (banana peels)
	boostUntil: number, -- energy drink
	boostFactor: number,
	slowUntil: number, -- snowball freeze
	adminSpeed: number, -- speed multiplier set from the admin panel (1 = normal)
	alpha: boolean, -- one of this round's first zombies (special look)
	knockedUntil: number, -- a real hit's shove lasts until then (see Combat.knockback)
	slowFactor: number,
	spawning: boolean,
	aim: Vector3,
	profile: any?, -- saved data table for players (DataService)
	state: Configuration,
}

local Participants = {}

local byId: { [string]: Participant } = {}
local order: { Participant } = {}
-- Plain callback lists, not BindableEvents: a BindableEvent hands listeners a
-- COPY of any table it carries, and every service must share the same
-- participant table.
local addedCallbacks: { (Participant) -> () } = {}
local removingCallbacks: { (Participant) -> () } = {}

-- Runs `callback(p)` in its own thread for every participant added from now on.
function Participants.onAdded(callback: (Participant) -> ())
	table.insert(addedCallbacks, callback)
end

-- Runs `callback(p)` just before a participant is removed.
function Participants.onRemoving(callback: (Participant) -> ())
	table.insert(removingCallbacks, callback)
end

local function stateFolder(): Folder
	return ReplicatedStorage:WaitForChild("BrainTagState"):WaitForChild("Participants") :: Folder
end

local function csv(set: { [string]: boolean }): string
	local list = {}
	for key, on in set do
		if on then
			table.insert(list, key)
		end
	end
	table.sort(list)
	return table.concat(list, ",")
end

-- Writes every replicated field. Cheap enough to call after any change.
function Participants.publish(p: Participant)
	local s = p.state
	s:SetAttribute("DisplayName", p.name)
	s:SetAttribute("UserId", if p.player then p.player.UserId else 0)
	s:SetAttribute("IsBot", p.isBot)
	s:SetAttribute("Team", p.team)
	s:SetAttribute("Score", math.floor(p.score))
	s:SetAttribute("Immunity", p.immunity)
	s:SetAttribute("Scale", p.scale)
	s:SetAttribute("HeldItem", p.heldItem or "")
	s:SetAttribute("HeldCharges", p.heldCharges or 0)
	s:SetAttribute("HumanSkin", p.humanSkin)
	s:SetAttribute("ZombieSkin", p.zombieSkin)
	s:SetAttribute("OwnedSkins", csv(p.ownedSkins))
	s:SetAttribute("Passes", csv(p.passes))
	s:SetAttribute("VIP", p.passes.VIP == true)
	s:SetAttribute("BoostEndsAt", p.boostEndsAt)
	if p.profile then
		s:SetAttribute("Wins", p.profile.Wins or 0)
		s:SetAttribute("Infections", p.profile.Infections or 0)
		s:SetAttribute("RoundsPlayed", p.profile.RoundsPlayed or 0)
		s:SetAttribute("SeenTutorial", p.profile.SeenTutorial == true)
	end
end

export type NewParticipant = {
	id: string,
	name: string,
	player: Player?,
	isBot: boolean,
	profile: any?,
	passes: { [string]: boolean }?,
}

function Participants.add(info: NewParticipant): Participant
	local state = Instance.new("Configuration")
	state.Name = info.id
	local profile = info.profile
	local owned = {}
	if profile and profile.OwnedSkins then
		for id, on in profile.OwnedSkins do
			owned[id] = on == true
		end
	end
	owned[Skins.DEFAULT_HUMAN] = true
	owned[Skins.DEFAULT_ZOMBIE] = true

	local p: Participant = {
		id = info.id,
		name = info.name,
		player = info.player,
		isBot = info.isBot,
		character = nil,
		team = "Human",
		score = if profile then profile.Score or 0 else 0,
		immunity = 0,
		scale = 1,
		heldItem = nil,
		slots = {},
		slot = 1,
		humanSkin = if profile then profile.HumanSkin or Skins.DEFAULT_HUMAN else Skins.DEFAULT_HUMAN,
		zombieSkin = if profile then profile.ZombieSkin or Skins.DEFAULT_ZOMBIE else Skins.DEFAULT_ZOMBIE,
		ownedSkins = owned,
		passes = info.passes or {},
		boostEndsAt = if profile then profile.BoostEndsAt or 0 else 0,
		itemReadyAt = 0,
		returnReadyAt = 0,
		stunUntil = 0,
		streaming = false,
		nextStreamTick = 0,
		heldCharges = nil,
		boostUntil = 0,
		boostFactor = 1,
		slowUntil = 0,
		adminSpeed = 1,
		alpha = false,
		knockedUntil = 0,
		slowFactor = 1,
		spawning = false,
		aim = Vector3.new(0, 0, -1),
		profile = profile,
		state = state,
	}
	byId[p.id] = p
	table.insert(order, p)
	Participants.publish(p)
	state.Parent = stateFolder()
	for _, callback in addedCallbacks do
		task.spawn(callback, p)
	end
	return p
end

function Participants.remove(p: Participant)
	if byId[p.id] ~= p then
		return
	end
	for _, callback in removingCallbacks do
		task.spawn(callback, p)
	end
	byId[p.id] = nil
	local index = table.find(order, p)
	if index then
		table.remove(order, index)
	end
	p.state:Destroy()
end

function Participants.get(id: string): Participant?
	return byId[id]
end

function Participants.playerId(player: Player): string
	return "P" .. player.UserId
end

function Participants.fromPlayer(player: Player): Participant?
	return byId[Participants.playerId(player)]
end

function Participants.fromCharacter(model: Instance?): Participant?
	if not model then
		return nil
	end
	local id = model:GetAttribute("ParticipantId")
	if typeof(id) == "string" then
		return byId[id]
	end
	return nil
end

-- Finds the participant whose character contains `part`.
function Participants.fromPart(part: Instance): Participant?
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		local p = Participants.fromCharacter(model)
		if p then
			return p
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function Participants.all(): { Participant }
	return table.clone(order)
end

function Participants.count(): number
	return #order
end

function Participants.onTeam(team: Team): { Participant }
	local list = {}
	for _, p in order do
		if p.team == team then
			table.insert(list, p)
		end
	end
	return list
end

-- Root and humanoid of a participant whose character is alive, else nil.
function Participants.body(p: Participant): (BasePart?, Humanoid?)
	local character = p.character
	if not character or character.Parent == nil then
		return nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

function Participants.setScore(p: Participant, value: number)
	p.score = math.max(0, math.floor(value))
	if p.profile then
		p.profile.Score = p.score
	end
	p.state:SetAttribute("Score", p.score)
end

function Participants.addScore(p: Participant, amount: number)
	Participants.setScore(p, p.score + amount)
end

function Participants.setImmunity(p: Participant, value: number)
	p.immunity = math.clamp(value, 0, 100)
	p.state:SetAttribute("Immunity", p.immunity)
end

return Participants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Projectiles</string>
          <string name="Source"><![CDATA[-- Everything that flies: potatoes, pebbles, snowballs, bubbles and rubber
-- ducks. Simulated on the server with sphere casts so hits are decided in
-- one place. Shots pass through bushes and stop at the first person (zombie
-- or human, never the shooter), wall or piece of furniture, then apply their
-- effect (shove, freeze, bubble trap or explosion).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local FurnitureService = require(script.Parent.FurnitureService)
local Items = require(ReplicatedStorage.Shared.Items)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Util = require(ReplicatedStorage.Shared.Util)

type Participant = Participants.Participant

local Projectiles = {}

type Shot = {
	model: Model,
	position: Vector3,
	direction: Vector3,
	traveled: number,
	item: Items.Item,
	params: RaycastParams,
	ignored: { Instance },
}

local shots: { Shot } = {}
local folder: Folder

local function ball(model: Model, diameter: number, offset: Vector3, color: string, transparency: number?)
	local part = Parts.make({
		name = "Ball",
		shape = Enum.PartType.Ball,
		size = Vector3.one * diameter,
		cframe = CFrame.new(offset),
		color = color,
		transparency = transparency,
		canCollide = false,
		canQuery = false,
		parent = model,
	})
	if not model.PrimaryPart then
		model.PrimaryPart = part
	end
end

-- The flying object, built at the origin facing -Z.
local function buildLook(item: Items.Item): Model
	local model = Instance.new("Model")
	model.Name = item.projectile or "Potato"
	local d = (item.projectileRadius or 0.6) * 2
	local look = item.projectile
	if look == "Pebble" then
		ball(model, d, Vector3.zero, "8C8C8C")
	elseif look == "Snowball" then
		ball(model, d, Vector3.zero, "FFFFFF")
		ball(model, d * 0.5, Vector3.new(0.2, 0.25, -0.1), "E8F6FF")
	elseif look == "Bubble" then
		ball(model, d, Vector3.zero, "BFE9FF", 0.55)
		ball(model, d * 0.25, Vector3.new(-d * 0.2, d * 0.3, -d * 0.15), "FFFFFF", 0.2) -- shine
	elseif look == "Duck" then
		ball(model, d, Vector3.zero, "FFD93B")
		ball(model, d * 0.6, Vector3.new(0, d * 0.35, -d * 0.35), "FFD93B")
		Parts.make({
			name = "Beak",
			size = Vector3.new(0.35, 0.15, 0.4) * d,
			cframe = CFrame.new(0, d * 0.32, -d * 0.7),
			color = "F28C1C",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	else
		ball(model, d, Vector3.zero, if item.isRare then "B98A4E" else "C9A66B")
		ball(model, d * 0.25, Vector3.new(d * 0.2, d * 0.3, 0), "8B6A43")
	end
	return model
end

local function impact(shot: Shot, at: Vector3, target: Participant?, hitPart: Instance)
	local item = shot.item
	local dir = shot.direction
	if item.effect == "Explode" then
		Combat.explode(at, item.radius or 10, item.knockback or 100, item.stun or 0.5)
		for _, body in
			FurnitureService.findInBox(
				CFrame.new(at),
				Vector3.new(1, 0, 1) * (item.radius or 10) * 1.6 + Vector3.yAxis * 6
			)
		do
			local away = Util.flatUnit(body.Position - at) or dir
			FurnitureService.shove(body, away * 18, 0.35)
		end
		Announcer.fx("Boom", { position = at })
		return
	end
	if target then
		if item.knockback and item.knockback > 0 then
			Combat.knockback(target, dir * item.knockback, item.stun or 0.3)
		else
			Combat.knockback(target, Vector3.zero, item.stun or 0.3)
		end
		if item.effect == "Freeze" then
			CharacterService.speedEffect(target, item.slowFactor or 0.4, item.effectSeconds or 2.5)
			Announcer.fx("Frozen", { character = target.character, seconds = item.effectSeconds or 2.5 })
		elseif item.effect == "Bubble" then
			Announcer.fx("Bubbled", { character = target.character, seconds = item.effectSeconds or 2 })
		end
	elseif hitPart:IsA("BasePart") then
		local weight = FurnitureService.weightOf(hitPart)
		if weight == "Light" or (weight == "Medium" and (item.knockback or 0) >= 80) then
			FurnitureService.shove(hitPart, dir * 12, 0.25)
		end
	end
	Announcer.fx("Splat", { position = at, look = item.projectile })
end

local function finish(shot: Shot)
	shot.model:Destroy()
	local index = table.find(shots, shot)
	if index then
		table.remove(shots, index)
	end
end

local function step(dt: number)
	for i = #shots, 1, -1 do
		local shot = shots[i]
		local item = shot.item
		local distance = (item.projectileSpeed or 90) * dt
		local radius = item.projectileRadius or 0.6
		local done = false
		-- A Spherecast ignores parts already overlapping its starting sphere,
		-- so each cast starts a little behind the shot. Otherwise a zombie
		-- walking into it between frames would be missed.
		local back = radius + 1
		local origin = shot.position - shot.direction * back
		for _ = 1, 4 do
			local result =
				workspace:Spherecast(origin, radius, shot.direction * (distance + back), shot.params)
			if not result then
				break
			end
			local target = Participants.fromPart(result.Instance)
			impact(shot, result.Position, target, result.Instance)
			finish(shot)
			done = true
			break
		end
		if not done then
			shot.position += shot.direction * distance
			shot.traveled += distance
			if shot.traveled >= (item.projectileRange or 100) then
				if item.effect == "Explode" then
					impact(shot, shot.position, nil, workspace) -- ducks go off at the end of their flight
				end
				finish(shot)
			else
				-- Ducks and potatoes tumble a little as they fly.
				local spin = CFrame.Angles(0, shot.traveled * 0.15, 0)
				shot.model:PivotTo(CFrame.lookAt(shot.position, shot.position + shot.direction) * spin)
			end
		end
	end
end

function Projectiles.fire(shooter: Participant, item: Items.Item, aim: Vector3)
	local root = Participants.body(shooter)
	if not root or not shooter.character then
		return
	end
	local radius = item.projectileRadius or 0.6
	local origin = root.Position + aim * (root.Size.X / 2 + radius + 0.4)
	local model = buildLook(item)
	model:PivotTo(CFrame.lookAt(origin, origin + aim))
	model.Parent = folder
	local ignored: { Instance } = {
		shooter.character,
		folder,
		workspace:WaitForChild("GroundItems"),
		workspace:WaitForChild("Traps"),
		workspace:WaitForChild("Effects"),
	}
	local map = workspace:WaitForChild("Map")
	for _, name in { "Ground", "Road", "Floors" } do -- shots stop at the boundary wall
		local child = map:FindFirstChild(name)
		if child then
			table.insert(ignored, child)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignored
	table.insert(shots, {
		model = model,
		position = origin,
		direction = aim,
		traveled = 0,
		item = item,
		params = params,
		ignored = ignored,
	})
end

function Projectiles.clear()
	for i = #shots, 1, -1 do
		finish(shots[i])
	end
end

function Projectiles.init()
	folder = workspace:WaitForChild("Projectiles") :: Folder
	RunService.Heartbeat:Connect(step)
end

return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[-- The round loop: Waiting -> Prep -> Outbreak -> Infection -> End -> (reset) -> Prep.
--
-- Prep: everyone is human; the banner counts down "Outbreak happening in N
-- seconds"; humans shop and barricade. Outbreak: first zombies are picked,
-- weighted by immunity. Infection: a zombie touching a human converts them.
-- Zombies win when no humans remain; survivors win if anyone lasts the timer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local CharacterService = require(script.Parent.CharacterService)
local Combat = require(script.Parent.Combat)
local Config = require(ReplicatedStorage.Shared.Config)
local FurnitureService = require(script.Parent.FurnitureService)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local MapBuilder = require(script.Parent.MapBuilder)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Participants = require(script.Parent.Participants)
local Projectiles = require(script.Parent.Projectiles)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Traps = require(script.Parent.Traps)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)
local Wizard = require(script.Parent.Wizard)

type Participant = Participants.Participant
type Phase = "Waiting" | "Prep" | "Infection" | "End"
type Winner = RoundRules.Winner

local RoundManager = {}

local state: Folder
local phase: Phase = "Waiting"
local rng = Random.new()

-- Spawning ---------------------------------------------------------------------------

local function spawnFrame(team: string, scale: number): CFrame
	local layout = MapLayout.current()
	local list = if team == "Zombie" then layout.zombieSpawns else layout.humanSpawns
	local spot = list[rng:NextInteger(1, #list)]
	local jitter = if team == "Zombie" then 3 else 5
	local x = spot.x + rng:NextNumber(-jitter, jitter)
	local z = spot.z + rng:NextNumber(-jitter, jitter)
	local y = MapLayout.HEIGHTS.Floor
		+ Config.CHARACTER.HipHeight
		+ Config.CHARACTER.RootHeight / 2 * scale
		+ 0.3
	return CFrame.new(x, y, z)
end

-- Every human starts the round at the map's start spot, packed into a
-- little crowd around it (a sunflower spiral, so nobody lands on anyone).
local crowd = 0

local function startFrame(scale: number): CFrame
	local spot = MapLayout.current().start
	crowd += 1
	local radius = 2.4 * math.sqrt(crowd - 1) * math.max(1, scale)
	local angle = crowd * 2.39996
	local y = MapLayout.HEIGHTS.Floor
		+ Config.CHARACTER.HipHeight
		+ Config.CHARACTER.RootHeight / 2 * scale
		+ 0.3
	return CFrame.new(spot.x + math.cos(angle) * radius, y, spot.z + math.sin(angle) * radius)
end

local function recount()
	state:SetAttribute("Survivors", #Participants.onTeam("Human"))
	state:SetAttribute("Zombies", #Participants.onTeam("Zombie"))
end

function RoundManager.phase(): Phase
	return phase
end

local function setPhase(name: Phase, seconds: number)
	phase = name
	state:SetAttribute("Phase", name)
	state:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + seconds)
end

local function secondsLeft(): number
	return (state:GetAttribute("PhaseEndsAt") :: number) - workspace:GetServerTimeNow()
end

-- Teams --------------------------------------------------------------------------------

function RoundManager.setTeam(p: Participant, team: Participants.Team)
	if p.team == team then
		return
	end
	p.team = team
	p.state:SetAttribute("Team", team)
	p.boostUntil, p.slowUntil = 0, 0 -- drinks and freezes don't carry across teams
	if team == "Human" then
		p.alpha = false
	end
	if team == "Zombie" then
		ItemService.onInfected(p)
	end
	CharacterService.applyLook(p)
	CharacterService.refreshSpeed(p)
	ItemService.refreshHand(p)
	recount()
end

local function bonusesFor(p: Participant, includeDrumstick: boolean): RoundRules.RewardBonuses
	-- A drumstick anywhere in your inventory counts (the best one).
	local drumstick: number? = nil
	for _, slot in p.slots do
		local item = Items.get(slot.id)
		if item and item.kind == "Passive" and item.rewardBonus then
			drumstick = math.max(drumstick or 0, item.rewardBonus)
		end
	end
	return {
		drumstick = if includeDrumstick then drumstick else nil,
		vip = p.passes.VIP == true,
		doubleScore = p.passes.DoubleScore == true,
		boosted = os.time() < p.boostEndsAt,
	}
end

local function award(p: Participant, base: number, includeDrumstick: boolean, reason: string)
	local amount = RoundRules.reward(base, bonusesFor(p, includeDrumstick))
	Participants.addScore(p, amount)
	CharacterService.refreshSize(p)
	CharacterService.refreshSpeed(p)
	if p.player then
		Announcer.toast(
			p.player,
			string.format("+%s score  %s", Util.commas(amount), reason),
			Config.COLORS.Good
		)
	end
end

local function infect(zombie: Participant, human: Participant)
	local root = Participants.body(human)
	-- The zombie eats a share of the human's points: the human shrinks and
	-- slows, the zombie grows and speeds up.
	local stolen = math.floor(human.score * Config.INFECT_STEAL_FRACTION)
	if stolen > 0 then
		Participants.addScore(human, -stolen)
		Participants.addScore(zombie, stolen)
		human.scale = RoundRules.scaleForScore(human.score)
		human.state:SetAttribute("Scale", human.scale)
		if human.player then
			Announcer.toast(
				human.player,
				string.format("-%s points: %s ate them!", Util.commas(stolen), zombie.name),
				Config.COLORS.ZombieText
			)
		end
		if zombie.player then
			Announcer.toast(
				zombie.player,
				string.format("+%s points eaten from %s", Util.commas(stolen), human.name),
				Config.COLORS.Good
			)
		end
	end
	RoundManager.setTeam(human, "Zombie") -- rebuilds the look at the new size
	CharacterService.refreshSpeed(human)
	award(zombie, Config.INFECT_REWARD, false, "infection")
	if zombie.profile then
		zombie.profile.Infections = (zombie.profile.Infections or 0) + 1
		zombie.state:SetAttribute("Infections", zombie.profile.Infections)
	end
	if root then
		Announcer.fx("Infect", { position = root.Position })
	end
	Announcer.chat(string.format("%s infected %s!", zombie.name, human.name), "9BE22D")
end

-- Does any part of the zombie touch the human? Its body, or the arms
-- reaching out in front of it (the box they sweep, in the zombie's own
-- frame), against the human's body circle.
local ARM_REACH = CharacterLook.ZOMBIE_ARM_REACH
local ARM_SPAN = CharacterLook.ZOMBIE_ARM_SPAN

local function touching(zRoot: BasePart, zScale: number, hRoot: BasePart, hScale: number): boolean
	local shell = Config.CHARACTER.ShellDiameter / 2
	local hr = shell * hScale + 0.25
	local offset = Util.flat(hRoot.Position - zRoot.Position)
	if offset.Magnitude <= hr + shell * zScale then
		return true
	end
	if offset.Magnitude > hr + (ARM_REACH + ARM_SPAN) * zScale then
		return false
	end
	local rel = zRoot.CFrame:VectorToObjectSpace(offset)
	local x = math.clamp(rel.X, -ARM_SPAN * zScale, ARM_SPAN * zScale)
	local z = math.clamp(rel.Z, -ARM_REACH * zScale, 0)
	local dx, dz = rel.X - x, rel.Z - z
	return dx * dx + dz * dz <= hr * hr
end

-- Every frame of the infection phase: a single touch from any part of a
-- zombie (with no wall or furniture between them) converts the human.
local function infectionStep()
	if phase ~= "Infection" then
		return
	end
	local zombies = Participants.onTeam("Zombie")
	local humans = Participants.onTeam("Human")
	for _, human in humans do
		local hRoot = Participants.body(human)
		if hRoot and human.team == "Human" then
			for _, zombie in zombies do
				local zRoot = Participants.body(zombie)
				if zRoot and zombie.team == "Zombie" then
					if
						touching(zRoot, zombie.scale, hRoot, human.scale)
						and Combat.clearPath(zRoot.Position, hRoot.Position)
					then
						infect(zombie, human)
						break
					end
				end
			end
		end
	end
end

-- World reset ---------------------------------------------------------------------------

local function grantRoundStartItems(p: Participant)
	if not ItemService.hasFreeSlot(p) then
		return
	end
	local profile = p.profile
	if profile and profile.PendingItems and #profile.PendingItems > 0 then
		local itemId = table.remove(profile.PendingItems, 1)
		if typeof(itemId) == "string" and Items.get(itemId) then
			ItemService.give(p, itemId)
			if p.player then
				Announcer.toast(
					p.player,
					"Your " .. (Items.get(itemId) :: Items.Item).name .. " is ready!",
					Config.COLORS.Good
				)
			end
			return
		end
	end
	if p.passes.StarterKit and not ItemService.carries(p, "Bat") then
		ItemService.give(p, "Bat")
	end
end

-- Everyone back to human at a yard spawn, furniture and walls restored.
local function resetWorld()
	Wizard.leave()
	Projectiles.clear()
	Traps.clear()
	ItemService.clearGround()
	FurnitureService.resetAll()
	MapBuilder.restoreWalls()
	crowd = 0
	for _, p in Participants.all() do
		p.team = "Human"
		p.stunUntil = 0
		p.boostUntil, p.slowUntil = 0, 0
		p.alpha = false
		p.scale = RoundRules.scaleForScore(p.score) -- you grow as your score grows
		p.state:SetAttribute("Team", "Human")
		p.state:SetAttribute("Scale", p.scale)
		CharacterService.place(p, startFrame(p.scale))
		CharacterService.applyLook(p)
		CharacterService.refreshSpeed(p)
		grantRoundStartItems(p)
		ItemService.refreshHand(p)
	end
	recount()
end

-- Phases ----------------------------------------------------------------------------------

local function enoughPlayers(): boolean
	return Participants.count() >= Config.MIN_PLAYERS
end

local function waitForPlayers()
	if enoughPlayers() then
		return
	end
	setPhase("Waiting", 0)
	resetWorld()
	while not enoughPlayers() do
		state:SetAttribute("Needed", Config.MIN_PLAYERS)
		task.wait(1)
	end
end

-- Waits until the phase timer ends. Returns false if players dropped below
-- the minimum (round aborted).
local function waitPhase(): boolean
	while secondsLeft() > 0 do
		if not enoughPlayers() then
			return false
		end
		task.wait(0.2)
	end
	return true
end

local function pickFirstZombies(): { Participant }
	local candidates = {}
	for _, p in Participants.onTeam("Human") do
		if Participants.body(p) then
			table.insert(candidates, p)
		end
	end
	local count = RoundRules.firstZombieCount(#candidates)
	return RoundRules.weightedPick(
		candidates,
		function(p: Participant)
			return RoundRules.zombieWeight(p.immunity)
		end,
		count,
		function()
			return rng:NextNumber()
		end
	)
end

local function turnFirstZombie(p: Participant)
	p.alpha = true -- the alpha look (see Skins "Alpha")
	RoundManager.setTeam(p, "Zombie")
	Participants.setImmunity(p, 0)
	if Config.FIRST_ZOMBIES_TO_SPAWN then
		CharacterService.place(p, spawnFrame("Zombie", p.scale))
	end
	p.returnReadyAt = os.clock() + 1
end

local function outbreak()
	Wizard.leave()
	local picked = pickFirstZombies()
	local names = {}
	for _, p in picked do
		turnFirstZombie(p)
		table.insert(names, p.name)
	end
	Announcer.chat(
		"* OUTBREAK! "
			.. table.concat(names, ", ")
			.. (if #names == 1 then " is" else " are")
			.. " a zombie! *",
		"E0303A"
	)
	Announcer.fx("Outbreak", {})
end

local function finishRound(winner: Winner)
	setPhase("End", Config.END_SCREEN_SECONDS)
	state:SetAttribute("Winner", winner)
	for _, p in Participants.all() do
		if p.profile then
			p.profile.RoundsPlayed = (p.profile.RoundsPlayed or 0) + 1
			p.state:SetAttribute("RoundsPlayed", p.profile.RoundsPlayed)
		end
		if winner == "Survivors" and p.team == "Human" then
			award(p, Config.SURVIVOR_WIN_REWARD, true, "survived!")
			if p.profile then
				p.profile.Wins = (p.profile.Wins or 0) + 1
				p.state:SetAttribute("Wins", p.profile.Wins)
			end
		elseif winner == "Zombies" and p.team == "Zombie" then
			award(p, Config.ZOMBIE_WIN_REWARD, false, "zombies win")
		end
	end
	Announcer.chat(if winner == "Survivors" then "Survivors Win!!!" else "Zombies Win!!!")
	Announcer.fx("RoundEnd", { winner = winner })
	task.wait(Config.END_SCREEN_SECONDS)
	state:SetAttribute("Winner", "")
end

local function runInfection(): Winner?
	setPhase("Infection", Config.ROUND_SECONDS)
	while true do
		task.wait(0.1)
		local humans = Participants.onTeam("Human")
		local zombies = Participants.onTeam("Zombie")
		local result = RoundRules.outcome(#humans, secondsLeft())
		if result then
			return result :: Winner
		end
		if #zombies == 0 then
			-- Every zombie left the game: pick a new one, or let the humans win.
			if #humans >= 2 then
				local replacement = pickFirstZombies()[1]
				if replacement then
					turnFirstZombie(replacement)
					Announcer.chat("* The zombies fled... " .. replacement.name .. " turned! *", "E0303A")
				end
			else
				return "Survivors" :: Winner
			end
		end
	end
end

-- Map rotation ------------------------------------------------------------------------------

local mapIndex = 1
local roundsOnMap = 0

local function loadMap(name: string)
	local layout = MapLayout.use(name)
	ItemService.clearGround()
	MapBuilder.build(layout)
	FurnitureService.build(layout)
	state:SetAttribute("Map", layout.title)
	Announcer.chat("* Next map: " .. layout.title .. " *")
end

local function nextMapIfDue()
	if roundsOnMap >= Config.ROUNDS_PER_MAP and #Config.MAP_ROTATION > 1 then
		roundsOnMap = 0
		mapIndex = mapIndex % #Config.MAP_ROTATION + 1
		loadMap(Config.MAP_ROTATION[mapIndex])
	end
	roundsOnMap += 1
end

local function runRound()
	waitForPlayers()

	nextMapIfDue()
	resetWorld()
	local round = state:GetAttribute("Round")
	state:SetAttribute("Round", (if typeof(round) == "number" then round else 0) + 1)
	ItemService.scatter()
	setPhase("Prep", Config.PREP_SECONDS)
	Wizard.schedule()
	Announcer.chat(
		MapLayout.current().title
			.. ": outbreak in "
			.. Config.PREP_SECONDS
			.. " seconds. Barricade a room and grab items!"
	)
	if waitPhase() then
		outbreak()
		local winner = runInfection()
		if winner then
			finishRound(winner :: Winner)
		end
	end
end

local function loop()
	while true do
		local ok, err = pcall(function()
			runRound()
			return true
		end)
		if not ok then
			warn("[Rounds] round failed, starting a new one: " .. tostring(err))
			state:SetAttribute("Winner", "")
			task.wait(2)
		end
	end
end

-- Joining, leaving, respawning ----------------------------------------------------------------

local function spawnNew(p: Participant)
	p.scale = RoundRules.scaleForScore(p.score)
	p.state:SetAttribute("Scale", p.scale)
	-- Late joiners become zombies once the outbreak has happened.
	if phase == "Infection" then
		p.team = "Zombie"
		p.state:SetAttribute("Team", "Zombie")
	end
	-- Humans joining before the outbreak start with everyone else.
	CharacterService.spawn(p, if p.team == "Human" then startFrame(p.scale) else spawnFrame(p.team, p.scale))
	if p.team == "Human" then
		grantRoundStartItems(p)
	end
	ItemService.refreshHand(p)
	recount()
end

-- "Z": back to the zombie spawn, with a whoosh where you left.
local function warp(p: Participant)
	local root = Participants.body(p)
	if root then
		Announcer.fx("Warp", { position = root.Position })
	end
	CharacterService.place(p, spawnFrame("Zombie", p.scale))
end

local function onZombieReturn(player: Player)
	local p = Participants.fromPlayer(player)
	if not p or p.team ~= "Zombie" or phase ~= "Infection" then
		return
	end
	local now = os.clock()
	if now < p.returnReadyAt then
		return
	end
	p.returnReadyAt = now + Config.ZOMBIE_RETURN_COOLDOWN
	warp(p)
end

function RoundManager.roundNumber(): number
	local round = state:GetAttribute("Round")
	return if typeof(round) == "number" then round else 0
end

-- Admin controls -------------------------------------------------------------------------------

-- Ends the current phase now (prep -> outbreak, infection -> survivors win).
function RoundManager.skipPhase(): boolean
	if phase == "Waiting" or phase == "End" then
		return false
	end
	state:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow())
	return true
end

function RoundManager.addTime(seconds: number): boolean
	local endsAt = state:GetAttribute("PhaseEndsAt")
	if typeof(endsAt) ~= "number" or phase == "Waiting" or phase == "End" then
		return false
	end
	state:SetAttribute("PhaseEndsAt", endsAt + seconds)
	return true
end

-- The next round starts on the next map in the rotation.
function RoundManager.queueNextMap(): boolean
	if #Config.MAP_ROTATION < 2 then
		return false
	end
	roundsOnMap = Config.ROUNDS_PER_MAP
	return true
end

function RoundManager.respawn(p: Participant)
	CharacterService.spawn(p, spawnFrame(p.team, p.scale))
	ItemService.refreshHand(p)
end

-- Lets bots press Z too.
function RoundManager.zombieReturn(p: Participant)
	if p.team == "Zombie" and phase == "Infection" and os.clock() >= p.returnReadyAt then
		p.returnReadyAt = os.clock() + Config.ZOMBIE_RETURN_COOLDOWN
		warp(p)
	end
end

function RoundManager.start()
	state = ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
	state:SetAttribute("Map", MapLayout.current().title)

	CharacterService.onNeedRespawn = function(p)
		CharacterService.spawn(p, spawnFrame(p.team, p.scale))
		ItemService.refreshHand(p)
	end

	Participants.onAdded(spawnNew)
	Participants.onRemoving(function(p)
		if p.isBot and p.character then
			p.character:Destroy()
		end
		task.defer(recount)
	end)

	Remotes.event("ZombieReturn").OnServerEvent:Connect(onZombieReturn)
	RunService.Heartbeat:Connect(infectionStep)
	task.spawn(loop)
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Score shop (B), the wizard's shop, skins and the first-join tutorial flag.
-- Clients only ask; every price, distance and balance is checked here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Announcer = require(script.Parent.Announcer)
local CharacterService = require(script.Parent.CharacterService)
local Config = require(ReplicatedStorage.Shared.Config)
local ItemService = require(script.Parent.ItemService)
local Items = require(ReplicatedStorage.Shared.Items)
local Participants = require(script.Parent.Participants)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Util = require(ReplicatedStorage.Shared.Util)
local Wizard = require(script.Parent.Wizard)

type Participant = Participants.Participant

local ShopService = {}

local rng = Random.new()

function ShopService.rareChance(p: Participant): number
	if p.passes.Lucky then
		return Config.MONETIZATION.LUCKY_RARE_CHANCE
	end
	return Config.RARE_CHANCE
end

local function buyItem(player: Player, itemId: unknown, fromWizard: unknown): (boolean, string)
	if typeof(itemId) ~= "string" then
		return false, "Unknown item"
	end
	local p = Participants.fromPlayer(player)
	local item = Items.get(itemId)
	if not p or not item then
		return false, "Unknown item"
	end
	if p.team ~= "Human" then
		return false, "Zombies can't shop!"
	end
	local root = Participants.body(p)
	if not root then
		return false, "Wait until you spawn"
	end

	local price: number
	if fromWizard == true then
		if not item.wizardPrice then
			return false, "The wizard doesn't sell that"
		end
		if not Wizard.isNear(root.Position) then
			return false, "Walk closer to the wizard"
		end
		price = item.wizardPrice
	else
		if not item.price then
			return false, "That isn't sold here"
		end
		price = item.price
	end
	if p.score < price then
		return false, "You need " .. Util.commas(price) .. " score"
	end

	Participants.addScore(p, -price)
	CharacterService.refreshSize(p) -- points are size and speed
	CharacterService.refreshSpeed(p)
	CharacterService.refreshSpeed(p)

	local finalId = item.id
	if item.rare and rng:NextNumber() < ShopService.rareChance(p) then
		finalId = item.rare
	end
	ItemService.give(p, finalId)
	local final = Items.get(finalId) :: Items.Item
	if finalId ~= item.id then
		Announcer.chat(string.format("* %s rolled a %s! *", p.name, final.name), "F5C542")
		return true, "RARE! You got a " .. final.name .. "!"
	end
	return true, "Bought " .. final.name
end

-- Marks a skin owned (in the session and the saved profile).
function ShopService.grantSkin(p: Participant, skinId: string)
	p.ownedSkins[skinId] = true
	if p.profile then
		p.profile.OwnedSkins[skinId] = true
	end
	Participants.publish(p)
end

function ShopService.equipSkin(p: Participant, skin: Skins.Skin)
	if skin.team == "Zombie" then
		p.zombieSkin = skin.id
		if p.profile then
			p.profile.ZombieSkin = skin.id
		end
	else
		p.humanSkin = skin.id
		if p.profile then
			p.profile.HumanSkin = skin.id
		end
	end
	Participants.publish(p)
	if p.team == skin.team then
		CharacterService.applyLook(p)
		ItemService.refreshHand(p)
	end
end

-- Returns a status the client acts on:
--   "equipped" | "bought" | "prompt" (Robux product) | "promptPass" | "error"
local function buySkin(player: Player, skinId: unknown): (string, string)
	if typeof(skinId) ~= "string" then
		return "error", "Unknown skin"
	end
	local p = Participants.fromPlayer(player)
	local skin = Skins.get(skinId)
	if not p or not skin then
		return "error", "Unknown skin"
	end
	if skin.pass and p.passes[skin.pass] then
		ShopService.grantSkin(p, skin.id)
	end
	if p.ownedSkins[skin.id] then
		ShopService.equipSkin(p, skin)
		return "equipped", skin.name .. " equipped"
	end
	if skin.scorePrice then
		if p.score < skin.scorePrice then
			return "error", "You need " .. Util.commas(skin.scorePrice) .. " score"
		end
		Participants.addScore(p, -skin.scorePrice)
		CharacterService.refreshSize(p) -- points are size and speed
		CharacterService.refreshSpeed(p)
		CharacterService.refreshSpeed(p)
		ShopService.grantSkin(p, skin.id)
		ShopService.equipSkin(p, skin)
		return "bought", "Unlocked " .. skin.name .. "!"
	end
	if skin.product then
		return "prompt", skin.product
	end
	if skin.pass then
		return "promptPass", skin.pass
	end
	return "error", "Not available"
end

function ShopService.init()
	Remotes.func("BuyItem").OnServerInvoke = buyItem
	Remotes.func("BuySkin").OnServerInvoke = buySkin
	Remotes.event("TutorialDone").OnServerEvent:Connect(function(player)
		local p = Participants.fromPlayer(player)
		if p and p.profile then
			p.profile.SeenTutorial = true
			p.state:SetAttribute("SeenTutorial", true)
		end
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">TopScores</string>
          <string name="Source"><![CDATA[-- All-time top 10 (across servers) for the trophy panel, refreshed every
-- couple of minutes from the OrderedDataStore that DataService updates.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local TopScores = {}

local names: { [number]: string } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and name then
		names[userId] = name
		return name
	end
	return "Player " .. userId
end

local function refresh()
	local rows = {}
	for _, entry in DataService.topScores(10) do
		table.insert(rows, { name = nameOf(entry.userId), score = entry.score })
	end
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("TopScores", HttpService:JSONEncode(rows))
	end
end

function TopScores.start()
	task.spawn(function()
		while true do
			if DataService.isAvailable() then
				refresh()
			end
			task.wait(Config.TOP_SCORES_REFRESH_SECONDS)
		end
	end)
end

return TopScores
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Traps</string>
          <string name="Source"><![CDATA[-- Banana peels: dropped by humans, slippery for everyone (the dropper gets
-- a moment to walk off it). Whoever steps on one slips: a shove in the way
-- they were walking and a long daze.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Announcer = require(script.Parent.Announcer)
local Combat = require(script.Parent.Combat)
local Items = require(ReplicatedStorage.Shared.Items)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Participants = require(script.Parent.Participants)
local Util = require(ReplicatedStorage.Shared.Util)

local Traps = {}

type Trap = { model: Model, position: Vector3, item: Items.Item, owner: Participant?, safeUntil: number }
type Participant = Participants.Participant

local traps: { Trap } = {}
local folder: Folder
local MAX_TRAPS = 30

local function buildPeel(at: Vector3, spin: number): Model
	local model = Instance.new("Model")
	model.Name = "BananaPeel"
	local y = MapLayout.HEIGHTS.Floor + 0.12
	local center = CFrame.new(at.X, y, at.Z) * CFrame.Angles(0, spin, 0)
	for i = 0, 2 do
		local arm = center * CFrame.Angles(0, i * math.pi * 2 / 3, 0) * CFrame.new(0, 0, -0.6)
		Parts.make({
			name = "Peel",
			size = Vector3.new(0.55, 0.12, 1.3),
			cframe = arm,
			color = "F7DC6F",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
		Parts.make({
			name = "PeelInside",
			size = Vector3.new(0.35, 0.13, 1.0),
			cframe = arm * CFrame.new(0, 0.005, 0.05),
			color = "FFF6C7",
			canCollide = false,
			canQuery = false,
			parent = model,
		})
	end
	Parts.disc("Stem", center.Position + Vector3.new(0, 0.05, 0), 0.5, 0.2, "8B5A2B", model).CanCollide =
		false
	return model
end

function Traps.place(position: Vector3, item: Items.Item, owner: Participant?)
	if #traps >= MAX_TRAPS then
		local oldest = table.remove(traps, 1)
		if oldest then
			oldest.model:Destroy()
		end
	end
	local model = buildPeel(position, math.random() * math.pi * 2)
	model.Parent = folder
	table.insert(traps, {
		model = model,
		position = Vector3.new(position.X, 0, position.Z),
		item = item,
		owner = owner,
		safeUntil = os.clock() + 1.5,
	})
end

function Traps.clear()
	for _, trap in traps do
		trap.model:Destroy()
	end
	table.clear(traps)
end

local function step()
	if #traps == 0 then
		return
	end
	local now = os.clock()
	for _, person in Participants.all() do
		local root, humanoid = Participants.body(person)
		if root and humanoid then
			for i = #traps, 1, -1 do
				local trap = traps[i]
				local safe = person == trap.owner and now < trap.safeUntil
				if not safe and Util.flatDistance(root.Position, trap.position) <= 1.4 + root.Size.X / 2 then
					local move = Util.flatUnit(humanoid.MoveDirection)
						or Util.flatUnit(root.CFrame.LookVector)
						or Vector3.xAxis
					Combat.knockback(person, move * (trap.item.knockback or 45), trap.item.stun or 1.2)
					Announcer.fx("Slip", { position = trap.position, character = person.character })
					trap.model:Destroy()
					table.remove(traps, i)
				end
			end
		end
	end
end

function Traps.init()
	folder = workspace:WaitForChild("Traps") :: Folder
	RunService.Heartbeat:Connect(step)
end

return Traps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Wizard</string>
          <string name="Source"><![CDATA[-- The wizard: shows up at a random moment during the prep phase in one of the
-- yards, sells rare items to humans standing within reach (press B near
-- him), and leaves when the outbreak starts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Announcer = require(script.Parent.Announcer)
local Config = require(ReplicatedStorage.Shared.Config)
local MapLayout = require(ReplicatedStorage.Shared.MapLayout)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Util = require(ReplicatedStorage.Shared.Util)

local Wizard = {}

local model: Model? = nil
local scheduleToken = 0
local rng = Random.new()

local function build(at: Vector3): Model
	local m = Instance.new("Model")
	m.Name = "Wizard"
	local function disc(name: string, offset: Vector3, diameter: number, height: number, color: string): Part
		return Parts.disc(name, at + offset, diameter, height, color, m)
	end
	-- Like the original: a blue robe, a big brown pointy hat, a grey beard.
	disc("RobeOutline", Vector3.new(0, 1.95, 0), 4.3, 3.9, "2C5866")
	local robe = disc("Robe", Vector3.new(0, 2, 0), 3.9, 4, "4F8FA3")
	disc("RobeTrim", Vector3.new(0, 4.03, 0), 3.1, 0.06, "6FB0C2")
	disc("HatBrimOutline", Vector3.new(0, 4.55, 0), 3.7, 0.3, "4A2C17")
	disc("HatBrim", Vector3.new(0, 4.6, 0), 3.4, 0.3, "6B4226")
	disc("HatMid", Vector3.new(0, 5.1, 0), 2.2, 0.7, "8B5A2B")
	disc("HatTip", Vector3.new(0, 5.6, 0), 0.9, 0.3, "A0703F")
	disc("Star", Vector3.new(0.5, 5.5, 0.3), 0.5, 0.25, "FFD54A")
	disc("Beard", Vector3.new(0, 4.3, -1.6), 1.4, 0.3, "B8BEC4")
	-- Staff with a glowing orb.
	Parts.make({
		name = "Staff",
		size = Vector3.new(0.35, 0.35, 4.5),
		cframe = CFrame.new(at + Vector3.new(1.9, 4.4, -0.6)),
		color = "8B5A2B",
		canCollide = false,
		parent = m,
	})
	local orb = Parts.make({
		name = "Orb",
		shape = Enum.PartType.Ball,
		size = Vector3.one * 1.1,
		cframe = CFrame.new(at + Vector3.new(1.9, 4.7, -3.0)),
		color = "7FE7FF",
		material = Enum.Material.Neon,
		canCollide = false,
		parent = m,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromHex("7FE7FF")
	light.Range = 10
	light.Brightness = 2
	light.Parent = orb
	m.PrimaryPart = robe

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(240, 44)
	tag.AlwaysOnTop = true
	tag.LightInfluence = 0
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2, -4.2)
	tag.Adornee = robe
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.BuilderSansExtraBold
	label.TextSize = 18
	label.TextColor3 = Color3.fromHex("D7B8FF")
	label.TextStrokeTransparency = 0.3
	label.Text = "Wizard\n[B] special items"
	label.Parent = tag
	tag.Parent = robe
	return m
end

function Wizard.arrive()
	if model then
		return
	end
	local spots = MapLayout.current().wizardSpots
	local spot = spots[rng:NextInteger(1, #spots)]
	local m = build(Vector3.new(spot.x, 0, spot.z))
	m.Parent = workspace
	model = m
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("WizardHere", true)
	end
	Announcer.chat("* The wizard has arrived! Press [B] at wizard to buy special items! *")
	Announcer.fx("Wizard", { position = Vector3.new(spot.x, 2, spot.z) })
end

function Wizard.leave()
	scheduleToken += 1
	if model then
		model:Destroy()
		model = nil
		Announcer.chat("* The wizard vanished in a puff of smoke. *")
	end
	local state = ReplicatedStorage:FindFirstChild("BrainTagState")
	if state then
		state:SetAttribute("WizardHere", false)
	end
end

-- Arrives after a random delay inside the configured window, unless leave()
-- is called first.
function Wizard.schedule()
	scheduleToken += 1
	local token = scheduleToken
	task.delay(rng:NextNumber(Config.WIZARD_ARRIVE_MIN, Config.WIZARD_ARRIVE_MAX), function()
		if token == scheduleToken then
			Wizard.arrive()
		end
	end)
end

function Wizard.isNear(position: Vector3): boolean
	local current = model
	if not current or not current.PrimaryPart then
		return false
	end
	return Util.flatDistance(current.PrimaryPart.Position, position) <= Config.WIZARD_SHOP_RADIUS
end

return Wizard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">WorldSetup</string>
          <string name="Source"><![CDATA[-- One-time world settings: flat lighting, collision groups, the folders other
-- services fill, and the replicated state folder the HUD reads.

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldSetup = {}

WorldSetup.GROUPS = {
	Characters = "Characters",
	Furniture = "Furniture",
	Shells = "CharacterShells", -- body-sized cylinders that only hit each other
}

local function folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function WorldSetup.run()
	Players.CharacterAutoLoads = false

	Lighting.GlobalShadows = false
	Lighting.Brightness = 1
	Lighting.ClockTime = 12
	Lighting.Ambient = Color3.fromRGB(190, 190, 190)
	Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.FogEnd = 100000
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("BloomEffect") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end

	local groups = WorldSetup.GROUPS
	PhysicsService:RegisterCollisionGroup(groups.Characters)
	PhysicsService:RegisterCollisionGroup(groups.Furniture)
	PhysicsService:RegisterCollisionGroup(groups.Shells)
	-- Root boxes never hit each other; the shells do the bumping, and only
	-- with each other, so a big player's wide shell never snags a doorway.
	PhysicsService:CollisionGroupSetCollidable(groups.Characters, groups.Characters, false)
	for _, other in { "Default", groups.Characters, groups.Furniture } do
		PhysicsService:CollisionGroupSetCollidable(groups.Shells, other, false)
	end
	PhysicsService:CollisionGroupSetCollidable(groups.Shells, groups.Shells, Config.PLAYERS_COLLIDE)

	for _, name in { "Map", "Furniture", "GroundItems", "Projectiles", "Traps", "Effects", "Bots" } do
		folder(name, workspace)
	end

	local state = folder("BrainTagState", ReplicatedStorage)
	folder("Participants", state)
	state:SetAttribute("Phase", "Waiting")
	state:SetAttribute("PhaseEndsAt", 0)
	state:SetAttribute("Survivors", 0)
	state:SetAttribute("Zombies", 0)
	state:SetAttribute("Winner", "")
	state:SetAttribute("Round", 0)
	state:SetAttribute("Needed", Config.MIN_PLAYERS)
	state:SetAttribute("WizardHere", false)
	state:SetAttribute("TopScores", "[]")
end

function WorldSetup.state(): Folder
	return ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
end

return WorldSetup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="41">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>

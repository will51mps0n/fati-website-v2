        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="LocalScript" referent="43">
        <Properties>
          <string name="Name">Animate</string>
          <string name="Source"><![CDATA[-- Intentionally empty. Brain Tag characters are flat top-down blobs with no
-- limbs, so Roblox's default walk/idle animation script is replaced by this one.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="44">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BushController</string>
            <string name="Source"><![CDATA[-- Hiding in bushes, on your screen: the bush you stand in fades so you can
-- see yourself (and anyone hiding with you), and the name tags of players
-- hiding in other bushes disappear.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Bushes = require(ReplicatedStorage.Shared.Bushes)
local Config = require(ReplicatedStorage.Shared.Config)

local BushController = {}

local player = Players.LocalPlayer
local INTERVAL = 0.1

local faded: Model? = nil

local function fade(bush: Model?, amount: number)
	if not bush then
		return
	end
	for _, part in bush:GetDescendants() do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = amount
		end
	end
end

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function rootOf(model: Instance): BasePart?
	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function step()
	local me = player.Character
	local myRoot = me and rootOf(me)
	local mine = if myRoot then Bushes.coverAt(myRoot.Position) else nil
	if mine ~= faded then
		fade(faded, 0)
		fade(mine, Config.BUSH_SEE_THROUGH)
		faded = mine
	end

	for _, model in characters() do
		if model:IsA("Model") and model:GetAttribute("ParticipantId") and model ~= me then
			local head = model:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("NameTag")
			local root = rootOf(model)
			if tag and tag:IsA("BillboardGui") and root then
				local theirs = Bushes.coverAt(root.Position)
				local show = theirs == nil or theirs == mine
				if tag.Enabled ~= show then
					tag.Enabled = show
				end
			end
		end
	end
end

function BushController.start()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < INTERVAL then
			return
		end
		elapsed = 0
		local ok, err = pcall(function()
			step()
			return true
		end)
		if not ok then
			warn("[Bushes] " .. tostring(err))
		end
	end)
end

return BushController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[-- Straight-down camera that follows your character. A narrow field of view
-- from high up gives the flat, near-orthographic 2D look. Screen up is world
-- -Z. No zoom or rotation (the Settings panel offers three fixed heights).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)

local CameraController = {}

local player = Players.LocalPlayer
local height = Config.CAMERA_HEIGHT
local focus: Vector3? = nil
local SCREEN_UP = Vector3.new(0, 0, -1)

function CameraController.setHeight(newHeight: number)
	height = newHeight
end

function CameraController.height(): number
	return height
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Config.CAMERA_FOV

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local target = Vector3.new(root.Position.X, 0, root.Position.Z)
		if not focus or Config.CAMERA_SMOOTHING <= 0 or (focus - target).Magnitude > 60 then
			focus = target -- locked on (and snaps after spawns and teleports)
		else
			focus = focus:Lerp(target, 1 - math.exp(-Config.CAMERA_SMOOTHING * dt))
		end
	end
	if focus then
		-- Bigger players see a little more around them.
		local scale = ClientState.my("Scale") or 1
		local eye = height * (1 + (scale - 1) * Config.CAMERA_GROWTH)
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(0, eye, 0), focus, SCREEN_UP)
	end
end

function CameraController.start()
	RunService:BindToRenderStep("BrainTagCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">ChatSetup</string>
            <string name="Source"><![CDATA[-- TextChatService setup: chat window at the bottom-right (bottom-left and
-- hidden until opened on phones) with channel tabs,
-- yellow system announcements from the server, and a gold [VIP] tag.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ChatSetup = {}

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

function ChatSetup.setVisible(visible: boolean)
	local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	local input = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
	if window then
		window.Enabled = visible
	end
	if input then
		input.Enabled = visible
	end
end

function ChatSetup.isVisible(): boolean
	local window = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
	return window == nil or window.Enabled
end

function ChatSetup.start()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	task.spawn(function()
		local window = TextChatService:WaitForChild("ChatWindowConfiguration", 10) :: ChatWindowConfiguration?
		if window then
			-- Desktop: bottom-right (points sit bottom-left). Phones keep the
			-- touch buttons bottom-right, so chat stays left and starts hidden
			-- (the chat button top-left shows it).
			window.HorizontalAlignment = if touch
				then Enum.HorizontalAlignment.Left
				else Enum.HorizontalAlignment.Right
			window.VerticalAlignment = Enum.VerticalAlignment.Bottom
			if touch then
				ChatSetup.setVisible(false)
			end
		end
		local tabs = TextChatService:FindFirstChildOfClass("ChannelTabsConfiguration")
		if tabs then
			tabs.Enabled = true
		end
	end)

	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local entry = ClientState.participants:FindFirstChild("P" .. source.UserId)
			if entry and entry:GetAttribute("VIP") then
				properties.PrefixText = string.format(
					'<font color="#%s">[VIP]</font> %s',
					Config.COLORS.VipName,
					message.PrefixText
				)
			end
		end
		return properties
	end

	local general: TextChannel? = nil
	task.spawn(function()
		local channels = TextChatService:WaitForChild("TextChannels", 20)
		general = channels and channels:WaitForChild("RBXGeneral", 20) :: TextChannel?
	end)

	Remotes.event("Announce").OnClientEvent:Connect(function(text: string, hex: string?)
		if typeof(text) ~= "string" then
			return
		end
		local channel = general
		if channel then
			channel:DisplaySystemMessage(
				string.format('<font color="#%s">%s</font>', hex or Config.COLORS.SystemMessage, escape(text))
			)
		end
	end)
end

return ChatSetup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- Read-only view of the replicated game state for client code: the round
-- phase and timer, and every participant's public info.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = {}

local player = Players.LocalPlayer
local folder = ReplicatedStorage:WaitForChild("BrainTagState") :: Folder
local participants = folder:WaitForChild("Participants") :: Folder

ClientState.folder = folder
ClientState.participants = participants

function ClientState.phase(): string
	return (folder:GetAttribute("Phase") :: string?) or "Waiting"
end

function ClientState.secondsLeft(): number
	local endsAt = folder:GetAttribute("PhaseEndsAt")
	if typeof(endsAt) ~= "number" then
		return 0
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

function ClientState.attr(name: string): any
	return folder:GetAttribute(name)
end

function ClientState.myId(): string
	return "P" .. player.UserId
end

-- This player's replicated entry (nil until the server finished loading them).
function ClientState.me(): Configuration?
	return participants:FindFirstChild(ClientState.myId()) :: Configuration?
end

function ClientState.my(name: string): any
	local me = ClientState.me()
	return me and me:GetAttribute(name)
end

function ClientState.isZombie(): boolean
	return ClientState.my("Team") == "Zombie"
end

function ClientState.myCharacter(): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return character, root, humanoid
end

function ClientState.owns(listAttr: string, key: string): boolean
	local raw = ClientState.my(listAttr)
	if typeof(raw) ~= "string" then
		return false
	end
	for entry in string.gmatch(raw, "[^,]+") do
		if entry == key then
			return true
		end
	end
	return false
end

export type Row = {
	id: string,
	name: string,
	score: number,
	team: string,
	isMe: boolean,
	isBot: boolean,
	vip: boolean,
}

function ClientState.rows(): { Row }
	local rows = {}
	local myId = ClientState.myId()
	for _, entry in participants:GetChildren() do
		table.insert(rows, {
			id = entry.Name,
			name = (entry:GetAttribute("DisplayName") :: string?) or entry.Name,
			score = (entry:GetAttribute("Score") :: number?) or 0,
			team = (entry:GetAttribute("Team") :: string?) or "Human",
			isMe = entry.Name == myId,
			isBot = entry:GetAttribute("IsBot") == true,
			vip = entry:GetAttribute("VIP") == true,
		})
	end
	table.sort(rows, function(a, b)
		if a.score == b.score then
			return a.name < b.name
		end
		return a.score > b.score
	end)
	return rows
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Plays what the server announces: your own knockback, item swings, potato
-- splats, shotgun blasts, wall debris, infection bursts and sounds.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.ClientState)
local Knockback = require(ReplicatedStorage.Shared.Knockback)
local Parts = require(ReplicatedStorage.Shared.Parts)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Sounds = require(script.Parent.Sounds)

local Effects = {}

local Items = require(ReplicatedStorage.Shared.Items)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)

-- Plays an item's sound style (a SoundBank name) if it has one.
local function playStyle(style: string?, position: Vector3?): boolean
	if style and Sounds.has(style) then
		Sounds.play(style, position)
		return true
	end
	return false
end

local player = Players.LocalPlayer
local effectsFolder = workspace:WaitForChild("Effects")

local baseGrip: { [Weld]: CFrame } = setmetatable({}, { __mode = "k" }) :: any

local function fadeAndRemove(part: BasePart, seconds: number, grow: Vector3?)
	local goal: { [string]: any } = { Transparency = 1 }
	if grow then
		goal.Size = grow
	end
	local tween = TweenService:Create(
		part,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	tween.Completed:Once(function()
		part:Destroy()
	end)
end

local function flatPart(position: Vector3, diameter: number, color: string): Part
	local part = Parts.disc("Fx", position, diameter, 0.1, color, effectsFolder)
	part.CanCollide = false
	part.CanQuery = false
	return part
end

-- Swings the held item around its grip (or thrusts a spear).
local function swing(character: Model?, itemId: string)
	if not character then
		return
	end
	local held = character:FindFirstChild("HeldItem")
	local handle = held and held:FindFirstChild("Handle")
	local weld = handle and handle:FindFirstChild("GripWeld") :: Weld?
	if not weld then
		return
	end
	local base = baseGrip[weld] or weld.C0
	baseGrip[weld] = base
	local thrust = itemId == "Spear" or itemId == "AncientSpear"
	local started = os.clock()
	local duration = if thrust then 0.22 else 0.28
	local connection: RBXScriptConnection
	connection = RunService.RenderStepped:Connect(function()
		local t = (os.clock() - started) / duration
		if t >= 1 or weld.Parent == nil then
			connection:Disconnect()
			if weld.Parent then
				weld.C0 = base
			end
			return
		end
		if thrust then
			local push = math.sin(t * math.pi) * 2.2
			weld.C0 = base * CFrame.new(0, 0, -push)
		else
			-- Sweep from the right side across to the left, then settle.
			local angle = if t < 0.6
				then math.rad(70) - (t / 0.6) * math.rad(130)
				else math.rad(-60) * (1 - (t - 0.6) / 0.4)
			weld.C0 = base * CFrame.Angles(0, angle, 0)
		end
	end)
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local item = Items.get(itemId)
	if not playStyle(item and item.sound, root and root.Position) then
		Sounds.play(if thrust then "Lunge" else "Whoosh", root and root.Position)
	end
end

-- Little bits flying out from a point and fading (stars, feathers, crumbs...).
local BITS: { [string]: { colors: { string }, size: number, count: number, shape: Enum.PartType } } = {
	Stars = { colors = { "FFE14D", "FFFFFF", "FFC21A" }, size = 0.5, count = 6, shape = Enum.PartType.Block },
	Puff = { colors = { "FFFFFF", "EDEDED" }, size = 0.45, count = 4, shape = Enum.PartType.Ball },
	Feathers = {
		colors = { "FFFFFF", "FFF3B0", "FFE14D" },
		size = 0.45,
		count = 8,
		shape = Enum.PartType.Block,
	},
	Crumbs = { colors = { "D9A15C", "B5783A", "E8C28A" }, size = 0.3, count = 10, shape = Enum.PartType.Ball },
	Sparkle = {
		colors = { "FF5FA2", "7FD3FF", "FFFFFF", "FFE14D" },
		size = 0.35,
		count = 8,
		shape = Enum.PartType.Ball,
	},
	Confetti = {
		colors = { "E5484D", "F1C40F", "2ECC71", "3498DB", "9B59B6", "FF5FA2" },
		size = 0.35,
		count = 30,
		shape = Enum.PartType.Block,
	},
	Snow = { colors = { "FFFFFF", "E8F6FF" }, size = 0.35, count = 10, shape = Enum.PartType.Ball },
	Peel = { colors = { "F7DC6F", "FFFFFF", "FFE14D" }, size = 0.4, count = 7, shape = Enum.PartType.Block },
}

local function bits(kind: string, position: Vector3, direction: Vector3?, spread: number?)
	local spec = BITS[kind]
	if not spec then
		return
	end
	local rng = Random.new()
	for i = 1, spec.count do
		local part = Parts.make({
			name = "Bit",
			shape = spec.shape,
			size = Vector3.new(spec.size, 0.08, spec.size)
				* (if spec.shape == Enum.PartType.Ball then 1 else 1),
			cframe = CFrame.new(position + Vector3.new(0, 2, 0))
				* CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			color = spec.colors[(i - 1) % #spec.colors + 1],
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		if spec.shape == Enum.PartType.Ball then
			part.Size = Vector3.one * spec.size
		end
		local dir: Vector3
		if direction then
			local cone = spread or 0.6
			dir = (CFrame.Angles(0, rng:NextNumber(-cone, cone), 0) * direction) * rng:NextNumber(14, 34)
		else
			local a = rng:NextNumber(0, math.pi * 2)
			dir = Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(6, 14)
		end
		local finish = position + Vector3.new(dir.X, 0, dir.Z) * 0.35
		local info = TweenInfo.new(rng:NextNumber(0.4, 0.8), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local tween = TweenService:Create(part, info, {
			CFrame = CFrame.new(finish + Vector3.new(0, 1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
			Transparency = 1,
		})
		tween:Play()
		tween.Completed:Once(function()
			part:Destroy()
		end)
	end
end

-- A temporary visual stuck to a character (plunger, bubble, ice).
local function stickTo(character: Model?, seconds: number, build: (root: BasePart) -> { BasePart })
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local parts = build(root)
	for _, part in parts do
		part.Anchored = false
		part.CanCollide = false
		part.CanQuery = false
		part.Massless = true
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = character
	end
	task.delay(seconds, function()
		for _, part in parts do
			part:Destroy()
		end
	end)
end

local function bodyScale(root: BasePart): number
	return root.Size.X / 2.2
end

-- Spray particles on everyone currently holding a water gun / leaf blower.
local SPRAY_COLORS = {
	WaterGun = ColorSequence.new(Color3.fromHex("8FD3F5"), Color3.fromHex("E8F6FF")),
	LeafBlower = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHex("6BBF4E")),
		ColorSequenceKeypoint.new(0.5, Color3.fromHex("E8913A")),
		ColorSequenceKeypoint.new(1, Color3.fromHex("C0392B")),
	}),
}

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function updateSprays()
	for _, character in characters() do
		if character:IsA("Model") and character:GetAttribute("ParticipantId") then
			local spraying = character:GetAttribute("Spraying")
			local held = character:FindFirstChild("HeldItem")
			local handle = held and held:FindFirstChild("Handle")
			if handle then
				local emitter = handle:FindFirstChild("Spray", true) :: ParticleEmitter?
				if spraying and not emitter then
					local attachment = Instance.new("Attachment")
					attachment.Name = "SprayAt"
					attachment.CFrame = CFrame.new(0, 0, -4.3)
					attachment.Parent = handle
					local created = Instance.new("ParticleEmitter")
					created.Name = "Spray"
					created.Color = SPRAY_COLORS[spraying] or SPRAY_COLORS.WaterGun
					created.EmissionDirection = Enum.NormalId.Front
					created.Speed = NumberRange.new(28, 40)
					created.SpreadAngle = Vector2.new(if spraying == "LeafBlower" then 18 else 6, 4)
					created.Lifetime = NumberRange.new(0.35, 0.5)
					created.Rate = 70
					created.Size = NumberSequence.new(if spraying == "LeafBlower" then 0.9 else 0.6, 0.2)
					created.LightEmission = 0.2
					created.Parent = attachment
					emitter = created
				end
				if emitter then
					emitter.Enabled = spraying ~= nil
				end
			end
		end
	end
end

local function blast(origin: Vector3, direction: Vector3, reach: number)
	for _, angle in { -0.3, -0.15, 0, 0.15, 0.3 } do
		local dir = CFrame.Angles(0, angle, 0) * direction
		local mid = origin + dir * (reach / 2)
		local tracer = Parts.make({
			name = "Pellet",
			size = Vector3.new(0.25, 0.25, reach),
			cframe = CFrame.lookAt(mid, mid + dir),
			color = "FFE36E",
			material = Enum.Material.Neon,
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		fadeAndRemove(tracer, 0.18)
	end
	local flash = flatPart(origin + direction * 2 + Vector3.new(0, 1, 0), 3, "FFF3B0")
	flash.Material = Enum.Material.Neon
	fadeAndRemove(flash, 0.15, flash.Size * 1.6)
	Sounds.play("Shotgun", origin, 0.8)
end

local function debris(cframe: CFrame, size: Vector3)
	local rng = Random.new()
	for _ = 1, 8 do
		local offset = Vector3.new(
			rng:NextNumber(-size.X / 2, size.X / 2),
			rng:NextNumber(-1, 3),
			rng:NextNumber(-size.Z / 2, size.Z / 2)
		)
		local chunk = Parts.make({
			name = "Debris",
			size = Vector3.one * rng:NextNumber(0.8, 1.8),
			cframe = cframe * CFrame.new(offset),
			color = "4A4A4A",
			anchored = false,
			canCollide = false,
			canQuery = false,
			parent = effectsFolder,
		})
		chunk.AssemblyLinearVelocity =
			Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(20, 40), rng:NextNumber(-25, 25))
		task.delay(1.2, function()
			chunk:Destroy()
		end)
	end
end

local function burst(position: Vector3, color: string, size: number)
	local ring = flatPart(Vector3.new(position.X, 0.6, position.Z), 2, color)
	ring.Transparency = 0.2
	fadeAndRemove(ring, 0.45, Vector3.new(0.1, size, size))
end

local HANDLERS: { [string]: (data: { [string]: any }) -> () } = {
	Swing = function(data)
		swing(data.character, data.item)
	end,
	Shoot = function(data)
		local character = data.character :: Model?
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Shoot", root and root.Position)
	end,
	Splat = function(data)
		local look = data.look
		if look == "Snowball" then
			bits("Snow", data.position)
		elseif look == "Bubble" then
			burst(data.position, "BFE9FF", 5)
			playStyle("Pop", data.position)
		elseif look == "Pebble" then
			burst(data.position, "8C8C8C", 2.5)
		else
			burst(data.position, "C9A66B", 4)
			Sounds.play("Splat", data.position)
		end
	end,
	Blast = function(data)
		if data.item == "ConfettiCannon" then
			bits("Confetti", data.origin, data.direction, 0.6)
			playStyle("Pop", data.origin)
			playStyle("Squeak", data.origin)
		else
			blast(data.origin, data.direction, data.reach)
		end
	end,
	Hit = function(data)
		bits(data.fx, data.position)
		Sounds.play("Hit", data.position)
	end,
	Plunged = function(data)
		local target = data.character :: Model?
		local hit = target and target:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Plunge", hit and hit.Position)
		stickTo(data.character, data.seconds, function(root)
			local s = bodyScale(root)
			local plunger = ItemModels.build("Plunger")
			-- Cup on the face, stick pointing straight out the front.
			plunger:PivotTo(
				root.CFrame
					* CFrame.new(0, 1.2 * s, -1.0 * s)
					* CFrame.Angles(0, math.pi, 0)
					* CFrame.new(0, 0, 3.4)
			)
			local parts = {}
			for _, part in plunger:GetDescendants() do
				if part:IsA("BasePart") and part.Name ~= "Handle" then
					for _, weld in part:GetChildren() do
						if weld:IsA("Weld") then
							weld:Destroy()
						end
					end
					table.insert(parts, part)
				end
			end
			return parts
		end)
	end,
	Bubbled = function(data)
		local character = data.character :: Model?
		local inside = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		Sounds.play("Bubble", inside and inside.Position)
		stickTo(character, data.seconds, function(root)
			local s = bodyScale(root)
			local bubble = Parts.make({
				name = "Bubble",
				shape = Enum.PartType.Ball,
				size = Vector3.one * 5.2 * s,
				cframe = root.CFrame,
				color = "BFE9FF",
				transparency = 0.6,
			})
			local shine = Parts.make({
				name = "Shine",
				shape = Enum.PartType.Ball,
				size = Vector3.one * 1.1 * s,
				cframe = root.CFrame * CFrame.new(-1.2 * s, 1.9 * s, -1.0 * s),
				color = "FFFFFF",
				transparency = 0.3,
			})
			return { bubble, shine }
		end)
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			task.delay(data.seconds, function()
				burst(root.Position, "BFE9FF", 7)
				playStyle("Pop", root.Position)
			end)
		end
	end,
	Frozen = function(data)
		local character = data.character :: Model?
		if not character then
			return
		end
		local ice = Instance.new("Highlight")
		ice.FillColor = Color3.fromHex("9FE3FF")
		ice.FillTransparency = 0.45
		ice.OutlineColor = Color3.new(1, 1, 1)
		ice.DepthMode = Enum.HighlightDepthMode.Occluded
		ice.Parent = character
		task.delay(data.seconds, function()
			ice:Destroy()
		end)
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			bits("Snow", root.Position)
			Sounds.play("Freeze", root.Position)
		end
	end,
	Slip = function(data)
		bits("Peel", data.position)
		bits("Stars", data.position)
		playStyle("Slip", data.position)
	end,
	Drop = function(data)
		Sounds.play("Drop", data.position)
	end,
	Gulp = function(data)
		bits("Sparkle", data.position)
		playStyle("Gulp", data.position)
	end,
	Boom = function(data)
		bits("Feathers", data.position)
		burst(data.position, "FFD93B", 16)
		Sounds.play("Boom", data.position)
	end,
	WallBreak = function(data)
		debris(data.cframe, data.size)
		Sounds.play("WallBreak", data.cframe.Position)
	end,
	Infect = function(data)
		burst(data.position, "7BC043", 10)
		Sounds.play("Infect", data.position)
		task.delay(0.35, function()
			Sounds.play("Groan", data.position, 0.8)
		end)
	end,
	Eat = function(data)
		burst(data.position, "F4F4F4", 4)
		Sounds.play("Eat", data.position)
	end,
	Pickup = function(data)
		Sounds.play("Pickup", data.position)
	end,
	Outbreak = function()
		Sounds.play("Outbreak")
	end,
	RoundEnd = function(data)
		-- A happy chime if your side won, a sad one if it didn't.
		local zombie = ClientState.isZombie()
		local won = (data.winner == "Survivors" and not zombie) or (data.winner == "Zombies" and zombie)
		Sounds.play(if won then "RoundWin" else "RoundLose")
	end,
	Wizard = function(data)
		bits("Sparkle", data.position)
		Sounds.play("Wizard")
	end,
	Warp = function(data)
		Sounds.play("Warp", data.position)
	end,
}

-- Bumping into another character: a soft thud and a little puff where you
-- touched, so collisions read clearly. Your character's "Shell" is the
-- body-sized cylinder only other characters collide with.
local BUMP_COOLDOWN = 0.4
local lastBump = 0

local function watchShell(character: Model)
	local function hook(shell: Instance)
		if not shell:IsA("BasePart") or shell.Name ~= "Shell" then
			return
		end
		shell.Touched:Connect(function(other)
			if other.Name ~= "Shell" or other:IsDescendantOf(character) then
				return
			end
			local now = os.clock()
			if now - lastBump < BUMP_COOLDOWN then
				return
			end
			lastBump = now
			local between = (shell.Position + other.Position) / 2
			playStyle("Bump", between)
			bits("Puff", between)
		end)
	end
	character.ChildAdded:Connect(hook)
	for _, child in character:GetChildren() do
		hook(child)
	end
end

function Effects.start()
	player.CharacterAdded:Connect(watchShell)
	if player.Character then
		watchShell(player.Character)
	end
	task.spawn(function()
		while true do
			task.wait(0.1)
			local ok, err = pcall(function()
				updateSprays()
				return true
			end)
			if not ok then
				warn("[Fx] spray: " .. tostring(err))
			end
		end
	end)
	Remotes.event("Knockback").OnClientEvent:Connect(function(velocity: Vector3, seconds: number)
		local character = player.Character
		if character and typeof(velocity) == "Vector3" then
			Knockback.apply(character, velocity, seconds)
		end
	end)
	Remotes.event("Fx").OnClientEvent:Connect(function(kind: string, data: { [string]: any })
		local handler = HANDLERS[kind]
		if handler then
			local ok, err = pcall(function()
				handler(data or {})
				return true
			end)
			if not ok then
				warn("[Fx] " .. kind .. ": " .. tostring(err))
			end
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ForceField</string>
            <string name="Source"><![CDATA[-- Soft force fields around people and held weapons, felt by YOUR character
-- (worked out on your machine, so it is smooth and instant):
--   * people on your team gently push apart before they overlap
--   * someone else's weapon pushes you off it (firm ones harder)
--   * pushing into someone with your own weapon pushes you back a little
--   * two weapons pressed together push their holders apart
-- So nobody stacks up and there is always a bit of friction, like the
-- original. Bots get the same push from the server (ItemService.shaftStep).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local Config = require(ReplicatedStorage.Shared.Config)
local Items = require(ReplicatedStorage.Shared.Items)

local ForceField = {}

local C = Config.CHARACTER
local player = Players.LocalPlayer

type Body = { root: BasePart, scale: number, team: any, item: Items.Item? }

local cached: { Model } = {}
local cachedAt = 0

local function others(): { Model }
	local now = os.clock()
	if now - cachedAt > 0.25 then
		cachedAt = now
		cached = {}
		for _, folder in { workspace, workspace:FindFirstChild("Bots") } do
			if folder then
				for _, child in folder:GetChildren() do
					if
						child:IsA("Model")
						and child:GetAttribute("ParticipantId")
						and child ~= player.Character
					then
						table.insert(cached, child)
					end
				end
			end
		end
	end
	return cached
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Closest point to `p` on the segment a-b (all flat).
local function closest(a: Vector3, b: Vector3, p: Vector3): Vector3
	local ab = b - a
	local length2 = ab:Dot(ab)
	if length2 < 1e-6 then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / length2, 0, 1)
	return a + ab * t
end

-- A held melee weapon's shaft: from the hand along where the holder faces.
local function shaft(root: BasePart, scale: number, item: Items.Item, facing: Vector3): (Vector3, Vector3)
	local hand = flat((root.CFrame * CharacterLook.grip(scale)).Position)
	local reach = (item.reach or 5) * math.max(1, scale * 0.9)
	return hand, hand + facing * reach
end

local function heldMelee(model: Model): Items.Item?
	local held = model:FindFirstChild("HeldItem")
	local id = held and held:GetAttribute("ItemId")
	local item = if typeof(id) == "string" then Items.get(id) else nil
	return if item and item.kind == "Melee" then item else nil
end

-- Extra velocity (studs/second, flat) for your character this frame.
function ForceField.velocity(root: BasePart, aim: Vector3, myItemId: string?, myTeam: any): Vector3
	local myScale = root.Size.X / C.RootWidth
	local myRadius = C.ShellDiameter / 2 * myScale
	local me = flat(root.Position)
	local myItem = Items.get(myItemId)
	local myA, myB: Vector3? = nil, nil
	if myItem and myItem.kind == "Melee" then
		myA, myB = shaft(root, myScale, myItem, aim)
	end
	local push = Vector3.zero

	for _, model in others() do
		local other = model:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not other then
			continue
		end
		local them = flat(other.Position)
		local offset = me - them
		if offset.Magnitude > 40 then
			continue
		end
		local scale = other.Size.X / C.RootWidth
		local radius = C.ShellDiameter / 2 * scale

		-- Body to body (same team only: a zombie touching you should infect).
		if model:GetAttribute("Team") == myTeam then
			local overlap = myRadius + radius + 0.3 - offset.Magnitude
			if overlap > 0 then
				local away = if offset.Magnitude > 0.01 then offset.Unit else Vector3.xAxis
				push += away * math.min(overlap * Config.FIELD_BODY, Config.FIELD_BODY_MAX)
			end
		end

		-- Their weapon against you.
		local item = heldMelee(model)
		local facing = flat(other.CFrame.LookVector)
		if item and facing.Magnitude > 0.1 then
			local a, b = shaft(other, scale, item, facing.Unit)
			local point = closest(a, b, me)
			local away = me - point
			local overlap = (item.guard or 0.5) + myRadius - away.Magnitude
			if overlap > 0 then
				local firm = (item.firmness or 1) * math.clamp(scale / myScale, 0.5, 2)
				local dir = if away.Magnitude > 0.01 then away.Unit else facing.Unit
				push += dir * math.min(overlap * Config.FIELD_WEAPON * firm, Config.FIELD_WEAPON_MAX)
			end

			-- Weapon against weapon: both holders get pushed apart.
			if myA and myB and myItem then
				local mine = closest(myA, myB, closest(a, b, (myA + myB) / 2))
				local theirs = closest(a, b, mine)
				local gap = mine - theirs
				local touch = (myItem.guard or 0.5) + (item.guard or 0.5) - gap.Magnitude
				if touch > 0 then
					local dir = if gap.Magnitude > 0.01 then gap.Unit else (me - them).Unit
					push += dir * math.min(touch * Config.FIELD_WEAPON, Config.FIELD_WEAPON_MAX) * 0.6
				end
			end
		end

		-- Your weapon pushing into them pushes you back a little.
		if myA and myB and myItem then
			local point = closest(myA, myB, them)
			local overlap = (myItem.guard or 0.5) + radius - (point - them).Magnitude
			if overlap > 0 then
				local back = if offset.Magnitude > 0.01 then offset.Unit else -aim
				local weight = math.clamp(scale / myScale, 0.5, 2)
				push += back * math.min(overlap * Config.FIELD_RECOIL * weight, Config.FIELD_WEAPON_MAX * 0.5)
			end
		end
	end
	return push
end

return ForceField
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">FurnitureController</string>
            <string name="Source"><![CDATA[-- Drives the furniture YOU are pushing, on your own machine, so it responds
-- instantly and stops the moment you stop. The server hands you a piece when
-- you claim it and takes it back if someone else pushes it too.
--
-- You move furniture by walking into it, with a zombie's arms, or with a
-- held weapon: its shaft is solid and pushes whatever it touches.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local ClientState = require(script.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local FurniturePush = require(ReplicatedStorage.Shared.FurniturePush)
local Items = require(ReplicatedStorage.Shared.Items)
local MovementController = require(script.Parent.MovementController)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local Util = require(ReplicatedStorage.Shared.Util)

local FurnitureController = {}

local player = Players.LocalPlayer
local OWNER = FurniturePush.OWNER_ATTRIBUTE
local CLAIM_INTERVAL = 0.1

local folder: Instance
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
local claimRemote: UnreliableRemoteEvent
local owned: { [BasePart]: boolean } = {}
local pendingClaims: { [Instance]: boolean } = {}
local lastClaim = 0

local function track(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local body = model:WaitForChild("Body", 10) :: BasePart?
	if not body then
		return
	end
	local function refresh()
		if model:GetAttribute(OWNER) == player.UserId and model.Parent == folder then
			owned[body] = true
		else
			owned[body] = nil
		end
	end
	model:GetAttributeChangedSignal(OWNER):Connect(refresh)
	model.AncestryChanged:Connect(refresh)
	refresh()
end

local function query(cframe: CFrame, size: Vector3): { BasePart }
	local found = {}
	for _, part in workspace:GetPartBoundsInBox(cframe, size, overlap) do
		if part.Name == "Body" and not part.Anchored then
			table.insert(found, part)
		end
	end
	return found
end

local function collect(): FurniturePush.Pushes
	local pushes: FurniturePush.Pushes = {}
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return pushes
	end
	local scale = ClientState.my("Scale") or 1
	local strength = RoundRules.pushStrength(scale)
	local walk = humanoid.WalkSpeed
	local move = Vector3.new(humanoid.MoveDirection.X, 0, humanoid.MoveDirection.Z)
	local moving = move.Magnitude > 0.1 and walk > 0
	local dir = if moving then move.Unit else Vector3.zero

	-- Walking into furniture.
	if moving then
		local probe, size = FurniturePush.moverProbe(root, dir, scale)
		for _, body in query(probe, size) do
			FurniturePush.add(pushes, body, dir * walk, strength, probe.Position)
		end
	end

	-- A zombie's arms are solid: walking, they push what they touch; standing
	-- or turning, they shove it out of the way.
	if ClientState.isZombie() and walk > 0 then
		local probe, size = FurniturePush.armsProbe(
			root,
			scale,
			CharacterLook.ZOMBIE_ARM_REACH,
			CharacterLook.ZOMBIE_ARM_SPAN
		)
		for _, body in query(probe, size) do
			if not pushes[body] then
				if moving then
					FurniturePush.add(pushes, body, dir * walk, strength, probe.Position)
				else
					local exit = FurniturePush.shaftExit(root.Position, probe.LookVector, body)
					FurniturePush.add(
						pushes,
						body,
						exit * walk * Config.SHAFT_FURNITURE_FACTOR,
						strength,
						nil
					)
				end
			end
		end
	end

	-- Weapons: the shaft pushes what it touches.
	local item = Items.get(ClientState.my("HeldItem"))
	if item and item.kind == "Melee" and not ClientState.isZombie() then
		local aim = MovementController.aim()
		local reach = (item.reach or 5) * math.max(1, scale * 0.9)
		local grip = CharacterLook.grip(scale)
		local hand = (root.CFrame * grip).Position
		local probe, size = FurniturePush.itemProbe(root, grip, aim, reach, item.guard)
		local touched = query(probe, size)
		local firm = strength * (item.firmness or 1) -- a stiff bat shoves harder than a noodle
		-- The shaft is solid: what it overlaps moves out of the way.
		if walk > 0 then
			for _, body in touched do
				if not pushes[body] then
					if moving then
						FurniturePush.add(pushes, body, dir * walk, firm, body.Position + aim * 0.5)
					else
						local exit = FurniturePush.shaftExit(hand, aim, body)
						FurniturePush.add(
							pushes,
							body,
							exit * walk * Config.SHAFT_FURNITURE_FACTOR,
							firm,
							nil
						)
					end
				end
			end
		end
	end

	-- A piece you drive pushes whatever it runs into, so you can shove a line.
	for body, push in table.clone(pushes) do
		if owned[body] then
			local velocity = FurniturePush.resolve(body, push)
			local ahead = Util.flatUnit(velocity)
			if ahead and velocity.Magnitude > 0.5 then
				local reachAhead = FurniturePush.extent(body, ahead)
				local center = body.Position + ahead * (reachAhead + 0.6)
				local side = Vector3.new(-ahead.Z, 0, ahead.X)
				local width = FurniturePush.extent(body, side) * 2 * 0.9
				local probe = CFrame.lookAt(center, center + ahead)
				for _, other in query(probe, Vector3.new(width, 2, 1.2)) do
					if other ~= body and not pushes[other] then
						FurniturePush.add(pushes, other, velocity, push.strength, center)
					end
				end
			end
		end
	end
	return pushes
end

local function step()
	local pushes = collect()

	-- Ask the server for anything we're pushing.
	for body in pushes do
		local model = body.Parent
		if model then
			pendingClaims[model] = true
		end
	end
	local now = os.clock()
	if next(pendingClaims) and now - lastClaim >= CLAIM_INTERVAL then
		local list = {}
		for model in pendingClaims do
			table.insert(list, model)
			if #list >= 16 then
				break
			end
		end
		table.clear(pendingClaims)
		lastClaim = now
		claimRemote:FireServer(list)
	end

	-- Drive the pieces the server gave us. Unpushed ones stand still.
	for body in owned do
		if body.Parent == nil then
			owned[body] = nil
			continue
		end
		local v = body.AssemblyLinearVelocity
		local push = pushes[body]
		if push then
			local velocity, spin = FurniturePush.resolve(body, push)
			body.AssemblyLinearVelocity = Vector3.new(velocity.X, math.min(v.Y, 0), velocity.Z)
			body.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
		elseif math.abs(v.X) + math.abs(v.Z) > 0.02 or body.AssemblyAngularVelocity.Magnitude > 0.02 then
			body.AssemblyLinearVelocity = Vector3.new(0, math.min(v.Y, 0), 0)
			body.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

function FurnitureController.start()
	folder = workspace:WaitForChild("Furniture")
	overlap.FilterDescendantsInstances = { folder }
	claimRemote = Remotes.unreliable("PushClaim")
	folder.ChildAdded:Connect(function(child)
		task.spawn(track, child)
	end)
	for _, child in folder:GetChildren() do
		task.spawn(track, child)
	end
	-- Before physics, so the velocities we set are used this very frame.
	RunService.PreSimulation:Connect(step)
end

return FurnitureController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- Keyboard, mouse and gamepad actions. Touch buttons call the same functions.
--   Left click / R2: use item (hold to keep spraying)
--   E / X: pick up      G / B: drop      B / Y: shop      Z / L1: zombie return
--   1 2 3 / D-pad: switch inventory slot

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local MovementController = require(script.Parent.MovementController)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local InputController = {}

local useRemote = Remotes.event("UseItem")
local pickRemote = Remotes.event("PickUp")
local dropRemote = Remotes.event("DropItem")
local returnRemote = Remotes.event("ZombieReturn")
local slotRemote = Remotes.event("SelectSlot")

-- Set by the HUD.
InputController.onShop = function() end
InputController.isMenuOpen = function(): boolean
	return false
end

local using = false

function InputController.useStart()
	using = true
	useRemote:FireServer("start", MovementController.aim())
end

-- True while the use button is held (hooking furniture with a weapon).
function InputController.isUsing(): boolean
	return using
end

function InputController.useStop()
	if using then
		using = false
		useRemote:FireServer("stop", MovementController.aim())
	end
end

function InputController.pickUp()
	pickRemote:FireServer()
end

function InputController.drop()
	dropRemote:FireServer()
end

function InputController.selectSlot(slot: number)
	slotRemote:FireServer(slot)
end

function InputController.zombieReturn()
	returnRemote:FireServer()
end

function InputController.shop()
	InputController.onShop()
end

local BEGIN: { [Enum.KeyCode]: () -> () } = {
	[Enum.KeyCode.E] = InputController.pickUp,
	[Enum.KeyCode.G] = InputController.drop,
	[Enum.KeyCode.B] = InputController.shop,
	[Enum.KeyCode.Z] = InputController.zombieReturn,
	[Enum.KeyCode.ButtonX] = InputController.pickUp,
	[Enum.KeyCode.ButtonB] = InputController.drop,
	[Enum.KeyCode.ButtonY] = InputController.shop,
	[Enum.KeyCode.ButtonL1] = InputController.zombieReturn,
	[Enum.KeyCode.ButtonR2] = InputController.useStart,
	[Enum.KeyCode.One] = function()
		InputController.selectSlot(1)
	end,
	[Enum.KeyCode.Two] = function()
		InputController.selectSlot(2)
	end,
	[Enum.KeyCode.Three] = function()
		InputController.selectSlot(3)
	end,
	[Enum.KeyCode.DPadLeft] = function()
		InputController.selectSlot(1)
	end,
	[Enum.KeyCode.DPadUp] = function()
		InputController.selectSlot(2)
	end,
	[Enum.KeyCode.DPadRight] = function()
		InputController.selectSlot(3)
	end,
}

function InputController.start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not InputController.isMenuOpen() then
				InputController.useStart()
			end
			return
		end
		local action = BEGIN[input.KeyCode]
		if action then
			action()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.KeyCode == Enum.KeyCode.ButtonR2
		then
			InputController.useStop()
		end
	end)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point.

local Client = script.Parent

require(Client.ChatSetup).start()
require(Client.CameraController).start()
require(Client.MovementController).start()
require(Client.InputController).start()
require(Client.FurnitureController).start()
require(Client.BushController).start()
require(Client.Effects).start()
require(Client.SoundController).start()
require(Client.UI.Hud).start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[-- Moves the character in SCREEN directions (W = up the screen = world -Z)
-- and turns it to face the mouse. On touch screens and gamepads, where there
-- is no mouse, the character faces the way it walks instead.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local ForceField = require(script.Parent.ForceField)

local MovementController = {}

local player = Players.LocalPlayer
local aim = Vector3.new(0, 0, -1)
local usingMouse = not UserInputService.TouchEnabled or UserInputService.MouseEnabled
local controls: any = nil
local aimRemote: UnreliableRemoteEvent? = nil
local lastAimSent = 0
local lastAimSentValue = Vector3.zero

local KEYS: { [Enum.KeyCode]: Vector3 } = {
	[Enum.KeyCode.W] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.Up] = Vector3.new(0, 0, -1),
	[Enum.KeyCode.S] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.Down] = Vector3.new(0, 0, 1),
	[Enum.KeyCode.A] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.Left] = Vector3.new(-1, 0, 0),
	[Enum.KeyCode.D] = Vector3.new(1, 0, 0),
	[Enum.KeyCode.Right] = Vector3.new(1, 0, 0),
}

local MOUSE_INPUTS = {
	[Enum.UserInputType.MouseMovement] = true,
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.MouseButton2] = true,
	[Enum.UserInputType.MouseWheel] = true,
	[Enum.UserInputType.Keyboard] = true,
}

function MovementController.aim(): Vector3
	return aim
end

function MovementController.usingMouse(): boolean
	return usingMouse
end

local function rawMove(): Vector3
	local v = Vector3.zero
	-- Thumbsticks and gamepads come from Roblox's PlayerModule. Its vector is
	-- already in screen terms: -Z means "up the screen".
	if controls then
		local ok, mv = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(mv) == "Vector3" then
			v += mv
		end
	end
	if not UserInputService:GetFocusedTextBox() then
		-- Read keys directly too, so arrows always work. Counting a key twice
		-- is harmless because the result is normalized below.
		for key, direction in KEYS do
			if UserInputService:IsKeyDown(key) then
				v += direction
			end
		end
	end
	v = Vector3.new(v.X, 0, v.Z)
	if v.Magnitude > 1 then
		v = v.Unit
	end
	return v
end

local function step()
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	humanoid.AutoRotate = false

	local move = rawMove()
	humanoid:Move(move, false) -- false = world space, not camera space

	-- Sharp, like the original: full speed the instant a key goes down, a dead
	-- stop the instant it comes up (a Humanoid alone eases in and out). Left
	-- alone while a knockback shove is playing.
	-- Soft force fields from people and weapons nearby are added on top, so
	-- nobody stacks and pushing always meets a little resistance.
	if not root:FindFirstChild("KnockbackForce") then
		local v = root.AssemblyLinearVelocity
		local speed = humanoid.WalkSpeed
		local field =
			ForceField.velocity(root, aim, ClientState.my("HeldItem"), character:GetAttribute("Team"))
		root.AssemblyLinearVelocity = Vector3.new(move.X * speed + field.X, v.Y, move.Z * speed + field.Z)
	end

	local camera = workspace.CurrentCamera
	if usingMouse and camera then
		local mouse = UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
		if math.abs(ray.Direction.Y) > 1e-3 then
			local t = (root.Position.Y - ray.Origin.Y) / ray.Direction.Y
			local point = ray.Origin + ray.Direction * t
			local flat = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z)
			if flat.Magnitude > 0.5 then
				aim = flat.Unit
			end
		end
	elseif move.Magnitude > 0.1 then
		aim = move.Unit
	end
	root.CFrame = CFrame.lookAt(root.Position, root.Position + aim)

	-- Keep the server's idea of your aim fresh (weapon pushes use it).
	local now = os.clock()
	if aimRemote and now - lastAimSent > 0.1 and aim:Dot(lastAimSentValue) < 0.995 then
		lastAimSent, lastAimSentValue = now, aim
		aimRemote:FireServer(aim)
	end
end

local function onCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.AutoRotate = false
	for _, state in
		{
			Enum.HumanoidStateType.Jumping,
			Enum.HumanoidStateType.Climbing,
			Enum.HumanoidStateType.FallingDown,
			Enum.HumanoidStateType.Ragdoll,
			Enum.HumanoidStateType.Seated,
			Enum.HumanoidStateType.Swimming,
		}
	do
		humanoid:SetStateEnabled(state, false)
	end
end

function MovementController.start()
	task.spawn(function()
		local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
		aimRemote = Remotes.unreliable("Aim")
	end)
	task.spawn(function()
		local ok, module = pcall(function()
			return require(
					player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript
				) :: any
		end)
		if ok and module then
			controls = module:GetControls()
		else
			warn("[Movement] PlayerModule unavailable; keyboard only")
		end
	end)

	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		if MOUSE_INPUTS[inputType] then
			usingMouse = true
		elseif inputType == Enum.UserInputType.Touch or string.find(inputType.Name, "Gamepad") then
			usingMouse = false
		end
	end)

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	-- Runs right after Roblox's own control script (priority Input), so our
	-- world-space move wins.
	RunService:BindToRenderStep("BrainTagMove", Enum.RenderPriority.Input.Value + 1, step)
end

return MovementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">SoundBank</string>
            <string name="Source"><![CDATA[-- Every sound in the game, built from the few sound files that ship inside
-- the Roblox client (so they always load, in any experience, with no
-- uploads). Each recipe picks a file and shapes it: pitch, volume, a slice of
-- the file, audio effects, or a short sequence of notes.
--
-- To use your own uploaded sound instead, put its id in
-- Config.SOUND_OVERRIDES, e.g. Squeak = "rbxassetid://1234567890".

export type Note = {
	file: string, -- key of FILES
	pitch: number?,
	volume: number?,
	from: number?, -- play only this slice of the file (seconds)
	to: number?,
	effects: { string }?, -- Echo, Distort, Tremolo, Flange, Reverb, Muffle, Thin
	delay: number?, -- seconds after the first note (sequences)
}

export type Recipe = { Note }

local FILES: { [string]: string } = {
	Fall = "rbxasset://sounds/action_falling.ogg", -- rushing air
	Steps = "rbxasset://sounds/action_footsteps_plastic.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Jump = "rbxasset://sounds/action_jump.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3", -- thud
	Swim = "rbxasset://sounds/action_swim.mp3",
	Explosion = "rbxasset://sounds/impact_explosion_03.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Oof = "rbxasset://sounds/oof.ogg",
	Ouch = "rbxasset://sounds/ouch.ogg",
	Click = "rbxasset://sounds/volume_slider.ogg",
}

local function note(file: string, pitch: number, volume: number, extra: { [string]: any }?): Note
	local n: Note = { file = file, pitch = pitch, volume = volume }
	if extra then
		n.from = extra.from
		n.to = extra.to
		n.effects = extra.effects
		n.delay = extra.delay
	end
	return n
end

local function chime(pitches: { number }, gap: number, volume: number, effects: { string }?): Recipe
	local notes = {}
	for i, pitch in pitches do
		table.insert(notes, note("Click", pitch, volume, { delay = (i - 1) * gap, effects = effects }))
	end
	return notes
end

local RECIPES: { [string]: Recipe } = {
	-- Weapons
	Whoosh = { note("Fall", 2.4, 0.35, { from = 0.2, to = 0.5 }) },
	Lunge = { note("Jump", 1.6, 0.45) },
	Swish = { note("Fall", 1.6, 0.35, { from = 0.1, to = 0.45, effects = { "Flange" } }) },
	Hit = { note("Land", 1.5, 0.7) },
	Clang = {
		note("Land", 2.6, 0.75, { effects = { "Echo", "Thin" } }),
		note("Click", 0.7, 0.5, { effects = { "Echo" } }),
	},
	Squeak = { note("Oof", 2.4, 0.55) },
	Boing = { note("Jump", 0.55, 0.7, { effects = { "Tremolo", "Flange" } }) },
	Pop = { note("Click", 0.55, 1) },
	Twang = { note("Jump", 2.2, 0.5, { effects = { "Tremolo" } }) },
	Gulp = { note("Splash", 2.2, 0.45, { to = 0.35 }) },
	Slip = { note("Fall", 1.8, 0.4, { to = 0.4 }), note("Oof", 1.4, 0.6, { delay = 0.25 }) },
	Shoot = { note("Explosion", 2.8, 0.25, { to = 0.25 }) },
	Shotgun = { note("Explosion", 1.5, 0.55, { to = 0.6 }) },
	Boom = { note("Explosion", 1, 0.7), note("Oof", 2.4, 0.4, { delay = 0.1 }) },
	Splat = { note("Splash", 1.6, 0.35, { to = 0.3 }), note("Land", 1.2, 0.3) },
	Plunge = { note("Land", 0.8, 0.6), note("Splash", 2.5, 0.35, { to = 0.2 }) },
	Freeze = {
		note("Splash", 0.6, 0.35, { to = 0.5, effects = { "Echo" } }),
		note("Click", 2.8, 0.5, { delay = 0.05 }),
	},
	Bubble = { note("Swim", 2, 0.35, { to = 0.4 }) },
	WallBreak = { note("Explosion", 1.2, 0.6, { to = 0.8 }), note("Land", 0.7, 0.7) },

	-- People
	Bump = { note("Land", 1.9, 0.3) },
	Infect = { note("Oof", 1, 0.9) }, -- the classic
	Groan = { note("Ouch", 0.5, 0.55, { effects = { "Distort", "Reverb" } }) },
	Pickup = { note("GetUp", 1.7, 0.45), note("Click", 1.6, 0.4, { delay = 0.06 }) },
	Drop = { note("Land", 1.1, 0.35) },
	Eat = { note("Click", 1.2, 0.5), note("GetUp", 2, 0.4, { delay = 0.05 }) },
	Warp = { note("Fall", 0.8, 0.45, { to = 0.6, effects = { "Reverb" } }) },

	-- Round and UI
	Outbreak = {
		note("Explosion", 0.45, 0.6),
		note("Ouch", 0.45, 0.6, { delay = 0.2, effects = { "Distort", "Reverb" } }),
	},
	RoundWin = chime({ 1, 1.26, 1.5, 2 }, 0.12, 0.7, { "Reverb" }),
	RoundLose = {
		note("Ouch", 0.45, 0.6, { effects = { "Distort" } }),
		note("Click", 1, 0.6, { delay = 0.15 }),
		note("Click", 0.84, 0.6, { delay = 0.3 }),
		note("Click", 0.7, 0.6, { delay = 0.45 }),
		note("Click", 0.5, 0.6, { delay = 0.6 }),
	},
	Tick = { note("Click", 1.3, 0.5) },
	TickFinal = { note("Click", 1.9, 0.75) },
	UiClick = { note("Click", 1.5, 0.35) },
	Buy = chime({ 2, 2.6 }, 0.09, 0.6),
	Error = chime({ 0.6, 0.5 }, 0.1, 0.5),
	Wizard = chime({ 1.5, 2, 2.5, 3 }, 0.07, 0.5, { "Echo" }),

	-- Loops (started and stopped by SoundController)
	Spray = { note("Swim", 1.5, 0.3) },
	Blower = { note("Fall", 1.3, 0.3) },
	Scrape = { note("Steps", 0.45, 0.25, { effects = { "Muffle" } }) },
	Footsteps = { note("Steps", 1.1, 0.18) },
}

return {
	FILES = FILES,
	RECIPES = RECIPES,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[-- Sounds that follow what's going on rather than one-off events: countdown
-- ticks in the last 10 seconds of prep and of the round, your footsteps,
-- water guns and leaf blowers spraying, furniture scraping, and zombies
-- groaning near you.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.ClientState)
local Sounds = require(script.Parent.Sounds)

local SoundController = {}

local player = Players.LocalPlayer
local HEARING = 90
local INTERVAL = 0.1
local rng = Random.new()

local function characters(): { Instance }
	local list = workspace:GetChildren()
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, bot in bots:GetChildren() do
			table.insert(list, bot)
		end
	end
	return list
end

local function rootOf(model: Instance): BasePart?
	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function setPlaying(sound: Sound?, on: boolean)
	if not sound then
		return
	end
	if on and not sound.IsPlaying then
		sound:Play()
	elseif not on and sound.IsPlaying then
		sound:Stop()
	end
end

function SoundController.start()
	local footsteps = Sounds.loop("Footsteps")
	local footstepsPitch = if footsteps then footsteps.PlaybackSpeed else 1
	local scrape = Sounds.loop("Scrape")
	local sprays: { [Instance]: { sound: Sound, volume: number } } = {}
	local lastTick = -1
	local nextGroan = os.clock() + 5
	local furniture = workspace:WaitForChild("Furniture")

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < INTERVAL then
			return
		end
		elapsed = 0
		local on = Sounds.enabled()
		local character = player.Character
		local me = character and rootOf(character)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")

		-- Countdown ticks.
		local phase = ClientState.phase()
		local left = ClientState.secondsLeft()
		if (phase == "Prep" or phase == "Infection") and left > 0 and left <= 10 then
			local second = math.ceil(left)
			if second ~= lastTick then
				lastTick = second
				Sounds.play(if second <= 3 then "TickFinal" else "Tick")
			end
		else
			lastTick = -1
		end

		-- Your footsteps, faster when you're faster.
		local walking = on
			and humanoid ~= nil
			and humanoid.Health > 0
			and humanoid.WalkSpeed > 0
			and humanoid.MoveDirection.Magnitude > 0.1
		if footsteps and humanoid then
			footsteps.PlaybackSpeed = footstepsPitch * math.clamp(humanoid.WalkSpeed / 16, 0.8, 1.5)
		end
		setPlaying(footsteps, walking)

		-- Furniture scraping along the floor near you.
		local scraping = false
		if on and me then
			for _, model in furniture:GetChildren() do
				local body = model:FindFirstChild("Body") :: BasePart?
				if body and not body.Anchored and body.AssemblyLinearVelocity.Magnitude > 2 then
					if (body.Position - me.Position).Magnitude < 40 then
						scraping = true
						break
					end
				end
			end
		end
		setPlaying(scrape, scraping)

		-- Water guns and leaf blowers, louder the closer they are.
		local seen: { [Instance]: boolean } = {}
		for _, model in characters() do
			local kind = model:GetAttribute("Spraying")
			local root = rootOf(model)
			if on and typeof(kind) == "string" and root then
				seen[model] = true
				local entry = sprays[model]
				if not entry then
					local sound = Sounds.loop(if kind == "LeafBlower" then "Blower" else "Spray")
					if sound then
						entry = { sound = sound, volume = sound.Volume }
						sprays[model] = entry
						sound:Play()
					end
				end
				if entry then
					local distance = if me then (root.Position - me.Position).Magnitude else 0
					entry.sound.Volume = entry.volume * math.clamp(1 - distance / HEARING, 0, 1)
				end
			end
		end
		for model, entry in sprays do
			if not seen[model] then
				entry.sound:Destroy()
				sprays[model] = nil
			end
		end

		-- Now and then a zombie near you groans.
		local now = os.clock()
		if on and me and now >= nextGroan then
			nextGroan = now + rng:NextNumber(4, 8)
			local nearby = {}
			for _, model in characters() do
				local root = rootOf(model)
				if model ~= character and root and model:GetAttribute("Team") == "Zombie" then
					if (root.Position - me.Position).Magnitude < 70 then
						table.insert(nearby, root)
					end
				end
			end
			if #nearby > 0 then
				local root = nearby[rng:NextInteger(1, #nearby)]
				Sounds.play("Groan", root.Position, 0.6, rng:NextNumber(0.9, 1.15))
			end
		end
	end)
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[-- Plays the game's sounds (recipes in SoundBank), quieter the farther they
-- happen from you (the camera is far overhead, so normal 3D falloff would
-- make everything silent). A sound named in Config.SOUND_OVERRIDES plays that
-- uploaded sound instead.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local SoundBank = require(script.Parent.SoundBank)

local Sounds = {}

local enabled = true
local player = Players.LocalPlayer
local HEARING = 90
local rng = Random.new()

function Sounds.setEnabled(on: boolean)
	enabled = on
end

function Sounds.enabled(): boolean
	return enabled
end

function Sounds.has(name: string?): boolean
	return name ~= nil
		and (SoundBank.RECIPES[name] ~= nil or (Config.SOUND_OVERRIDES :: { [string]: string })[name] ~= nil)
end

local function listener(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

local EFFECTS: { [string]: () -> SoundEffect } = {
	Echo = function()
		local e = Instance.new("EchoSoundEffect")
		e.Delay = 0.07
		e.Feedback = 0.35
		e.WetLevel = -4
		return e
	end,
	Distort = function()
		local e = Instance.new("DistortionSoundEffect")
		e.Level = 0.55
		return e
	end,
	Tremolo = function()
		local e = Instance.new("TremoloSoundEffect")
		e.Frequency = 14
		e.Depth = 0.8
		return e
	end,
	Flange = function()
		local e = Instance.new("FlangeSoundEffect")
		e.Mix = 0.8
		e.Rate = 5
		e.Depth = 0.6
		return e
	end,
	Reverb = function()
		local e = Instance.new("ReverbSoundEffect")
		e.DecayTime = 0.9
		e.WetLevel = -6
		return e
	end,
	Muffle = function()
		local e = Instance.new("EqualizerSoundEffect")
		e.HighGain = -25
		e.MidGain = -6
		e.LowGain = 4
		return e
	end,
	Thin = function()
		local e = Instance.new("EqualizerSoundEffect")
		e.LowGain = -20
		e.MidGain = 2
		e.HighGain = 4
		return e
	end,
}

-- Builds (but doesn't play) one note.
local function make(note: SoundBank.Note, volume: number, pitch: number): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = SoundBank.FILES[note.file] or ""
	sound.Volume = (note.volume or 0.6) * volume
	sound.PlaybackSpeed = (note.pitch or 1) * pitch
	if note.from or note.to then
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(note.from or 0, note.to or 60)
	end
	local effects: { string } = note.effects or {}
	for _, name in effects do
		local build = EFFECTS[name]
		if build then
			build().Parent = sound
		end
	end
	sound.Parent = SoundService
	return sound
end

local function playOnce(sound: Sound)
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(8, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

-- `volume` and `pitch` scale the recipe's own values.
function Sounds.play(name: string, position: Vector3?, volume: number?, pitch: number?)
	if not enabled then
		return
	end
	local v = volume or 1
	if position then
		local here = listener()
		if here then
			local dx, dz = position.X - here.X, position.Z - here.Z
			v *= math.clamp(1 - math.sqrt(dx * dx + dz * dz) / HEARING, 0, 1)
		end
		if v < 0.03 then
			return
		end
	end
	local p = (pitch or 1) * rng:NextNumber(0.96, 1.04) -- a little variety
	local override = (Config.SOUND_OVERRIDES :: { [string]: string })[name]
	if override and override ~= "" then
		local sound = Instance.new("Sound")
		sound.SoundId = override
		sound.Volume = 0.6 * v
		sound.PlaybackSpeed = p
		sound.Parent = SoundService
		playOnce(sound)
		return
	end
	local recipe = SoundBank.RECIPES[name]
	if not recipe then
		return
	end
	for _, n in recipe do
		if n.delay and n.delay > 0 then
			task.delay(n.delay, function()
				if enabled then
					playOnce(make(n, v, p))
				end
			end)
		else
			playOnce(make(n, v, p))
		end
	end
end

-- A looping sound you switch on and off (sprays, scraping, footsteps). Uses
-- the first note of the recipe.
function Sounds.loop(name: string): Sound?
	local override = (Config.SOUND_OVERRIDES :: { [string]: string })[name]
	local recipe = SoundBank.RECIPES[name]
	local sound: Sound
	if override and override ~= "" then
		sound = Instance.new("Sound")
		sound.SoundId = override
		sound.Parent = SoundService
	elseif recipe and recipe[1] then
		sound = make(recipe[1], 1, 1)
	else
		return nil
	end
	sound.Looped = true
	return sound
end

return Sounds
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="59">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- The admin panel (F2, or the ADMIN button on the left). Only shown to
-- admins; the server checks every request again (see AdminService).
--   Target: one player or everyone
--   Items:  give any item (or drop it in front of you)
--   Speed, points, immunity, team, bring / go to / respawn
--   Round:  skip phase, add time, next map, reset furniture, clear items

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.Parent.ClientState)
local Items = require(ReplicatedStorage.Shared.Items)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local UIKit = require(script.Parent.UIKit)

local AdminPanel = {}

local GRAY = Color3.fromRGB(70, 72, 78)
local ADMIN_RED = Color3.fromRGB(196, 54, 54)

export type Panel = {
	open: () -> (),
	close: () -> (),
	isOpen: () -> boolean,
	update: () -> (),
}

-- Every item: the shop's order, then the wizard's, then anything else.
local function itemIds(): { string }
	local list, seen = {}, {}
	for _, group in { Items.shopOrder, Items.wizardOrder } do
		for _, id in group do
			if not seen[id] and Items.get(id) then
				seen[id] = true
				table.insert(list, id)
			end
		end
	end
	local rest = {}
	for id in Items.all do
		if not seen[id] then
			table.insert(rest, id)
		end
	end
	table.sort(rest)
	for _, id in rest do
		table.insert(list, id)
	end
	return list
end

function AdminPanel.build(parent: Instance, toast: (string, string?) -> ()): Panel
	local remote = Remotes.func("Admin")
	local window, content = UIKit.modal(parent, "Admin", 660, 600, function() end)

	local scroll = UIKit.new("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -28),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 21,
		Parent = content,
	}, { UIKit.list(Enum.FillDirection.Vertical, 6) })
	local status = UIKit.label({
		Name = "Status",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 16,
		TextColor3 = UIKit.MUTED,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Pick a target, then a command.",
		ZIndex = 21,
		Parent = content,
	})

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	local function heading(text: string)
		UIKit.label({
			Text = text,
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 22),
			TextSize = 18,
			Font = UIKit.HEAVY,
			TextColor3 = UIKit.GOLD,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 21,
			Parent = scroll,
		})
	end

	-- A wrapping row of buttons.
	local function row(height: number?): Frame
		return UIKit.new("Frame", {
			LayoutOrder = nextOrder(),
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			ZIndex = 21,
			Parent = scroll,
		}, {
			UIKit.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(118, height or 32),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
	end

	local function button(parentRow: Frame, text: string, color: Color3?, onClick: () -> ()): TextButton
		return UIKit.button({
			Text = text,
			TextSize = 15,
			TextWrapped = true,
			BackgroundColor3 = color or UIKit.ACCENT,
			ZIndex = 22,
			Parent = parentRow,
		}, onClick)
	end

	-- Target picker --------------------------------------------------------------------------
	local target = ClientState.myId()
	local targetRow: Frame
	local function send(action: string, data: { [string]: any }?)
		local args: { [string]: any } = data or {}
		args.target = target
		status.Text = "..."
		task.spawn(function()
			local ok, success, message = pcall(function()
				return remote:InvokeServer(action, args)
			end)
			local text = if ok then tostring(message) else "Couldn't reach the server"
			status.Text = text
			status.TextColor3 = if ok and success then UIKit.GOOD else UIKit.RED
			if ok and success then
				toast(text)
			end
		end)
	end

	heading("Target")
	targetRow = row(30)
	local function refreshTargets()
		for _, child in targetRow:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local entries = { { id = "*", name = "Everyone" } }
		for _, r in ClientState.rows() do
			table.insert(entries, { id = r.id, name = (if r.isMe then "Me: " else "") .. r.name })
		end
		local stillThere = false
		for _, entry in entries do
			stillThere = stillThere or entry.id == target
		end
		if not stillThere then
			target = ClientState.myId()
		end
		for i, entry in entries do
			local b = button(
				targetRow,
				entry.name,
				if entry.id == target then UIKit.GOOD else GRAY,
				function()
					target = entry.id
					refreshTargets()
				end
			)
			b.LayoutOrder = i
		end
	end

	-- Items -------------------------------------------------------------------------------
	heading("Give item (click)")
	local toGround = false
	local modeRow = row(30)
	local modeButton: TextButton
	modeButton = button(modeRow, "To: their hand", GRAY, function()
		toGround = not toGround
		modeButton.Text = if toGround then "To: ground near me" else "To: their hand"
	end)
	local itemRow = row(30)
	for i, id in itemIds() do
		local item = Items.get(id)
		if item then
			local b = button(itemRow, item.name, nil, function()
				send("give", { item = id, ground = toGround })
			end)
			b.LayoutOrder = i
		end
	end

	-- Skins ---------------------------------------------------------------------------------
	heading("Give skin (they keep it, and wear it now)")
	local skinRow = row(30)
	for i, skin in Skins.list do
		local label = skin.name .. (if skin.team == "Zombie" then " (Z)" else "")
		local b = button(
			skinRow,
			label,
			if skin.team == "Zombie" then Color3.fromRGB(70, 120, 60) else nil,
			function()
				send("skin", { skin = skin.id })
			end
		)
		b.LayoutOrder = i
	end

	-- Speed ---------------------------------------------------------------------------------
	heading("Speed")
	local speedRow = row()
	for _, factor in { 0, 0.25, 0.5, 1, 1.5, 2, 3 } do
		local label = if factor == 0 then "Freeze" elseif factor == 1 then "Normal (1x)" else factor .. "x"
		button(speedRow, label, if factor < 1 then GRAY else nil, function()
			send("speed", { factor = factor })
		end)
	end

	-- Points --------------------------------------------------------------------------------
	heading("Points (size and speed follow points)")
	local pointsRow = row()
	for _, amount in { 1000, 10000, 100000, -1000 } do
		button(pointsRow, string.format("%+d", amount), if amount < 0 then GRAY else nil, function()
			send("points", { add = amount })
		end)
	end
	button(pointsRow, "Set to 0", ADMIN_RED, function()
		send("points", { set = 0 })
	end)

	-- Player --------------------------------------------------------------------------------
	heading("Player")
	local playerRow = row()
	button(playerRow, "Make human", nil, function()
		send("team", { team = "Human" })
	end)
	button(playerRow, "Make zombie", ADMIN_RED, function()
		send("team", { team = "Zombie" })
	end)
	button(playerRow, "Immunity 100", nil, function()
		send("immunity", { value = 100 })
	end)
	button(playerRow, "Bring to me", nil, function()
		send("bring")
	end)
	button(playerRow, "Go to", nil, function()
		send("goTo")
	end)
	button(playerRow, "Respawn", GRAY, function()
		send("respawn")
	end)

	-- Round ---------------------------------------------------------------------------------
	heading("Round")
	local roundRow = row()
	button(roundRow, "Skip phase", nil, function()
		send("skip")
	end)
	button(roundRow, "+60 seconds", nil, function()
		send("time", { seconds = 60 })
	end)
	button(roundRow, "-30 seconds", GRAY, function()
		send("time", { seconds = -30 })
	end)
	button(roundRow, "Next map (next round)", nil, function()
		send("nextMap")
	end)
	button(roundRow, "Reset furniture", GRAY, function()
		send("resetFurniture")
	end)
	button(roundRow, "Clear ground items", GRAY, function()
		send("clearItems")
	end)

	-- Open button (admins only) ----------------------------------------------------------------
	local openButton = UIKit.button({
		Name = "AdminButton",
		Text = "ADMIN\n(F2)",
		TextSize = 13,
		-- Under the left side bar's buttons.
		Position = UDim2.fromOffset(12, 10 + 5 * (66 + 8)),
		Size = UDim2.fromOffset(66, 46),
		BackgroundColor3 = ADMIN_RED,
		Visible = false,
		Parent = parent,
	})

	local function isAdmin(): boolean
		return ClientState.my("Admin") == true
	end

	local lastCount = -1
	local panel: Panel = {
		open = function()
			if isAdmin() then
				lastCount = #ClientState.rows()
				refreshTargets()
				window.Visible = true
			end
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function()
			openButton.Visible = isAdmin()
			if window.Visible then
				local count = #ClientState.rows()
				if count ~= lastCount then
					lastCount = count
					refreshTargets()
				end
			end
		end,
	}
	local function toggle()
		if window.Visible then
			panel.close()
		else
			panel.open()
		end
	end
	openButton.Activated:Connect(toggle)
	local close = window:FindFirstChild("Close")
	if close and close:IsA("TextButton") then
		close.Activated:Connect(panel.close)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F2 then
			toggle()
		end
	end)
	return panel
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Banner</string>
              <string name="Source"><![CDATA[-- Top-center countdown banner: "Outbreak happening in N seconds", the
-- survival timer, or "Waiting for players".

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local Banner = {}

function Banner.build(parent: Instance): () -> ()
	local frame = UIKit.panel({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = parent,
	}, { UIKit.padding(18, 0) })
	local label = UIKit.label({
		Name = "Text",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 22,
		Font = UIKit.HEAVY,
		Parent = frame,
	})

	return function()
		local phase = ClientState.phase()
		local left = ClientState.secondsLeft()
		local text
		if phase == "Waiting" then
			local count = #ClientState.participants:GetChildren()
			local needed = ClientState.attr("Needed") or 2
			text = string.format("Waiting for players (%d/%d)", count, needed)
		elseif phase == "Prep" then
			text = string.format("Outbreak happening in %d seconds", math.ceil(left))
		elseif phase == "Infection" then
			if ClientState.isZombie() then
				text = "Infect them all!  " .. Util.clock(left)
			else
				text = "Survive!  " .. Util.clock(left) .. " left"
			end
		else
			text = "Next round starting..."
		end
		label.Text = text
		label.TextColor3 = if phase == "Infection" and left <= 10 then UIKit.RED else UIKit.WHITE
	end
end

return Banner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">BottomCenter</string>
              <string name="Source"><![CDATA[-- Bottom-center: a context hint ("Press E to pick up Bat"), the inventory
-- (3 slots with 3D previews; the gold one is in your hand), and the
-- "Immunity 0/100" bar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local InputController = require(script.Parent.Parent.InputController)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local BottomCenter = {}

-- " x3" for peels, " 60%" for a water tank, "" for everything else.
local function chargeText(item: Items.Item, charges: any): string
	if typeof(charges) ~= "number" or charges <= 0 or not item.charges then
		return ""
	end
	if item.kind == "Stream" then
		return string.format(" %d%%", math.ceil(charges / item.charges * 100))
	end
	return " x" .. charges
end

local function nearestGroundItem(position: Vector3): string?
	local folder = workspace:FindFirstChild("GroundItems")
	if not folder then
		return nil
	end
	local best: string? = nil
	local bestDistance = Config.PICKUP_RADIUS
	for _, model in folder:GetChildren() do
		local x, z = model:GetAttribute("SpotX"), model:GetAttribute("SpotZ")
		if typeof(x) == "number" and typeof(z) == "number" then
			local d = Util.flatDistance(Vector3.new(x, 0, z), position)
			if d <= bestDistance then
				best, bestDistance = model:GetAttribute("ItemId") :: string?, d
			end
		end
	end
	return best
end

function BottomCenter.wizardNear(position: Vector3): boolean
	local wizard = workspace:FindFirstChild("Wizard")
	local robe = wizard and wizard:FindFirstChild("Robe") :: BasePart?
	return robe ~= nil and Util.flatDistance(robe.Position, position) <= Config.WIZARD_SHOP_RADIUS
end

function BottomCenter.build(parent: Instance, touchMode: boolean): () -> ()
	local column = UIKit.new("Frame", {
		Name = "BottomCenter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(300, 150),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		UIKit.list(
			Enum.FillDirection.Vertical,
			6,
			Enum.HorizontalAlignment.Center,
			Enum.VerticalAlignment.Bottom
		),
	})

	local hint = UIKit.label({
		Name = "Hint",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(300, 22),
		TextSize = 17,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = hint

	-- The inventory: one box per slot, the one in your hand outlined in gold.
	-- Click a box (or press 1-3) to switch.
	local row = UIKit.new("Frame", {
		Name = "Inventory",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(Config.INVENTORY_SLOTS * 80, 72),
		BackgroundTransparency = 1,
		Parent = column,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	type SlotView = { box: Frame, stroke: UIStroke, name: TextLabel, shown: string?, preview: ViewportFrame? }
	local views: { SlotView } = {}
	for i = 1, Config.INVENTORY_SLOTS do
		local stroke = UIKit.stroke(UIKit.WHITE, 2) :: UIStroke
		local box = UIKit.new("Frame", {
			Name = "Slot" .. i,
			LayoutOrder = i,
			Size = UDim2.fromOffset(72, 72),
			BackgroundColor3 = UIKit.PANEL,
			BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
			BorderSizePixel = 0,
			Parent = row,
		}, { UIKit.corner(10), stroke })
		local number = UIKit.label({
			Name = "Number",
			Text = tostring(i),
			Position = UDim2.fromOffset(5, 2),
			Size = UDim2.fromOffset(16, 16),
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 4,
			Parent = box,
		})
		UIKit.textStroke(1).Parent = number
		local name = UIKit.label({
			Name = "ItemName",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -2),
			Size = UDim2.new(1, -4, 0, 14),
			TextSize = 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 3,
			Parent = box,
		})
		UIKit.textStroke(1).Parent = name
		UIKit.new("TextButton", {
			Name = "Pick",
			Text = "",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 5,
			Parent = box,
		}).Activated
			:Connect(function()
				InputController.selectSlot(i)
			end)
		table.insert(views, { box = box, stroke = stroke, name = name, shown = nil, preview = nil })
	end

	local bar = UIKit.new("Frame", {
		Name = "Immunity",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(200, 18),
		BackgroundColor3 = Color3.fromRGB(40, 40, 44),
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = column,
	}, { UIKit.corner(9) })
	local fill = UIKit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.fromRGB(94, 196, 255),
		BorderSizePixel = 0,
		Parent = bar,
	}, { UIKit.corner(9) })
	local barText = UIKit.label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		TextSize = 13,
		ZIndex = 2,
		Parent = bar,
	})
	UIKit.textStroke(1).Parent = barText

	return function()
		local active = ClientState.my("ActiveSlot") or 1
		for i, view in views do
			local raw = ClientState.my("Slot" .. i)
			local id = if typeof(raw) == "string" and raw ~= "" then raw else nil
			if id ~= view.shown then
				view.shown = id
				if view.preview then
					view.preview:Destroy()
					view.preview = nil
				end
				if id then
					view.preview = UIKit.viewport(view.box, ItemModels.build(id), { ZIndex = 2 })
				end
			end
			local slotItem = Items.get(id)
			view.name.Text = if slotItem
				then slotItem.name .. chargeText(slotItem, ClientState.my("Slot" .. i .. "Charges"))
				else ""
			local isActive = i == active
			view.stroke.Color = if isActive then UIKit.GOLD else UIKit.WHITE
			view.stroke.Thickness = if isActive then 3 else 1.5
			view.stroke.Transparency = if isActive then 0 else 0.5
		end
		local held = ClientState.my("HeldItem")
		local item = Items.get(if typeof(held) == "string" and held ~= "" then held else nil)

		local immunity = ClientState.my("Immunity") or 0
		fill.Size = UDim2.fromScale(math.clamp(immunity / Config.IMMUNITY_MAX, 0, 1), 1)
		barText.Text = string.format("Immunity  %d/%d", immunity, Config.IMMUNITY_MAX)

		local _, root = ClientState.myCharacter()
		local text = ""
		local keys = not touchMode
		if root then
			if ClientState.isZombie() then
				if ClientState.phase() == "Infection" then
					text = if keys then "[Z] back to spawn" else ""
				end
			else
				local ground = nearestGroundItem(root.Position)
				local groundItem = Items.get(ground)
				if BottomCenter.wizardNear(root.Position) then
					text = if keys
						then "Press [B] to trade with the wizard"
						else "Tap SHOP to trade with the wizard"
				elseif groundItem then
					text = (if keys then "Press [E] to pick up " else "Tap PICK UP: ") .. groundItem.name
				elseif item and keys then
					local verb = if item.kind == "Stream"
						then "[Hold click] spray"
						elseif item.kind == "Trap" then "[Click] drop one"
						elseif item.kind == "Melee" and item.hits then "[Click] swing  - hold it out to block"
						elseif item.kind == "Melee" then "Hold it toward zombies to keep them back"
						else "[Click] use"
					text = verb .. "   [G] drop   [1-3] switch"
				end
			end
		end
		hint.Text = text
	end
end

return BottomCenter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">BottomLeft</string>
              <string name="Source"><![CDATA[-- Bottom-left: your points, the speed boost and size they give you, and
-- anything changing your speed right now (energy drink, freeze, stun).
-- Plus a 2x score timer when one is running.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local RoundRules = require(ReplicatedStorage.Shared.RoundRules)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local BottomLeft = {}

local ICE = Color3.fromHex("8FD3FF")

function BottomLeft.build(parent: Instance): () -> ()
	local box = UIKit.panel({
		Name = "ScoreBox",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(220, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, { UIKit.padding(12, 8), UIKit.list(Enum.FillDirection.Vertical, 2) })
	local function line(name: string, order: number, height: number, props: { [string]: any }?): TextLabel
		local label = UIKit.label({
			Name = name,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height),
			TextSize = height - 2,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = box,
		})
		local extra: { [string]: any } = props or {}
		for key, value in extra do
			(label :: any)[key] = value
		end
		return label
	end
	local points = line("Points", 1, 24, { Font = UIKit.HEAVY })
	local speed = line("Speed", 2, 18)
	local size = line("Size", 3, 18)
	local effect = line("Effect", 4, 16, { Visible = false })
	local boost = line("Boost", 5, 16, { TextColor3 = UIKit.GOLD, Visible = false })

	return function()
		local value = ClientState.my("Score") or 0
		points.Text = "Points: " .. Util.commas(value)
		local multiplier = Config.SPEED_MULTIPLIER(value)
		speed.Text = string.format("Speed boost: +%d%%", math.floor((multiplier - 1) * 100 + 0.5))
		size.Text = string.format("Size: %.2fx", ClientState.my("Scale") or 1)

		-- Compare your real walk speed with what your points alone give you.
		local _, _, humanoid = ClientState.myCharacter()
		local expected = RoundRules.walkSpeed(value, ClientState.isZombie())
		local ratio = if humanoid and expected > 0 then humanoid.WalkSpeed / expected else 1
		effect.Visible = math.abs(ratio - 1) > 0.03
		if ratio < 0.01 then
			effect.Text = "Stunned!"
			effect.TextColor3 = ICE
		elseif ratio > 1 then
			effect.Text = string.format("Speed right now: x%.2f", ratio)
			effect.TextColor3 = UIKit.GOLD
		else
			effect.Text = string.format("Slowed: x%.2f", ratio)
			effect.TextColor3 = ICE
		end

		local endsAt = ClientState.my("BoostEndsAt")
		local left = if typeof(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		boost.Visible = left > 0
		if left > 0 then
			boost.Text = "2x score  " .. Util.clock(left)
		end
	end
end

return BottomLeft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Center</string>
              <string name="Source"><![CDATA[-- Center screen: the big "Survivors Win!!!" / "Zombies Win!!!" text, plus
-- short toasts under the banner.

local TweenService = game:GetService("TweenService")

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)

local Center = {}

function Center.buildWinText(parent: Instance): () -> ()
	local label = UIKit.label({
		Name = "WinText",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.9, 0.2),
		TextScaled = true,
		Font = UIKit.HEAVY,
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	})
	UIKit.new("UITextSizeConstraint", { MaxTextSize = 96, Parent = label })
	UIKit.textStroke(4).Parent = label
	local scale = UIKit.new("UIScale", { Scale = 1, Parent = label })

	local shown = ""
	return function()
		local winner = ClientState.attr("Winner")
		local text = if winner == "Survivors"
			then "Survivors Win!!!"
			elseif winner == "Zombies" then "Zombies Win!!!"
			else ""
		if text ~= shown then
			shown = text
			label.Visible = text ~= ""
			label.Text = text
			if text ~= "" then
				scale.Scale = 0.4
				TweenService:Create(
					scale,
					TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Scale = 1 }
				):Play()
			end
		end
	end
end

function Center.buildToasts(parent: Instance): (text: string, hex: string?) -> ()
	local stack = UIKit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(420, 120),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center) })

	local order = 0
	return function(text: string, hex: string?)
		order += 1
		local toast = UIKit.panel({
			Name = "Toast",
			LayoutOrder = order,
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			Parent = stack,
		}, { UIKit.padding(14, 0) })
		local label = UIKit.label({
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 17,
			Text = text,
			TextColor3 = if hex then Color3.fromHex(hex) else UIKit.WHITE,
			Parent = toast,
		})
		local toasts = stack:GetChildren()
		local count = 0
		for _, child in toasts do
			if child:IsA("Frame") then
				count += 1
			end
		end
		if count > 3 then
			local oldest: Frame? = nil
			for _, child in toasts do
				if child:IsA("Frame") and (not oldest or child.LayoutOrder < oldest.LayoutOrder) then
					oldest = child
				end
			end
			if oldest then
				oldest:Destroy()
			end
		end
		task.delay(3, function()
			if toast.Parent then
				local info = TweenInfo.new(0.4)
				TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
				TweenService:Create(label, info, { TextTransparency = 1 }):Play()
				task.wait(0.45)
				toast:Destroy()
			end
		end)
	end
end

return Center
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Builds the whole HUD in code and keeps it up to date.
--   left side: buttons       top-center: countdown      top-right: counts + leaderboard
--   bottom-left: points      bottom-center: item slot   bottom-right: chat
--   center: win text, toasts, shop / settings / trophy / quick start windows

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local AdminPanel = require(script.Parent.AdminPanel)
local Banner = require(script.Parent.Banner)
local BottomCenter = require(script.Parent.BottomCenter)
local BottomLeft = require(script.Parent.BottomLeft)
local Center = require(script.Parent.Center)
local ChatSetup = require(script.Parent.Parent.ChatSetup)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local InputController = require(script.Parent.Parent.InputController)
local MobileButtons = require(script.Parent.MobileButtons)
local QuickStart = require(script.Parent.QuickStart)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopPanel = require(script.Parent.ShopPanel)
local SidePanels = require(script.Parent.SidePanels)
local TopLeft = require(script.Parent.TopLeft)
local TopRight = require(script.Parent.TopRight)
local UIKit = require(script.Parent.UIKit)

local Hud = {}

local player = Players.LocalPlayer

local function hideDefaultGui()
	for _, kind in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health } do
		for _ = 1, 10 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(kind, false)
			end)
			if ok then
				break
			end
			task.wait(0.5)
		end
	end
end

function Hud.start()
	task.spawn(hideDefaultGui)

	local gui = UIKit.new("ScreenGui", {
		Name = "BrainTagHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local uiScale = UIKit.new("UIScale", { Parent = gui })
	local function rescale()
		local camera = workspace.CurrentCamera
		if camera then
			uiScale.Scale = math.clamp(camera.ViewportSize.Y / 760, 0.62, 1)
		end
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end

	local touchMode = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	local toast = Center.buildToasts(gui)
	ShopPanel.build(gui, toast)
	local openQuick, quickOpen = QuickStart.build(gui, touchMode, function()
		Remotes.event("TutorialDone"):FireServer()
	end)
	local settings = SidePanels.buildSettings(gui, openQuick)
	local trophy = SidePanels.buildTrophy(gui)
	local admin = AdminPanel.build(gui, toast)

	local function closeAll()
		ShopPanel.close()
		settings.close()
		trophy.close()
		admin.close()
	end

	local function toggleShop()
		if ShopPanel.isOpen() then
			ShopPanel.close()
			return
		end
		if ClientState.isZombie() then
			toast("Zombies can't shop!", Config.COLORS.ZombieText)
			return
		end
		closeAll()
		local _, root = ClientState.myCharacter()
		local atWizard = root ~= nil and BottomCenter.wizardNear(root.Position)
		ShopPanel.open(if atWizard then "Wizard" else "Items")
	end

	TopLeft.build(gui, {
		menu = function()
			closeAll()
			openQuick()
		end,
		shop = toggleShop,
		settings = function()
			local wasOpen = settings.isOpen()
			closeAll()
			if not wasOpen then
				settings.open()
			end
		end,
		trophy = function()
			local wasOpen = trophy.isOpen()
			closeAll()
			if not wasOpen then
				trophy.open()
			end
		end,
		chat = function()
			ChatSetup.setVisible(not ChatSetup.isVisible())
		end,
	})

	local updaters = {
		Banner.build(gui),
		TopRight.build(gui),
		BottomCenter.build(gui, touchMode),
		BottomLeft.build(gui),
		Center.buildWinText(gui),
	}
	if touchMode then
		table.insert(updaters, MobileButtons.build(gui))
	end

	InputController.onShop = toggleShop
	InputController.isMenuOpen = function()
		return ShopPanel.isOpen() or settings.isOpen() or trophy.isOpen() or quickOpen() or admin.isOpen()
	end

	Remotes.event("Toast").OnClientEvent:Connect(function(text: string, hex: string?)
		if typeof(text) == "string" then
			toast(text, hex)
		end
	end)

	-- First visit: show the quick start once the server has loaded our data.
	task.spawn(function()
		local me = ClientState.participants:WaitForChild(ClientState.myId(), 60)
		if me and me:GetAttribute("SeenTutorial") ~= true then
			openQuick()
		end
	end)

	task.spawn(function()
		while true do
			for _, update in updaters do
				local ok, err = pcall(function()
					update()
					return true
				end)
				if not ok then
					warn("[Hud] " .. tostring(err))
				end
			end
			ShopPanel.update()
			trophy.update()
			admin.update()

			-- Close the shop if you turned into a zombie or walked away from the wizard.
			if ShopPanel.isOpen() then
				local _, root = ClientState.myCharacter()
				if ClientState.isZombie() then
					ShopPanel.close()
				elseif
					ShopPanel.mode() == "Wizard" and (not root or not BottomCenter.wizardNear(root.Position))
				then
					ShopPanel.close()
				end
			end

			-- Your own name tag is lime green (only on your screen).
			local character = player.Character
			local head = character and character:FindFirstChild("Head")
			local tag = head and head:FindFirstChild("NameTag")
			local label = tag and tag:FindFirstChild("Label") :: TextLabel?
			if label then
				label.TextColor3 = UIKit.LIME
			end

			task.wait(0.1)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">MobileButtons</string>
              <string name="Source"><![CDATA[-- On-screen buttons for phones and tablets: USE (hold), PICK UP, DROP, SHOP,
-- and RETURN for zombies. Placed bottom-right.

local ClientState = require(script.Parent.Parent.ClientState)
local InputController = require(script.Parent.Parent.InputController)
local UIKit = require(script.Parent.UIKit)

local MobileButtons = {}

local function round(parent: Instance, text: string, size: number, position: UDim2, color: Color3): TextButton
	local button = UIKit.button({
		Text = text,
		TextSize = if size > 70 then 22 else 14,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.15,
		Parent = parent,
	})
	local corner = button:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(0.5, 0) -- full circle
	end
	return button
end

function MobileButtons.build(parent: Instance): () -> ()
	local cluster = UIKit.new("Frame", {
		Name = "MobileButtons",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -100),
		Size = UDim2.fromOffset(200, 200),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local use = round(cluster, "USE", 86, UDim2.fromOffset(140, 140), UIKit.ACCENT)
	use.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			InputController.useStart()
		end
	end)
	use.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			InputController.useStop()
		end
	end)

	local pick = round(cluster, "PICK\nUP", 56, UDim2.fromOffset(52, 150), UIKit.PANEL)
	pick.Activated:Connect(InputController.pickUp)
	local drop = round(cluster, "DROP", 50, UDim2.fromOffset(78, 92), UIKit.PANEL)
	drop.Activated:Connect(InputController.drop)
	local shop = round(cluster, "SHOP", 50, UDim2.fromOffset(140, 66), UIKit.PANEL)
	shop.Activated:Connect(InputController.shop)
	local back = round(cluster, "RETURN", 70, UDim2.fromOffset(140, 140), UIKit.RED)
	back.Activated:Connect(InputController.zombieReturn)

	return function()
		local zombie = ClientState.isZombie()
		use.Visible = not zombie
		pick.Visible = not zombie
		drop.Visible = not zombie
		shop.Visible = not zombie
		back.Visible = zombie and ClientState.phase() == "Infection"
	end
end

return MobileButtons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">QuickStart</string>
              <string name="Source"><![CDATA[-- The "Quick start" card shown on your first visit (and from the menu button).

local UIKit = require(script.Parent.UIKit)

local QuickStart = {}

function QuickStart.build(parent: Instance, touchMode: boolean, onDone: () -> ()): (() -> (), () -> boolean)
	local card = UIKit.panel({
		Name = "QuickStart",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 30,
		Parent = parent,
	}, { UIKit.padding(22, 18), UIKit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center) })
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(440, 600), Parent = card })

	local function line(order: number, text: string, size: number, font: Enum.Font, color: Color3?)
		UIKit.label({
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = text,
			TextSize = size,
			Font = font,
			TextColor3 = color or UIKit.WHITE,
			TextWrapped = true,
			RichText = true,
			ZIndex = 31,
			Parent = card,
		})
	end

	line(1, "Quick start", 30, UIKit.HEAVY)
	line(
		2,
		"Everyone starts human. When the outbreak hits, some players turn into zombies. Survive until the timer runs out, or infect every human.",
		17,
		UIKit.FONT,
		UIKit.MUTED
	)
	local controls: { string } = if touchMode
		then {
			"<b>Thumbstick</b>  move",
			"<b>USE</b>  swing or fire your item",
			"<b>PICK UP / DROP</b>  grab or let go of an item",
			"<b>SHOP</b>  buy items (and trade with the wizard)",
			"<b>RETURN</b>  zombies: back to spawn",
		}
		else {
			"<b>WASD / Arrows</b>  move",
			"<b>Mouse</b>  aim     <b>Click</b>  use item",
			"<b>B</b>  shop (or the wizard, when you stand next to him)",
			"<b>E</b>  pick up     <b>G</b>  drop",
			"<b>Z</b>  zombies: back to spawn",
		}
	for i, text in controls do
		line(2 + i, text, 18, UIKit.BOLD)
	end
	line(
		10,
		"Tip: walk into furniture to push it (bigger players push harder). A held weapon pushes too. Jam a couch into a doorway to build a barricade!",
		17,
		UIKit.BOLD,
		UIKit.LIME
	)
	UIKit.button({
		LayoutOrder = 11,
		Text = "Got it",
		Size = UDim2.fromOffset(160, 42),
		BackgroundColor3 = UIKit.GOOD,
		TextSize = 22,
		ZIndex = 31,
		Parent = card,
	}, function()
		card.Visible = false
		onDone()
	end)

	local function open()
		card.Visible = true
	end
	local function isOpen(): boolean
		return card.Visible
	end
	return open, isOpen
end

return QuickStart
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">ShopPanel</string>
              <string name="Source"><![CDATA[-- The shop window. Tabs: Items (spend score), Skins (score, Robux or VIP) and
-- Robux (game passes and developer products). Opened next to the wizard, it
-- shows his rare stock instead. The server validates every purchase.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CharacterLook = require(ReplicatedStorage.Shared.CharacterLook)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local ItemModels = require(ReplicatedStorage.Shared.ItemModels)
local Items = require(ReplicatedStorage.Shared.Items)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Skins = require(ReplicatedStorage.Shared.Skins)
local Sounds = require(script.Parent.Parent.Sounds)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

type Mode = "Items" | "Wizard" | "Skins" | "Robux"

-- Filled in by build().
local ShopPanel = {
	open = function(_mode: Mode) end,
	close = function() end,
	isOpen = function(): boolean
		return false
	end,
	update = function() end,
	mode = function(): Mode
		return "Items"
	end,
}

local player = Players.LocalPlayer
local money = Config.MONETIZATION
local buyItemRemote = Remotes.func("BuyItem")
local buySkinRemote = Remotes.func("BuySkin")

local PASSES = {
	{
		key = "VIP",
		name = "VIP",
		description = "Gold name and [VIP] chat tag, +20% score, VIP skins.",
		preview = "skin:Royal",
	},
	{
		key = "DoubleScore",
		name = "Double Score",
		description = "+100% score from every reward. Forever.",
		preview = "item:GoldenDrumstick",
	},
	{
		key = "StarterKit",
		name = "Starter Kit",
		description = "Start every round holding a Bat.",
		preview = "item:Bat",
	},
	{
		key = "Lucky",
		name = "Lucky",
		description = "Rare roll chance 5% -> 15% on every purchase.",
		preview = "item:RarePotatoGun",
	},
}

local PRODUCTS = {
	{
		key = "InstantAncientSpear",
		name = "Ancient Spear",
		description = "Super rare. The only weapon that strikes.",
		preview = "item:AncientSpear",
	},
	{
		key = "InstantBat",
		name = "Instant Bat",
		description = "A Bat in your hand right now.",
		preview = "item:Bat",
	},
	{
		key = "InstantSpear",
		name = "Instant Spear",
		description = "A Spear in your hand right now.",
		preview = "item:Spear",
	},
	{
		key = "InstantShotgun",
		name = "Instant Shotgun",
		description = "The big one. Right now.",
		preview = "item:Shotgun",
	},
	{
		key = "ImmunityShot",
		name = "Immunity Shot",
		description = "+50 immunity right now.",
		preview = "item:Pill",
	},
	{
		key = "ScoreBoost30",
		name = "2x Score, 30 min",
		description = "Double every reward for 30 minutes. Stacks.",
		preview = "item:Drumstick",
	},
}

local prices: { [string]: number } = {}

local function fetchPrice(kind: "Product" | "GamePass", id: number, onDone: () -> ())
	local cacheKey = kind .. id
	if prices[cacheKey] or id == 0 then
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(
				id,
				if kind == "GamePass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and info and typeof(info.PriceInRobux) == "number" then
			prices[cacheKey] = info.PriceInRobux
			onDone()
		end
	end)
end

local function priceText(kind: "Product" | "GamePass", id: number): string
	local price = prices[kind .. id]
	return if price then "R$ " .. price else "Robux"
end

local function buildPreview(spec: string): Model?
	local kind, id = string.match(spec, "^(%a+):(%w+)$")
	if kind == "item" and id then
		return ItemModels.build(id)
	elseif kind == "skin" and id then
		local skin = Skins.get(id)
		if skin then
			return CharacterLook.preview(skin.id, skin.team)
		end
	end
	return nil
end

function ShopPanel.build(parent: Instance, toast: (string, string?) -> ())
	local mode: Mode = "Items"
	local render: () -> ()

	local window, content, heading = UIKit.modal(parent, "Shop", 780, 520, function()
		ShopPanel.close()
	end)

	local scoreLabel = UIKit.label({
		Name = "Score",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -54, 0, 12),
		Size = UDim2.fromOffset(220, 28),
		TextSize = 18,
		TextColor3 = UIKit.GOLD,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 22,
		Parent = window,
	})

	local tabBar = UIKit.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = 21,
		Parent = content,
	}, { UIKit.list(Enum.FillDirection.Horizontal, 8) })

	local body = UIKit.new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 1, -42),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 21,
		Parent = content,
	})

	local tabButtons: { [string]: TextButton } = {}
	local function tab(name: string, order: number, onClick: () -> ()): TextButton
		local button = UIKit.button({
			Name = name,
			Text = name,
			LayoutOrder = order,
			Size = UDim2.fromOffset(104, 32),
			TextSize = 17,
			ZIndex = 22,
			Parent = tabBar,
		}, onClick)
		tabButtons[name] = button
		return button
	end
	for i, name in { "Items", "Skins", "Robux" } do
		tab(name, i, function()
			mode = name :: Mode
			render()
		end)
	end

	local function clearBody()
		for _, child in body:GetChildren() do
			child:Destroy()
		end
		UIKit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(168, 222),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = body,
		})
	end

	type CardSpec = {
		order: number,
		title: string,
		price: string,
		priceColor: Color3?,
		description: string,
		preview: Model?,
		button: string,
		buttonColor: Color3?,
		enabled: boolean,
		onClick: (() -> ())?,
	}

	local function card(spec: CardSpec)
		local frame = UIKit.new("Frame", {
			LayoutOrder = spec.order,
			BackgroundColor3 = Color3.fromRGB(44, 46, 52),
			BorderSizePixel = 0,
			ZIndex = 22,
			Parent = body,
		}, { UIKit.corner(10) })
		local previewBox = UIKit.new("Frame", {
			Name = "Preview",
			BackgroundColor3 = Color3.fromRGB(60, 63, 70),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.new(1, -16, 0, 86),
			ZIndex = 22,
			Parent = frame,
		}, { UIKit.corner(8) })
		if spec.preview then
			-- Skins (CharacterLook previews) are shown from above, like in game.
			UIKit.viewport(previewBox, spec.preview, { ZIndex = 23 }, spec.preview.Name == "Preview")
		end
		UIKit.label({
			Position = UDim2.fromOffset(10, 98),
			Size = UDim2.new(1, -20, 0, 20),
			Text = spec.title,
			TextSize = 17,
			Font = UIKit.HEAVY,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.label({
			Position = UDim2.fromOffset(10, 118),
			Size = UDim2.new(1, -20, 0, 16),
			Text = spec.price,
			TextSize = 15,
			TextColor3 = spec.priceColor or UIKit.GOLD,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.label({
			Position = UDim2.fromOffset(10, 136),
			Size = UDim2.new(1, -20, 0, 42),
			Text = spec.description,
			TextSize = 13,
			Font = UIKit.FONT,
			TextColor3 = UIKit.MUTED,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 23,
			Parent = frame,
		})
		UIKit.button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -8),
			Size = UDim2.new(1, -16, 0, 32),
			Text = spec.button,
			TextSize = 16,
			BackgroundColor3 = if spec.enabled
				then (spec.buttonColor or UIKit.GOOD)
				else Color3.fromRGB(80, 82, 88),
			AutoButtonColor = spec.enabled,
			ZIndex = 23,
			Parent = frame,
		}, function()
			if spec.enabled and spec.onClick then
				spec.onClick()
			end
		end)
	end

	local function renderItems(fromWizard: boolean)
		local score = ClientState.my("Score") or 0
		local order: { string } = if fromWizard then Items.wizardOrder else Items.shopOrder
		for i, id in order do
			local item = Items.get(id) :: Items.Item
			local price = (if fromWizard then item.wizardPrice else item.price) or 0
			local affordable = score >= price
			card({
				order = i,
				title = item.name,
				price = Util.commas(price) .. " score",
				priceColor = if affordable then UIKit.GOLD else UIKit.RED,
				description = item.description .. (if item.rare then "  (5% chance: rare!)" else ""),
				preview = ItemModels.build(id),
				button = "Buy",
				enabled = affordable,
				onClick = function()
					local ok, okResult, message = pcall(function()
						return buyItemRemote:InvokeServer(id, fromWizard)
					end)
					if ok then
						Sounds.play(if okResult then "Buy" else "Error")
						toast(
							tostring(message),
							if okResult then Config.COLORS.Good else Config.COLORS.ZombieText
						)
					end
					task.delay(0.2, render)
				end,
			})
		end
	end

	local function prompt(kind: "Product" | "GamePass", key: string)
		local id = if kind == "GamePass" then money.GamePasses[key] else money.Products[key]
		if not id or id == 0 then
			toast("Not set up yet: add its id to Config.MONETIZATION", Config.COLORS.ZombieText)
			return
		end
		if kind == "GamePass" then
			MarketplaceService:PromptGamePassPurchase(player, id)
		else
			MarketplaceService:PromptProductPurchase(player, id)
		end
	end

	local function renderSkins()
		local equipped = ClientState.my("HumanSkin")
		local score = ClientState.my("Score") or 0
		for i, skin in Skins.forTeam("Human") do
			local owned = ClientState.owns("OwnedSkins", skin.id)
				or skin.default == true
				or (skin.pass ~= nil and ClientState.owns("Passes", skin.pass))
			local price, button, enabled = "", "", true
			if equipped == skin.id then
				price, button, enabled = "Owned", "Equipped", false
			elseif owned then
				price, button = "Owned", "Equip"
			elseif skin.scorePrice then
				price = Util.commas(skin.scorePrice) .. " score"
				button = "Unlock"
				enabled = score >= skin.scorePrice
			elseif skin.product then
				local id = money.Products[skin.product] or 0
				fetchPrice("Product", id, render)
				price, button = priceText("Product", id), "Buy"
			elseif skin.pass then
				price, button = "VIP pass", "Get VIP"
			end
			card({
				order = i,
				title = skin.name,
				price = price,
				priceColor = if owned then UIKit.LIME else UIKit.GOLD,
				description = if skin.team == "Zombie" then "Zombie skin" else "Human skin",
				preview = CharacterLook.preview(skin.id, skin.team),
				button = button,
				buttonColor = if skin.product or skin.pass then UIKit.ACCENT else UIKit.GOOD,
				enabled = enabled,
				onClick = function()
					local ok, status, message = pcall(function()
						return buySkinRemote:InvokeServer(skin.id)
					end)
					if not ok then
						return
					end
					if status == "prompt" then
						prompt("Product", message)
					elseif status == "promptPass" then
						prompt("GamePass", message)
					else
						Sounds.play(if status == "error" then "Error" else "Buy")
						toast(
							tostring(message),
							if status == "error" then Config.COLORS.ZombieText else Config.COLORS.Good
						)
					end
					task.delay(0.3, render)
				end,
			})
		end
	end

	local function renderRobux()
		local shown = 0
		local studio = RunService:IsStudio()
		local order = 0
		local function addCard(
			kind: "Product" | "GamePass",
			entry: { key: string, name: string, description: string, preview: string }
		)
			local id = (if kind == "GamePass" then money.GamePasses[entry.key] else money.Products[entry.key])
				or 0
			if id == 0 and not studio then
				return
			end
			order += 1
			shown += 1
			local owned = kind == "GamePass" and ClientState.owns("Passes", entry.key)
			fetchPrice(kind, id, render)
			card({
				order = order,
				title = entry.name,
				price = if owned then "Owned" elseif id == 0 then "Not set up" else priceText(kind, id),
				priceColor = if owned then UIKit.LIME else UIKit.GOLD,
				description = entry.description .. (if kind == "GamePass" then "  (permanent)" else ""),
				preview = buildPreview(entry.preview),
				button = if owned then "Owned" elseif id == 0 then "Needs an id (README)" else "Buy",
				buttonColor = UIKit.ACCENT,
				enabled = not owned and id ~= 0,
				onClick = function()
					prompt(kind, entry.key)
				end,
			})
		end
		for _, entry in PASSES do
			addCard("GamePass", entry)
		end
		for _, entry in PRODUCTS do
			addCard("Product", entry)
		end
		if shown == 0 then
			UIKit.label({
				Text = "Coming soon!",
				TextSize = 22,
				Size = UDim2.fromOffset(168, 222),
				ZIndex = 22,
				Parent = body,
			})
		end
	end

	render = function()
		if not window.Visible then
			return
		end
		clearBody()
		local wizard = mode == "Wizard"
		heading.Text = if wizard then "Wizard's Wares" else "Shop"
		tabBar.Visible = not wizard
		body.Position = UDim2.fromOffset(0, if wizard then 0 else 42)
		body.Size = UDim2.new(1, 0, 1, if wizard then 0 else -42)
		for name, button in tabButtons do
			local selected = name == mode
			button.BackgroundColor3 = if selected then UIKit.ACCENT else Color3.fromRGB(70, 72, 78)
		end
		if mode == "Items" then
			renderItems(false)
		elseif mode == "Wizard" then
			renderItems(true)
		elseif mode == "Skins" then
			renderSkins()
		else
			renderRobux()
		end
	end

	local lastScore = -1
	ShopPanel.update = function()
		if not window.Visible then
			return
		end
		local score = ClientState.my("Score") or 0
		scoreLabel.Text = "Score: " .. Util.commas(score)
		if score ~= lastScore then
			lastScore = score
			render()
		end
	end

	ShopPanel.open = function(newMode: Mode)
		mode = newMode
		window.Visible = true
		lastScore = -1
		render()
	end

	ShopPanel.close = function()
		window.Visible = false
	end

	ShopPanel.isOpen = function(): boolean
		return window.Visible
	end

	ShopPanel.mode = function(): Mode
		return mode
	end

	MarketplaceService.PromptProductPurchaseFinished:Connect(function()
		task.delay(1, render)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function()
		task.delay(1, render)
	end)
end

return ShopPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">SidePanels</string>
              <string name="Source"><![CDATA[-- The settings window (sound, camera height, ping/fps line) and the trophy
-- window (your stats and the all-time top 10).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CameraController = require(script.Parent.Parent.CameraController)
local ClientState = require(script.Parent.Parent.ClientState)
local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(script.Parent.Parent.Sounds)
local TopRight = require(script.Parent.TopRight)
local UIKit = require(script.Parent.UIKit)
local Util = require(ReplicatedStorage.Shared.Util)

local SidePanels = {}

export type Panel = { open: () -> (), close: () -> (), isOpen: () -> boolean, update: () -> () }

local function row(parent: Instance, order: number, title: string): Frame
	local frame = UIKit.new("Frame", {
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		ZIndex = 21,
		Parent = parent,
	})
	UIKit.label({
		Text = title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.45, 0, 1, 0),
		ZIndex = 22,
		Parent = frame,
	})
	local options = UIKit.new("Frame", {
		Name = "Options",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.55, 0, 1, 0),
		ZIndex = 22,
		Parent = frame,
	}, {
		UIKit.list(
			Enum.FillDirection.Horizontal,
			6,
			Enum.HorizontalAlignment.Right,
			Enum.VerticalAlignment.Center
		),
	})
	return options
end

-- A row of mutually exclusive choices.
local function choices(parent: Instance, labels: { string }, current: () -> string, pick: (string) -> ())
	local buttons: { [string]: TextButton } = {}
	local function refresh()
		for label, button in buttons do
			button.BackgroundColor3 = if label == current() then UIKit.ACCENT else Color3.fromRGB(70, 72, 78)
		end
	end
	for i, label in labels do
		buttons[label] = UIKit.button({
			Text = label,
			LayoutOrder = i,
			Size = UDim2.fromOffset(78, 32),
			TextSize = 15,
			ZIndex = 23,
			Parent = parent,
		}, function()
			pick(label)
			refresh()
		end)
	end
	refresh()
end

function SidePanels.buildSettings(parent: Instance, openHelp: () -> ()): Panel
	local panel: Panel
	local window, content = UIKit.modal(parent, "Settings", 440, 330, function()
		panel.close()
	end)
	UIKit.list(Enum.FillDirection.Vertical, 8).Parent = content

	choices(row(content, 1, "Sound effects"), { "On", "Off" }, function()
		return if Sounds.enabled() then "On" else "Off"
	end, function(choice)
		Sounds.setEnabled(choice == "On")
	end)

	choices(row(content, 2, "Camera"), { "Close", "Normal", "Far" }, function()
		for name, height in Config.CAMERA_ZOOMS do
			if height == CameraController.height() then
				return name :: string
			end
		end
		return "Normal"
	end, function(choice)
		CameraController.setHeight((Config.CAMERA_ZOOMS :: { [string]: number })[choice])
	end)

	choices(row(content, 3, "Ping / FPS"), { "On", "Off" }, function()
		return if TopRight.statsVisible() then "On" else "Off"
	end, function(choice)
		TopRight.setStatsVisible(choice == "On")
	end)

	UIKit.button({
		LayoutOrder = 4,
		Text = "How to play",
		Size = UDim2.fromOffset(160, 36),
		ZIndex = 22,
		Parent = content,
	}, function()
		panel.close()
		openHelp()
	end)

	panel = {
		open = function()
			window.Visible = true
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function() end,
	}
	return panel
end

function SidePanels.buildTrophy(parent: Instance): Panel
	local panel: Panel
	local window, content = UIKit.modal(parent, "Trophies", 520, 500, function()
		panel.close()
	end)
	UIKit.list(Enum.FillDirection.Vertical, 6).Parent = content

	local stats = UIKit.label({
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 18,
		RichText = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = content,
	})
	UIKit.label({
		LayoutOrder = 2,
		Text = "All-time top 10",
		Size = UDim2.new(1, 0, 0, 30),
		TextSize = 22,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = content,
	})
	local board = UIKit.label({
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 17,
		Font = UIKit.FONT,
		RichText = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 22,
		Parent = content,
	})

	panel = {
		open = function()
			window.Visible = true
		end,
		close = function()
			window.Visible = false
		end,
		isOpen = function()
			return window.Visible
		end,
		update = function()
			if not window.Visible then
				return
			end
			stats.Text = string.format(
				"Score <b>%s</b>     Wins <b>%d</b>     Infections <b>%d</b>     Rounds <b>%d</b>",
				Util.commas(ClientState.my("Score") or 0),
				ClientState.my("Wins") or 0,
				ClientState.my("Infections") or 0,
				ClientState.my("RoundsPlayed") or 0
			)
			local ok, rows = pcall(function()
				return HttpService:JSONDecode(ClientState.attr("TopScores") or "[]")
			end)
			if ok and typeof(rows) == "table" and #rows > 0 then
				local lines = {}
				for i, entry in rows do
					table.insert(
						lines,
						string.format(
							"%d.  %s  <b>%s</b>",
							i,
							tostring(entry.name),
							Util.commas(tonumber(entry.score) or 0)
						)
					)
				end
				board.Text = table.concat(lines, "\n")
			else
				board.Text = "No saved scores yet. (Saving needs a published place with API access.)"
			end
		end,
	}
	return panel
end

return SidePanels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">TopLeft</string>
              <string name="Source"><![CDATA[-- Left side bar: five big square icon buttons stacked down the left edge
-- (menu, shop, settings, trophy, chat).

local UIKit = require(script.Parent.UIKit)

local TopLeft = {}

TopLeft.BUTTON = 66 -- button size (pixels before UI scaling)
TopLeft.GAP = 8

export type Actions = {
	menu: () -> (),
	shop: () -> (),
	settings: () -> (),
	trophy: () -> (),
	chat: () -> (),
}

function TopLeft.build(parent: Instance, actions: Actions)
	local bar = UIKit.new("Frame", {
		Name = "SideBar",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.fromOffset(TopLeft.BUTTON, 5 * (TopLeft.BUTTON + TopLeft.GAP)),
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, TopLeft.GAP) })

	local buttons: { { icon: string, action: () -> (), accent: boolean?, name: string } } = {
		{ icon = "☰", action = actions.menu, accent = true, name = "Menu" },
		{ icon = "🛒", action = actions.shop, name = "Shop" },
		{ icon = "⚙", action = actions.settings, name = "Settings" },
		{ icon = "🏆", action = actions.trophy, name = "Trophy" },
		{ icon = "💬", action = actions.chat, name = "Chat" },
	}
	for i, b in buttons do
		UIKit.button({
			Name = b.name,
			Text = b.icon,
			TextSize = 34,
			Font = UIKit.BOLD,
			LayoutOrder = i,
			Size = UDim2.fromOffset(TopLeft.BUTTON, TopLeft.BUTTON),
			BackgroundColor3 = if b.accent then UIKit.ACCENT else UIKit.PANEL,
			BackgroundTransparency = if b.accent then 0 else UIKit.PANEL_TRANSPARENCY,
			Parent = bar,
		}, b.action)
	end
end

return TopLeft
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">TopRight</string>
              <string name="Source"><![CDATA[-- Top-right: ping/fps, "N Survivors" (white) over "N Zombies" (red), and a
-- collapsible top-10 leaderboard with your own name in lime green.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ClientState = require(script.Parent.Parent.ClientState)
local UIKit = require(script.Parent.UIKit)
local Util = require(game:GetService("ReplicatedStorage").Shared.Util)

local TopRight = {}

local ROWS = 10
local HUMAN_DOT = Color3.fromHex("F2C79A")
local ZOMBIE_DOT = Color3.fromHex("7BC043")

local showStats = true

function TopRight.setStatsVisible(on: boolean)
	showStats = on
end

function TopRight.statsVisible(): boolean
	return showStats
end

function TopRight.build(parent: Instance): () -> ()
	local column = UIKit.new("Frame", {
		Name = "TopRight",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(240, 400),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { UIKit.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Right) })

	local stats = UIKit.label({
		Name = "Stats",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(240, 16),
		TextSize = 13,
		Font = UIKit.FONT,
		TextColor3 = UIKit.MUTED,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	local survivors = UIKit.label({
		Name = "Survivors",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(240, 32),
		TextSize = 30,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = survivors
	local zombies = UIKit.label({
		Name = "Zombies",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(240, 32),
		TextSize = 30,
		Font = UIKit.HEAVY,
		TextColor3 = UIKit.RED,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = column,
	})
	UIKit.textStroke(1.5).Parent = zombies

	local expanded = true
	local toggle = UIKit.button({
		Name = "LeaderboardToggle",
		LayoutOrder = 4,
		Size = UDim2.fromOffset(150, 26),
		Text = "^  Leaderboard",
		TextSize = 16,
		BackgroundColor3 = UIKit.PANEL,
		BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
		Parent = column,
	})
	local board = UIKit.panel({
		Name = "Leaderboard",
		LayoutOrder = 5,
		Size = UDim2.fromOffset(220, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = column,
	}, { UIKit.padding(8, 6), UIKit.list(Enum.FillDirection.Vertical, 2) })

	toggle.Activated:Connect(function()
		expanded = not expanded
		board.Visible = expanded
		toggle.Text = (if expanded then "^" else "v") .. "  Leaderboard"
	end)

	local rows = {}
	for i = 1, ROWS do
		local row = UIKit.new("Frame", {
			Name = "Row" .. i,
			LayoutOrder = i,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 20),
			Visible = false,
			Parent = board,
		})
		local dot = UIKit.new("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(8, 8),
			BorderSizePixel = 0,
			Parent = row,
		}, { UIKit.corner(4) })
		local name = UIKit.label({
			Name = "Name",
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -84, 1, 0),
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = row,
		})
		local score = UIKit.label({
			Name = "Score",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 70, 1, 0),
			TextSize = 15,
			Font = UIKit.FONT,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
		rows[i] = { frame = row, dot = dot, name = name, score = score }
	end

	local frames, fps = 0, 60
	local windowStart = os.clock()
	RunService.RenderStepped:Connect(function()
		frames += 1
		local now = os.clock()
		if now - windowStart >= 1 then
			fps = frames / (now - windowStart)
			frames, windowStart = 0, now
		end
	end)

	return function()
		stats.Visible = showStats
		if showStats then
			local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000)
			stats.Text = string.format("ping %d ms  |  %d fps", ping, math.floor(fps + 0.5))
		end
		local s = ClientState.attr("Survivors") or 0
		local z = ClientState.attr("Zombies") or 0
		survivors.Text = string.format("%d %s", s, if s == 1 then "Survivor" else "Survivors")
		zombies.Text = string.format("%d %s", z, if z == 1 then "Zombie" else "Zombies")

		local list = ClientState.rows()
		for i, row in rows do
			local entry = list[i]
			row.frame.Visible = entry ~= nil
			if entry then
				row.name.Text = entry.name
				row.name.TextColor3 = if entry.isMe
					then UIKit.LIME
					elseif entry.vip then UIKit.GOLD
					else UIKit.WHITE
				row.score.Text = Util.commas(entry.score)
				row.score.TextColor3 = if entry.isMe then UIKit.LIME else UIKit.WHITE
				row.dot.BackgroundColor3 = if entry.team == "Zombie" then ZOMBIE_DOT else HUMAN_DOT
			end
		end
	end
end

return TopRight
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">UIKit</string>
              <string name="Source"><![CDATA[-- Tiny UI toolkit: every HUD element is built in code with these helpers.
-- Style: BuilderSans, white text, dark translucent rounded panels.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Sounds = require(script.Parent.Parent.Sounds)

local UIKit = {}

UIKit.FONT = Enum.Font.BuilderSans
UIKit.BOLD = Enum.Font.BuilderSansBold
UIKit.HEAVY = Enum.Font.BuilderSansExtraBold
UIKit.PANEL = Color3.fromHex(Config.COLORS.Panel)
UIKit.PANEL_TRANSPARENCY = 0.25
UIKit.WHITE = Color3.new(1, 1, 1)
UIKit.MUTED = Color3.fromRGB(190, 194, 200)
UIKit.LIME = Color3.fromHex(Config.COLORS.SelfName)
UIKit.RED = Color3.fromHex(Config.COLORS.ZombieText)
UIKit.GOLD = Color3.fromHex(Config.COLORS.VipName)
UIKit.ACCENT = Color3.fromHex(Config.COLORS.Accent)
UIKit.GOOD = Color3.fromHex(Config.COLORS.Good)

type Props = { [string]: any }

-- Creates an instance, applies properties (Parent last) and adds children.
function UIKit.new(className: string, props: Props?, children: { any }?): any
	local instance = Instance.new(className) :: any
	local parent = nil
	local given: Props = props or {}
	local kids: { any } = children or {}
	for key, value in given do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in kids do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UIKit.corner(radius: number?): Instance
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 8) })
end

function UIKit.stroke(color: Color3?, thickness: number?, transparency: number?): Instance
	return UIKit.new("UIStroke", {
		Color = color or UIKit.WHITE,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UIKit.textStroke(thickness: number?): Instance
	return UIKit.new("UIStroke", {
		Color = Color3.fromRGB(15, 15, 18),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	})
end

function UIKit.padding(px: number, vertical: number?): Instance
	local v = vertical or px
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, v),
		PaddingBottom = UDim.new(0, v),
	})
end

function UIKit.list(
	direction: Enum.FillDirection?,
	padding: number?,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): Instance
	return UIKit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UIKit.panel(props: Props, children: { any }?): Frame
	local merged: Props = {
		BackgroundColor3 = UIKit.PANEL,
		BackgroundTransparency = UIKit.PANEL_TRANSPARENCY,
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	local frame = UIKit.new("Frame", merged, children)
	UIKit.corner(8).Parent = frame
	return frame
end

function UIKit.label(props: Props): TextLabel
	local merged: Props = {
		BackgroundTransparency = 1,
		Font = UIKit.BOLD,
		TextColor3 = UIKit.WHITE,
		TextSize = 18,
		Text = "",
		BorderSizePixel = 0,
	}
	for key, value in props do
		merged[key] = value
	end
	return UIKit.new("TextLabel", merged)
end

function UIKit.button(props: Props, onClick: (() -> ())?): TextButton
	local merged: Props = {
		BackgroundColor3 = UIKit.ACCENT,
		BorderSizePixel = 0,
		Font = UIKit.HEAVY,
		TextColor3 = UIKit.WHITE,
		TextSize = 18,
		AutoButtonColor = true,
	}
	for key, value in props do
		merged[key] = value
	end
	local button = UIKit.new("TextButton", merged)
	UIKit.corner(8).Parent = button
	button.Activated:Connect(function()
		Sounds.play("UiClick")
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- A centered modal window with a title bar and a close button. Returns the
-- window and its content frame.
function UIKit.modal(
	parent: Instance,
	title: string,
	width: number,
	height: number,
	onClose: () -> ()
): (Frame, Frame, TextLabel)
	local window = UIKit.panel({
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.94, 0, 0.86, 0),
		BackgroundTransparency = 0.08,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(width, height), Parent = window })
	local heading = UIKit.label({
		Name = "Title",
		Text = title,
		TextSize = 26,
		Font = UIKit.HEAVY,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -80, 0, 36),
		ZIndex = 21,
		Parent = window,
	})
	UIKit.button({
		Name = "Close",
		Text = "X",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Color3.fromRGB(70, 72, 78),
		ZIndex = 22,
		Parent = window,
	}, onClose)
	local content = UIKit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -64),
		ZIndex = 21,
		Parent = window,
	})
	return window, content, heading
end

-- Renders a 3D model inside a ViewportFrame, framed from above at an angle.
-- `fromAbove` looks straight down with the front up, like the game camera.
function UIKit.viewport(parent: Instance, model: Model, props: Props?, fromAbove: boolean?): ViewportFrame
	local merged: Props = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(205, 205, 205),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.3, -1, -0.4),
	}
	local given: Props = props or {}
	for key, value in given do
		merged[key] = value
	end
	local frame = UIKit.new("ViewportFrame", merged)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = frame
	frame.CurrentCamera = camera
	model.Parent = frame
	local cf, size = model:GetBoundingBox()
	local radius = math.max(size.Magnitude / 2, 0.5)
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.08
	if fromAbove then
		camera.CFrame = CFrame.lookAt(cf.Position + Vector3.yAxis * distance, cf.Position, -Vector3.zAxis)
	else
		local from = cf.Position + Vector3.new(0.45, 1, 0.75).Unit * distance
		camera.CFrame = CFrame.lookAt(from, cf.Position)
	end
	frame.Parent = parent
	return frame
end

return UIKit
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="LocalScript" referent="73">
        <Properties>
          <string name="Name">RbxCharacterSounds</string>
